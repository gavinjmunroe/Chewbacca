#!/usr/bin/env bash
# chewbacca api: any website as an API the agent calls over plain HTTP.
#
#   chewbacca api                      every site and how many operations each has
#   chewbacca api ops <site>           a site's operations, params and caveats
#   chewbacca api call <site> <op> k=v one call, one line of JSON back
#   chewbacca api teach <site> <op> --trigger <url> --example k=v ...
#                                      learn a new operation (api-anything add)
#   chewbacca api login <site>         import a session from a signed-in browser
#                                      (brightspace: from the Work Chrome profile)
#   chewbacca api sync                 load the kit's taught sites into the engine
#   chewbacca api install              build the engine, wire MCP into Claude and Codex
#
# The engine is goodnight000/api-anything (MIT). It watches a site's own page
# make a request once, then replays that request with new inputs, falling back
# to Chrome only when plain HTTP is refused. It stays an upstream binary because
# its repair logic tracks sites that change underneath it.
#
# Sites this kit taught live in library/api-sites/<site>.json with a <site>.md
# of caveats. `sync` copies them into the engine's own store, and only over a
# copy that is older than the repo's, so an operation the engine healed in
# place since the last sync is kept. Clay is not here: it has its own engine.
set -uo pipefail

ROOT="${CHEWBACCA_ROOT:-$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)}"
KIT_SITES="${CHEWBACCA_API_SITES:-$ROOT/library/api-sites}"
ENGINE_HOME="${API_ANYTHING_HOME:-$HOME/.api-anything}"
UPSTREAM="https://github.com/goodnight000/api-anything.git"
# Pinned to the commit built and tested on 2026-10-09. A moving HEAD would
# install whatever upstream pushes next, with this kit's MCP and your sessions.
UPSTREAM_SHA="ba26db14a122a684e2de672a24c6480c9b274e53"

say() { printf '%s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

install_engine() {
  have node || { say "chewbacca api needs Node 22.13 or newer."; return 1; }
  if ! have api-anything; then
    say "Building the api engine (one time, about a minute)..."
    (
      dir="$(mktemp -d)" || exit 1
      trap 'rm -rf "$dir"' 0
      git clone -q "$UPSTREAM" "$dir" &&
        cd "$dir" &&
        git -c advice.detachedHead=false checkout -q "$UPSTREAM_SHA" &&
        npm ci --no-audit --no-fund >/dev/null 2>&1 &&
        archive="$(npm pack --silent)" &&
        npm install -g "$archive" >/dev/null 2>&1
    ) || { say "Could not build the api engine."; return 1; }
  fi
  # MCP: four tools (list_sites, list_operations, call_operation, login).
  # Wired through this script so the kit's specs are re-checked on start.
  local self="$ROOT/bin/chewbacca-api"
  if have claude; then
    claude mcp remove --scope user api-anything >/dev/null 2>&1
    claude mcp add --scope user api-anything -- bash "$self" mcp >/dev/null 2>&1
  fi
  if have codex; then
    codex mcp remove api-anything >/dev/null 2>&1
    codex mcp add api-anything -- bash "$self" mcp >/dev/null 2>&1
  fi
  local skill
  skill="$(npm root -g 2>/dev/null)/api-anything/skills/api-anything/SKILL.md"
  if [ -f "$skill" ]; then
    mkdir -p "$HOME/.claude/skills/api-anything" && cp "$skill" "$HOME/.claude/skills/api-anything/"
  fi
  sync_sites
  say "api engine ready: $(api-anything sites 2>/dev/null | grep -o '"name"' | wc -l | tr -d ' ') sites"
}

# A spec from the repo is replayed with your cookies for its site. So one that
# names a site you are signed in to, or sends a request off its own domain,
# could carry a session somewhere else. Kit specs are logged-out reads; refuse
# anything that is not.
spec_is_safe() {
  # Node's WHATWG URL, the parser the engine itself uses, so a URL this check
  # reads as on-site cannot resolve somewhere else when the engine sends it
  # (Python's urlparse and WHATWG disagree on "https://evil.com\\@site.com").
  node - "$1" "$ENGINE_HOME/sessions" "${2:-$(basename "$1")}" "$KIT_SITES/hosts.allow" <<'JS'
const fs = require("fs"), path = require("path");
const [file, sessions, shown, allowFile] = process.argv.slice(2);
const die = (m) => { console.error(m); process.exit(1); };
let spec;
try { spec = JSON.parse(fs.readFileSync(file, "utf8")); } catch (e) { die(`${shown}: not JSON`); }
// The engine loads a site by file name; a spec whose name differs would be
// checked against one site's session and run as another.
const name = path.basename(shown, ".json");
if (spec.name !== name) die(`${shown}: its name is "${spec.name}", not "${name}"`);
// Registrable domain, with the two-letter-country second levels (co.uk, com.au).
const root = (h) => { const l = h.split("."); const n = /^(co|com|net|org|ac|gov|edu)$/.test(l[l.length - 2] || "") && l[l.length - 1].length === 2 ? 3 : 2; return l.slice(-n).join("."); };
const hostOf = (u) => { try { return new URL(u).hostname.toLowerCase(); } catch { return ""; } };
const base = hostOf(String(spec.baseUrl || ""));
if (!base || /[{}%]/.test(base)) die(`${name}: baseUrl is missing or templated`);
const home = root(base);
// A site whose own frontend calls a third-party API (YC's directory is an
// Algolia index) lists that exact host in hosts.allow, one "site host" per
// line, after someone read the request. Nothing else leaves the domain.
let allowed = new Set();
try {
  allowed = new Set(fs.readFileSync(allowFile, "utf8").split("\n").map((l) => l.replace(/#.*/, "").trim().split(/\s+/)).filter((p) => p[0] === name && p[1]).map((p) => p[1].toLowerCase()));
} catch {}
const reviewed = allowed.has("signed-in-ok");
// The engine also keeps cookies a logged-out site sets on a plain call; only a
// session imported by `login` carries a "source", and only that one is yours.
try {
  if (JSON.parse(fs.readFileSync(path.join(sessions, name + ".json"), "utf8")).source && !reviewed)
    die(`${name}: you have a signed-in session for this site; a repo spec will not replace it unless hosts.allow marks it signed-in-ok`);
} catch (e) { if (e.code !== "ENOENT" && !(e instanceof SyntaxError)) throw e; }
// Kit specs are reads. A write op from the repo would be one --allow-writes
// away from acting as the user.
for (const op of spec.operations || []) if (op?.readOnly !== true) die(`${name}.${op?.name}: not a read-only operation`);
// The session check above is by name, but the browser fallback runs in one
// shared Chrome profile that holds every login's cookies. So a spec on the
// same domain as any signed-in site (linkedin-jobs beside a linkedin login)
// would ride that login. Refused, unless a person listed the site as
// "<site> signed-in-ok" in hosts.allow after reading it.
// Matched the way a browser sends cookies: a cookie for brightspace.usc.edu
// reaches that host and its subdomains, never classes.usc.edu. Comparing
// registrable domains instead flagged every usc.edu site the moment
// Brightspace was signed in (2026-10-10).
const cookieDomains = new Set();
try {
  for (const f of fs.readdirSync(sessions)) {
    if (!f.endsWith(".json")) continue;
    try {
      const sess = JSON.parse(fs.readFileSync(path.join(sessions, f), "utf8"));
      if (sess.source) for (const c of sess.cookies || []) if (c?.domain) cookieDomains.add(String(c.domain).replace(/^\./, "").toLowerCase());
    } catch { die(`${name}: session ${f} is unreadable, so whether you're signed in can't be checked`); }
  }
} catch (e) { if (e.code !== "ENOENT") die(`${name}: sessions unreadable (${e.code})`); }
const specHosts = new Set([base]);
for (const op of spec.operations || []) for (const u of [op?.request?.url, op?.trigger?.url]) if (u !== undefined && hostOf(u)) specHosts.add(hostOf(u));
const rides = [...specHosts].find((h) => [...cookieDomains].some((d) => h === d || h.endsWith("." + d)));
if (rides && !reviewed)
  die(`${name}: ${rides} gets cookies from a signed-in session; list "${name} signed-in-ok" in hosts.allow after reading the spec`);
// Every string in the spec, keys included: a host can hide in a header value,
// a redirect, or a template whose host is a parameter.
const walk = (v, out) => { if (typeof v === "string") out.push(v); else if (v && typeof v === "object") for (const [k, x] of Object.entries(v)) { out.push(k); walk(x, out); } return out; };
// The fields the engine actually sends from, checked directly: each request
// URL, trigger URL and match host must parse to an allowed host, and no slot
// may write the Host or authority header.
const okHost = (h) => !!h && (h === home || h.endsWith("." + home) || allowed.has(h));
for (const op of Array.isArray(spec.operations) ? spec.operations : die(`${name}: no operations`)) {
  for (const u of [op?.request?.url, op?.trigger?.url]) {
    if (u === undefined) continue;
    const auth = String(u).replace(/^https?:\/\//i, "").split(/[/?#]/)[0];
    if (!/^https?:\/\//i.test(String(u)) || /[{}%\\@\s]/.test(auth) || !okHost(hostOf(u)))
      die(`${name}.${op.name}: sends to ${u}, outside ${home}`);
  }
  // A third-party host from hosts.allow gets public requests only: no cookie
  // of the user's rides to it, whatever a later edit to the allowlist says.
  const third = [op?.request?.url, op?.trigger?.url].some((u) => u !== undefined && !(hostOf(u) === home || hostOf(u).endsWith("." + home)));
  if (third && /"cookie:/.test(JSON.stringify(op))) die(`${name}.${op.name}: sends a cookie to a third-party host`);
  if (op?.match?.host !== undefined && !okHost(String(op.match.host).toLowerCase())) die(`${name}.${op.name}: matches host ${op.match.host}`);
  // A caller's argument may fill a header only where it can't redirect or
  // authenticate a request: the referer. Session refs fill headers with
  // values this same site issued, sent back to it.
  for (const sl of op.slots || []) for (const at of sl.at || [])
    if (/^header:/i.test(String(at)) && sl.ref === undefined && !/^header:referer$/i.test(String(at)))
      die(`${name}.${op.name}: an argument writes ${at}`);
}
// An op's `response` block only parses what came back (extract paths, pick
// patterns like "url=link~(https?://[^\s]+)" in sc-engage); the engine never
// sends from it, so it is left out of the scan. Everything else is scanned.
const sendable = { ...spec, operations: (spec.operations || []).map((op) => { const { response, ...rest } = op || {}; return rest; }) };
for (const s of walk(sendable, [])) {
  for (const m of s.matchAll(/(?:[a-z][a-z0-9+.-]*:)?\/\/[^\s"'<>]*/gi)) {
    const u = m[0].startsWith("//") ? "https:" + m[0] : m[0];
    if (!/^https?:/i.test(u)) continue;
    const auth = u.replace(/^https?:\/\//i, "").split(/[/?#]/)[0];
    if (/[{}%\\@]/.test(auth)) die(`${name}: a request host is templated or obfuscated (${auth})`);
    const h = hostOf(u);
    if (!okHost(h)) die(`${name}: requests ${h || u}, outside ${home}`);
  }
}
JS
}

sync_sites() {
  [ -d "$KIT_SITES" ] || return 0
  mkdir -p "$ENGINE_HOME/sites"
  local f base dest tmp copied=0
  for f in "$KIT_SITES"/*.json; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    dest="$ENGINE_HOME/sites/$base"
    if [ -f "$dest" ] && ! [ "$f" -nt "$dest" ]; then
      # Already installed, but a login since then (or an edited hosts.allow)
      # can make it unsafe now. Re-check what's installed from the kit on
      # every run and pull it if it no longer passes.
      if grep -qxF "$base" "$ENGINE_HOME/sites/.from-kit" 2>/dev/null && ! spec_is_safe "$dest" "$base" 2>/dev/null; then
        rm -f "$dest" "${dest%.json}.md"
        say "removed $base: it no longer passes the kit's check (chewbacca api sync says why)" >&2
      fi
      continue
    fi
    # Check the copy that gets installed, not the repo file, so nothing can
    # change between the check and the move.
    tmp="$(mktemp "$ENGINE_HOME/sites/.$base.XXXXXX")" || continue
    cp "$f" "$tmp"
    if ! spec_is_safe "$tmp" "$base"; then
      rm -f "$tmp"
      say "refused $base: see above" >&2
      continue
    fi
    mv -f "$tmp" "$dest" && copied=$((copied + 1))
    grep -qxF "$base" "$ENGINE_HOME/sites/.from-kit" 2>/dev/null || echo "$base" >> "$ENGINE_HOME/sites/.from-kit"
    # Notes ride along, and only with a spec that passed.
    [ -f "${f%.json}.md" ] && cp "${f%.json}.md" "$ENGINE_HOME/sites/"
  done
  [ "${1:-}" = "--quiet" ] || say "synced $copied site(s) from the kit"
}

# Brightspace's d2l login cookies have no expiry, and the engine's own Chrome
# drops cookies like that on every restart, so a plain profile import never
# held (2026-10-10: every capture bounced to USC SSO). Instead this reads the
# four d2l cookies the way bin/brightspace does, gives them a 12 hour expiry,
# imports them from a private temp file, and deletes the file.
login_brightspace() {
  local dir rc
  dir="$(mktemp -d)" || return 1
  chmod 700 "$dir"
  if ! python3 - "$ROOT/bin/brightspace" "$dir/cookies.json" <<'PY'
import importlib.machinery, importlib.util, json, os, sys, time
loader = importlib.machinery.SourceFileLoader("brightspace", sys.argv[1])
spec = importlib.util.spec_from_loader("brightspace", loader)
mod = importlib.util.module_from_spec(spec); loader.exec_module(mod)
jar = {k: v for k, v in mod.chrome_cookies().items() if k.lower().startswith("d2l")}
if not jar:
    sys.exit("no Brightspace session in the Work Chrome profile; open brightspace.usc.edu there once")
expires = int(time.time()) + 12 * 3600
rows = [{"name": k, "value": v, "domain": "brightspace.usc.edu", "path": "/", "expires": expires,
         "httpOnly": True, "secure": True, "sameSite": "Lax"} for k, v in jar.items()]
fd = os.open(sys.argv[2], os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd, "w") as f:
    json.dump(rows, f)
PY
  then
    rm -rf "$dir"
    return 1
  fi
  api-anything login brightspace --cookies "$dir/cookies.json" >/dev/null; rc=$?
  rm -rf "$dir"
  [ "$rc" -eq 0 ] && say "Brightspace session imported for 12 hours"
  return "$rc"
}

need_engine() {
  have api-anything && return 0
  install_engine
}

cmd="${1:-sites}"
[ $# -gt 0 ] && shift

case "$cmd" in
  install|setup) install_engine ;;
  sync) need_engine && sync_sites ;;
  teach) need_engine && exec api-anything add "$@" ;;
  login)
    # A login changes which kit specs are safe, so re-check them after it,
    # not only before the next call.
    need_engine || exit 1
    if [ "${1:-}" = brightspace ]; then
      sync_sites --quiet
      login_brightspace; rc=$?
    else
      api-anything login "$@"; rc=$?
    fi
    sync_sites --quiet
    exit "$rc"
    ;;
  mcp)
    # Agents reach the engine through this, never `api-anything mcp` directly,
    # so the kit's specs are re-checked each time a server starts.
    need_engine || exit 1
    sync_sites --quiet
    exec api-anything mcp "$@"
    ;;
  sites|ops|call|logout|capture|inspect|verify|heal|export|add)
    need_engine || exit 1
    sync_sites --quiet
    exec api-anything "$cmd" "$@"
    ;;
  -h|--help|help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)
    say "chewbacca api: unknown command '$cmd'. Try: chewbacca api help"
    exit 2
    ;;
esac
