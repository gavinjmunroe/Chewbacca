          "image": "./assets/images/splash-amber.png",
          "imageWidth": 84,
          "resizeMode": "contain",
          "backgroundColor": "#FFFDFA"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Amber uses your contacts to build your relationship graph and surface warm intros."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Amber reads your calendar to overlay opportunity prompts on upcoming events and surface who you're meeting with."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Amber uses Face ID to unlock your relationship graph so only you can open the app."
        }
      ],
      "expo-audio",
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "record",
              "title": "New voice note",
              "subtitle": "Talk to Amber",
              "icon": "symbol:mic.fill"
            }
          ]
        }
      ],
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Amber uses the camera to scan business cards and contact QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-document-picker",
      "./plugins/withReactCoreConfiguration"
