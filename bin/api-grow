#!/usr/bin/env python3
"""api-grow: every site an agent browses becomes an API op, or gets a reason not to.

  api-grow status            hosts browsed with no op yet (most visited first),
                             hosts skipped and why, hosts that grew an API
  api-grow lookup <url>      the taught sites and ops for that URL's host
  api-grow skip <host> why   never ask to teach this host again
  api-grow hook              read a Claude Code hook event on stdin (the hooks call this)

The hooks run it before and after every browse (WebFetch, browser MCPs, chewie
web, jev-browse, scrape, curl). See bin/lib/api_grow.py for the why.
"""
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
import api_grow  # noqa: E402


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "hook":
        try:
            payload = json.loads(sys.stdin.read() or "{}")
        except ValueError:
            return 0
        if not isinstance(payload, dict):
            return 0
        try:
            line = api_grow.handle(payload)
        except Exception as e:  # a hook must never break the tool call it rides on
            sys.stderr.write("api-grow: %s\n" % e)
            return 0
        if line:
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": str(payload.get("hook_event_name") or "PostToolUse"),
                "additionalContext": line}}))
        return 0
    if cmd == "status":
        print(json.dumps(api_grow.status(), indent=1))
        return 0
    if cmd == "lookup" and len(argv) > 2:
        host = api_grow.host_of(argv[2] if "://" in argv[2] else "https://" + argv[2])
        print(json.dumps({"host": host, "sites": api_grow.lookup(host),
                          "never_teach": api_grow.never_teach(host)}))
        return 0
    if cmd == "skip" and len(argv) > 2:
        print(json.dumps(api_grow.skip(argv[2], " ".join(argv[3:]))))
        return 0
    sys.stdout.write(__doc__)
    return 0 if cmd in ("-h", "--help", "help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
