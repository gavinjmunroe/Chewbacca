vision/outbox/

# MCP client config: this file embeds local-only tool endpoints and may
# contain operator-specific secrets for connected MCP servers. Treat it
# like .env — never commit per-developer copies.
.mcp.json
**/.mcp.json

# Local data dumps: per-tenant calendar / context exports that operators
# generate while debugging. These are personal data — not source — and
# must not land in the repo.
Newton/agent/calendar-events.json
**/calendar-events.json
**/calendar-dump-*.json
