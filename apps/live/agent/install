#!/usr/bin/env bash
# Installs the live stats sync as a launchd agent on this Mac, pointing at the
# script in this checkout, and restarts it. Needs the sync key in the login
# keychain first (service chewbacca-live-sync). Idempotent.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
AGENT="$HERE/live-stats-sync"
if ! security find-generic-password -s chewbacca-live-sync >/dev/null 2>&1; then
  echo "install: no chewbacca-live-sync key in the login keychain" >&2
  exit 1
fi
mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
# launchd starts jobs with a bare PATH, and api-anything (the inbox reader)
# lives wherever this shell's node put it, often under ~/.nvm. On 2026-10-10 the
# first launchd run said "api-anything is not installed" for exactly this.
EXTRA=""
for tool in api-anything node; do
  found="$(command -v "$tool" 2>/dev/null || true)"
  [ -n "$found" ] && EXTRA="$EXTRA$(dirname "$found"):"
done
# One Login Items row for all of Chewbacca: this is a keepalive service of
# chewbacca-daemon, not its own LaunchAgent (Caleb, 2026-10-11).
NODE="$("$HERE/../../../bin/chewbacca-node" 2>/dev/null || command -v node)"
"$NODE" "$HERE/../../../bin/chewbacca-daemon" register live-stats-sync --keepalive \
  --env "PATH=${EXTRA}$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" -- /usr/bin/python3 "$AGENT"
launchctl bootout "gui/$(id -u)/com.chewbacca.live-stats-sync" 2>/dev/null || true
rm -f "$HOME/Library/LaunchAgents/com.chewbacca.live-stats-sync.plist"
"$NODE" "$HERE/../../../bin/chewbacca-daemon" install >/dev/null
echo "installed live-stats-sync -> $AGENT"
