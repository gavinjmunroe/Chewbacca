#!/usr/bin/env python3
"""Coding-agent sessions on the glass, so agent work needs no editor or terminal.

    kyber-sessions                     one line per session, what needs you first
    kyber-sessions --json              the same as JSON (--all adds scripted `claude -p` runs)
    kyber-sessions needs --json        only the sessions waiting on a person
    kyber-sessions stream <id>         a session's transcript as JSON lines (--follow keeps going)
    kyber-sessions send <id> <text>    one message to an idle session, reply streamed as JSON lines
    kyber-sessions send --fork <id> <text>  the same into a new headless copy of it
                                       (--fork only as the first word after send; an id
                                       prefix must name exactly one session)
    kyber-sessions run <id> <what>     an allowlisted command in its folder: status, diff, tests
    kyber-sessions route "<words>"     which session a sentence is for (the hook for hud-listen)
    kyber-sessions serve [--open <id>] draw the sessions surface and answer its presses

Sessions come from Claude Code's own transcripts (~/.claude/projects/*/*.jsonl,
and ~/.claude-2 when present), merged with the terminal hook's live board
(bin/lib/agent_board.py), which is where "waiting on you" and the exact
permission text come from. Codex rollouts in ~/.codex/sessions are listed,
read-only.

Everything read from a transcript is untrusted: it is drawn, never acted on.
Nothing here grants a permission. A message is sent only when the person
presses send (the card's own Send, or the conversation panel addressed to a
session with `to`), and only to a session that is idle, never into one
mid-run.

How it gets there depends on whether the session is open in a client right
now. Open (VS Code, a terminal, any interactive claude): through the inbox
Claude Code gives every running session (bin/lib/sessions_inbox.py), so the
text lands in the window Caleb left it in. Not open: `claude -p --resume`
in its folder, as before, with the text on stdin so it can never be read as
a flag. A session open somewhere is never resumed by a second process,
because two writers on one transcript fork the conversation.

Whether an open session would hold the message is predicted from the
permission mode in its transcript, which only a turn writes. A mode switched
in VS Code after the last turn is not seen; if Claude Code then holds the
message, the transcript says so and the send reports `held`, not delivered.

Layout design follows Carlton Aikins' realm (github.com/31Carlton7/realm,
unlicensed, read as a design reference only; no code from it is used).
"""
from __future__ import annotations

import json
import os
import re
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path
from typing import Callable, Iterable, Iterator

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import hud_events  # noqa: E402
import sessions_inbox  # noqa: E402

HOME = Path.home()
SOCKET = os.environ.get("BOB_HUD_SOCKET", str(HOME / ".bob" / "hud.sock"))
CLAUDE_DIRS = [Path(p) for p in os.environ.get(
    "KYBER_CLAUDE_DIRS", f"{HOME / '.claude'}:{HOME / '.claude-2'}").split(":") if p]
CODEX_DIR = Path(os.environ.get("KYBER_CODEX_DIR", str(HOME / ".codex" / "sessions")))
CLAUDE_BIN = os.environ.get("KYBER_CLAUDE", "claude")

# How much of a transcript's end is read to decide its state and draw it.
# Measured 2026-10-04: this session's transcript was 9 MB and its last 40
# turns sat in the final 600 KB; 768 KB keeps them with room.
TAIL_BYTES = 768_000
# Newer than this and still mid-turn is working; older and mid-turn on a
# tool call is a turn that stopped on something, most often a permission
# dialog in a terminal the hook did not report. Guessed, never measured.
WORKING_S = 45.0
# A user turn with nothing after it for this long is a run that died.
# Guessed, never measured.
STALLED_S = 600.0
# Only transcripts touched within this window are listed: a week of
# finished work is history, not something on the glass. Guessed.
RECENT_S = 3 * 24 * 3600.0
# A tool call with no result older than this is not a dialog anyone is
# still looking at. Guessed, never measured.
ABANDONED_S = 2 * 3600.0
# Where a session was started from. `sdk-py` and `sdk-cli` are programs
# (reviewer runs, the voice's own `claude -p`): on 2026-10-04 they were 19 of
# the 25 newest transcripts and buried the four Caleb was actually in.
INTERACTIVE = frozenset({"cli", "claude-vscode", "claude-desktop"})
# The most rows the surface shows. Miller's seven plus two.
MAX_ROWS = 9
# How many turns a session card draws.
CARD_TURNS = 40

RANK = {"needs": 0, "working": 1, "failed": 2, "finished": 3}
WORDS = {"needs": "needs you", "working": "working", "failed": "failed", "finished": "finished"}

# What a Claude Code session exports into every process it starts. The same
# list as hud-listen's INHERITED_SESSION_VARS (a test keeps the two equal):
# a resumed session must not run as a child of whatever started this, or it
# stops saving its transcript (2026-09-20, see hud-listen).
INHERITED_SESSION_VARS = frozenset({"FORCE_COLOR", "COLORTERM", "CLICOLOR_FORCE", "CLAUDECODE"})
INHERITED_SESSION_PREFIXES = ("CLAUDE_CODE_",)


def scrubbed_env(config: Path | None = None) -> dict[str, str]:
    env = {k: v for k, v in os.environ.items()
           if k not in INHERITED_SESSION_VARS and not k.startswith(INHERITED_SESSION_PREFIXES)}
    if config and config.name != ".claude":
        env["CLAUDE_CONFIG_DIR"] = str(config)
    else:
        env.pop("CLAUDE_CONFIG_DIR", None)
    return env


# ── Reading transcripts ──────────────────────────────────────────────────────

def tail_entries(path: Path, max_bytes: int = TAIL_BYTES) -> list[dict]:
    try:
        with path.open("rb") as f:
            size = f.seek(0, 2)
            f.seek(max(0, size - max_bytes))
            raw = f.read().decode("utf-8", errors="replace")
    except OSError:
        return []
    lines = raw.splitlines()
    if size > max_bytes and lines:
        lines = lines[1:]  # a mid-file read starts on a fragment
    out = []
    for line in lines:
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if isinstance(entry, dict):
            out.append(entry)
    return out


def blocks(entry: dict) -> list[dict]:
    content = (entry.get("message") or {}).get("content")
    if isinstance(content, str):
        return [{"type": "text", "text": content}]
    return [b for b in content if isinstance(b, dict)] if isinstance(content, list) else []


def is_turn(entry: dict) -> bool:
    """A user or assistant message that is part of the conversation, not a
    hook attachment, a title line or a subagent's sidechain."""
    return entry.get("type") in ("user", "assistant") and not entry.get("isSidechain") \
        and not entry.get("isMeta")


def classify(entries: list[dict], age_s: float) -> tuple[str, str]:
    """(state, detail) from a transcript's tail and how long since it was written.

    `needs` from here is a guess (a tool call with no result that has sat
    still); the hook's board, when it has the session, is the authority.
    """
    turns = [e for e in entries if is_turn(e)]
    if not turns:
        return "finished", ""
    last = turns[-1]
    if last.get("isApiErrorMessage") or any(
            e.get("type") == "system" and "error" in str(e.get("subtype") or e.get("level") or "")
            for e in entries[-3:]):
        return "failed", first_text(last)[:140] or "the API returned an error"
    kinds = [b.get("type") for b in blocks(last)]
    # A `--json-schema` run ends on a StructuredOutput call and its result.
    # Read as a stalled tool call, every finished reviewer run showed as
    # "needs you" or "failed" on the first live list (2026-10-04).
    if any(b.get("type") == "tool_use" and b.get("name") == "StructuredOutput" for t in turns[-2:]
           for b in blocks(t)):
        return "finished", ""
    if last.get("type") == "assistant":
        stop = (last.get("message") or {}).get("stop_reason")
        if "tool_use" in kinds:
            use = next(b for b in blocks(last) if b.get("type") == "tool_use")
            if age_s <= WORKING_S:
                return "working", tool_line(use)
            if age_s <= ABANDONED_S:
                return "needs", tool_line(use)
            return "failed", "stopped on " + tool_line(use)
        if stop == "end_turn" or "text" in kinds:
            return ("working", "") if age_s <= 5 and stop != "end_turn" else ("finished", "")
        return ("working", "") if age_s <= WORKING_S else ("finished", "")
    # The last turn is the person's, or a tool's result: the model owes a reply.
    if age_s <= STALLED_S:
        return "working", ""
    return "failed", "stopped without an answer"


def first_text(entry: dict) -> str:
    for b in blocks(entry):
        if b.get("type") == "text" and str(b.get("text") or "").strip():
            return " ".join(str(b["text"]).split())
    return ""


def tool_line(use: dict) -> str:
    name = str(use.get("name") or "tool")
    args = use.get("input") if isinstance(use.get("input"), dict) else {}
    target = args.get("command") or args.get("file_path") or args.get("path") \
        or args.get("pattern") or args.get("url") or args.get("description") or ""
    target = " ".join(str(target).split())
    return f"{name}: {target[:120]}" if target else name


def meta(entries: list[dict]) -> dict:
    """Title, model and folder: the newest of each in the tail."""
    out = {"title": "", "model": "", "cwd": "", "mode": ""}
    points = {str(e.get("entrypoint")) for e in entries if e.get("entrypoint")}
    for e in reversed(entries):
        if not out["mode"] and e.get("permissionMode"):
            out["mode"] = str(e["permissionMode"])
        if not out["title"]:
            out["title"] = str(e.get("customTitle") or e.get("aiTitle") or e.get("summary") or "").strip() \
                if e.get("type") in ("custom-title", "ai-title", "summary") else ""
        if not out["model"] and e.get("type") == "assistant":
            out["model"] = str((e.get("message") or {}).get("model") or "")
        if not out["cwd"] and e.get("cwd"):
            out["cwd"] = str(e["cwd"])
        if out["title"] and out["model"] and out["cwd"] and out["mode"]:
            break
    out["interactive"] = bool(points & INTERACTIVE) or not points
    if not out["title"]:
        first_user = next((e for e in entries if e.get("type") == "user" and is_turn(e) and first_text(e)), None)
        out["title"] = first_text(first_user)[:80] if first_user else ""
    return out


def project_of(cwd: str) -> str:
    """The repo a folder belongs to: a worktree under `<repo>/.claude/worktrees/`
    is that repo, not `agent-a461fbe8a950a0206`."""
    parts = Path(cwd).parts
    if ".claude" in parts and "worktrees" in parts:
        i = parts.index(".claude")
        if i > 0:
            return parts[i - 1]
    return Path(cwd).name


def short_model(model: str) -> str:
    m = re.search(r"(opus|sonnet|haiku|fable)", model)
    return m.group(1) if m else (model.split("-")[0] if model else "")


def age_words(seconds: float) -> str:
    s = max(0, int(seconds))
    if s < 60:
        return "now"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h"
    return f"{s // 86400}d"


def claude_transcripts(now: float) -> Iterator[tuple[Path, Path]]:
    for config in CLAUDE_DIRS:
        root = config / "projects"
        if not root.is_dir():
            continue
        for path in root.glob("*/*.jsonl"):
            try:
                if now - path.stat().st_mtime <= RECENT_S:
                    yield config, path
            except OSError:
                continue


# Parsed tails, keyed on size and mtime. Measured 2026-10-04: listing 300
# recent transcripts cold took 1.3 s of CPU, which every two seconds in
# `serve` would be most of a core; unchanged files now cost a stat.
_parsed: dict[str, tuple[tuple[int, int], list[dict]]] = {}


def cached_entries(path: Path) -> list[dict]:
    st = path.stat()
    stamp = (st.st_size, st.st_mtime_ns)
    hit = _parsed.get(str(path))
    if hit and hit[0] == stamp:
        return hit[1]
    entries = tail_entries(path)
    _parsed[str(path)] = (stamp, entries)
    return entries


# Modes read from behind the tail, keyed like `_parsed`. Measured 2026-10-05
# with --all: 43 of 461 Claude rows had no permissionMode in their last
# 768 KB, so --json showed their mode as ""; with this fallback, 3 did (their
# transcripts never record one). A review the same day saw open bypass
# sessions among the empty ones.
_modes: dict[str, tuple[tuple[int, int], str]] = {}


def effective_mode(path: Path, tail_mode: str) -> str:
    """The tail's mode, else the newest one anywhere in the transcript."""
    if tail_mode:
        return tail_mode
    st = path.stat()
    stamp = (st.st_size, st.st_mtime_ns)
    hit = _modes.get(str(path))
    if hit and hit[0] == stamp:
        return hit[1]
    mode = sessions_inbox.last_mode(path)
    _modes[str(path)] = (stamp, mode)
    return mode


def from_transcript(config: Path, path: Path, now: float) -> dict:
    entries = cached_entries(path)
    mtime = path.stat().st_mtime
    state, detail = classify(entries, now - mtime)
    m = meta(entries)
    m["mode"] = effective_mode(path, m["mode"])
    cwd = m["cwd"]
    return {
        "id": path.stem, "agent": "claude", "config": str(config), "transcript": str(path),
        "cwd": cwd, "project": project_of(cwd) if cwd else path.parent.name,
        "interactive": m["interactive"], "mode": m["mode"],
        "title": m["title"], "model": short_model(m["model"]), "last": mtime,
        "state": state, "detail": detail, "ask": "",
    }


def codex_sessions(now: float) -> Iterator[dict]:
    if not CODEX_DIR.is_dir():
        return
    for path in CODEX_DIR.glob("*/*/*/*.jsonl"):
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        if now - mtime > RECENT_S:
            continue
        cwd, title, model = "", "", ""
        for e in tail_entries(path, 200_000):
            p = e.get("payload") if isinstance(e.get("payload"), dict) else {}
            cwd = cwd or str(p.get("cwd") or "")
            model = model or str(p.get("model") or "")
            if not title and p.get("type") == "message" and p.get("role") == "user":
                text = " ".join(str(c.get("text") or "") for c in p.get("content") or [] if isinstance(c, dict))
                if text and not text.lstrip().startswith("<"):
                    title = " ".join(text.split())[:80]
        yield {
            "id": path.stem, "agent": "codex", "config": "", "transcript": str(path), "cwd": cwd,
            "interactive": True,
            "project": Path(cwd).name if cwd else "codex", "title": title, "model": model,
            "last": mtime, "state": "working" if now - mtime <= WORKING_S else "finished",
            "detail": "", "ask": "",
        }


def merge_live(sessions: dict[str, dict], live: dict[str, dict]) -> None:
    """Claude Code's own registry says which sessions are open in a client
    right now, and whether each is idle or busy. That beats every guess from
    a transcript's tail; the hook's board, merged after this, still wins on
    "waiting on you", the one thing the registry does not say."""
    for sid, rec in live.items():
        s = sessions.get(sid)
        if s is None:
            continue
        s["open_in"] = sessions_inbox.client_name(rec)
        s["live"] = str(rec.get("status") or "")
        if s["live"] == "busy" and s["state"] in ("finished", "failed"):
            # Mid-turn by the registry. A stalled tool call stays "needs":
            # busy is also what a turn sitting on a permission dialog says.
            s["state"], s["detail"] = "working", ""
        elif s["live"] == "idle" and s["state"] in ("working", "needs", "failed"):
            s["state"], s["detail"] = "finished", ""


def merge_board(sessions: dict[str, dict], board: dict) -> None:
    """The hook saw the session live: its state wins, and it is the only
    source of the exact permission text."""
    states = {"waiting": "needs", "running": "working", "done": None, "idle": None}
    for sid, live in board.items():
        s = sessions.get(sid)
        if s is None:
            continue
        mapped = states.get(live.get("state"))
        if mapped and float(live.get("t") or 0) >= s["last"] - 5:
            s["state"] = mapped
            s["detail"] = str(live.get("text") or s["detail"])
            s["ask"] = str(live.get("ask") or "")
        s["cwd"] = str(live.get("cwd") or s["cwd"])
        s["project"] = project_of(s["cwd"]) if s["cwd"] else s["project"]
        s["tty"] = str(live.get("tty") or "")


def order(rows: Iterable[dict]) -> list[dict]:
    return sorted(rows, key=lambda s: (RANK.get(s["state"], 9), -s["last"]))


def discover(now: float | None = None, board: dict | None = None, everything: bool = False,
             live: dict | None = None) -> list[dict]:
    now = time.time() if now is None else now
    found: dict[str, dict] = {}
    for config, path in claude_transcripts(now):
        try:
            found[path.stem] = from_transcript(config, path, now)
        except OSError:
            continue
    if board is None:
        try:
            import agent_board
            board = agent_board.load()
        except Exception:  # the board is a bonus; listing works without it
            board = {}
    try:
        live = sessions_inbox.live_records(CLAUDE_DIRS) if live is None else live
    except OSError:
        live = {}
    merge_live(found, live)
    merge_board(found, board)
    for s in codex_sessions(now):
        found.setdefault(s["id"], s)
    rows = found.values() if everything else (s for s in found.values() if s.get("interactive", True))
    return order(rows)


def matches(sid: str, now: float | None = None) -> list[dict]:
    """Every session `sid` names: the one whose id it is exactly, else each
    whose id starts with it (or, from eight characters, ends with it, for a
    Codex rollout's uuid tail)."""
    if not sid:
        return []
    rows = discover(now, everything=True)
    exact = [s for s in rows if s["id"] == sid]
    if exact:
        return exact[:1]
    return [s for s in rows if s["id"].startswith(sid) or (len(sid) >= 8 and s["id"].endswith(sid))]


def find(sid: str, now: float | None = None) -> dict | None:
    """The one session `sid` names, or None when it names none or several.
    Measured 2026-10-05: 33 of the 481 sessions `--all` lists started with
    "b", and taking the first match would have typed into one the person
    never named."""
    hits = matches(sid, now)
    return hits[0] if len(hits) == 1 else None


# ── Turning a transcript into rows for the glass ─────────────────────────────

def card_items(entries: list[dict], limit: int = CARD_TURNS) -> list[dict]:
    """Rows for a `Transcript` component: the person, the prose, and each
    tool call folded to one line. Text is only ever displayed."""
    items: list[dict] = []
    plain = sessions_inbox.clean
    for e in entries:
        peer = sessions_inbox.peer_body(e) if e.get("isMeta") and not e.get("isSidechain") else None
        if peer is not None:
            # A message that came in through the inbox. One with no reply
            # address is the glass's own send; one from another session says so.
            origin = e.get("origin") if isinstance(e.get("origin"), dict) else {}
            who = "" if origin.get("from") in (None, "unknown") else "From another session: "
            items.append({"id": f"{e.get('uuid') or len(items)}:0", "role": "user",
                          "text": (who + plain(peer))[:4000]})
            continue
        if not is_turn(e):
            continue
        uid = str(e.get("uuid") or len(items))
        for i, b in enumerate(blocks(e)):
            kind = b.get("type")
            key = f"{uid}:{i}"
            if kind == "text" and str(b.get("text") or "").strip():
                text = str(b["text"]).strip()
                if e["type"] == "user" and text.startswith("<"):
                    continue  # a command or hook wrapper, not something they typed
                items.append({"id": key, "role": e["type"], "text": plain(text)[:4000]})
            elif kind == "tool_use":
                args = b.get("input") if isinstance(b.get("input"), dict) else {}
                item = {"id": key, "role": "tool", "tool": plain(str(b.get("name") or "tool")),
                        "text": plain(tool_line(b))}
                if b.get("name") in ("Read", "Edit", "Write", "MultiEdit") and args.get("file_path"):
                    item["open"] = True
                items.append(item)
            elif kind == "tool_result" and b.get("is_error"):
                body = b.get("content")
                text = body if isinstance(body, str) else " ".join(
                    str(c.get("text") or "") for c in body or [] if isinstance(c, dict))
                items.append({"id": key, "role": "error", "text": plain(" ".join(text.split()))[:300]})
    return items[-limit:]


def tool_use_by_key(entries: list[dict], key: str) -> dict | None:
    uid, _, index = key.rpartition(":")
    for e in entries:
        if str(e.get("uuid")) == uid:
            bl = blocks(e)
            if index.isdigit() and int(index) < len(bl):
                return bl[int(index)]
    return None


def edit_diff(use: dict) -> str:
    """An Edit or Write call as a unified-looking diff, for the Diff surface."""
    args = use.get("input") if isinstance(use.get("input"), dict) else {}
    path = str(args.get("file_path") or "")
    lines = [f"--- {path}", f"+++ {path}"]
    edits = args.get("edits") if isinstance(args.get("edits"), list) else [args]
    for edit in edits:
        if not isinstance(edit, dict):
            continue
        old, new = str(edit.get("old_string") or ""), str(edit.get("new_string") or edit.get("content") or "")
        lines.append("@@")
        lines += [f"-{line}" for line in old.splitlines()] + [f"+{line}" for line in new.splitlines()]
    return "\n".join(lines)


def under_home(path: str) -> str | None:
    """A path from a transcript, only if it resolves inside the home folder.
    A transcript is untrusted: it does not get to point the viewer anywhere."""
    try:
        real = Path(path).expanduser().resolve()
    except (OSError, RuntimeError):
        return None
    return str(real) if real.is_relative_to(HOME.resolve()) and real.is_file() else None


# ── Commands that run in a session's folder ──────────────────────────────────

def test_command(cwd: Path) -> list[str] | None:
    """The one test command a folder declares, or None. Only these run from
    the glass; anything else is asked of the agent."""
    if (cwd / "Package.swift").exists():
        return ["swift", "test"]
    if (cwd / "hud" / "Package.swift").exists() and (cwd / "bin").is_dir():
        return ["swift", "test", "--package-path", "hud"]
    pkg = cwd / "package.json"
    if pkg.exists():
        try:
            if "test" in (json.loads(pkg.read_text()).get("scripts") or {}):
                return ["npm", "test", "--silent"]
        except (OSError, ValueError):
            pass
    if (cwd / "pyproject.toml").exists() or (cwd / "pytest.ini").exists():
        return ["python3", "-m", "pytest", "-q"]
    return None


def allowlisted(what: str, cwd: Path, path: str | None = None) -> list[str] | None:
    if what == "status":
        return ["git", "status", "--short"]
    if what == "diff":
        return ["git", "diff", "--no-color"] + (["--", path] if path else [])
    if what == "tests":
        return test_command(cwd)
    return None


def run_streaming(argv: list[str], cwd: str, on_line: Callable[[str], None], timeout: float = 900) -> int:
    try:
        proc = subprocess.Popen(argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, env=scrubbed_env())
    except OSError as err:
        on_line(f"could not start {argv[0]}: {err}")
        return 127
    started = time.monotonic()
    assert proc.stdout is not None
    for line in proc.stdout:
        on_line(line.rstrip("\n"))
        if time.monotonic() - started > timeout:
            proc.kill()
            on_line(f"stopped after {int(timeout)}s")
            break
    return proc.wait()


# ── Sending ──────────────────────────────────────────────────────────────────

SESSION_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,127}")


def send_argv(session: dict, fork: bool = False) -> list[str]:
    """The `claude -p` command line. The message is not in it: it goes on
    stdin (see `send`), because a bare positional starting with "-" is read
    as a flag (`claude -p "--version"` printed the version, 2026-10-05).
    No permission flag of any kind: the run gets the mode Caleb's own
    settings give every session, nothing here adds or raises one, and in
    print mode a tool that would need approval is refused and the refusal
    shown, never answered here."""
    sid = str(session["id"])
    if not SESSION_ID.fullmatch(sid):
        raise ValueError("not a session id")
    return [CLAUDE_BIN, "-p", "--resume", sid,
            "--output-format", "stream-json", "--verbose", "--include-partial-messages"] \
        + (["--fork-session"] if fork else [])


_LOOKUP = object()


def live_record(session: dict) -> dict | None:
    """The registry record of the client this session is open in right now,
    read fresh, or None when nothing has it open."""
    if session.get("agent") != "claude":
        return None
    try:
        return sessions_inbox.live_records(CLAUDE_DIRS).get(session["id"])
    except OSError:
        return None


def held_reason(session: dict, rec: dict) -> str | None:
    """Why Claude Code would hold a message to this open session rather
    than hand it to the model, predicted before anything is sent."""
    config = Path(session.get("config") or HOME / ".claude")
    policy = sessions_inbox.inbound_policy(session.get("cwd") or "", config)
    mode = session.get("mode") or sessions_inbox.last_mode(Path(session.get("transcript") or "/nonexistent"))
    return sessions_inbox.hold_reason(mode, policy, sessions_inbox.client_name(rec))


def can_fork(session: dict) -> str | None:
    """Why this session cannot be forked into a new headless one now. A fork
    copies the conversation into a new session id and leaves the original,
    open or not, untouched."""
    if session.get("agent") != "claude":
        return "Codex sessions are read-only here."
    if session.get("state") in ("working", "needs") or session.get("live") == "busy":
        return "It is mid-turn. Fork it once it is idle."
    if not session.get("cwd") or not Path(session["cwd"]).is_dir():
        return "Its folder is gone."
    return None


def can_send(session: dict, rec: object = _LOOKUP) -> str | None:
    """Why a message cannot go to this session now, or None when it can."""
    if session.get("agent") != "claude":
        return "Codex sessions are read-only here."
    if session.get("state") == "needs":
        return "It is waiting on you for a permission. Answer it in its own window."
    record = live_record(session) if rec is _LOOKUP else rec
    if isinstance(record, dict):
        return sessions_inbox.why_not(record) or held_reason(session, record)
    if session.get("state") == "working":
        return "It is mid-turn. Wait for it to finish, or answer it in its own window."
    if not session.get("cwd") or not Path(session["cwd"]).is_dir():
        return "Its folder is gone."
    return None


def stream_reply(proc_lines: Iterable[str], on_text: Callable[[str], None]) -> dict:
    """Fold stream-json lines into the reply so far. Returns the result
    event, with any permission denials, so they can be shown."""
    text = ""
    result: dict = {}
    for line in proc_lines:
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if ev.get("type") == "stream_event":
            delta = (ev.get("event") or {}).get("delta") or {}
            if delta.get("type") == "text_delta":
                text += str(delta.get("text") or "")
                on_text(text)
        elif ev.get("type") == "assistant" and not text:
            whole = first_text(ev)
            if whole:
                text = whole
                on_text(text)
        elif ev.get("type") == "result":
            result = ev
    return result


def send_open(session: dict, rec: dict, text: str, on_text: Callable[[str], None]) -> dict:
    """Into the client it is open in, through its inbox, then the reply read
    back from its transcript. Arrival is proved by the transcript, not by the
    socket accepting the bytes."""
    path = Path(session["transcript"])
    offset = sessions_inbox.size_of(path)
    try:
        sessions_inbox.deliver(rec, text)
    except sessions_inbox.Refused as err:
        return {"is_error": True, "result": str(err), "delivered": False, "via": "inbox"}

    def status() -> str | None:
        now = live_record(session)
        return str(now.get("status") or "") if now else None

    out = sessions_inbox.follow(path, offset, text, status, on_text, poll_s=0.5)
    out["via"] = "inbox"
    out["open_in"] = sessions_inbox.client_name(rec)
    return out


def send(session: dict, text: str, on_text: Callable[[str], None], fork: bool = False) -> dict:
    """One message. Open in a client: into it. Not open: resumed headless.
    `fork`: a new headless session copied from this one, whatever has it
    open, for when the open one cannot take a message from here."""
    text = sessions_inbox.clean(text)
    if not text:
        return {"is_error": True, "result": "Nothing to send."}
    if fork:
        why = can_fork(session)
        if why:
            return {"is_error": True, "result": why}
    else:
        rec = live_record(session)
        why = can_send(session, rec)
        if why:
            return {"is_error": True, "result": why}
        if rec is not None:
            return send_open(session, rec, text, on_text)
    try:
        argv = send_argv(session, fork)
    except ValueError:
        return {"is_error": True, "result": "That is not a session id this can resume."}
    proc = subprocess.Popen(argv, cwd=session["cwd"], stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, stdin=subprocess.PIPE, text=True,
                            env=scrubbed_env(Path(session["config"]) if session.get("config") else None))
    assert proc.stdin is not None and proc.stdout is not None

    def feed() -> None:
        # Written from a thread and closed, so a prompt longer than the pipe
        # buffer cannot stall against the reply being read below.
        try:
            proc.stdin.write(text)
            proc.stdin.close()
        except (BrokenPipeError, OSError):
            pass

    threading.Thread(target=feed, daemon=True).start()
    result = stream_reply(proc.stdout, on_text)
    proc.wait()
    result["via"] = "fork" if fork else "resume"
    return result


# ── Routing a sentence (the hud-listen hook) ─────────────────────────────────

def route(words: str, sessions: list[dict] | None = None) -> dict:
    """Which session `words` is for, and what to tell it.

    "tell the lemma session to run the tests" -> the session whose project or
    title is lemma, message "run the tests". A name match decides without a
    model; several or none fall back to the agent board's Jev pick.
    """
    sessions = discover() if sessions is None else sessions
    said = words.strip()
    m = re.match(r"(?i)^(?:tell|ask|have)\s+(?:the\s+)?(.+?)\s+(?:session|agent|one)\s+(?:to\s+)?(.*)$", said)
    name, message = (m.group(1), m.group(2)) if m else ("", said)
    if name:
        key = name.lower()
        hits = [s for s in sessions if key in s["project"].lower() or key in (s["title"] or "").lower()]
        if len(hits) == 1:
            return {"session": hits[0]["id"], "message": message, "why": f"named {name}"}
    try:
        import agent_board
        got = agent_board.pick(said, agent_board.load())
        if got.get("session"):
            return {"session": got["session"], "message": message, "why": got.get("why", "")}
    except Exception:
        pass
    return {"session": None, "message": message, "why": "no single session matched"}


# ── The glass ────────────────────────────────────────────────────────────────

def q(value: str) -> str:
    return json.dumps(value)


def surface_name(sid: str) -> str:
    return "s-" + re.sub(r"[^A-Za-z0-9]", "", sid)[:8]


def session_rows(sessions: list[dict], now: float) -> list[dict]:
    rows = []
    for s in sessions[:MAX_ROWS]:
        bits = [WORDS.get(s["state"], s["state"]), s["model"], age_words(now - s["last"])]
        rows.append({
            "id": s["id"], "accent": s["state"] == "needs",
            "text": sessions_inbox.clean(f"{s['project']}: {s['title'] or 'untitled'}")[:90],
            "time": " · ".join(b for b in bits if b),
        })
    return rows


def sessions_surface(rows: list[dict]) -> list[str]:
    return [
        "@ sessions at=left w=400",
        'c s Screen title="SESSIONS"',
        "r s",
        'c l Events caption="What needs you first" action=open actionLabel="Open" items=@/rows',
        "> s l",
        f"d /rows {json.dumps(rows)}",
    ]


def status_line(s: dict, why: str | None = None) -> tuple[str, str]:
    """`why` is can_send's refusal for a session that looks idle, so the card
    says before anything is typed that Send will not reach it."""
    if s["state"] == "needs":
        ask = s.get("ask") or s.get("detail") or "a tool call"
        return ("Waiting for permission: " + ask + ". Approve it in the session; "
                "Kyber never grants permissions.", "warning")
    if s["state"] == "failed":
        return ("Failed: " + (s.get("detail") or "see the last turn"), "error")
    if s["state"] == "working":
        return ("Working" + (": " + s["detail"] if s.get("detail") else ""), "info")
    if why:
        return (why, "warning")
    if s.get("open_in"):
        return (f"Idle in {s['open_in']}. Send types into that open session.", "success")
    return ("Finished. Send resumes this session.", "success")


def draft_pointer(name: str) -> str:
    """The card's message Field. Namespaced by the card, because a Field's
    `v` line names the pointer and not the surface."""
    return f"/{name}/draft"


def card_surface(s: dict, items: list[dict], changes: list[dict], why: str | None = None) -> list[str]:
    name = surface_name(s["id"])
    message, level = status_line(s, why)
    # Title, model and the status detail come out of the transcript, which
    # other people's text (tool lines, file paths, a pasted message) writes
    # into. A review on 2026-10-05 drew `fix \u202egnp.exe` on the card, so
    # every transcript-derived string passes the same clean as a send.
    message = sessions_inbox.clean(message)
    title = f"{s['project'].upper()}"
    return [
        f"@ {name} at=center w=560",
        f"c s Screen title={q(title)}",
        "r s",
        f"c sub Text value={q(sessions_inbox.clean((s['title'] or '') + (' · ' + s['model'] if s['model'] else '')))} tone=muted",
        "c st Status message=@/status/message level=@/status/level",
        "c t Transcript items=@/t action=open",
        "c live Text value=@/live",
        'c ch List caption="Changed" items=@/changes action=diff actionLabel="Diff"',
        f'c msg Field label="Message" placeholder="Typed here, sent only by Send" value=@{draft_pointer(name)}',
        "c acts Stack direction=horizontal gap=2",
        'c go Button label="Send" action=send variant=primary',
        'c fork Button label="Fork and send" action=fork',
        'c reply Button label="Reply" action=reply',
        'c tests Button label="Run tests" action=tests',
        'c diff Button label="Open diff" action=diff',
        "> acts go fork reply tests diff",
        "> s sub st t live ch msg acts",
        f'd {draft_pointer(name)} ""',
        f"d /status {json.dumps({'message': message, 'level': level})}",
        f"d /t {json.dumps(items)}",
        f"d /changes {json.dumps(changes)}",
        'd /live ""',
    ]


def git_changes(cwd: str) -> list[dict]:
    try:
        out = subprocess.run(["git", "status", "--short"], cwd=cwd, capture_output=True, text=True,
                             timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    rows = []
    for line in out.splitlines()[:12]:
        path = line[3:].strip()
        if path:
            rows.append({"id": path, "text": f"{line[:2].strip() or '?'}  {path}"})
    return rows


def parse_event(line: str) -> dict | None:
    """`e <name> <component> key=value ...` into a dict, through the one
    shared reader (bin/lib/hud_events.py). None for anything else, and for
    any line that does not parse exactly: a press half-read is refused."""
    return hud_events.event(line)


class Serve:
    """One connection to the display: draws the sessions surface, keeps it
    current, draws a session's card on a press and keeps that current too."""

    def __init__(self, sock_path: str = SOCKET):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(sock_path)
        self.lock = threading.Lock()
        self.cards: dict[str, dict] = {}  # surface name -> session
        self.seen: dict[str, tuple] = {}  # surface name -> last drawn stamp
        self.rows_drawn = ""
        # What is typed into each card's message Field, by surface name. Only
        # the person's Send press reads it; typing alone never sends.
        self.drafts: dict[str, str] = {}
        self.closed = False
        # False once the person closes the list: redrawing it would bring
        # back a surface they just took down.
        self.list_open = True

    def send(self, lines: list[str]) -> None:
        with self.lock:
            self.sock.sendall(("\n".join(lines) + "\n").encode())

    def refresh_list(self) -> None:
        if not self.list_open:
            return
        now = time.time()
        rows = session_rows(discover(now), now)
        drawn = json.dumps(rows)
        if not self.rows_drawn:
            self.send(sessions_surface(rows))
        elif drawn != self.rows_drawn:
            self.send(["@ sessions", f"d /rows {drawn}"])
        self.rows_drawn = drawn

    def open_card(self, sid: str) -> None:
        s = find(sid)
        if not s:
            return
        name = surface_name(s["id"])
        self.cards[name] = s
        entries = tail_entries(Path(s["transcript"]))
        self.send(card_surface(s, card_items(entries), git_changes(s["cwd"]), self.blocked(s)))
        self.seen[name] = (Path(s["transcript"]).stat().st_mtime, s["state"])

    def refresh_cards(self) -> None:
        for name, old in list(self.cards.items()):
            s = find(old["id"])
            if not s:
                continue
            try:
                stamp = (Path(s["transcript"]).stat().st_mtime, s["state"])
            except OSError:
                continue
            if stamp == self.seen.get(name):
                continue
            self.seen[name] = stamp
            self.cards[name] = s
            message, level = status_line(s, self.blocked(s))
            message = sessions_inbox.clean(message)
            entries = tail_entries(Path(s["transcript"]))
            self.send([f"@ {name}",
                       f"d /status {json.dumps({'message': message, 'level': level})}",
                       f"d /t {json.dumps(card_items(entries))}",
                       f"d /changes {json.dumps(git_changes(s['cwd']))}"])

    def show_text(self, name: str, title: str, text: str, beside: str) -> None:
        """A Diff surface beside the card: read-only text, coloured as a diff."""
        lines = sessions_inbox.clean(text).splitlines()[-600:]
        title = sessions_inbox.clean(title)
        self.send([f"@ {name} at=right w=520", f"c s Screen title={q(title)}", "r s",
                   "c d Diff text=@/text", "> s d", f"d /text {json.dumps(chr(10).join(lines))}"])

    def run_into(self, s: dict, what: str, path: str | None = None) -> None:
        argv = allowlisted(what, Path(s["cwd"]), path)
        head: list[str] = []
        if what == "diff" and argv:
            # New files are not in `git diff`, so the status comes first: an
            # empty diff over a folder of new files read as "nothing changed".
            status = subprocess.run(["git", "status", "--short"], cwd=s["cwd"], capture_output=True,
                                    text=True, timeout=20).stdout.rstrip()
            if status:
                head = ["$ git status --short", status, ""]
        out_name = surface_name(s["id"]) + ("-run" if what == "tests" else "-diff")
        title = {"tests": "TESTS", "diff": "DIFF", "status": "STATUS"}[what] + " · " + s["project"]
        if argv is None:
            self.show_text(out_name, title, f"No {what} command this folder declares. Ask the agent.", "")
            return
        buf: list[str] = head + [f"$ {' '.join(argv)}"]
        last = [0.0]

        def on_line(line: str) -> None:
            buf.append(line)
            if time.monotonic() - last[0] > 0.25:
                last[0] = time.monotonic()
                self.show_text(out_name, title, "\n".join(buf), "")

        code = run_streaming(argv, s["cwd"], on_line)
        buf.append(f"exit {code}")
        self.show_text(out_name, title, "\n".join(buf), "")

    def handle(self, ev: dict) -> None:
        surface = str(ev.get("surface") or "")
        if ev["name"] == "closed" and surface == "sessions":
            self.list_open = False
            return
        if ev["name"] == "open" and surface == "sessions":
            self.open_card(str(ev.get("row") or ""))
            return
        s = self.cards.get(surface)
        if not s:
            return
        if ev["name"] == "closed":
            self.cards.pop(surface, None)
            self.drafts.pop(surface, None)
            return
        if ev["name"] == "reply":
            why = can_send(find(s["id"]) or s)
            label = f"{s['project']} session"
            if why:
                self.send([f"@ {surface}", f"d /status {json.dumps({'message': why, 'level': 'warning'})}"])
            self.send([f"to {surface} label={q(label)}"])
        elif ev["name"] == "send" and str(ev.get("row")) == surface:
            text = str(ev.get("text") or "").strip()
            if text:
                threading.Thread(target=self.send_message, args=(surface, text), daemon=True).start()
        elif ev["name"] in ("send", "fork") and ev.get("component") in ("go", "fork") and "row" not in ev:
            # The card's own Send or Fork: whatever the person typed into its
            # Field. A refusal keeps the draft, so Fork can take it next.
            fork = ev["name"] == "fork"
            text = self.drafts.get(surface, "").strip()
            if not text:
                self.send([f"@ {surface}", f"d /status {json.dumps({'message': 'Type a message first.', 'level': 'warning'})}"])
                return
            now = find(s["id"]) or s
            why = can_fork(now) if fork else can_send(now)
            if why:
                self.send([f"@ {surface}", f"d /status {json.dumps({'message': why, 'level': 'warning'})}"])
                return
            self.drafts[surface] = ""
            self.send([f"@ {surface}", f'd {draft_pointer(surface)} ""'])
            threading.Thread(target=self.send_message, args=(surface, text, fork), daemon=True).start()
        elif ev["name"] == "diff" and ev.get("row"):
            # A changed file's own row: its diff, or the file itself when git
            # has nothing to diff (untracked).
            self.open_change(s, str(ev["row"]))
        elif ev["name"] in ("tests", "diff"):
            threading.Thread(target=self.run_into, args=(s, ev["name"]), daemon=True).start()
        elif ev["name"] == "open" and ev.get("row"):
            self.open_item(s, str(ev["row"]))

    def open_change(self, s: dict, rel: str) -> None:
        changed = {c["id"] for c in git_changes(s["cwd"])}
        if rel not in changed:
            return  # only a path git itself listed, never one from a press alone
        out = subprocess.run(["git", "diff", "--no-color", "--", rel], cwd=s["cwd"],
                             capture_output=True, text=True, timeout=20).stdout
        if out.strip():
            self.show_text(surface_name(s["id"]) + "-diff", "DIFF · " + Path(rel).name, out, "")
            return
        path = under_home(str(Path(s["cwd"]) / rel))
        if path:
            name = surface_name(s["id"]) + "-file"
            self.send([f"@ {name} at=right w=520", f"c s Screen title={q(Path(path).name)}", "r s",
                       f"c f File path={q(path)}", "> s f"])
        else:
            self.show_text(surface_name(s["id"]) + "-diff", "NEW · " + Path(rel).name,
                           f"{rel} is new and not in git yet.", "")

    def open_item(self, s: dict, key: str) -> None:
        use = tool_use_by_key(tail_entries(Path(s["transcript"])), key)
        if not use or use.get("type") != "tool_use":
            return
        args = use.get("input") if isinstance(use.get("input"), dict) else {}
        if use.get("name") == "Read":
            path = under_home(str(args.get("file_path") or ""))
            if path:
                name = surface_name(s["id"]) + "-file"
                self.send([f"@ {name} at=right w=520", f"c s Screen title={q(Path(path).name)}", "r s",
                           f"c f File path={q(path)}", "> s f"])
        else:
            self.show_text(surface_name(s["id"]) + "-diff", "EDIT · " + Path(str(args.get("file_path"))).name,
                           edit_diff(use), "")

    @staticmethod
    def blocked(s: dict) -> str | None:
        """can_send's refusal for a session that is otherwise idle and open,
        so the card can say it up front. Mid-turn states say themselves."""
        return can_send(s) if s.get("open_in") and s["state"] == "finished" else None

    def on_value(self, line: str) -> None:
        """`v /<card>/draft "typed"`: keep what is in a card's Field. Any other
        pointer, or a card this client did not draw, is ignored."""
        parts = line.split(None, 2)
        if len(parts) != 3:
            return
        pointer = parts[1]
        name = pointer[1:-len("/draft")] if pointer.startswith("/") and pointer.endswith("/draft") else ""
        if name not in self.cards:
            return
        try:
            value = json.loads(parts[2])
        except ValueError:
            return
        if isinstance(value, str):
            self.drafts[name] = value

    def send_message(self, surface: str, text: str, fork: bool = False) -> None:
        s = find(self.cards[surface]["id"])
        if not s:
            return
        why = can_fork(s) if fork else can_send(s)
        if why:
            self.send([f"@ {surface}", f"d /status {json.dumps({'message': why, 'level': 'warning'})}"])
            return
        where = "into a fork of it" if fork else f"into {s['open_in']}" if s.get("open_in") else "by resuming it"
        self.send([f"@ {surface}", f"d /status {json.dumps({'message': f'Sending {where}. Replying below.', 'level': 'info'})}",
                   f"d /live {q('You: ' + sessions_inbox.clean(text))}"])
        last = [0.0]

        def on_text(reply: str) -> None:
            if time.monotonic() - last[0] > 0.15:
                last[0] = time.monotonic()
                self.send([f"@ {surface}", f"d /live {q(sessions_inbox.clean(reply))}"])

        result = send(s, text, on_text, fork=fork)
        denied = result.get("permission_denials") or []
        if denied:
            names = ", ".join(str(d.get("tool_name") or "a tool") for d in denied)
            message = f"It asked to use {names}, which needs approval. Approve it in the session."
            self.send([f"@ {surface}", f"d /status {json.dumps({'message': message, 'level': 'warning'})}"])
        elif result.get("is_error"):
            level = "warning" if result.get("held") else "error"
            self.send([f"@ {surface}", f"d /status {json.dumps({'message': sessions_inbox.clean(str(result.get('result') or 'Failed'))[:300], 'level': level})}"])
        elif result.get("via") == "inbox":
            message = f"Delivered into {result.get('open_in') or 'the open session'}. It reads it as a teammate's request."
            self.send([f"@ {surface}", f"d /status {json.dumps({'message': message, 'level': 'success'})}"])
        elif result.get("via") == "fork" and result.get("session_id"):
            new = str(result["session_id"])
            message = f"Forked into {new[:8]}, which has its own card. This one is unchanged."
            self.send([f"@ {surface}", f"d /status {json.dumps({'message': message, 'level': 'success'})}"])
            self.open_card(new)
        self.send([f"@ {surface}", 'd /live ""'])

    def reader(self) -> None:
        buf = b""
        while True:
            chunk = self.sock.recv(65536)
            if not chunk:
                self.closed = True
                return
            buf += chunk
            while b"\n" in buf:
                raw, buf = buf.split(b"\n", 1)
                line = raw.decode("utf-8", errors="replace")
                if line.startswith(("e ", "!")):
                    # The log says what was pressed, never what was typed.
                    print(f"kyber-sessions: {line.split(' text=')[0][:200]}", file=sys.stderr, flush=True)
                if line.startswith("v ") and not line.startswith("v! "):
                    self.on_value(line)
                    continue
                ev = parse_event(line)
                if ev:
                    try:
                        self.handle(ev)
                    except Exception as err:  # one bad press must not take the daemon down
                        print(f"kyber-sessions: {err}", file=sys.stderr)

    def run(self, every: float = 2.0, open_first: str = "") -> int:
        self.send([hud_events.listen_line(SOCKET)])
        threading.Thread(target=self.reader, daemon=True).start()
        if open_first:
            # `serve --open <id>`: the talk key or a Needs-you row on another
            # surface summoning one session's card directly.
            self.open_card(open_first)
        while not self.closed and (self.list_open or self.cards):
            self.refresh_list()
            self.refresh_cards()
            time.sleep(every)
        return 0


# ── CLI ──────────────────────────────────────────────────────────────────────

def short_id(sid: str) -> str:
    """Eight characters that identify a session: a Claude uuid's head, a
    Codex rollout's uuid tail."""
    return sid[-8:] if sid.startswith("rollout-") else sid[:8]


def line_for(s: dict, now: float) -> str:
    bits = [WORDS.get(s["state"], s["state"]), s["project"], s["model"], age_words(now - s["last"])]
    head = "  ".join(b for b in bits if b)
    extra = s.get("ask") or s.get("detail") or ""
    return f"{short_id(s['id'])}  {head}  {s['title'][:60]}" + (f"\n          {extra[:120]}" if extra else "")


def main(argv: list[str]) -> int:
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__)
        return 0
    cmd = argv[0] if argv and not argv[0].startswith("-") else "list"
    rest = argv[1:] if argv and not argv[0].startswith("-") else argv
    now = time.time()
    if cmd in ("list", "needs"):
        rows = discover(now, everything="--all" in rest)
        if cmd == "needs":
            rows = [s for s in rows if s["state"] in ("needs", "failed")]
        if "--json" in rest:
            print(json.dumps(rows, indent=2))
        else:
            shown = rows if "--all" in rest else rows[:20]
            print("\n".join(line_for(s, now) for s in shown) or "No sessions in the last three days.")
        return 0
    if cmd == "stream" and rest:
        s = find(rest[0])
        if not s:
            print("no such session", file=sys.stderr)
            return 1
        path, size = Path(s["transcript"]), 0
        for item in card_items(tail_entries(path), limit=10_000):
            print(json.dumps(item), flush=True)
        while "--follow" in rest:
            time.sleep(1)
            if path.stat().st_size != size:
                size = path.stat().st_size
                for item in card_items(tail_entries(path, 64_000), limit=5):
                    print(json.dumps(item), flush=True)
        return 0
    # Only a leading --fork is a flag. Anywhere else it is part of the message.
    fork = cmd == "send" and rest[:1] == ["--fork"]
    words = rest[1:] if fork else rest
    if cmd == "send" and len(words) >= 2:
        hits = matches(words[0])
        if len(hits) != 1:
            print(f"{len(hits)} sessions match {words[0]!r}; give more of the id" if hits
                  else "no such session", file=sys.stderr)
            return 1
        s = hits[0]
        result = send(s, " ".join(words[1:]), lambda t: print(json.dumps({"reply": t}), flush=True), fork=fork)
        print(json.dumps({"result": result.get("result"), "is_error": bool(result.get("is_error")),
                          "permission_denials": result.get("permission_denials") or [],
                          "via": result.get("via", ""), "delivered": result.get("delivered"),
                          "held": bool(result.get("held")),
                          "session": result.get("session_id") if fork else s["id"]}))
        return 1 if result.get("is_error") else 0
    if cmd == "run" and len(rest) >= 2:
        s = find(rest[0])
        argv2 = allowlisted(rest[1], Path(s["cwd"])) if s else None
        if not s or argv2 is None:
            print("not allowlisted here: status, diff, tests (when the folder declares one)", file=sys.stderr)
            return 2
        return run_streaming(argv2, s["cwd"], print)
    if cmd == "route" and rest:
        print(json.dumps(route(" ".join(rest))))
        return 0
    if cmd == "serve":
        import fcntl
        lock_path = HOME / ".bob" / "kyber-sessions.lock"
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        lock = lock_path.open("w")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            # One already runs. Ask it nothing: the menu was pressed twice.
            print("kyber-sessions serve is already running", file=sys.stderr)
            return 0
        open_first = rest[rest.index("--open") + 1] if "--open" in rest[:-1] else ""
        return Serve().run(open_first=open_first)
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
