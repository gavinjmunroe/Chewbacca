#!/usr/bin/env python3
"""Coding-agent sessions on the glass, so agent work needs no editor or terminal.

    kyber-sessions                     one line per session, what needs you first
    kyber-sessions --json              the same as JSON (--all adds scripted `claude -p` runs)
    kyber-sessions needs --json        only the sessions waiting on a person
    kyber-sessions stream <id>         a session's transcript as JSON lines (--follow keeps going)
    kyber-sessions send <id> <text>    one message to an idle session, reply streamed as JSON lines
    kyber-sessions send --fork <id> <text>  the same into a new headless copy of it
                                       (--fork only as the first word after send; an id
                                       prefix must name exactly one session)
    kyber-sessions run <id> <what>     an allowlisted command in its folder: status, diff, tests
    kyber-sessions tree <id> [--json]  what it touched plus one level, the tree beside its card
    kyber-sessions route "<words>"     which session a sentence is for (the hook for hud-listen)
    kyber-sessions new "<task>" [--in <folder>]  a new background run, no window ("in lemma: ..." works too)
    kyber-sessions draft "<task>"      put a task in the panel's New task box; only Start runs it
    kyber-sessions stop <id>           stop a run the glass started (never a VS Code tab)
    kyber-sessions watch               one look: toast what newly needs you (launchd runs it each minute)
    kyber-sessions serve [--open <id>] draw the sessions surface and answer its presses

Sessions come from Claude Code's own transcripts (~/.claude/projects/*/*.jsonl,
and ~/.claude-2 when present), merged with the terminal hook's live board
(bin/lib/agent_board.py), which is where "waiting on you" and the exact
permission text come from. Codex rollouts in ~/.codex/sessions are listed,
read-only.

Everything read from a transcript is untrusted: it is drawn, never acted on.
Nothing here grants a permission. A message is sent only when the person
presses send (the card's own Send, or the conversation panel addressed to a
session with `to`), and only to a session that is idle, never into one
mid-run.

How it gets there depends on whether the session is open in a client right
now. Open (VS Code, a terminal, any interactive claude): through the inbox
Claude Code gives every running session (bin/lib/sessions_inbox.py), so the
text lands in the window Caleb left it in. Not open: `claude -p --resume`
in its folder, as before, with the text on stdin so it can never be read as
a flag. A session open somewhere is never resumed by a second process,
because two writers on one transcript fork the conversation.

Whether an open session would hold the message is predicted from the
permission mode in its transcript, which only a turn writes. A mode switched
in VS Code after the last turn is not seen; if Claude Code then holds the
message, the transcript says so and the send reports `held`, not delivered.

Layout design follows Carlton Aikins' realm (github.com/31Carlton7/realm,
unlicensed, read as a design reference only; no code from it is used).
"""
from __future__ import annotations

import json
import os
import re
import signal
import socket
import subprocess
import sys
import threading
import time
import uuid
from pathlib import Path
from typing import Callable, Iterable, Iterator

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import hud_events  # noqa: E402
import session_tree  # noqa: E402
import sessions_inbox  # noqa: E402

HOME = Path.home()
SOCKET = os.environ.get("BOB_HUD_SOCKET", str(HOME / ".bob" / "hud.sock"))
CLAUDE_DIRS = [Path(p) for p in os.environ.get(
    "KYBER_CLAUDE_DIRS", f"{HOME / '.claude'}:{HOME / '.claude-2'}").split(":") if p]
CODEX_DIR = Path(os.environ.get("KYBER_CODEX_DIR", str(HOME / ".codex" / "sessions")))
CLAUDE_BIN = os.environ.get("KYBER_CLAUDE", "claude")

# How much of a transcript's end is read to decide its state and draw it.
# Measured 2026-10-04: this session's transcript was 9 MB and its last 40
# turns sat in the final 600 KB; 768 KB keeps them with room.
TAIL_BYTES = 768_000
# Newer than this and still mid-turn is working; older and mid-turn on a
# tool call is a turn that stopped on something, most often a permission
# dialog in a terminal the hook did not report. Guessed, never measured.
WORKING_S = 45.0
# A user turn with nothing after it for this long is a run that died.
# Guessed, never measured.
STALLED_S = 600.0
# Only transcripts touched within this window are listed: a week of
# finished work is history, not something on the glass. Guessed.
RECENT_S = 3 * 24 * 3600.0
# A tool call with no result older than this is not a dialog anyone is
# still looking at. Guessed, never measured.
ABANDONED_S = 2 * 3600.0
# Where a session was started from. `sdk-py` and `sdk-cli` are programs
# (reviewer runs, the voice's own `claude -p`): on 2026-10-04 they were 19 of
# the 25 newest transcripts and buried the four Caleb was actually in.
INTERACTIVE = frozenset({"cli", "claude-vscode", "claude-desktop"})
# Where throwaway one-shot runs live. tab-rescue skips these folders too.
SCRATCH_DIRS = ("/private/var/folders/", "/var/folders/", "/private/tmp/", "/tmp/")
# The most rows the surface shows. Miller's seven plus two.
MAX_ROWS = 9
# How many turns a session card draws.
CARD_TURNS = 40
# How long a first Run tests press stays armed. A folder's test script is the
# folder's own code (`npm test` runs whatever package.json says), so one press
# on a card for a cloned repo ran it unread; a push security review flagged
# that on 2026-10-05. The first press now shows the command and folder, and
# only a second press inside this window runs it. Guessed, never measured.
TESTS_CONFIRM_S = 15.0

# Where a session runs, as the rail names it. A VS Code session is a row like
# any other (CHW-134): the name only says where Send will type.
ORIGINS = {"claude-vscode": "VS Code", "cli": "terminal", "claude-desktop": "desktop",
           "sdk-cli": "script", "sdk-py": "script"}

RANK = {"needs": 0, "working": 1, "failed": 2, "finished": 3}
WORDS = {"needs": "needs you", "working": "working", "failed": "failed", "finished": "finished"}

# What a Claude Code session exports into every process it starts. The same
# list as hud-listen's INHERITED_SESSION_VARS (a test keeps the two equal):
# a resumed session must not run as a child of whatever started this, or it
# stops saving its transcript (2026-09-20, see hud-listen).
INHERITED_SESSION_VARS = frozenset({"FORCE_COLOR", "COLORTERM", "CLICOLOR_FORCE", "CLAUDECODE"})
INHERITED_SESSION_PREFIXES = ("CLAUDE_CODE_",)


def scrubbed_env(config: Path | None = None) -> dict[str, str]:
    env = {k: v for k, v in os.environ.items()
           if k not in INHERITED_SESSION_VARS and not k.startswith(INHERITED_SESSION_PREFIXES)}
    if config and config.name != ".claude":
        env["CLAUDE_CONFIG_DIR"] = str(config)
    else:
        env.pop("CLAUDE_CONFIG_DIR", None)
    return env


# ── Reading transcripts ──────────────────────────────────────────────────────

def tail_entries(path: Path, max_bytes: int = TAIL_BYTES) -> list[dict]:
    try:
        with path.open("rb") as f:
            size = f.seek(0, 2)
            f.seek(max(0, size - max_bytes))
            raw = f.read().decode("utf-8", errors="replace")
    except OSError:
        return []
    lines = raw.splitlines()
    if size > max_bytes and lines:
        lines = lines[1:]  # a mid-file read starts on a fragment
    out = []
    for line in lines:
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if isinstance(entry, dict):
            out.append(entry)
    return out


def blocks(entry: dict) -> list[dict]:
    content = (entry.get("message") or {}).get("content")
    if isinstance(content, str):
        return [{"type": "text", "text": content}]
    return [b for b in content if isinstance(b, dict)] if isinstance(content, list) else []


def is_turn(entry: dict) -> bool:
    """A user or assistant message that is part of the conversation, not a
    hook attachment, a title line or a subagent's sidechain."""
    return entry.get("type") in ("user", "assistant") and not entry.get("isSidechain") \
        and not entry.get("isMeta")


def classify(entries: list[dict], age_s: float) -> tuple[str, str]:
    """(state, detail) from a transcript's tail and how long since it was written.

    `needs` from here is a guess (a tool call with no result that has sat
    still); the hook's board, when it has the session, is the authority.
    """
    turns = [e for e in entries if is_turn(e)]
    if not turns:
        return "finished", ""
    last = turns[-1]
    if last.get("isApiErrorMessage") or any(
            e.get("type") == "system" and "error" in str(e.get("subtype") or e.get("level") or "")
            for e in entries[-3:]):
        return "failed", first_text(last)[:140] or "the API returned an error"
    kinds = [b.get("type") for b in blocks(last)]
    # A `--json-schema` run ends on a StructuredOutput call and its result.
    # Read as a stalled tool call, every finished reviewer run showed as
    # "needs you" or "failed" on the first live list (2026-10-04).
    if any(b.get("type") == "tool_use" and b.get("name") == "StructuredOutput" for t in turns[-2:]
           for b in blocks(t)):
        return "finished", ""
    if last.get("type") == "assistant":
        stop = (last.get("message") or {}).get("stop_reason")
        if "tool_use" in kinds:
            use = next(b for b in blocks(last) if b.get("type") == "tool_use")
            if age_s <= WORKING_S:
                return "working", tool_line(use)
            if age_s <= ABANDONED_S:
                return "needs", tool_line(use)
            return "failed", "stopped on " + tool_line(use)
        if stop == "end_turn" or "text" in kinds:
            return ("working", "") if age_s <= 5 and stop != "end_turn" else ("finished", "")
        return ("working", "") if age_s <= WORKING_S else ("finished", "")
    # The last turn is the person's, or a tool's result: the model owes a reply.
    if age_s <= STALLED_S:
        return "working", ""
    return "failed", "stopped without an answer"


def first_text(entry: dict) -> str:
    for b in blocks(entry):
        if b.get("type") == "text" and str(b.get("text") or "").strip():
            return " ".join(str(b["text"]).split())
    return ""


def tool_line(use: dict) -> str:
    name = str(use.get("name") or "tool")
    args = use.get("input") if isinstance(use.get("input"), dict) else {}
    target = args.get("command") or args.get("file_path") or args.get("path") \
        or args.get("pattern") or args.get("url") or args.get("description") or ""
    target = " ".join(str(target).split())
    return f"{name}: {target[:120]}" if target else name


def meta(entries: list[dict]) -> dict:
    """Title, model and folder: the newest of each in the tail."""
    out = {"title": "", "model": "", "cwd": "", "mode": ""}
    points = {str(e.get("entrypoint")) for e in entries if e.get("entrypoint")}
    newest = next((str(e["entrypoint"]) for e in reversed(entries) if e.get("entrypoint")), "")
    out["origin"] = ORIGINS.get(newest, "")
    for e in reversed(entries):
        if not out["mode"] and e.get("permissionMode"):
            out["mode"] = str(e["permissionMode"])
        if not out["title"]:
            out["title"] = str(e.get("customTitle") or e.get("aiTitle") or e.get("summary") or "").strip() \
                if e.get("type") in ("custom-title", "ai-title", "summary") else ""
        if not out["model"] and e.get("type") == "assistant":
            out["model"] = str((e.get("message") or {}).get("model") or "")
        if not out["cwd"] and e.get("cwd"):
            out["cwd"] = str(e["cwd"])
        if out["title"] and out["model"] and out["cwd"] and out["mode"]:
            break
    out["interactive"] = bool(points & INTERACTIVE) or not points
    turns = sum(1 for e in entries if e.get("type") == "user" and is_turn(e) and first_text(e))
    out["turns"] = turns
    if turns <= 1 and out["cwd"].startswith(SCRATCH_DIRS):
        # A one-shot `claude -p` (a blind image judge, an eval) inherits its
        # parent's desktop entrypoint. On 2026-10-10 two judges in
        # /var/folders sat in the agents list as failed tabs.
        out["interactive"] = False
    if not out["title"]:
        first_user = next((e for e in entries if e.get("type") == "user" and is_turn(e) and first_text(e)), None)
        out["title"] = first_text(first_user)[:80] if first_user else ""
    return out


def project_of(cwd: str) -> str:
    """The repo a folder belongs to: a worktree under `<repo>/.claude/worktrees/`
    is that repo, not `agent-a461fbe8a950a0206`."""
    parts = Path(cwd).parts
    if ".claude" in parts and "worktrees" in parts:
        i = parts.index(".claude")
        if i > 0:
            return parts[i - 1]
    return Path(cwd).name


def short_model(model: str) -> str:
    m = re.search(r"(opus|sonnet|haiku|fable)", model)
    return m.group(1) if m else (model.split("-")[0] if model else "")


def age_words(seconds: float) -> str:
    s = max(0, int(seconds))
    if s < 60:
        return "now"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h"
    return f"{s // 86400}d"


def claude_transcripts(now: float) -> Iterator[tuple[Path, Path]]:
    for config in CLAUDE_DIRS:
        root = config / "projects"
        if not root.is_dir():
            continue
        for path in root.glob("*/*.jsonl"):
            try:
                if now - path.stat().st_mtime <= RECENT_S:
                    yield config, path
            except OSError:
                continue


# Parsed tails, keyed on size and mtime. Measured 2026-10-04: listing 300
# recent transcripts cold took 1.3 s of CPU, which every two seconds in
# `serve` would be most of a core; unchanged files now cost a stat.
_parsed: dict[str, tuple[tuple[int, int], list[dict]]] = {}


def cached_entries(path: Path) -> list[dict]:
    st = path.stat()
    stamp = (st.st_size, st.st_mtime_ns)
    hit = _parsed.get(str(path))
    if hit and hit[0] == stamp:
        return hit[1]
    entries = tail_entries(path)
    _parsed[str(path)] = (stamp, entries)
    return entries


# Modes read from behind the tail, keyed like `_parsed`. Measured 2026-10-05
# with --all: 43 of 461 Claude rows had no permissionMode in their last
# 768 KB, so --json showed their mode as ""; with this fallback, 3 did (their
# transcripts never record one). A review the same day saw open bypass
# sessions among the empty ones.
_modes: dict[str, tuple[tuple[int, int], str]] = {}


def effective_mode(path: Path, tail_mode: str) -> str:
    """The tail's mode, else the newest one anywhere in the transcript."""
    if tail_mode:
        return tail_mode
    st = path.stat()
    stamp = (st.st_size, st.st_mtime_ns)
    hit = _modes.get(str(path))
    if hit and hit[0] == stamp:
        return hit[1]
    mode = sessions_inbox.last_mode(path)
    _modes[str(path)] = (stamp, mode)
    return mode


def from_transcript(config: Path, path: Path, now: float) -> dict:
    entries = cached_entries(path)
    mtime = path.stat().st_mtime
    state, detail = classify(entries, now - mtime)
    m = meta(entries)
    if state == "failed" and m.get("turns", 0) <= 1:
        # Failed on its first message, the way tab-rescue's MIN_TURNS reads
        # it: an eval prompt run through the desktop app, or a tab whose
        # owner saw the error on their own screen. On 2026-10-10 five
        # "Just cloned this repo" evals from that morning filled the agents
        # panel as failed tabs.
        m["interactive"] = False
    m["mode"] = effective_mode(path, m["mode"])
    cwd = m["cwd"]
    return {
        "id": path.stem, "agent": "claude", "config": str(config), "transcript": str(path),
        "cwd": cwd, "project": project_of(cwd) if cwd else path.parent.name,
        "interactive": m["interactive"], "mode": m["mode"], "origin": m["origin"],
        "title": m["title"], "model": short_model(m["model"]), "last": mtime,
        "state": state, "detail": detail, "ask": "", "turns": m.get("turns", 0),
    }


def codex_sessions(now: float) -> Iterator[dict]:
    if not CODEX_DIR.is_dir():
        return
    for path in CODEX_DIR.glob("*/*/*/*.jsonl"):
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        if now - mtime > RECENT_S:
            continue
        cwd, title, model = "", "", ""
        for e in tail_entries(path, 200_000):
            p = e.get("payload") if isinstance(e.get("payload"), dict) else {}
            cwd = cwd or str(p.get("cwd") or "")
            model = model or str(p.get("model") or "")
            if not title and p.get("type") == "message" and p.get("role") == "user":
                text = " ".join(str(c.get("text") or "") for c in p.get("content") or [] if isinstance(c, dict))
                if text and not text.lstrip().startswith("<"):
                    title = " ".join(text.split())[:80]
        yield {
            "id": path.stem, "agent": "codex", "config": "", "transcript": str(path), "cwd": cwd,
            "interactive": True, "origin": "Codex",
            "project": Path(cwd).name if cwd else "codex", "title": title, "model": model,
            "last": mtime, "state": "working" if now - mtime <= WORKING_S else "finished",
            "detail": "", "ask": "",
        }


def merge_live(sessions: dict[str, dict], live: dict[str, dict]) -> None:
    """Claude Code's own registry says which sessions are open in a client
    right now, and whether each is idle or busy. That beats every guess from
    a transcript's tail; the hook's board, merged after this, still wins on
    "waiting on you", the one thing the registry does not say."""
    for sid, rec in live.items():
        s = sessions.get(sid)
        if s is None:
            continue
        s["open_in"] = sessions_inbox.client_name(rec)
        s["live"] = str(rec.get("status") or "")
        if s["live"] == "busy" and s["state"] in ("finished", "failed"):
            # Mid-turn by the registry. A stalled tool call stays "needs":
            # busy is also what a turn sitting on a permission dialog says.
            s["state"], s["detail"] = "working", ""
        elif s["live"] == "idle" and s["state"] in ("working", "needs", "failed"):
            s["state"], s["detail"] = "finished", ""


def merge_board(sessions: dict[str, dict], board: dict) -> None:
    """The hook saw the session live: its state wins, and it is the only
    source of the exact permission text."""
    states = {"waiting": "needs", "running": "working", "done": None, "idle": None}
    for sid, live in board.items():
        s = sessions.get(sid)
        if s is None:
            continue
        mapped = states.get(live.get("state"))
        if mapped and float(live.get("t") or 0) >= s["last"] - 5:
            s["state"] = mapped
            s["detail"] = str(live.get("text") or s["detail"])
            s["ask"] = str(live.get("ask") or "")
        s["cwd"] = str(live.get("cwd") or s["cwd"])
        s["project"] = project_of(s["cwd"]) if s["cwd"] else s["project"]
        s["tty"] = str(live.get("tty") or "")


def order(rows: Iterable[dict]) -> list[dict]:
    return sorted(rows, key=lambda s: (RANK.get(s["state"], 9), -s["last"]))


def discover(now: float | None = None, board: dict | None = None, everything: bool = False,
             live: dict | None = None) -> list[dict]:
    now = time.time() if now is None else now
    found: dict[str, dict] = {}
    for config, path in claude_transcripts(now):
        try:
            found[path.stem] = from_transcript(config, path, now)
        except OSError:
            continue
    if board is None:
        try:
            import agent_board
            board = agent_board.load()
        except Exception:  # the board is a bonus; listing works without it
            board = {}
    try:
        live = sessions_inbox.live_records(CLAUDE_DIRS) if live is None else live
    except OSError:
        live = {}
    merge_live(found, live)
    merge_board(found, board)
    merge_runs(found, runs(now), now)
    for s in codex_sessions(now):
        found.setdefault(s["id"], s)
    if not everything:
        kinds = session_kinds()
        classify_later([s for s in found.values() if borderline(s) and s["id"] not in kinds])
    else:
        kinds = {}
    rows = found.values() if everything else (
        s for s in found.values() if s.get("interactive", True) and kinds.get(s["id"]) != "run")
    return order(rows)


# ── Which sessions are a person's tab, by meaning (Jev) ──────────────────────

# The rules above (scratch folder, failed on its first message) are the floor.
# What they miss is a one-prompt program run from a real folder: on 2026-10-10
# the panel listed "Erik Fish site security review", "Warm-up" and "Partners.tsx
# landing page security review" as tabs. A title like that is a meaning
# question, so Jev answers it once per session and the answer is cached.
KINDS_FILE = Path(os.environ.get("KYBER_KINDS_FILE", str(HOME / ".bob" / "session-kinds.json")))
# Below this Jev is not sure enough to hide a row; a hidden real tab costs
# more than one extra row. Measured once on 10 real borderline rows
# (2026-10-10 midnight): 7 named tab, all right; 3 unsure, including a
# title-generator prompt and "approval e2e"; none wrongly hidden. Recall on
# runs is low, so the floor can come down once a sealed set says it is safe.
RUN_FLOOR = 0.8
# Sessions asked per pass, and the gap between passes. Guessed, never measured.
KIND_BATCH = 6
KIND_EVERY_S = 60.0
_kind_lock = threading.Lock()
_kind_last = [0.0]


def borderline(s: dict) -> bool:
    """A Claude row the rules let through but that is short enough to be a
    program's one prompt. Long conversations are tabs; Jev is not asked."""
    return s.get("agent") == "claude" and s.get("interactive", True) and 0 < int(s.get("turns") or 0) <= 3 \
        and s.get("origin") != "Kyber"


def session_kinds() -> dict[str, str]:
    try:
        got = json.loads(KINDS_FILE.read_text())
    except (OSError, ValueError):
        return {}
    return {k: v for k, v in got.items() if v in ("tab", "run")} if isinstance(got, dict) else {}


def save_kinds(kinds: dict[str, str]) -> None:
    try:
        KINDS_FILE.parent.mkdir(parents=True, exist_ok=True)
        tmp = KINDS_FILE.with_suffix(".tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0), 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(kinds, f)
        tmp.replace(KINDS_FILE)
    except OSError as err:
        print(f"kyber-sessions: kinds: {err}", file=sys.stderr)


def kind_of(title: str, ask: Callable | None = None) -> str | None:
    """'run' when Jev is sure a title is a program's one prompt, 'tab' when
    it is a person's work, None when Jev is down or unsure."""
    try:
        if ask is None:
            import jev  # noqa: PLC0415  bin/lib; only when a borderline row exists

            def ask(state, questions):
                return jev.ask(state, questions, decision="session-kind")
        criteria = {
            "tab": "A person working in a chat tab: a project, a question, a request in their own words",
            "run": "A program sent one fixed prompt: a security review, a judge, a warm-up, a test, an eval, a probe",
        }
        answers = ask({"title": sessions_inbox.clean(title)[:160]}, {"kind": {
            "type": "choice",
            "instructions": "Is this AI coding session a person's own tab, or a one-prompt run a program started?",
            "criteria": criteria,
        }})
        answer = answers.get("kind") if isinstance(answers, dict) else None
        import jev as _jev  # noqa: PLC0415
        got = _jev.validate_choice(answer, criteria)
    except Exception:  # noqa: BLE001  Jev is a bonus; the rules still decide
        return None
    if not got:
        return None
    choice, confidence = got
    if choice == "run" and confidence < RUN_FLOOR:
        return None
    return choice


def classify_now(rows: list[dict], ask: Callable | None = None) -> dict[str, str]:
    kinds = session_kinds()
    for s in rows[:KIND_BATCH]:
        got = kind_of(s.get("title") or "", ask)
        if got:
            kinds[s["id"]] = got
    save_kinds(kinds)
    return kinds


def classify_later(rows: list[dict]) -> None:
    """At most one background pass a minute; never blocks a listing."""
    if not rows or os.environ.get("KYBER_NO_JEV"):
        return
    now = time.monotonic()
    with _kind_lock:
        if now - _kind_last[0] < KIND_EVERY_S:
            return
        _kind_last[0] = now
    threading.Thread(target=classify_now, args=(list(rows),), daemon=True).start()


def matches(sid: str, now: float | None = None) -> list[dict]:
    """Every session `sid` names: the one whose id it is exactly, else each
    whose id starts with it (or, from eight characters, ends with it, for a
    Codex rollout's uuid tail)."""
    if not sid:
        return []
    rows = discover(now, everything=True)
    exact = [s for s in rows if s["id"] == sid]
    if exact:
        return exact[:1]
    return [s for s in rows if s["id"].startswith(sid) or (len(sid) >= 8 and s["id"].endswith(sid))]


def find(sid: str, now: float | None = None) -> dict | None:
    """The one session `sid` names, or None when it names none or several.
    Measured 2026-10-05: 33 of the 481 sessions `--all` lists started with
    "b", and taking the first match would have typed into one the person
    never named."""
    hits = matches(sid, now)
    return hits[0] if len(hits) == 1 else None


# ── Turning a transcript into rows for the glass ─────────────────────────────

def card_items(entries: list[dict], limit: int = CARD_TURNS) -> list[dict]:
    """Rows for a `Transcript` component: the person, the prose, and each
    tool call folded to one line. Text is only ever displayed."""
    items: list[dict] = []
    plain = sessions_inbox.clean
    for e in entries:
        peer = sessions_inbox.peer_body(e) if e.get("isMeta") and not e.get("isSidechain") else None
        if peer is not None:
            # A message that came in through the inbox. One with no reply
            # address is the glass's own send; one from another session says so.
            origin = e.get("origin") if isinstance(e.get("origin"), dict) else {}
            who = "" if origin.get("from") in (None, "unknown") else "From another session: "
            items.append({"id": f"{e.get('uuid') or len(items)}:0", "role": "user",
                          "text": (who + plain(peer))[:4000]})
            continue
        if not is_turn(e):
            continue
        uid = str(e.get("uuid") or len(items))
        for i, b in enumerate(blocks(e)):
            kind = b.get("type")
            key = f"{uid}:{i}"
            if kind == "text" and str(b.get("text") or "").strip():
                text = str(b["text"]).strip()
                if e["type"] == "user" and text.startswith("<"):
                    continue  # a command or hook wrapper, not something they typed
                items.append({"id": key, "role": e["type"], "text": plain(text)[:4000]})
            elif kind == "tool_use":
                args = b.get("input") if isinstance(b.get("input"), dict) else {}
                item = {"id": key, "role": "tool", "tool": plain(str(b.get("name") or "tool")),
                        "text": plain(tool_line(b))}
                if b.get("name") in ("Read", "Edit", "Write", "MultiEdit") and args.get("file_path"):
                    item["open"] = True
                items.append(item)
            elif kind == "tool_result" and b.get("is_error"):
                body = b.get("content")
                text = body if isinstance(body, str) else " ".join(
                    str(c.get("text") or "") for c in body or [] if isinstance(c, dict))
                items.append({"id": key, "role": "error", "text": plain(" ".join(text.split()))[:300]})
    return items[-limit:]


def tool_use_by_key(entries: list[dict], key: str) -> dict | None:
    uid, _, index = key.rpartition(":")
    for e in entries:
        if str(e.get("uuid")) == uid:
            bl = blocks(e)
            if index.isdigit() and int(index) < len(bl):
                return bl[int(index)]
    return None


def edit_diff(use: dict) -> str:
    """An Edit or Write call as a unified-looking diff, for the Diff surface."""
    args = use.get("input") if isinstance(use.get("input"), dict) else {}
    path = str(args.get("file_path") or "")
    lines = [f"--- {path}", f"+++ {path}"]
    edits = args.get("edits") if isinstance(args.get("edits"), list) else [args]
    for edit in edits:
        if not isinstance(edit, dict):
            continue
        old, new = str(edit.get("old_string") or ""), str(edit.get("new_string") or edit.get("content") or "")
        lines.append("@@")
        lines += [f"-{line}" for line in old.splitlines()] + [f"+{line}" for line in new.splitlines()]
    return "\n".join(lines)


def under_home(path: str) -> str | None:
    """A path from a transcript, only if it resolves inside the home folder.
    A transcript is untrusted: it does not get to point the viewer anywhere."""
    try:
        real = Path(path).expanduser().resolve()
    except (OSError, RuntimeError):
        return None
    return str(real) if real.is_relative_to(HOME.resolve()) and real.is_file() else None


# ── Commands that run in a session's folder ──────────────────────────────────

def test_command(cwd: Path) -> list[str] | None:
    """The one test command a folder declares, or None. Only these run from
    the glass; anything else is asked of the agent."""
    if (cwd / "Package.swift").exists():
        return ["swift", "test"]
    if (cwd / "hud" / "Package.swift").exists() and (cwd / "bin").is_dir():
        return ["swift", "test", "--package-path", "hud"]
    pkg = cwd / "package.json"
    if pkg.exists():
        try:
            if "test" in (json.loads(pkg.read_text()).get("scripts") or {}):
                return ["npm", "test", "--silent"]
        except (OSError, ValueError):
            pass
    if (cwd / "pyproject.toml").exists() or (cwd / "pytest.ini").exists():
        return ["python3", "-m", "pytest", "-q"]
    return None


def allowlisted(what: str, cwd: Path, path: str | None = None) -> list[str] | None:
    if what == "status":
        return ["git", "status", "--short"]
    if what == "diff":
        return ["git", "diff", "--no-color"] + (["--", path] if path else [])
    if what == "tests":
        return test_command(cwd)
    return None


def run_streaming(argv: list[str], cwd: str, on_line: Callable[[str], None], timeout: float = 900) -> int:
    try:
        proc = subprocess.Popen(argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, env=scrubbed_env())
    except OSError as err:
        on_line(f"could not start {argv[0]}: {err}")
        return 127
    started = time.monotonic()
    assert proc.stdout is not None
    for line in proc.stdout:
        on_line(line.rstrip("\n"))
        if time.monotonic() - started > timeout:
            proc.kill()
            on_line(f"stopped after {int(timeout)}s")
            break
    return proc.wait()


# ── Sending ──────────────────────────────────────────────────────────────────

SESSION_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,127}")


def send_argv(session: dict, fork: bool = False) -> list[str]:
    """The `claude -p` command line. The message is not in it: it goes on
    stdin (see `send`), because a bare positional starting with "-" is read
    as a flag (`claude -p "--version"` printed the version, 2026-10-05).
    No permission flag of any kind: the run gets the mode Caleb's own
    settings give every session, nothing here adds or raises one, and in
    print mode a tool that would need approval is refused and the refusal
    shown, never answered here."""
    sid = str(session["id"])
    if not SESSION_ID.fullmatch(sid):
        raise ValueError("not a session id")
    return [CLAUDE_BIN, "-p", "--resume", sid,
            "--output-format", "stream-json", "--verbose", "--include-partial-messages"] \
        + (["--fork-session"] if fork else [])


_LOOKUP = object()


def live_record(session: dict) -> dict | None:
    """The registry record of the client this session is open in right now,
    read fresh, or None when nothing has it open."""
    if session.get("agent") != "claude":
        return None
    try:
        return sessions_inbox.live_records(CLAUDE_DIRS).get(session["id"])
    except OSError:
        return None


def held_reason(session: dict, rec: dict) -> str | None:
    """Why Claude Code would hold a message to this open session rather
    than hand it to the model, predicted before anything is sent."""
    config = Path(session.get("config") or HOME / ".claude")
    policy = sessions_inbox.inbound_policy(session.get("cwd") or "", config)
    mode = session.get("mode") or sessions_inbox.last_mode(Path(session.get("transcript") or "/nonexistent"))
    return sessions_inbox.hold_reason(mode, policy, sessions_inbox.client_name(rec))


def can_fork(session: dict) -> str | None:
    """Why this session cannot be forked into a new headless one now. A fork
    copies the conversation into a new session id and leaves the original,
    open or not, untouched."""
    if session.get("agent") != "claude":
        return "Codex sessions are read-only here."
    if session.get("state") in ("working", "needs") or session.get("live") == "busy":
        return "It is mid-turn. Fork it once it is idle."
    if not session.get("cwd") or not Path(session["cwd"]).is_dir():
        return "Its folder is gone."
    return None


def can_send(session: dict, rec: object = _LOOKUP) -> str | None:
    """Why a message cannot go to this session now, or None when it can."""
    if session.get("agent") != "claude":
        return "Codex sessions are read-only here."
    if session.get("state") == "needs":
        return "It is waiting on you for a permission. Answer it in its own window."
    record = live_record(session) if rec is _LOOKUP else rec
    if isinstance(record, dict):
        return sessions_inbox.why_not(record) or held_reason(session, record)
    if session.get("state") == "working":
        return "It is mid-turn. Wait for it to finish, or answer it in its own window."
    if not session.get("cwd") or not Path(session["cwd"]).is_dir():
        return "Its folder is gone."
    return None


def stream_reply(proc_lines: Iterable[str], on_text: Callable[[str], None]) -> dict:
    """Fold stream-json lines into the reply so far. Returns the result
    event, with any permission denials, so they can be shown."""
    text = ""
    result: dict = {}
    for line in proc_lines:
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if ev.get("type") == "stream_event":
            delta = (ev.get("event") or {}).get("delta") or {}
            if delta.get("type") == "text_delta":
                text += str(delta.get("text") or "")
                on_text(text)
        elif ev.get("type") == "assistant" and not text:
            whole = first_text(ev)
            if whole:
                text = whole
                on_text(text)
        elif ev.get("type") == "result":
            result = ev
    return result


def send_open(session: dict, rec: dict, text: str, on_text: Callable[[str], None]) -> dict:
    """Into the client it is open in, through its inbox, then the reply read
    back from its transcript. Arrival is proved by the transcript, not by the
    socket accepting the bytes."""
    path = Path(session["transcript"])
    offset = sessions_inbox.size_of(path)
    try:
        sessions_inbox.deliver(rec, text)
    except sessions_inbox.Refused as err:
        return {"is_error": True, "result": str(err), "delivered": False, "via": "inbox"}

    def status() -> str | None:
        now = live_record(session)
        return str(now.get("status") or "") if now else None

    out = sessions_inbox.follow(path, offset, text, status, on_text, poll_s=0.5)
    out["via"] = "inbox"
    out["open_in"] = sessions_inbox.client_name(rec)
    return out


def send(session: dict, text: str, on_text: Callable[[str], None], fork: bool = False) -> dict:
    """One message. Open in a client: into it. Not open: resumed headless.
    `fork`: a new headless session copied from this one, whatever has it
    open, for when the open one cannot take a message from here."""
    text = sessions_inbox.clean(text)
    if not text:
        return {"is_error": True, "result": "Nothing to send."}
    if fork:
        why = can_fork(session)
        if why:
            return {"is_error": True, "result": why}
    else:
        rec = live_record(session)
        why = can_send(session, rec)
        if why:
            return {"is_error": True, "result": why}
        if rec is not None:
            return send_open(session, rec, text, on_text)
    try:
        argv = send_argv(session, fork)
    except ValueError:
        return {"is_error": True, "result": "That is not a session id this can resume."}
    proc = subprocess.Popen(argv, cwd=session["cwd"], stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, stdin=subprocess.PIPE, text=True,
                            env=scrubbed_env(Path(session["config"]) if session.get("config") else None),
                            start_new_session=True)
    assert proc.stdin is not None and proc.stdout is not None
    if not fork:
        # A resume from the glass is a run the glass owns, so Stop reaches it.
        record_run(str(session["id"]), proc.pid, session["cwd"], session.get("title") or "")

    def feed() -> None:
        # Written from a thread and closed, so a prompt longer than the pipe
        # buffer cannot stall against the reply being read below.
        try:
            proc.stdin.write(text)
            proc.stdin.close()
        except (BrokenPipeError, OSError):
            pass

    threading.Thread(target=feed, daemon=True).start()
    result = stream_reply(proc.stdout, on_text)
    proc.wait()
    result["via"] = "fork" if fork else "resume"
    return result


# ── Runs the glass starts and stops ──────────────────────────────────────────

# One JSON record per process the glass started (a new task, or a resume
# from Send): its pid, that pid's start time, the folder and the task. Stop
# only ever signals a pid named here whose start time still matches, so a
# recycled pid, or a session open in VS Code, is never touched.
RUNS_DIR = Path(os.environ.get("KYBER_RUNS_DIR", str(HOME / ".bob" / "kyber-runs")))
# Stop sends SIGINT (what Esc does in a client: the turn ends, the transcript
# keeps everything written), then SIGTERM, then SIGKILL, this long apart.
# Guessed, never measured.
STOP_GRACE_S = 5.0
# Where a task with no folder named runs. The home folder, because that is
# where Caleb opens a fresh VS Code tab with nothing else in mind.
DEFAULT_RUN_DIR = Path(os.environ.get("KYBER_RUN_DIR", str(HOME)))
CODE_ROOT = Path(os.environ.get("KYBER_CODE_ROOT", str(HOME / "code")))
# A task said or typed to hud-listen waits here for the Start press. Speech
# is not consent: any audio near the mic (a video, a call) reaches the same
# path, and a run gets Caleb's full permission mode, so a sentence only ever
# fills the New task box (commit review, 2026-10-10).
DRAFT_FILE = Path(os.environ.get("KYBER_DRAFT_FILE", str(HOME / ".bob" / "kyber-task-draft.json")))
# "in chewbacca: fix the tests", "in lemma, write a README". The folder is a
# single word or hyphenated name, matched against real folder names only.
IN_FOLDER = re.compile(r"(?is)^\s*in\s+(?P<name>[A-Za-z0-9][A-Za-z0-9_.-]{0,63})\s*[:,]\s*(?P<task>.+)$")


def proc_start(pid: int) -> str:
    return sessions_inbox._proc_starts([pid]).get(pid, "")


def record_run(sid: str, pid: int, cwd: str, task: str) -> dict:
    rec = {"id": sid, "pid": pid, "start": proc_start(pid), "cwd": str(cwd),
           "task": " ".join(task.split())[:80], "t": time.time()}
    try:
        RUNS_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        path = RUNS_DIR / f"{sid}.json"
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0), 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(rec, f)
    except OSError as err:
        print(f"kyber-sessions: could not record run {sid[:8]}: {err}", file=sys.stderr)
    return rec


def runs(now: float | None = None) -> dict[str, dict]:
    """Every run the glass started in the last RECENT_S, by session id."""
    now = time.time() if now is None else now
    out: dict[str, dict] = {}
    try:
        paths = list(RUNS_DIR.glob("*.json"))
    except OSError:
        return out
    for path in paths:
        try:
            rec = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(rec, dict) and rec.get("id") == path.stem and now - float(rec.get("t") or 0) <= RECENT_S:
            out[path.stem] = rec
    return out


def run_alive(rec: dict, starts: Callable[[int], str] | None = None) -> bool:
    """The recorded process is still running, and it is the same process."""
    try:
        pid = int(rec.get("pid") or 0)
    except (TypeError, ValueError):
        return False
    if pid <= 1 or not rec.get("start"):
        return False
    return (starts or proc_start)(pid) == rec["start"]


def resolve_folder(name: str) -> Path | None:
    """A folder named exactly `name` (any case): ~/code/<name>, one level
    below that, or ~/<name>. None unless exactly one matches."""
    key = name.lower()
    hits: list[Path] = []
    for parent in (CODE_ROOT, *(d for d in sorted(CODE_ROOT.glob("*")) if d.is_dir()), HOME):
        try:
            for child in parent.iterdir():
                if child.name.lower() == key and child.is_dir() and not child.is_symlink():
                    hits.append(child.resolve())
        except OSError:
            continue
    unique = list(dict.fromkeys(hits))
    return unique[0] if len(unique) == 1 else None


def plan_task(words: str, folder: str = "") -> tuple[str, Path]:
    """What to do and where, from what was typed or said. Raises ValueError
    with words for the glass when either is unclear."""
    text = sessions_inbox.clean(words).strip()
    m = IN_FOLDER.match(text)
    if m and not folder:
        folder, text = m.group("name"), m.group("task").strip()
    if not text:
        raise ValueError("Say what the task is.")
    if not folder:
        return text, DEFAULT_RUN_DIR
    where = Path(folder).expanduser()
    if where.is_absolute():
        if not where.is_dir():
            raise ValueError(f"{where} is not a folder.")
        return text, where.resolve()
    found = resolve_folder(folder)
    if not found:
        raise ValueError(f"No single folder is named {folder}. Say the full path.")
    return text, found


def queue_draft(text: str) -> None:
    """Put `text` in the New task box of the sessions panel, unsent."""
    DRAFT_FILE.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(DRAFT_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0), 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump({"text": sessions_inbox.clean(text)[:sessions_inbox.MAX_CHARS], "t": time.time()}, f)


def take_draft(now: float | None = None) -> str:
    """The queued draft, once, and only a fresh one."""
    now = time.time() if now is None else now
    try:
        got = json.loads(DRAFT_FILE.read_text())
        DRAFT_FILE.unlink()
    except (OSError, ValueError):
        return ""
    # A draft older than this was meant for a panel that never opened.
    # Guessed, never measured.
    if not isinstance(got, dict) or now - float(got.get("t") or 0) > 120:
        return ""
    return str(got.get("text") or "")


def start_run(task: str, cwd: Path, spawn: Callable = subprocess.Popen) -> tuple[dict, object]:
    """A new headless Claude Code session on `task` in `cwd`, detached so it
    outlives whatever pressed Start. No window opens and no permission flag
    is added: the run gets the mode Caleb's own settings give every session,
    as `send_argv` does. The task goes on stdin, never argv."""
    sid = str(uuid.uuid4())
    RUNS_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    argv = [CLAUDE_BIN, "-p", "--session-id", sid, "--output-format", "stream-json", "--verbose"]
    with open(RUNS_DIR / f"{sid}.log", "w") as log:
        proc = spawn(argv, cwd=str(cwd), stdin=subprocess.PIPE, stdout=log, stderr=subprocess.STDOUT,
                     text=True, env=scrubbed_env(None), start_new_session=True)
    try:
        proc.stdin.write(task)
        proc.stdin.close()
    except (BrokenPipeError, OSError):
        pass
    return record_run(sid, proc.pid, str(cwd), task), proc


def descendants(pid: int) -> list[int]:
    """Every process below `pid`, read in one `ps`. Claude Code runs a tool's
    shell in its own process group, so signalling the run's group alone left
    a `sleep 90` from its Bash tool running after Stop (seen 2026-10-10)."""
    try:
        out = subprocess.run(["ps", "-A", "-o", "pid=,ppid="], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    kids: dict[int, list[int]] = {}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
            kids.setdefault(int(parts[1]), []).append(int(parts[0]))
    found, todo = [], [pid]
    while todo:
        for child in kids.get(todo.pop(), []):
            if child not in found and child != pid:
                found.append(child)
                todo.append(child)
    return found


def stop_run(sid: str, kill: Callable = os.killpg, starts: Callable[[int], str] | None = None,
             sleep: Callable[[float], None] = time.sleep, grace: float = STOP_GRACE_S,
             tree: Callable[[int], list[int]] = descendants, kill_one: Callable = os.kill) -> tuple[bool, str]:
    """Stop a run the glass started, and everything its tools started.
    (stopped, words for the glass)."""
    rec = runs().get(sid)
    if not rec:
        s = find(sid)
        where = (s or {}).get("open_in") or (s or {}).get("origin") or "its own window"
        return False, f"Only runs started from Kyber stop from here. Stop this one in {where}."
    if not run_alive(rec, starts):
        return False, "It already stopped."
    pid = int(rec["pid"])
    # Read before the first signal: once the run exits its children are
    # reparented to launchd and nothing links them to it.
    below = tree(pid)
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGKILL):
        if not run_alive(rec, starts):
            break
        try:
            kill(pid, sig)
        except ProcessLookupError:
            break
        except PermissionError:
            return False, "macOS refused the stop."
        waited = 0.0
        while waited < grace and run_alive(rec, starts):
            sleep(0.25)
            waited += 0.25
    if run_alive(rec, starts):
        return False, "It didn't stop."
    for child in below:
        try:
            kill_one(child, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            continue
    return True, "Stopped. Everything it wrote is still in the transcript."


def merge_runs(sessions: dict[str, dict], recs: dict[str, dict], now: float,
               alive: Callable[[dict], bool] = run_alive) -> None:
    """Runs the glass started are listed like a VS Code tab, and a live one
    is working whatever its transcript's tail says. One with no transcript
    yet is drawn from its record, so Start shows a row at once."""
    for sid, rec in recs.items():
        live = alive(rec)
        s = sessions.get(sid)
        if s is None:
            if not live:
                continue
            cwd = str(rec.get("cwd") or "")
            s = sessions[sid] = {
                "id": sid, "agent": "claude", "config": str(HOME / ".claude"), "transcript": "",
                "cwd": cwd, "project": project_of(cwd) if cwd else "kyber", "interactive": True,
                "mode": "", "title": str(rec.get("task") or ""), "model": "",
                "last": float(rec.get("t") or now), "state": "working", "detail": "starting", "ask": ""}
        s["origin"], s["interactive"], s["run"] = "Kyber", True, live
        if live and s["state"] in ("finished", "failed"):
            s["state"], s["detail"] = "working", ""


# ── Routing a sentence (the hud-listen hook) ─────────────────────────────────

def route(words: str, sessions: list[dict] | None = None) -> dict:
    """Which session `words` is for, and what to tell it.

    "tell the lemma session to run the tests" -> the session whose project or
    title is lemma, message "run the tests". A name match decides without a
    model; several or none fall back to the agent board's Jev pick.
    """
    sessions = discover() if sessions is None else sessions
    said = words.strip()
    m = re.match(r"(?i)^(?:tell|ask|have)\s+(?:the\s+)?(.+?)\s+(?:session|agent|one)\s+(?:to\s+)?(.*)$", said)
    name, message = (m.group(1), m.group(2)) if m else ("", said)
    if name:
        key = name.lower()
        hits = [s for s in sessions if key in s["project"].lower() or key in (s["title"] or "").lower()]
        if len(hits) == 1:
            return {"session": hits[0]["id"], "message": message, "why": f"named {name}"}
    try:
        import agent_board
        got = agent_board.pick(said, agent_board.load())
        if got.get("session"):
            return {"session": got["session"], "message": message, "why": got.get("why", "")}
    except Exception:
        pass
    return {"session": None, "message": message, "why": "no single session matched"}


# ── The glass ────────────────────────────────────────────────────────────────

def q(value: str) -> str:
    return json.dumps(value)


def surface_name(sid: str) -> str:
    return "s-" + re.sub(r"[^A-Za-z0-9]", "", sid)[:8]


# The list is a glance (kyber-surfaces rules 2 and 3): what needs Caleb and
# what is running, nothing he has to read past. On 2026-10-10 nine rows of
# full titles plus origin and model read to him as "a fat wall of text".
GLANCE_ROWS = 5
# A failure older than this is history, not something to act on tonight, and
# a finished session older than FINISHED_S is done. Both guessed, never measured.
FAILED_S = 6 * 3600.0
FINISHED_S = 3600.0
TITLE_CHARS = 40


def short_title(text: str) -> str:
    """The first clause of a title, cut on a word at TITLE_CHARS."""
    one = " ".join(sessions_inbox.clean(text or "").split())
    one = re.split(r"\s[(\[]|[?!.](?:\s|$)", one, maxsplit=1)[0].strip(" ,:;-") or "untitled"
    if len(one) <= TITLE_CHARS:
        return one
    return one[:TITLE_CHARS].rsplit(" ", 1)[0].rstrip(" ,:;-") + "\u2026"


def glance(sessions: list[dict], now: float) -> list[dict]:
    keep = []
    for s in sessions:
        age = now - float(s.get("last") or 0)
        if s["state"] in ("needs", "working") or (s["state"] == "failed" and age <= FAILED_S) \
                or (s["state"] == "finished" and age <= FINISHED_S):
            keep.append(s)
    return keep


LANES = (("needs", "Needs u"), ("working", "Running"), ("done", "Done"))


def lane_of(s: dict) -> str:
    return "done" if s["state"] in ("finished", "failed") else s["state"]


def counts(sessions: list[dict], now: float) -> dict[str, int]:
    shown = glance(sessions, now)
    return {k: sum(1 for s in shown if lane_of(s) == k) for k, _ in LANES}


def pick_lane(lane: str, n: dict[str, int]) -> str:
    """The lane asked for, or the first one with something in it."""
    if lane in n:
        return lane
    return next((k for k, _ in LANES if n.get(k)), "working")


def session_rows(sessions: list[dict], now: float, lane: str = "") -> list[dict]:
    rows = []
    for s in glance(sessions, now):
        if lane and lane_of(s) != lane:
            continue
        word = "needs u" if s["state"] == "needs" else WORDS.get(s["state"], s["state"])
        rows.append({
            "id": s["id"], "accent": s["state"] == "needs",
            "text": short_title(s.get("title") or ""),
            "time": " · ".join(b for b in (word, s.get("project") or "", age_words(now - s["last"])) if b),
        })
        if len(rows) == GLANCE_ROWS:
            break
    return rows


def list_caption(sessions: list[dict], now: float, lane: str = "") -> str:
    n = counts(sessions, now)
    if not any(n.values()):
        return "Nothing running. Start one below."
    if lane and not n.get(lane):
        return {"needs": "Nothing needs u.", "working": "Nothing running.", "done": "Nothing done in the last hour."}[lane]
    return ""


def lane_options(n: dict[str, int]) -> list[dict]:
    return [{"id": k, "label": label, "count": n.get(k, 0)} for k, label in LANES]


def sessions_surface(rows: list[dict], caption: str = "", n: dict[str, int] | None = None,
                     lane: str = "working") -> list[str]:
    """Counts on top, lanes under them, the lane's rows, then a new task.
    Opal's task glass was the bar (kyber-surfaces skill): numbers that say
    what to do, and Stuck/Ready lanes as first-class states."""
    n = n or {k: 0 for k, _ in LANES}
    return [
        "@ sessions at=left w=380",
        'c s Screen title="AGENTS"',
        "r s",
        "c nums Stack direction=horizontal gap=3",
        'c mn Metric label="Need u" value=@/n/needs thresholds=[{"at":1,"tone":"bad"}]',
        'c mw Metric label="Running" value=@/n/working',
        'c md Metric label="Done" value=@/n/done',
        "> nums mn mw md",
        "c lanes Segmented value=@/lane options=@/lanes",
        'c l Events caption=@/caption action=open actionLabel="Open" items=@/rows',
        "c new Stack direction=horizontal gap=2",
        'c task Field label="New task" placeholder="What should an agent do?" value=@/sessions/draft',
        'c start Button label="Start" action=start variant=primary',
        "> new task start",
        "c st Status message=@/sessions/status/message level=@/sessions/status/level",
        # The Status line joins the layout only once it has words: empty, it
        # drew a lone blue dot under the panel (screenshot, 2026-10-10).
        "> s nums lanes l new",
        f"d /n {json.dumps(n)}",
        f"d /lane {json.dumps(lane)}",
        f"d /lanes {json.dumps(lane_options(n))}",
        f"d /rows {json.dumps(rows)}",
        f"d /caption {json.dumps(caption)}",
        'd /sessions/draft ""',
        'd /sessions/status {"message": "", "level": "info"}',
    ]


def status_line(s: dict, why: str | None = None) -> tuple[str, str]:
    """`why` is can_send's refusal for a session that looks idle, so the card
    says before anything is typed that Send will not reach it."""
    if s["state"] == "needs":
        ask = s.get("ask") or s.get("detail") or "a tool call"
        return ("Waiting for permission: " + ask + ". Approve it in the session; "
                "Kyber never grants permissions.", "warning")
    if s["state"] == "failed":
        return ("Failed: " + (s.get("detail") or "see the last turn"), "error")
    if s["state"] == "working":
        return ("Working" + (": " + s["detail"] if s.get("detail") else ""), "info")
    if why:
        return (why, "warning")
    if s.get("open_in"):
        return (f"Idle in {s['open_in']}. Send types into that open session.", "success")
    return ("Finished. Send resumes this session.", "success")


def draft_pointer(name: str) -> str:
    """The card's message Field. Namespaced by the card, because a Field's
    `v` line names the pointer and not the surface."""
    return f"/{name}/draft"


def card_surface(s: dict, items: list[dict], changes: list[dict], why: str | None = None) -> list[str]:
    name = surface_name(s["id"])
    message, level = status_line(s, why)
    # Title, model and the status detail come out of the transcript, which
    # other people's text (tool lines, file paths, a pasted message) writes
    # into. A review on 2026-10-05 drew `fix \u202egnp.exe` on the card, so
    # every transcript-derived string passes the same clean as a send.
    message = sessions_inbox.clean(message)
    title = f"{s['project'].upper()}"
    return [
        f"@ {name} at=center w=560",
        f"c s Screen title={q(title)}",
        "r s",
        f"c sub Text value={q(sessions_inbox.clean((s['title'] or '') + (' · ' + s['model'] if s['model'] else '')))} tone=muted",
        "c st Status message=@/status/message level=@/status/level",
        "c t Transcript items=@/t action=open",
        "c live Text value=@/live",
        'c ch List caption="Changed" items=@/changes action=diff actionLabel="Diff"',
        f'c msg Field label="Message" placeholder="Typed here, sent only by Send" value=@{draft_pointer(name)}',
        "c acts Stack direction=horizontal gap=2",
        'c go Button label="Send" action=send variant=primary',
        'c fork Button label="Fork and send" action=fork',
        'c reply Button label="Reply" action=reply',
        'c tests Button label="Run tests" action=tests',
        'c diff Button label="Open diff" action=diff',
    ] + ([
        # Only a run the glass started can be stopped from it.
        'c stop Button label="Stop" action=stop variant=destructive',
        "> acts go fork reply tests diff stop",
    ] if s.get("run") else ["> acts go fork reply tests diff"]) + [
        "> s sub st t live ch msg acts",
        f'd {draft_pointer(name)} ""',
        f"d /status {json.dumps({'message': message, 'level': level})}",
        f"d /t {json.dumps(items)}",
        f"d /changes {json.dumps(changes)}",
        'd /live ""',
    ]


def git_changes(cwd: str) -> list[dict]:
    try:
        out = subprocess.run(["git", "status", "--short"], cwd=cwd, capture_output=True, text=True,
                             timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    rows = []
    for line in out.splitlines()[:12]:
        path = line[3:].strip()
        if path:
            rows.append({"id": path, "text": f"{line[:2].strip() or '?'}  {path}"})
    return rows


def change_codes(changes: list[dict]) -> dict[str, str]:
    """git_changes' rows as repo path -> git's status letters, for the tree."""
    return {c["id"]: c["text"].split("  ", 1)[0] for c in changes}


def tree_name(card: str) -> str:
    return card + "-tree"


def tree_surface(name: str, project: str, rows: list[dict]) -> list[str]:
    """The tree beside a card: what the session touched plus one level
    (bin/lib/session_tree.py). A file row's press opens its Diff when git
    says it changed, else the file itself, editable."""
    return [
        f"@ {name} at=right w=320",
        f"c s Screen title={q('FILES · ' + sessions_inbox.clean(project))}",
        "r s",
        "c tr Tree items=@/rows action=open",
        "> s tr",
        f"d /rows {json.dumps(rows)}",
    ]


def parse_event(line: str) -> dict | None:
    """`e <name> <component> key=value ...` into a dict, through the one
    shared reader (bin/lib/hud_events.py). None for anything else, and for
    any line that does not parse exactly: a press half-read is refused."""
    return hud_events.event(line)


class Serve:
    """One connection to the display: draws the sessions surface, keeps it
    current, draws a session's card on a press and keeps that current too."""

    def __init__(self, sock_path: str = SOCKET):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(sock_path)
        self.lock = threading.Lock()
        self.cards: dict[str, dict] = {}  # surface name -> session
        self.seen: dict[str, tuple] = {}  # surface name -> last drawn stamp
        self.rows_drawn = ""
        # What is typed into each card's message Field, by surface name. Only
        # the person's Send press reads it; typing alone never sends.
        self.drafts: dict[str, str] = {}
        # Surface name -> when Run tests was first pressed on that card.
        self.tests_armed: dict[str, float] = {}
        # Tree surface name -> (card surface, row id -> absolute path, repo root).
        # A press on a tree row can only name a row this daemon drew.
        self.trees: dict[str, tuple[str, dict[str, str], str]] = {}
        self.trees_drawn: dict[str, str] = {}
        # Trees the person took down; not redrawn while their card is open.
        self.trees_closed: set[str] = set()
        self.closed = False
        # False once the person closes the list: redrawing it would bring
        # back a surface they just took down.
        self.list_open = True

    def send(self, lines: list[str]) -> None:
        with self.lock:
            self.sock.sendall(("\n".join(lines) + "\n").encode())

    def refresh_list(self) -> None:
        if not self.list_open:
            return
        now = time.time()
        found = discover(now)
        n = counts(found, now)
        lane = pick_lane(getattr(self, "lane", ""), n)
        rows = session_rows(found, now, lane)
        caption = list_caption(found, now, lane)
        drawn = json.dumps([rows, caption, n, lane])
        if not self.rows_drawn:
            self.send(sessions_surface(rows, caption, n, lane))
        elif drawn != self.rows_drawn:
            self.send(["@ sessions", f"d /n {json.dumps(n)}", f"d /lanes {json.dumps(lane_options(n))}",
                       f"d /lane {json.dumps(lane)}", f"d /rows {json.dumps(rows)}",
                       f"d /caption {json.dumps(caption)}"])
        self.rows_drawn = drawn

    def open_card(self, sid: str) -> None:
        s = find(sid)
        if not s:
            return
        name = surface_name(s["id"])
        self.cards[name] = s
        entries = tail_entries(Path(s["transcript"]))
        changes = git_changes(s["cwd"])
        self.send(card_surface(s, card_items(entries), changes, self.blocked(s)))
        self.seen[name] = (Path(s["transcript"]).stat().st_mtime, s["state"])
        self.trees_closed.discard(tree_name(name))
        self.draw_tree(name, s, entries, changes)

    def draw_tree(self, card: str, s: dict, entries: list[dict], changes: list[dict]) -> None:
        """Draw or update the card's tree. Only the rows go on a redraw."""
        name = tree_name(card)
        if name in self.trees_closed or not s.get("cwd"):
            return
        try:
            rows, ids, root = session_tree.build(s["cwd"], entries, change_codes(changes))
        except Exception as err:  # the tree is beside the card; the card stands without it
            print(f"kyber-sessions: tree: {err}", file=sys.stderr)
            return
        if not rows:
            return
        drawn = json.dumps(rows)
        if name not in self.trees:
            self.send(tree_surface(name, s["project"], rows))
        elif drawn != self.trees_drawn.get(name):
            self.send([f"@ {name}", f"d /rows {drawn}"])
        self.trees[name] = (card, ids, root)
        self.trees_drawn[name] = drawn

    def open_path(self, s: dict, path: str, root: str) -> None:
        """A tree row: its Diff when git lists it as changed, else the file,
        editable when it is a regular file inside the repo."""
        rel = Path(path).relative_to(root).as_posix() if root and Path(path).is_relative_to(root) else ""
        if rel and rel in {c["id"] for c in git_changes(s["cwd"])}:
            self.open_change(s, rel)
            return
        if not session_tree.editable(path, root):
            return
        name = surface_name(s["id"]) + "-file"
        self.send([f"@ {name} at=right w=560", f"c s Screen title={q(sessions_inbox.clean(Path(path).name))}",
                   "r s", f"c f File path={q(path)} editable=true", "> s f"])

    def refresh_cards(self) -> None:
        for name, old in list(self.cards.items()):
            s = find(old["id"])
            if not s:
                continue
            try:
                stamp = (Path(s["transcript"]).stat().st_mtime, s["state"])
            except OSError:
                continue
            if stamp == self.seen.get(name):
                continue
            self.seen[name] = stamp
            self.cards[name] = s
            message, level = status_line(s, self.blocked(s))
            message = sessions_inbox.clean(message)
            entries = tail_entries(Path(s["transcript"]))
            changes = git_changes(s["cwd"])
            self.send([f"@ {name}",
                       f"d /status {json.dumps({'message': message, 'level': level})}",
                       f"d /t {json.dumps(card_items(entries))}",
                       f"d /changes {json.dumps(changes)}"])
            self.draw_tree(name, s, entries, changes)

    def show_text(self, name: str, title: str, text: str, beside: str, path: str = "") -> None:
        """A Diff surface beside the card: read-only text, coloured as a diff,
        and syntax coloured by the language its `+++` header (or `path`) names."""
        lines = sessions_inbox.clean(text).splitlines()[-600:]
        title = sessions_inbox.clean(title)
        lang = f" path={q(sessions_inbox.clean(Path(path).name))}" if path else ""
        self.send([f"@ {name} at=right w=520", f"c s Screen title={q(title)}", "r s",
                   f"c d Diff text=@/text{lang}", "> s d", f"d /text {json.dumps(chr(10).join(lines))}"])

    def run_into(self, s: dict, what: str, path: str | None = None) -> None:
        argv = allowlisted(what, Path(s["cwd"]), path)
        head: list[str] = []
        if what == "diff" and argv:
            # New files are not in `git diff`, so the status comes first: an
            # empty diff over a folder of new files read as "nothing changed".
            status = subprocess.run(["git", "status", "--short"], cwd=s["cwd"], capture_output=True,
                                    text=True, timeout=20).stdout.rstrip()
            if status:
                head = ["$ git status --short", status, ""]
        out_name = surface_name(s["id"]) + ("-run" if what == "tests" else "-diff")
        title = {"tests": "TESTS", "diff": "DIFF", "status": "STATUS"}[what] + " · " + s["project"]
        if argv is None:
            self.show_text(out_name, title, f"No {what} command this folder declares. Ask the agent.", "")
            return
        buf: list[str] = head + [f"$ {' '.join(argv)}"]
        last = [0.0]

        def on_line(line: str) -> None:
            buf.append(line)
            if time.monotonic() - last[0] > 0.25:
                last[0] = time.monotonic()
                self.show_text(out_name, title, "\n".join(buf), "")

        code = run_streaming(argv, s["cwd"], on_line)
        buf.append(f"exit {code}")
        self.show_text(out_name, title, "\n".join(buf), "")

    def handle(self, ev: dict) -> None:
        surface = str(ev.get("surface") or "")
        if ev["name"] == "closed" and surface == "sessions":
            self.list_open = False
            return
        if ev["name"] == "open" and surface == "sessions":
            self.open_card(str(ev.get("row") or ""))
            return
        if ev["name"] == "select" and surface == "sessions":
            # A lane press. Only a lane this surface drew counts.
            if str(ev.get("row") or "") in dict(LANES):
                self.lane = str(ev["row"])
                self.rows_drawn = self.rows_drawn and "-"
                self.refresh_list()
            return
        if ev["name"] == "start" and surface == "sessions":
            self.start_task(self.drafts.get("sessions", ""))
            return
        if surface in self.trees:
            card, ids, root = self.trees[surface]
            if ev["name"] == "closed":
                self.trees.pop(surface, None)
                self.trees_drawn.pop(surface, None)
                self.trees_closed.add(surface)
            elif ev["name"] == "open" and card in self.cards and str(ev.get("row") or "") in ids:
                self.open_path(self.cards[card], ids[str(ev["row"])], root)
            return
        s = self.cards.get(surface)
        if not s:
            return
        if ev["name"] == "closed":
            self.cards.pop(surface, None)
            self.drafts.pop(surface, None)
            tree = tree_name(surface)
            if tree in self.trees:
                # The tree belongs to the card: it goes when the card goes.
                self.trees.pop(tree, None)
                self.trees_drawn.pop(tree, None)
                self.send([f"- {tree}"])
            self.trees_closed.discard(tree)
            return
        if ev["name"] == "reply":
            why = can_send(find(s["id"]) or s)
            label = f"{s['project']} session"
            if why:
                self.send([f"@ {surface}", f"d /status {json.dumps({'message': why, 'level': 'warning'})}"])
            self.send([f"to {surface} label={q(label)}"])
        elif ev["name"] == "send" and str(ev.get("row")) == surface:
            text = str(ev.get("text") or "").strip()
            if text:
                threading.Thread(target=self.send_message, args=(surface, text), daemon=True).start()
        elif ev["name"] in ("send", "fork") and ev.get("component") in ("go", "fork") and "row" not in ev:
            # The card's own Send or Fork: whatever the person typed into its
            # Field. A refusal keeps the draft, so Fork can take it next.
            fork = ev["name"] == "fork"
            text = self.drafts.get(surface, "").strip()
            if not text:
                self.send([f"@ {surface}", f"d /status {json.dumps({'message': 'Type a message first.', 'level': 'warning'})}"])
                return
            now = find(s["id"]) or s
            why = can_fork(now) if fork else can_send(now)
            if why:
                self.send([f"@ {surface}", f"d /status {json.dumps({'message': why, 'level': 'warning'})}"])
                return
            self.drafts[surface] = ""
            self.send([f"@ {surface}", f'd {draft_pointer(surface)} ""'])
            threading.Thread(target=self.send_message, args=(surface, text, fork), daemon=True).start()
        elif ev["name"] == "stop":
            threading.Thread(target=self.stop_card, args=(surface, s), daemon=True).start()
        elif ev["name"] == "diff" and ev.get("row"):
            # A changed file's own row: its diff, or the file itself when git
            # has nothing to diff (untracked).
            self.open_change(s, str(ev["row"]))
        elif ev["name"] == "tests" and not self.confirm_tests(surface, s):
            return
        elif ev["name"] in ("tests", "diff"):
            threading.Thread(target=self.run_into, args=(s, ev["name"]), daemon=True).start()
        elif ev["name"] == "open" and ev.get("row"):
            self.open_item(s, str(ev["row"]))

    def take_queued(self) -> None:
        """A task said to the voice: into the New task box, never run."""
        text = take_draft()
        if not text:
            return
        if not self.list_open:
            self.list_open, self.rows_drawn = True, ""
            self.refresh_list()
        try:
            _, cwd = plan_task(text)
            where = f"in {project_of(str(cwd))}"
        except ValueError as err:
            where = f"once fixed ({err})"
        self.drafts["sessions"] = text
        self.send(["@ sessions", f"d /sessions/draft {q(text)}"])
        self.list_status(f"Press Start to run it {where}. Nothing runs until you do.", "info")

    def list_status(self, message: str, level: str) -> None:
        self.send(["@ sessions", "> s nums lanes l new st", f"d /sessions/status {json.dumps({'message': sessions_inbox.clean(message), 'level': level})}"])

    def start_task(self, words: str) -> None:
        """Start: what is typed in the list's New task Field becomes a new
        background run, and its card opens. A refusal keeps the draft."""
        try:
            task, cwd = plan_task(words)
        except ValueError as err:
            self.list_status(str(err), "warning")
            return
        try:
            rec, proc = start_run(task, cwd)
        except OSError as err:
            self.list_status(f"It didn't start: {err}", "error")
            return
        # Reaped here so a finished run is not left a zombie under the daemon.
        threading.Thread(target=proc.wait, daemon=True).start()
        self.drafts["sessions"] = ""
        self.send(["@ sessions", 'd /sessions/draft ""'])
        self.list_status(f"Started in {project_of(str(cwd))}. Its card is open.", "success")
        self.rows_drawn = self.rows_drawn or "-"
        self.refresh_list()
        self.open_card(rec["id"])

    def stop_card(self, surface: str, s: dict) -> None:
        self.send([f"@ {surface}", f"d /status {json.dumps({'message': 'Stopping.', 'level': 'info'})}"])
        stopped, words = stop_run(s["id"])
        self.send([f"@ {surface}", f"d /status {json.dumps({'message': words, 'level': 'success' if stopped else 'warning'})}"])

    def confirm_tests(self, surface: str, s: dict, now: float | None = None) -> bool:
        """True on the second Run tests press within TESTS_CONFIRM_S. The
        first one only shows what would run, and where."""
        now = time.monotonic() if now is None else now
        argv = allowlisted("tests", Path(s["cwd"]))
        if argv is None:
            return True  # nothing would run; run_into says so
        armed = self.tests_armed.pop(surface, None)
        if armed is not None and now - armed <= TESTS_CONFIRM_S:
            return True
        self.tests_armed[surface] = now
        self.show_text(surface_name(s["id"]) + "-run", "TESTS · " + s["project"],
                       f"$ {' '.join(argv)}\nin {s['cwd']}\n\n"
                       "This runs the folder's own test script, which can run any code.\n"
                       f"Press Run tests again within {int(TESTS_CONFIRM_S)} seconds to run it.", "")
        return False

    def open_change(self, s: dict, rel: str) -> None:
        changed = {c["id"] for c in git_changes(s["cwd"])}
        if rel not in changed:
            return  # only a path git itself listed, never one from a press alone
        out = subprocess.run(["git", "diff", "--no-color", "--", rel], cwd=s["cwd"],
                             capture_output=True, text=True, timeout=20).stdout
        if out.strip():
            self.show_text(surface_name(s["id"]) + "-diff", "DIFF · " + Path(rel).name, out, "", rel)
            return
        path = under_home(str(Path(s["cwd"]) / rel))
        if path:
            name = surface_name(s["id"]) + "-file"
            self.send([f"@ {name} at=right w=520", f"c s Screen title={q(Path(path).name)}", "r s",
                       f"c f File path={q(path)}", "> s f"])
        else:
            self.show_text(surface_name(s["id"]) + "-diff", "NEW · " + Path(rel).name,
                           f"{rel} is new and not in git yet.", "")

    def open_item(self, s: dict, key: str) -> None:
        use = tool_use_by_key(tail_entries(Path(s["transcript"])), key)
        if not use or use.get("type") != "tool_use":
            return
        args = use.get("input") if isinstance(use.get("input"), dict) else {}
        if use.get("name") == "Read":
            path = under_home(str(args.get("file_path") or ""))
            if path:
                name = surface_name(s["id"]) + "-file"
                self.send([f"@ {name} at=right w=520", f"c s Screen title={q(Path(path).name)}", "r s",
                           f"c f File path={q(path)}", "> s f"])
        else:
            self.show_text(surface_name(s["id"]) + "-diff", "EDIT · " + Path(str(args.get("file_path"))).name,
                           edit_diff(use), "")

    @staticmethod
    def blocked(s: dict) -> str | None:
        """can_send's refusal for a session that is otherwise idle and open,
        so the card can say it up front. Mid-turn states say themselves."""
        return can_send(s) if s.get("open_in") and s["state"] == "finished" else None

    def on_value(self, line: str) -> None:
        """`v /<card>/draft "typed"`: keep what is in a card's Field. Any other
        pointer, or a card this client did not draw, is ignored."""
        parts = line.split(None, 2)
        if len(parts) != 3:
            return
        pointer = parts[1]
        name = pointer[1:-len("/draft")] if pointer.startswith("/") and pointer.endswith("/draft") else ""
        if name not in self.cards and name != "sessions":
            return
        try:
            value = json.loads(parts[2])
        except ValueError:
            return
        if isinstance(value, str):
            self.drafts[name] = value

    def send_message(self, surface: str, text: str, fork: bool = False) -> None:
        s = find(self.cards[surface]["id"])
        if not s:
            return
        why = can_fork(s) if fork else can_send(s)
        if why:
            self.send([f"@ {surface}", f"d /status {json.dumps({'message': why, 'level': 'warning'})}"])
            return
        where = "into a fork of it" if fork else f"into {s['open_in']}" if s.get("open_in") else "by resuming it"
        self.send([f"@ {surface}", f"d /status {json.dumps({'message': f'Sending {where}. Replying below.', 'level': 'info'})}",
                   f"d /live {q('You: ' + sessions_inbox.clean(text))}"])
        last = [0.0]

        def on_text(reply: str) -> None:
            if time.monotonic() - last[0] > 0.15:
                last[0] = time.monotonic()
                self.send([f"@ {surface}", f"d /live {q(sessions_inbox.clean(reply))}"])

        result = send(s, text, on_text, fork=fork)
        denied = result.get("permission_denials") or []
        if denied:
            names = ", ".join(str(d.get("tool_name") or "a tool") for d in denied)
            message = f"It asked to use {names}, which needs approval. Approve it in the session."
            self.send([f"@ {surface}", f"d /status {json.dumps({'message': message, 'level': 'warning'})}"])
        elif result.get("is_error"):
            level = "warning" if result.get("held") else "error"
            self.send([f"@ {surface}", f"d /status {json.dumps({'message': sessions_inbox.clean(str(result.get('result') or 'Failed'))[:300], 'level': level})}"])
        elif result.get("via") == "inbox":
            message = f"Delivered into {result.get('open_in') or 'the open session'}. It reads it as a teammate's request."
            self.send([f"@ {surface}", f"d /status {json.dumps({'message': message, 'level': 'success'})}"])
        elif result.get("via") == "fork" and result.get("session_id"):
            new = str(result["session_id"])
            message = f"Forked into {new[:8]}, which has its own card. This one is unchanged."
            self.send([f"@ {surface}", f"d /status {json.dumps({'message': message, 'level': 'success'})}"])
            self.open_card(new)
        self.send([f"@ {surface}", 'd /live ""'])

    def reader(self) -> None:
        buf = b""
        while True:
            chunk = self.sock.recv(65536)
            if not chunk:
                self.closed = True
                return
            buf += chunk
            while b"\n" in buf:
                raw, buf = buf.split(b"\n", 1)
                line = raw.decode("utf-8", errors="replace")
                if line.startswith(("e ", "!")):
                    # The log says what was pressed, never what was typed.
                    print(f"kyber-sessions: {line.split(' text=')[0][:200]}", file=sys.stderr, flush=True)
                if line.startswith("v ") and not line.startswith("v! "):
                    self.on_value(line)
                    continue
                ev = parse_event(line)
                if ev:
                    try:
                        self.handle(ev)
                    except Exception as err:  # one bad press must not take the daemon down
                        print(f"kyber-sessions: {err}", file=sys.stderr)

    def run(self, every: float = 2.0, open_first: str = "") -> int:
        self.send([hud_events.listen_line(SOCKET)])
        threading.Thread(target=self.reader, daemon=True).start()
        if open_first:
            # `serve --open <id>`: the talk key or a Needs-you row on another
            # surface summoning one session's card directly.
            self.open_card(open_first)
        while not self.closed and (self.list_open or self.cards):
            self.refresh_list()
            self.take_queued()
            self.refresh_cards()
            time.sleep(every)
        return 0


# ── Telling Caleb when an agent needs him ────────────────────────────────────

# What `watch` last saw, so it says each thing once. tab-rescue's own --new
# state belongs to its hook, which reports into whichever tab is typed in
# next; a person working only on the glass types in no tab, so this keeps
# its own.
WATCH_STATE = Path(os.environ.get("KYBER_WATCH_STATE", str(HOME / ".bob" / "kyber-watch.json")))
HUD_BIN = Path(__file__).resolve().parent / "hud"
TAB_RESCUE = Path(__file__).resolve().parent / "tab-rescue"
# hud-watch holds itself to 2 an hour for due dates. An agent stopped on a
# permission or a dead tab is more urgent than a due date, so 6; one toast
# carries every alert found in the same minute. Guessed, never measured.
ALERTS_PER_HOUR = 6
# Long enough to read two lines, short enough that it is gone before it
# covers what he is studying. Guessed, never measured.
ALERT_LIFE_S = 12
# How long an alert that could not be said yet (over the cap, display down)
# is still worth saying. Two hours, so a full hourly cap cannot drop one.
# Guessed, never measured.
PENDING_S = 7200
# Rule 11 of the surfaces skill: someone else may see the glass.
ALERT_CHARS = 90


def alert_text(text: str) -> str:
    one = " ".join(sessions_inbox.clean(text).split())
    return one if len(one) <= ALERT_CHARS else one[:ALERT_CHARS - 1].rstrip() + "\u2026"


def alerts(rows: list[dict], dead: list[dict], prev: dict[str, str]) -> list[tuple[str, str]]:
    """(key, line) for each thing that newly needs Caleb: a session that
    started waiting on him, a run the glass started that finished or failed,
    a tab that failed mid-turn, and a tab tab-rescue found dead on a usage
    limit. `prev` is each session's state at the last look."""
    out: list[tuple[str, str]] = []
    dead_ids = {str(d.get("session") or "") for d in dead}
    for r in rows:
        sid, state, old = r["id"], r["state"], prev.get(r["id"])
        name = r.get("project") or "an agent"
        if state == "needs" and old != "needs":
            out.append((f"needs:{sid}:{r.get('ask') or r.get('detail')}",
                        alert_text(f"{name} needs u: {r.get('ask') or r.get('detail') or 'a permission'}")))
        elif r.get("origin") == "Kyber" and old in (None, "working", "needs") and state in ("finished", "failed"):
            # None: a short run can start and finish between two looks (a
            # 12 s "pong" did on 2026-10-10 and was never said).
            word = "finished" if state == "finished" else "failed: " + (r.get("detail") or "see its card")
            out.append((f"done:{sid}:{int(r.get('last') or 0)}", alert_text(f"{name} {word}")))
        elif state == "failed" and old in ("working", "needs") and sid not in dead_ids:
            out.append((f"failed:{sid}:{int(r.get('last') or 0)}",
                        alert_text(f"{name} tab failed: {r.get('detail') or 'see its card'}")))
    for d in dead:
        cwd = str(d.get("cwd") or "")
        name = project_of(cwd) if cwd else "a tab"
        resets = f", resets {d['resets']}" if d.get("resets") else ""
        out.append((f"dead:{d.get('session')}:{d.get('died_at')}",
                    alert_text(f"{name} tab died on a usage limit{resets}. Fork it from ur agents to keep going")))
    return out


def alert_lines(lines: list[str]) -> list[str]:
    body = [f"@ agent-alert at=top w=440 life={ALERT_LIFE_S}", 'c s Screen title="AGENTS"', "r s"]
    ids = []
    for i, line in enumerate(lines[:3]):
        body.append(f"c a{i} Text value={q(line)}")
        ids.append(f"a{i}")
    if len(lines) > 3:
        body.append(f"c more Text value={q(f'and {len(lines) - 3} more. Say show my agents')} tone=muted")
        ids.append("more")
    body.append("> s " + " ".join(ids))
    return body


def dead_tabs() -> list[dict]:
    try:
        done = subprocess.run([sys.executable, str(TAB_RESCUE), "--hours", "3", "--json"],
                              capture_output=True, text=True, timeout=60)
        got = json.loads(done.stdout or "[]")
    except (OSError, subprocess.SubprocessError, ValueError):
        return []
    return [d for d in got if isinstance(d, dict)] if isinstance(got, list) else []


def watch_once(rows: list[dict] | None = None, dead: list[dict] | None = None, now: float | None = None,
               draw: Callable[[list[str]], bool] | None = None) -> list[str]:
    """One look. Returns the lines it put on the glass. The first look ever
    only remembers, so turning this on never replays three days of history."""
    now = time.time() if now is None else now
    rows = discover(now) if rows is None else rows
    dead = dead_tabs() if dead is None else dead
    try:
        state = json.loads(WATCH_STATE.read_text())
    except (OSError, ValueError):
        state = None
    first = not isinstance(state, dict)
    state = state if isinstance(state, dict) else {}
    said: dict[str, float] = {k: v for k, v in (state.get("said") or {}).items() if now - float(v) < RECENT_S}
    shown = [t for t in state.get("shown") or [] if now - float(t) < 3600]
    # Alerts found but not yet said (over the cap, or no display) wait here,
    # because the state they were found from has already moved on.
    pending: dict[str, list] = {k: v for k, v in (state.get("pending") or {}).items()
                                if isinstance(v, list) and len(v) == 2 and now - float(v[1]) < PENDING_S}
    for k, line in alerts(rows, dead, state.get("states") or {}):
        if k not in said and k not in pending:
            pending[k] = [line, now]
    lines: list[str] = []
    if first:
        said.update({k: now for k in pending})
        pending = {}
    elif pending and len(shown) < ALERTS_PER_HOUR:
        lines = [v[0] for v in pending.values()]
        if (draw or draw_alert)(alert_lines(lines)):
            shown.append(now)
            said.update({k: now for k in pending})
            pending = {}
        else:
            lines = []
    state = {"states": {r["id"]: r["state"] for r in rows}, "said": said, "shown": shown, "pending": pending}
    try:
        WATCH_STATE.parent.mkdir(parents=True, exist_ok=True)
        tmp = WATCH_STATE.with_suffix(".tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0), 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(state, f)
        tmp.replace(WATCH_STATE)
    except OSError as err:
        print(f"kyber-sessions: watch state: {err}", file=sys.stderr)
    return lines


def draw_alert(lines: list[str]) -> bool:
    """A toast on the glass through `hud draw`. It never takes focus and
    takes itself down; with no display running it is simply not said, and
    `said` is left alone so the next look tries again."""
    try:
        done = subprocess.run([str(HUD_BIN), "draw"], input="\n".join(lines) + "\n", capture_output=True,
                              text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return False
    return done.returncode == 0


# ── CLI ──────────────────────────────────────────────────────────────────────

def short_id(sid: str) -> str:
    """Eight characters that identify a session: a Claude uuid's head, a
    Codex rollout's uuid tail."""
    return sid[-8:] if sid.startswith("rollout-") else sid[:8]


def line_for(s: dict, now: float) -> str:
    bits = [WORDS.get(s["state"], s["state"]), s["project"], s.get("origin") or "", s["model"],
            age_words(now - s["last"])]
    head = "  ".join(b for b in bits if b)
    extra = s.get("ask") or s.get("detail") or ""
    return f"{short_id(s['id'])}  {head}  {s['title'][:60]}" + (f"\n          {extra[:120]}" if extra else "")


def main(argv: list[str]) -> int:
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__)
        return 0
    cmd = argv[0] if argv and not argv[0].startswith("-") else "list"
    rest = argv[1:] if argv and not argv[0].startswith("-") else argv
    now = time.time()
    if cmd in ("list", "needs"):
        rows = discover(now, everything="--all" in rest)
        if cmd == "needs":
            rows = [s for s in rows if s["state"] in ("needs", "failed")]
        if "--json" in rest:
            print(json.dumps(rows, indent=2))
        else:
            shown = rows if "--all" in rest else rows[:20]
            print("\n".join(line_for(s, now) for s in shown) or "No sessions in the last three days.")
        return 0
    if cmd == "stream" and rest:
        s = find(rest[0])
        if not s:
            print("no such session", file=sys.stderr)
            return 1
        path, size = Path(s["transcript"]), 0
        for item in card_items(tail_entries(path), limit=10_000):
            print(json.dumps(item), flush=True)
        while "--follow" in rest:
            time.sleep(1)
            if path.stat().st_size != size:
                size = path.stat().st_size
                for item in card_items(tail_entries(path, 64_000), limit=5):
                    print(json.dumps(item), flush=True)
        return 0
    # Only a leading --fork is a flag. Anywhere else it is part of the message.
    fork = cmd == "send" and rest[:1] == ["--fork"]
    words = rest[1:] if fork else rest
    if cmd == "send" and len(words) >= 2:
        hits = matches(words[0])
        if len(hits) != 1:
            print(f"{len(hits)} sessions match {words[0]!r}; give more of the id" if hits
                  else "no such session", file=sys.stderr)
            return 1
        s = hits[0]
        result = send(s, " ".join(words[1:]), lambda t: print(json.dumps({"reply": t}), flush=True), fork=fork)
        print(json.dumps({"result": result.get("result"), "is_error": bool(result.get("is_error")),
                          "permission_denials": result.get("permission_denials") or [],
                          "via": result.get("via", ""), "delivered": result.get("delivered"),
                          "held": bool(result.get("held")),
                          "session": result.get("session_id") if fork else s["id"]}))
        return 1 if result.get("is_error") else 0
    if cmd == "run" and len(rest) >= 2:
        s = find(rest[0])
        argv2 = allowlisted(rest[1], Path(s["cwd"])) if s else None
        if not s or argv2 is None:
            print("not allowlisted here: status, diff, tests (when the folder declares one)", file=sys.stderr)
            return 2
        return run_streaming(argv2, s["cwd"], print)
    if cmd == "tree" and rest:
        s = find(rest[0])
        if not s:
            print("no such session", file=sys.stderr)
            return 1
        rows, _, root = session_tree.build(s["cwd"], tail_entries(Path(s["transcript"])),
                                           change_codes(git_changes(s["cwd"])))
        if "--json" in rest:
            print(json.dumps({"root": root, "rows": rows}, indent=2))
        elif rows:
            print(root)
            print(session_tree.text_lines(rows))
        else:
            print("Nothing touched in a git repo yet.")
        return 0
    if cmd == "new" and rest:
        folder = ""
        if "--in" in rest[:-1]:
            i = rest.index("--in")
            folder, rest = rest[i + 1], rest[:i] + rest[i + 2:]
        try:
            task, cwd = plan_task(" ".join(rest), folder)
            rec, _ = start_run(task, cwd)
        except (ValueError, OSError) as err:
            print(str(err), file=sys.stderr)
            return 1
        print(json.dumps({"session": rec["id"], "cwd": rec["cwd"], "pid": rec["pid"]}))
        return 0
    if cmd == "stop" and rest:
        hits = matches(rest[0])
        if len(hits) != 1:
            print(f"{len(hits)} sessions match {rest[0]!r}; give more of the id" if hits
                  else "no such session", file=sys.stderr)
            return 1
        stopped, words = stop_run(hits[0]["id"])
        print(words)
        return 0 if stopped else 1
    if cmd == "draft" and rest:
        queue_draft(" ".join(rest))
        return 0
    if cmd == "watch":
        for line in watch_once():
            print(line)
        return 0
    if cmd == "route" and rest:
        print(json.dumps(route(" ".join(rest))))
        return 0
    if cmd == "serve":
        import fcntl
        lock_path = HOME / ".bob" / "kyber-sessions.lock"
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        lock = lock_path.open("w")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            # One already runs. Ask it nothing: the menu was pressed twice.
            print("kyber-sessions serve is already running", file=sys.stderr)
            return 0
        open_first = rest[rest.index("--open") + 1] if "--open" in rest[:-1] else ""
        return Serve().run(open_first=open_first)
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
