#!/usr/bin/env bash
# Front door: runs Dough's engine/bin/gtme-dedupe. The gtme engine lives in Dough.
# gtme-front-door. tools/dough_home.py finds Dough. Bash, like the script it runs,
# because `chewbacca gtme-dedupe` calls it with bash.
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  L="$(readlink "$SRC")"
  case "$L" in /*) SRC="$L" ;; *) SRC="$(dirname "$SRC")/$L" ;; esac
done
KIT="$(cd "$(dirname "$SRC")/.." && pwd)"
DOUGH="$(python3 "$KIT/tools/dough_home.py" path)" || exit 1
export CHEWBACCA_ROOT="${CHEWBACCA_ROOT:-$KIT}"
exec bash "$DOUGH/engine/bin/gtme-dedupe" "$@"
