<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications: production APS environment for App Store/TestFlight -->
	<!-- Use "development" for debug builds signed with a dev provisioning profile -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- Associated Domains: enables Universal Links for amber://* deep links -->
	<!-- Replace amber.app with the actual registered domain once available -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:amber.app</string>
		<string>webcredentials:amber.app</string>
	</array>
</dict>
</plist>
