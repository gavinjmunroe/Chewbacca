# Slack bot token (xoxb-...) with channels:history, groups:history,
# channels:read, groups:read, users:read, files:read scopes.
SLACK_BOT_TOKEN=xoxb-your-token-here

# The channel ID to mirror (NOT the name). Find it in the channel's
# "Open channel details" > bottom, e.g. C0123ABCD.
SLACK_CHANNEL_ID=C0XXXXXXX

# Optional: pretty name shown in the header.
SLACK_CHANNEL_NAME=medha
