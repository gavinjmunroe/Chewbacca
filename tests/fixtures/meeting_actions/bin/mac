#!/usr/bin/env python3
"""Fake `mac` for tests/test_meeting_actions.py: calendar add and list only.
FAKE_MAC_DENIED=1 answers the way mac does with Calendars access off."""
import json
import os
import sys
from pathlib import Path

state = Path(os.environ["FAKE_STATE"])
args = sys.argv[1:]
with (state / "calls.jsonl").open("a") as fh:
    fh.write(json.dumps(["mac"] + args) + "\n")
if os.environ.get("FAKE_MAC_DENIED"):
    print(json.dumps({"error": {"code": "permissionDenied", "message": "Calendar access not granted."}}))
    sys.exit(1)
path = state / "mac-events.json"
rows = json.loads(path.read_text()) if path.exists() else []
if args[:2] == ["calendar", "add"]:
    at = args[args.index("--at") + 1]
    row = {"id": f"mac{len(rows) + 1}", "title": args[2], "start": at, "isAllDay": "--all-day" in args,
           "calendar": "Home", "notes": args[args.index("--notes") + 1] if "--notes" in args else ""}
    rows.append(row)
    path.write_text(json.dumps(rows))
    print(json.dumps(row))
    sys.exit(0)
if args[:2] == ["calendar", "list"]:
    lo, hi = args[args.index("--from") + 1], args[args.index("--to") + 1]
    print(json.dumps([r for r in rows if lo <= r["start"][:10] < hi]))
    sys.exit(0)
print("fake mac refused: " + " ".join(args), file=sys.stderr)
sys.exit(2)
