// Staging build configuration.
// Points iOS at staging-tier amber-agent and amber-id.
// DO NOT put secrets here. Keep API keys in Keychain or CI secrets.

AMBER_URL_SCHEME = https:/$()/

AMBER_AGENT_BASE_URL = $(AMBER_URL_SCHEME)amber-agent-staging.up.railway.app
AMBER_ID_BASE_URL = $(AMBER_URL_SCHEME)amber-id-staging.up.railway.app
PRIVY_APP_ID = REPLACE_WITH_PRIVY_STAGING_APP_ID
PRIVY_APP_CLIENT_ID = REPLACE_WITH_PRIVY_STAGING_CLIENT_ID
COMPOSIO_PROJECT_ID = REPLACE_WITH_COMPOSIO_STAGING_PROJECT_ID
AMBER_ENVIRONMENT = staging

PRODUCT_BUNDLE_IDENTIFIER = com.amber.AmberApp.staging
DISPLAY_NAME = Amber Staging
ASSETCATALOG_COMPILER_APPICON_NAME = AppIconStaging
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) STAGING
