/**
 * WebSocket Service
 * Real-time updates from backend with auto-reconnection, message queuing, and auth integration
 *
 * Features:
 * - Real-time updates for coaching sessions
 * - Auto-reconnection with exponential backoff
 * - Event types: session_update, coaching_moment, insight_ready
 * - Subscribe/unsubscribe pattern for selective updates
 * - Message queue for offline support
 * - Automatic token refresh on reconnection
 *
 * @example
 * ```tsx
 * import { webSocketService } from '@/services';
 *
 * // In your component or hook
 * useEffect(() => {
 *   // Connect to WebSocket
 *   webSocketService.connect(authToken);
 *
 *   // Subscribe to session updates
 *   const unsubscribe = webSocketService.subscribe('session_update', (data) => {
 *     console.log('Session updated:', data);
 *   });
 *
 *   return () => {
 *     unsubscribe();
 *     webSocketService.disconnect();
 *   };
 * }, [authToken]);
 *
 * // Send a message
 * await webSocketService.send({
 *   type: 'action',
 *   payload: { action: 'pause_session' }
 * });
 * ```
 */

import AsyncStorage from '@react-native-async-storage/async-storage';
import { STORAGE_KEYS } from '../shared/constants';
import { isTokenExpired } from '../shared/utils/tokenUtils';

/**
 * WebSocket event types
 */
export type WebSocketEventType = 'session_update' | 'coaching_moment' | 'insight_ready' | 'error' | 'connected' | 'disconnected';

/**
 * WebSocket connection states
 */
export enum WebSocketState {
  DISCONNECTED = 'DISCONNECTED',
  CONNECTING = 'CONNECTING',
  CONNECTED = 'CONNECTED',
  RECONNECTING = 'RECONNECTING',
  CLOSING = 'CLOSING',
}

/**
 * WebSocket message interface
 */
export interface WebSocketMessage {
  type: WebSocketEventType | string;
  timestamp?: number;
  data?: any;
  sessionId?: string;
  userId?: string;
}

/**
 * Queued message for offline support
 */
interface QueuedMessage {
  id: string;
  message: WebSocketMessage;
  timestamp: number;
  retries: number;
}

/**
 * Subscription callback type
 */
type SubscriptionCallback = (data: any) => void;

/**
 * Connection state listener type
 */
type ConnectionStateListener = (state: WebSocketState) => void;

/**
 * WebSocket configuration
 */
interface WebSocketConfig {
  url: string;
  heartbeatInterval?: number;
  messageQueueCapacity?: number;
  maxReconnectAttempts?: number;
  maxMessageRetries?: number;
  enableMessageQueue?: boolean;
  enableHeartbeat?: boolean;
}

/**
 * WebSocket Service Class
 * Manages real-time connections with automatic reconnection and message queuing
 */
export class WebSocketService {
  private ws: WebSocket | null = null;
  private config: Required<WebSocketConfig>;
  private state: WebSocketState = WebSocketState.DISCONNECTED;
  private reconnectAttempts: number = 0;
  private reconnectTimer: NodeJS.Timeout | null = null;
  private heartbeatTimer: NodeJS.Timeout | null = null;
  private currentToken: string | undefined = undefined;
  private messageId: number = 0;

  // Event subscriptions
  private subscriptions: Map<WebSocketEventType | string, Set<SubscriptionCallback>> = new Map();
  private stateListeners: Set<ConnectionStateListener> = new Set();

  // Message queue for offline support
  private messageQueue: Map<string, QueuedMessage> = new Map();
  private messageQueueSize: number = 0;

  constructor(config: WebSocketConfig) {
    this.config = {
      heartbeatInterval: config.heartbeatInterval || 30000,
      messageQueueCapacity: config.messageQueueCapacity || 100,
      maxReconnectAttempts: config.maxReconnectAttempts || 10,
      maxMessageRetries: config.maxMessageRetries || 3,
      enableMessageQueue: config.enableMessageQueue !== false,
      enableHeartbeat: config.enableHeartbeat !== false,
      url: config.url,
    };

    if (__DEV__) {
      console.log('[WebSocketService] Initialized with config:', {
        url: this.config.url,
        enableMessageQueue: this.config.enableMessageQueue,
        enableHeartbeat: this.config.enableHeartbeat,
        maxReconnectAttempts: this.config.maxReconnectAttempts,
      });
    }
  }

  /**
   * Connect to WebSocket server
   * Retrieves token from AsyncStorage if not provided
   */
  async connect(token?: string): Promise<void> {
    if (this.state === WebSocketState.CONNECTED || this.state === WebSocketState.CONNECTING) {
      if (__DEV__) {
        console.warn('[WebSocketService] Already connected or connecting');
      }
      return;
    }

    try {
      // Get token from AsyncStorage if not provided
      if (!token) {
        const storedToken = await AsyncStorage.getItem(STORAGE_KEYS.AUTH_TOKEN);
        if (!storedToken) {
          throw new Error('No authentication token available');
        }
        token = storedToken;
      }

      // Check if token is expired
      if (isTokenExpired(token)) {
        await AsyncStorage.removeItem(STORAGE_KEYS.AUTH_TOKEN);
        throw new Error('Authentication token is expired');
      }

      this.currentToken = token;
      this.setState(WebSocketState.CONNECTING);

      await this.establishConnection(token);
    } catch (error) {
      console.error('[WebSocketService] Connection error:', error);
      this.setState(WebSocketState.DISCONNECTED);
      this.handleDisconnection();
      throw error;
    }
  }

  /**
   * Establish WebSocket connection
   */
  private async establishConnection(token: string): Promise<void> {
    return new Promise((resolve, reject) => {
      try {
        const wsUrl = this.buildWebSocketUrl(token);
        if (__DEV__) {
          console.log('[WebSocketService] Connecting to', wsUrl.split('?')[0] + '?token=***');
        }

        this.ws = new WebSocket(wsUrl);

        // Set connection timeout
        const connectionTimeout = setTimeout(() => {
          if (this.ws && this.ws.readyState !== WebSocket.OPEN) {
            this.ws.close();
            reject(new Error('WebSocket connection timeout'));
          }
        }, 10000);

        this.ws.onopen = () => {
          clearTimeout(connectionTimeout);
          if (__DEV__) {
            console.log('[WebSocketService] Connected');
          }
          this.reconnectAttempts = 0;
          this.setState(WebSocketState.CONNECTED);
          this.startHeartbeat();
          this.processMessageQueue();
          resolve();
        };

        this.ws.onmessage = (event) => {
          try {
            const message = JSON.parse(event.data) as WebSocketMessage;
            this.handleMessage(message);
          } catch (error) {
            console.error('[WebSocketService] Failed to parse message:', error);
          }
        };

        this.ws.onerror = (error) => {
          clearTimeout(connectionTimeout);
          console.error('[WebSocketService] WebSocket error:', error);
          reject(new Error(`WebSocket error: ${error}`));
        };

        this.ws.onclose = () => {
          clearTimeout(connectionTimeout);
          if (__DEV__) {
            console.log('[WebSocketService] WebSocket closed');
          }
          this.handleDisconnection();
        };
      } catch (error) {
        reject(error);
      }
    });
  }

  /**
   * Build WebSocket URL with token
   */
  private buildWebSocketUrl(token: string): string {
    const url = new URL(this.config.url);
    url.searchParams.set('token', token);
    return url.toString();
  }

  /**
   * Handle incoming messages
   */
  private handleMessage(message: WebSocketMessage): void {
    const eventType = message.type as WebSocketEventType;

    if (__DEV__) {
      console.log('[WebSocketService] Received message:', {
        type: eventType,
        timestamp: message.timestamp,
        hasData: !!message.data,
      });
    }

    // Emit to all subscribers of this event type
    const callbacks = this.subscriptions.get(eventType);
    if (callbacks) {
      callbacks.forEach((callback) => {
        try {
          callback(message.data || message);
        } catch (error) {
          console.error(`[WebSocketService] Callback error for ${eventType}:`, error);
        }
      });
    }

    // Handle connection state messages
    if (eventType === 'connected') {
      if (__DEV__) {
        console.log('[WebSocketService] Server confirmed connection');
      }
    }
  }

  /**
   * Disconnect from WebSocket server
   */
  async disconnect(): Promise<void> {
    if (__DEV__) {
      console.log('[WebSocketService] Disconnecting');
    }
    this.setState(WebSocketState.CLOSING);

    // Clear timers
    this.stopHeartbeat();
    if (this.reconnectTimer) {
      clearTimeout(this.reconnectTimer);
      this.reconnectTimer = null;
    }

    // Close WebSocket
    if (this.ws) {
      try {
        if (this.ws.readyState === WebSocket.OPEN) {
          this.ws.close(1000, 'Client disconnect');
        }
      } catch (error) {
        console.error('[WebSocketService] Error closing WebSocket:', error);
      }
      this.ws = null;
    }

    this.setState(WebSocketState.DISCONNECTED);
    this.currentToken = undefined;
  }

  /**
   * Handle disconnection and attempt reconnection
   */
  private handleDisconnection(): void {
    this.stopHeartbeat();

    if (this.state === WebSocketState.CLOSING) {
      // User explicitly closed the connection
      this.setState(WebSocketState.DISCONNECTED);
      return;
    }

    // Attempt automatic reconnection
    if (this.reconnectAttempts < this.config.maxReconnectAttempts) {
      this.setState(WebSocketState.RECONNECTING);
      this.scheduleReconnection();
    } else {
      console.error('[WebSocketService] Max reconnection attempts reached');
      this.setState(WebSocketState.DISCONNECTED);
      this.emitEvent('error', {
        message: 'Failed to connect after maximum attempts',
        code: 'MAX_RECONNECT_ATTEMPTS_REACHED',
      });
    }
  }

  /**
   * Schedule reconnection with exponential backoff
   */
  private scheduleReconnection(): void {
    if (this.reconnectTimer) {
      return; // Already scheduled
    }

    const baseDelay = 1000;
    const maxDelay = 30000;
    const delay = Math.min(baseDelay * Math.pow(2, this.reconnectAttempts), maxDelay);

    this.reconnectAttempts++;

    if (__DEV__) {
      console.log(
        `[WebSocketService] Scheduling reconnection attempt ${this.reconnectAttempts}/${this.config.maxReconnectAttempts} in ${delay}ms`
      );
    }

    this.reconnectTimer = setTimeout(() => {
      this.reconnectTimer = null;
      this.attemptReconnection();
    }, delay);
  }

  /**
   * Attempt to reconnect
   */
  private async attemptReconnection(): Promise<void> {
    try {
      // Verify token is still valid
      let token = this.currentToken;
      if (!token) {
        const storedToken = await AsyncStorage.getItem(STORAGE_KEYS.AUTH_TOKEN);
        token = storedToken ?? undefined;
      }

      if (!token) {
        if (__DEV__) {
          console.warn('[WebSocketService] No token available for reconnection');
        }
        this.setState(WebSocketState.DISCONNECTED);
        this.emitEvent('error', {
          message: 'No authentication token available',
          code: 'NO_AUTH_TOKEN',
        });
        return;
      }

      if (isTokenExpired(token)) {
        if (__DEV__) {
          console.warn('[WebSocketService] Token expired, cannot reconnect');
        }
        await AsyncStorage.removeItem(STORAGE_KEYS.AUTH_TOKEN);
        this.setState(WebSocketState.DISCONNECTED);
        this.emitEvent('error', {
          message: 'Authentication token expired',
          code: 'TOKEN_EXPIRED',
        });
        return;
      }

      this.currentToken = token;
      await this.establishConnection(token);
    } catch (error) {
      console.error('[WebSocketService] Reconnection failed:', error);
      this.handleDisconnection();
    }
  }

  /**
   * Send a message to the server
   */
  async send(message: WebSocketMessage): Promise<void> {
    const messageWithMetadata: WebSocketMessage = {
      ...message,
      timestamp: message.timestamp || Date.now(),
    };

    if (this.state === WebSocketState.CONNECTED && this.ws && this.ws.readyState === WebSocket.OPEN) {
      try {
        this.ws.send(JSON.stringify(messageWithMetadata));
        if (__DEV__) {
          console.log('[WebSocketService] Message sent:', messageWithMetadata.type);
        }
      } catch (error) {
        console.error('[WebSocketService] Failed to send message:', error);
        this.queueMessage(messageWithMetadata);
      }
    } else {
      // Queue message if offline
      if (this.config.enableMessageQueue) {
        if (__DEV__) {
          console.log('[WebSocketService] Queuing message (offline):', messageWithMetadata.type);
        }
        this.queueMessage(messageWithMetadata);
      } else {
        throw new Error('WebSocket is not connected');
      }
    }
  }

  /**
   * Queue message for later delivery
   */
  private queueMessage(message: WebSocketMessage): void {
    if (!this.config.enableMessageQueue) {
      return;
    }

    // Check queue capacity
    if (this.messageQueueSize >= this.config.messageQueueCapacity) {
      if (__DEV__) {
        console.warn('[WebSocketService] Message queue at capacity, dropping oldest message');
      }
      const firstKey = Array.from(this.messageQueue.keys())[0];
      if (firstKey) {
        this.messageQueue.delete(firstKey);
        this.messageQueueSize--;
      }
    }

    const messageId = `msg-${Date.now()}-${++this.messageId}`;
    const queuedMessage: QueuedMessage = {
      id: messageId,
      message,
      timestamp: Date.now(),
      retries: 0,
    };

    this.messageQueue.set(messageId, queuedMessage);
    this.messageQueueSize++;

    if (__DEV__) {
      console.log(`[WebSocketService] Message queued: ${messageId} (queue size: ${this.messageQueueSize})`);
    }
  }

  /**
   * Process queued messages once connected
   */
  private async processMessageQueue(): Promise<void> {
    if (!this.config.enableMessageQueue || this.messageQueueSize === 0) {
      return;
    }

    console.log(`[WebSocketService] Processing ${this.messageQueueSize} queued messages`);

    const messages = Array.from(this.messageQueue.values()).sort(
      (a, b) => a.timestamp - b.timestamp
    );

    for (const queuedMessage of messages) {
      if (this.state !== WebSocketState.CONNECTED || !this.ws) {
        console.log('[WebSocketService] Connection lost while processing queue');
        break;
      }

      try {
        this.ws.send(JSON.stringify(queuedMessage.message));
        this.messageQueue.delete(queuedMessage.id);
        this.messageQueueSize--;
        console.log(`[WebSocketService] Sent queued message: ${queuedMessage.id}`);
      } catch (error) {
        console.error(`[WebSocketService] Failed to send queued message ${queuedMessage.id}:`, error);

        queuedMessage.retries++;
        if (queuedMessage.retries >= this.config.maxMessageRetries) {
          console.warn(`[WebSocketService] Max retries exceeded for ${queuedMessage.id}, dropping`);
          this.messageQueue.delete(queuedMessage.id);
          this.messageQueueSize--;
        }
      }
    }
  }

  /**
   * Start heartbeat to keep connection alive
   */
  private startHeartbeat(): void {
    if (!this.config.enableHeartbeat) {
      return;
    }

    this.stopHeartbeat();

    console.log('[WebSocketService] Starting heartbeat');

    this.heartbeatTimer = setInterval(() => {
      if (this.state === WebSocketState.CONNECTED && this.ws && this.ws.readyState === WebSocket.OPEN) {
        try {
          this.ws.send(JSON.stringify({ type: 'ping', timestamp: Date.now() }));
        } catch (error) {
          console.error('[WebSocketService] Heartbeat failed:', error);
        }
      }
    }, this.config.heartbeatInterval);
  }

  /**
   * Stop heartbeat
   */
  private stopHeartbeat(): void {
    if (this.heartbeatTimer) {
      clearInterval(this.heartbeatTimer);
      this.heartbeatTimer = null;
      console.log('[WebSocketService] Heartbeat stopped');
    }
  }

  /**
   * Subscribe to a specific event type
   */
  subscribe(eventType: WebSocketEventType | string, callback: SubscriptionCallback): () => void {
    if (!this.subscriptions.has(eventType)) {
      this.subscriptions.set(eventType, new Set());
    }

    const callbacks = this.subscriptions.get(eventType)!;
    callbacks.add(callback);

    console.log(
      `[WebSocketService] Subscribed to ${eventType} (${callbacks.size} subscriber${callbacks.size > 1 ? 's' : ''})`
    );

    // Return unsubscribe function
    return () => {
      callbacks.delete(callback);
      console.log(
        `[WebSocketService] Unsubscribed from ${eventType} (${callbacks.size} subscriber${callbacks.size > 1 ? 's' : ''})`
      );
    };
  }

  /**
   * Unsubscribe from a specific event type
   */
  unsubscribe(eventType: WebSocketEventType | string, callback?: SubscriptionCallback): void {
    if (callback) {
      const callbacks = this.subscriptions.get(eventType);
      if (callbacks) {
        callbacks.delete(callback);
        console.log(`[WebSocketService] Unsubscribed from ${eventType}`);
      }
    } else {
      this.subscriptions.delete(eventType);
      console.log(`[WebSocketService] Unsubscribed all from ${eventType}`);
    }
  }

  /**
   * Emit event to all subscribers
   */
  private emitEvent(eventType: WebSocketEventType | string, data: any): void {
    const callbacks = this.subscriptions.get(eventType);
    if (callbacks) {
      callbacks.forEach((callback) => {
        try {
          callback(data);
        } catch (error) {
          console.error(`[WebSocketService] Callback error for ${eventType}:`, error);
        }
      });
    }
  }

  /**
   * Subscribe to connection state changes
   */
  onStateChange(listener: ConnectionStateListener): () => void {
    this.stateListeners.add(listener);

    // Immediately notify with current state
    listener(this.state);

    // Return unsubscribe function
    return () => {
      this.stateListeners.delete(listener);
    };
  }

  /**
   * Set connection state and notify listeners
   */
  private setState(newState: WebSocketState): void {
    if (newState !== this.state) {
      const previousState = this.state;
      this.state = newState;

      console.log(`[WebSocketService] State changed: ${previousState} -> ${newState}`);

      // Notify all state listeners
      this.stateListeners.forEach((listener) => {
        try {
          listener(newState);
        } catch (error) {
          console.error('[WebSocketService] State listener error:', error);
        }
      });

      // Emit state change event
      this.emitEvent('state_changed', { from: previousState, to: newState });
    }
  }

  /**
   * Get current connection state
   */
  getState(): WebSocketState {
    return this.state;
  }

  /**
   * Check if connected
   */
  isConnected(): boolean {
    return this.state === WebSocketState.CONNECTED;
  }

  /**
   * Get message queue size
   */
  getMessageQueueSize(): number {
    return this.messageQueueSize;
  }

  /**
   * Get all queued messages
   */
  getQueuedMessages(): QueuedMessage[] {
    return Array.from(this.messageQueue.values());
  }

  /**
   * Clear message queue
   */
  clearMessageQueue(): void {
    console.log(`[WebSocketService] Clearing message queue (${this.messageQueueSize} messages)`);
    this.messageQueue.clear();
    this.messageQueueSize = 0;
  }

  /**
   * Get connection statistics
   */
  getStats(): {
    state: WebSocketState;
    isConnected: boolean;
    reconnectAttempts: number;
    maxReconnectAttempts: number;
    messageQueueSize: number;
    uptime?: number;
  } {
    return {
      state: this.state,
      isConnected: this.isConnected(),
      reconnectAttempts: this.reconnectAttempts,
      maxReconnectAttempts: this.config.maxReconnectAttempts,
      messageQueueSize: this.messageQueueSize,
    };
  }

  /**
   * Clean up resources
   */
  destroy(): void {
    console.log('[WebSocketService] Destroying');
    this.disconnect().catch(console.error);
    this.subscriptions.clear();
    this.stateListeners.clear();
    this.clearMessageQueue();
  }
}

// WebSocket Service Configuration
const WS_BASE_URL = process.env.EXPO_PUBLIC_WS_URL || 'wss://api.tizzy.app/v1/ws';

// Singleton instance with default configuration
export const webSocketService = new WebSocketService({
  url: WS_BASE_URL,
  heartbeatInterval: 30000,
  messageQueueCapacity: 100,
  maxReconnectAttempts: 10,
  maxMessageRetries: 3,
  enableMessageQueue: true,
  enableHeartbeat: true,
});

/**
 * React Hook for WebSocket connection and subscriptions
 *
 * @example
 * ```tsx
 * function MyComponent() {
 *   const { state, connect, disconnect } = useWebSocket();
 *
 *   useEffect(() => {
 *     connect();
 *     return () => disconnect();
 *   }, []);
 *
 *   return <Text>{state}</Text>;
 * }
 * ```
 */
export function useWebSocket() {
  const [state, setState] = React.useState<WebSocketState>(WebSocketState.DISCONNECTED);
  const [stats, setStats] = React.useState(webSocketService.getStats());

  React.useEffect(() => {
    // Subscribe to state changes
    const unsubscribeState = webSocketService.onStateChange((newState) => {
      setState(newState);
      setStats(webSocketService.getStats());
    });

    return unsubscribeState;
  }, []);

  return {
    state,
    stats,
    connect: () => webSocketService.connect(),
    disconnect: () => webSocketService.disconnect(),
    subscribe: (eventType: WebSocketEventType | string, callback: SubscriptionCallback) =>
      webSocketService.subscribe(eventType, callback),
    unsubscribe: (eventType: WebSocketEventType | string, callback?: SubscriptionCallback) =>
      webSocketService.unsubscribe(eventType, callback),
    send: (message: WebSocketMessage) => webSocketService.send(message),
    isConnected: () => webSocketService.isConnected(),
  };
}

// Import React for hook
import * as React from 'react';
