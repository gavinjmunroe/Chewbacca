#!/bin/bash
# chewbacca cloud: your own always-on CRM and Claude connector, one command.
#
#   chewbacca cloud up <name> "<Owner Name>" [--no-bridge]   deploy one, bridge this Mac
#   chewbacca cloud list                                    every instance this Mac set up
#
# The service is the joel-os template (calebnewtonusc/joel-os). It deploys from
# GitHub on Railway, so pushes to its main redeploy every instance. Its README
# and docs/ONBOARDING.md hold the details. Secrets live in
# ~/.chewbacca/secrets/<name>-os.env and are never printed.
set -euo pipefail

TEMPLATE_REPO="${CHEWBACCA_CLOUD_REPO:-calebnewtonusc/joel-os}"
TEMPLATE="${CHEWBACCA_CLOUD_TEMPLATE:-$HOME/.chewbacca/cloud/template}"
SECRETS_DIR="$HOME/.chewbacca/secrets"

usage() {
  echo 'usage: chewbacca cloud up <name> "<Owner Name>" [--no-bridge]'
  echo '       chewbacca cloud list'
}

template() {
  if [ ! -x "$TEMPLATE/bin/cloud-up" ]; then
    mkdir -p "$(dirname "$TEMPLATE")"
    gh repo clone "$TEMPLATE_REPO" "$TEMPLATE" -- --quiet
  else
    git -C "$TEMPLATE" pull --quiet --ff-only || echo "template pull failed, using the copy on disk" >&2
  fi
}

case "${1:-}" in
  up)
    shift
    [ $# -ge 2 ] || { usage; exit 1; }
    template
    exec bash "$TEMPLATE/bin/cloud-up" "$@"
    ;;
  list)
    found=0
    for f in "$SECRETS_DIR"/*-os.env; do
      [ -e "$f" ] || continue
      found=1
      name="$(basename "$f" .env)"
      url="$(sed -n 's/^URL=//p' "$f")"
      health="$( [ -n "$url" ] && curl -s -m 5 "$url/health" || true)"
      people="$(printf '%s' "$health" | sed -n 's/.*"people":\([0-9]*\).*/\1/p')"
      if [ -n "$people" ]; then
        printf '%-24s %-44s %s people\n' "$name" "$url" "$people"
      else
        printf '%-24s %-44s not answering\n' "$name" "${url:-no url}"
      fi
    done
    [ "$found" = 1 ] || echo "No instances yet. chewbacca cloud up <name> \"<Owner Name>\""
    ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
