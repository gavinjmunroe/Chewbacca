{
  "name": "bma-expenses-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Slack bot that runs BMA's reimbursement workflow: request, approve, Rho payout prep, and Google Sheets accounting.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@slack/bolt": "^4.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
