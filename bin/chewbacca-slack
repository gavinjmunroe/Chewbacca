#!/usr/bin/env bash
# chewbacca slack: Slack as part of the kit, through the CLI.
#
#   chewbacca slack                  status: which workspaces can send
#   chewbacca slack link [url]       save a workspace's session (silently when possible)
#   chewbacca slack refresh          re-save every session silently
#
# Reading copies the Slack desktop app's cache (slacrawl). Sending goes through
# slackcli (shaharia-lab/slackcli, MIT), which keeps one browser profile of its
# own. The first time a workspace is linked, a person signs into it in that
# profile once: it's their password, and no agent may type it. After that the
# profile stays signed in, and `--headless` re-saves the session with no window
# (measured 2026-10-09: Amber re-linked headless in seconds after one sign-in).
set -uo pipefail
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
say() { printf '%s\n' "$*"; }

ensure() {
  command -v slackcli >/dev/null 2>&1 && return 0
  say "Installing Slack support..."
  brew trust --formula shaharia-lab/tap/slackcli >/dev/null 2>&1
  brew install shaharia-lab/tap/slackcli >/dev/null 2>&1 || { say "Could not install slackcli."; return 1; }
}

status() {
  ensure || return 1
  if slackcli auth list 2>&1 | grep -q "No authenticated"; then
    say "Slack: reading works. Sending needs one link: chewbacca slack link"
  else
    slackcli auth list 2>&1
  fi
}

busiest_url() {
  [ -f "$HOME/.slacrawl/slacrawl.db" ] || return 0
  local dom
  dom=$(sqlite3 "$HOME/.slacrawl/slacrawl.db" "SELECT w.domain FROM messages m JOIN workspaces w ON w.id = m.workspace_id GROUP BY 1 ORDER BY count(*) DESC LIMIT 1" 2>/dev/null)
  [ -n "$dom" ] && echo "https://$dom.slack.com"
}

link() {
  ensure || return 1
  local url="${1:-$(busiest_url)}" args=(--timeout 1800 --secret-backend keychain)
  [ -n "$url" ] && args+=(--workspace-url "$url")
  # Silent first: if slackcli's profile is already signed in, no window opens.
  if slackcli auth login-auto --headless "${args[@]/1800/90}" >/dev/null 2>&1 &&
     ! slackcli auth list 2>&1 | grep -q "No authenticated"; then
    status; return 0
  fi
  say "A browser window is opening. Sign into Slack there once, then leave it until it closes itself."
  slackcli auth login-auto "${args[@]}"
  status
}

refresh() {
  ensure || return 1
  slackcli auth login-auto --headless --timeout 90 --secret-backend keychain >/dev/null 2>&1
  status
}

case "${1:-status}" in
  status) status ;;
  link) shift; link "${1:-}" ;;
  refresh) refresh ;;
  -h|--help|help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) say "Try: chewbacca slack [status|link|refresh]"; exit 2 ;;
esac
