#!/usr/bin/env python3
"""Try a change somewhere safe, score it, and keep the evidence either way.

    evolve --patch fix.diff          apply in isolation, score, report
    evolve --cmd "python3 x.py"      run a mutator in isolation, score, report
    evolve --archive                 every attempt ever made, kept or not
    evolve --show <id>               the diff and the score for one attempt
    evolve --cmd "bin/propose --shapes open" \\
           --expect "python3 tests/voice_cases.py --shapes open" --gate --branch
                                     the learning loop: see bin/reflect
    evolve --cmd ... --expect ... --gate --branch --n 3
                                     three proposals side by side, best kept

BEST OF N. One proposal is one sample: when it passes you cannot tell a
reliable fix from a lucky one. --n runs the --cmd in N worktrees at once,
judges each, and ranks the ones the judge passes by the held-out cases they
also pass (the sentences no proposer saw, see tests/voice_cases.py), then by
the smallest diff. The suite, the expensive part at 15 to 20 minutes, runs
only on the best candidate, and on the next only if the gate refuses it. Every
candidate is archived. The spread is printed, because "1 of 3 passed" says
the fix is not reliable yet even when the one is kept.

--expect names a judge that must FAIL before the change and PASS after it.
That flip is the only evidence a change fixed what it was written for; a
score can rise for a change that fixed nothing. --branch keeps a change that
passed the gate as a commit on learn/<id>, a branch nobody works on, for a
person to read and merge. Without --branch nothing is ever committed.

WHY IT NEVER MERGES. The Darwin Godel Machine (Zhang et al., ICLR 2026,
arXiv 2505.22954) self-modifies and validates each change on a benchmark, and
the part people skip when they retell it is the ARCHIVE: it keeps every
variant, not only the winners, because open-ended exploration beats greedy
selection and stops the system stagnating in a local optimum.

So this proposes and measures. It does not merge. Three reasons, in order of
how much they cost when ignored:

  1. bin/fitness scores COVERAGE AND CONFORMANCE, not quality. A change that
     raises the number can still make the kit worse, and auto-merging on a
     proxy metric is how a system optimises itself into something nobody
     wanted.
  2. This repo has had two sessions running in it on the same day, and one
     commit already absorbed another's staged files. A loop that commits by
     itself in that environment is a data-loss machine. --branch commits
     only inside its own worktree, only the files the change touched, onto
     a new branch, so no session's index is ever in reach.
  3. A losing attempt is evidence. Deleting it throws away the only record of
     what was tried, which is the archive DGM says you need.

ISOLATION IS A GIT WORKTREE. The change is applied to a detached worktree
under .worktrees/evolve-<id>, scored there, and the worktree is removed by
exact path. Nothing touches the working tree you are sitting in.
"""
import argparse
import concurrent.futures
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import time

ROOT = pathlib.Path(__file__).resolve().parent.parent
ARCHIVE = pathlib.Path.home() / ".chewbacca" / "evolve"
LEDGER = ARCHIVE / "archive.jsonl"


def git(*args, cwd=None, check=False):
    r = subprocess.run(["git", "-C", str(cwd or ROOT), *args],
                       capture_output=True, text=True)
    if check and r.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)}: {r.stderr.strip()[:200]}")
    return r.stdout.strip()


def baseline():
    """The last recorded full (unsampled) score, or None."""
    p = pathlib.Path.home() / ".chewbacca" / "fitness.jsonl"
    if not p.exists():
        return None
    rows = []
    for line in p.read_text().splitlines():
        try:
            e = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not e.get("sampled"):
            rows.append(e)
    return rows[-1] if rows else None


def score_in(path):
    # Score into a THROWAWAY ledger. The first run of this tool wrote its
    # worktree score into the real one, so an unmerged change became the
    # baseline and the next real comparison read as a 3.13 regression against
    # code that was never committed.
    env = dict(os.environ)
    env["CHEWBACCA_FITNESS_LEDGER"] = str(path / ".evolve-fitness.jsonl")
    r = subprocess.run([sys.executable, str(path / "bin/fitness"),
                        "--no-tests"], capture_output=True, text=True,
                       timeout=900, cwd=str(path), env=env)
    out = r.stdout + r.stderr
    m = re.search(r"structural\s+([\d.]+)", out)
    if not m:
        return None, out[-400:]
    return float(m.group(1)), out


def cases_from(ledger_path):
    """Which eval cases failed, from the newest row that recorded any.

    Returns None when nothing in the ledger carries per-case results, which
    is the honest answer for a run made before `fitness` learned to record
    them, and is different from "nothing failed".
    """
    p = pathlib.Path(ledger_path)
    if not p.exists():
        return None
    newest = None
    for line in p.read_text().splitlines():
        try:
            e = json.loads(line)
        except json.JSONDecodeError:
            continue
        if e.get("failed_cases") is not None:
            newest = e
    if newest is None:
        return None
    return {c.get("id") for c in newest["failed_cases"] if c.get("id")}


def expect(worktree, cmd, env=None):
    """Run the judge in the worktree. (passed, last lines of its output, the
    counts from its JUDGE line or None when the judge prints none)."""
    r = subprocess.run(cmd, shell=True, cwd=str(worktree), capture_output=True,
                       text=True, errors="replace", timeout=600, env=env)
    return r.returncode == 0, (r.stdout + r.stderr).strip()[-1500:], judge_counts(r.stdout)


def judge_counts(out):
    """The JSON on the judge's last `JUDGE ` line."""
    found = re.findall(r"^JUDGE (\{.*\})\s*$", out or "", re.M)
    try:
        return json.loads(found[-1]) if found else None
    except ValueError:
        return None


def changed_lines(diff):
    return sum(1 for line in diff.splitlines()
               if line[:1] in "+-" and not line.startswith(("+++", "---")))


def rank_candidates(cands):
    """The candidates worth gating, best first.

    Only a change that ran and, when there is a judge, passed it. Among
    those: the larger share of held-out cases reached, then the smaller
    diff, then the id so the order never depends on which finished first.
    A judge that prints no counts ranks on the diff alone.
    """
    def held_rate(c):
        held = (c.get("counts") or {}).get("held") or [0, 0]
        return held[0] / held[1] if held[1] else 0.0
    eligible = [c for c in cands if c["ok"] and c.get("judged") is not False]
    return sorted(eligible, key=lambda c: (-held_rate(c), c.get("diff_lines", 0), c["aid"]))


def keep_declines(dest):
    """Copy the kept candidate's declines into the loop's declined.jsonl.

    Only the kept one: a refused candidate's "leave this to the model" must
    not excuse that sentence for the next attempt."""
    rows = [line for line in (dest / "declines.jsonl").read_text().splitlines() if line.strip()] \
        if (dest / "declines.jsonl").exists() else []
    if not rows:
        return 0
    sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent / "lib"))
    import learnloop
    learnloop.DECLINED.parent.mkdir(parents=True, exist_ok=True)
    with learnloop.DECLINED.open("a", encoding="utf-8") as fh:
        fh.write("\n".join(rows) + "\n")
    return len(rows)


def full_diff(worktree):
    """The change, including files it created.

    `git diff` alone shows tracked files only, so a proposal that added a
    parser module and its test archived as a diff with neither in it, and
    `git apply` of that diff produced a call to a module that did not exist.
    Intent-to-add makes new files show up in the diff without staging their
    content, inside a worktree that is about to be removed anyway.
    """
    new = git("ls-files", "--others", "--exclude-standard", cwd=worktree).splitlines()
    new = [p for p in new if not p.startswith(".evolve-")]
    if new:
        git("add", "--intent-to-add", "--", *new, cwd=worktree)
    # git() strips its output, and a diff without its final newline is one
    # `git apply` calls corrupt. Attempt 590e4335 on 2026-09-27 archived
    # that way and could not be replayed until the newline went back on.
    diff = git("diff", cwd=worktree)
    return diff + "\n" if diff else diff


def commit_branch(worktree, aid, note):
    """Keep a change that passed the gate as a branch a person can read.

    A branch and not a merge: tier B in docs/SELF-LEARNING.md is "a branch
    with a test, Gavin merges". The branch outlives the worktree, so the
    change survives this run without ever touching the tree anyone works in.
    Files are staged by name, never with -A, per the kit's git rule.
    """
    name = f"learn/{aid}"
    files = [p for p in git("diff", "--name-only", cwd=worktree).splitlines()
             if p and not p.startswith(".evolve-")]
    if not files:
        return None
    try:
        git("checkout", "-q", "-b", name, cwd=worktree, check=True)
        git("add", "--", *files, cwd=worktree, check=True)
        # Named paths: the repo's pre-commit hook refuses a bare commit while
        # more than one session is live, which is exactly when this runs.
        git("commit", "-q", "-m",
            f"feat: {note or 'a change the learning loop proposed'} (learned, evolve {aid})",
            "--", *files, cwd=worktree, check=True)
    except RuntimeError as e:
        print(f"  could not keep the change on {name}: {e}")
        return None
    return name


def gate(worktree, base, after, judged=None, suite_before=None):
    """Should this change be allowed to land?

    THE RETENTION STEP THIS TOOL HAS NEVER HAD. `evolve` proposes and
    archives and never merges, which leaves variation with no selection: an
    archive with no retention is a museum. This is the missing half, minus
    the click, and it deliberately stops short of merging for the three
    reasons at the top of this file.

    WHY A RISING SCORE IS NOT ENOUGH ON ITS OWN. `fitness` measures coverage
    and conformance, so a change can raise the number and make the kit
    worse. The check that carries real weight is the second one: no eval
    case that passed may now fail. That comparison was impossible until
    2026-09-21, when `fitness` started recording WHICH cases failed instead
    of how many, and it is the reason this gate can exist at all.

    Returns (allowed, reasons).
    """
    reasons = []

    if after is None:
        return False, ["the change did not score, so there is nothing to judge"]
    # The check that says the change fixed what it was written for. A score
    # can rise for a change that fixed nothing; this cannot.
    if judged is not None and not judged:
        reasons.append("the judge (--expect) still fails after the change")
    if after < base["structural_score"]:
        reasons.append(
            f"structural score fell {base['structural_score']:.2f} -> {after:.2f}")

    # The suite, run in the worktree. No model calls, and a change that
    # breaks a test is refused whatever it did to the score. Judged against
    # the same suite on the unchanged commit, because a machine can fail a
    # check before any change: on 2026-09-27 a pristine upstream main failed
    # `counts --check` on Gavin's Mac, and demanding a green suite would have
    # refused every change forever for a failure none of them caused.
    failing, finished, tail = suite_failures(worktree)
    if not finished:
        reasons.append("the test suite failed without naming a check: " + tail)
    elif suite_before is None:
        if failing:
            reasons.append("the test suite failed: " + ", ".join(sorted(failing)[:6]))
    else:
        newly = sorted(failing - suite_before)
        if newly:
            reasons.append("tests that passed and now fail: " + ", ".join(newly[:6]))

    # Per-case regression, when both sides recorded cases.
    before_ids = cases_from(pathlib.Path.home() / ".chewbacca" / "fitness.jsonl")
    after_ids = cases_from(worktree / ".evolve-fitness.jsonl")
    if before_ids is None or after_ids is None:
        reasons.append(
            "NOT CHECKED: no per-case results on one side, so a regression "
            "from pass to fail cannot be ruled out. Run `fitness --run` on "
            "both to make this gate mean something")
    else:
        newly_failing = sorted(after_ids - before_ids)
        if newly_failing:
            reasons.append("cases that passed and now fail: "
                           + ", ".join(newly_failing[:8]))

    hard = [x for x in reasons if not x.startswith("NOT CHECKED")]
    return (not hard), reasons



ANSI = re.compile(r"\x1b\[[0-9;]*m")


def suite_failures(path):
    """Run tests/run.sh in `path`: (names of failed checks, finished, tail).

    `finished` is False when the runner died without its summary, which is
    different from a clean run and must never read as one.
    """
    # The suite took 954 s and 1139 s on 2026-09-27 with two runs sharing the
    # Mac; 2400 leaves about twice that before a slow run reads as a hang.
    try:
        r = subprocess.run(["bash", str(path / "tests/run.sh")], capture_output=True,
                           text=True, timeout=2400, cwd=str(path))
    except subprocess.TimeoutExpired:
        return set(), False, "timed out after 2400 s"
    out = ANSI.sub("", r.stdout + r.stderr)
    failing = set(re.findall(r"^\s+FAIL\s+(.+?)\s*$", out, re.M))
    finished = r.returncode == 0 or bool(failing)
    return failing, finished, " / ".join(out.strip().splitlines()[-3:])


def suite_before(worktree):
    """The suite's failures on the unchanged commit, run once per commit.

    Cached by sha because the suite takes minutes and HEAD does not move
    between attempts; a second proposal against the same commit reuses it.
    """
    sha = git("rev-parse", "HEAD", cwd=worktree)
    cache = ARCHIVE / f"suite-{sha[:12]}.json"
    if cache.exists():
        try:
            return set(json.loads(cache.read_text())["failing"])
        except (ValueError, KeyError):
            pass
    failing, finished, tail = suite_failures(worktree)
    if not finished:
        print(f"  the suite did not finish on the unchanged commit: {tail}")
        return None
    cache.write_text(json.dumps({"sha": sha, "failing": sorted(failing)}))
    return failing


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--patch"); ap.add_argument("--cmd")
    ap.add_argument("--note", default="")
    ap.add_argument("--archive", action="store_true")
    ap.add_argument("--gate", action="store_true",
                    help="judge the change against the merge gate; never merges")
    ap.add_argument("--expect", default="",
                    help="a command that must fail before the change and pass after")
    ap.add_argument("--branch", action="store_true",
                    help="if the gate passes, commit the change to learn/<id>; never merges")
    ap.add_argument("--show")
    ap.add_argument("--n", type=int, default=1,
                    help="run --cmd this many times side by side and keep the best")
    a = ap.parse_args()
    if a.n < 1 or (a.n > 1 and a.patch):
        print("--n needs --cmd and a count of 1 or more: the same patch N times "
              "is one attempt", file=sys.stderr)
        return 2

    ARCHIVE.mkdir(parents=True, exist_ok=True)

    if a.archive:
        if not LEDGER.exists():
            print("no attempts yet.")
            return 0
        print(f"{'ID':<10} {'WHEN':<17} {'BASE':>7} {'AFTER':>7} {'DELTA':>7}  NOTE")
        for line in LEDGER.read_text().splitlines():
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            # Every column is stringified BEFORE it is padded. A failed
            # attempt has after=None and delta=None, and a numeric format
            # spec on None raises, which crashed --archive the first time a
            # patch failed to apply. The archive exists to hold failures, so
            # the one row it must never choke on is a failure.
            def cell(v, fmt="{:.2f}"):
                return "-" if v is None else fmt.format(v)
            d = e.get("delta")
            print(f"{e['id']:<10} "
                  f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(e['at'])):<17} "
                  f"{cell(e.get('base')):>7} {cell(e.get('after')):>7} "
                  f"{cell(d, '{:+g}'):>7}  {e.get('note','')[:34]}")
        print("\nLosing attempts are kept on purpose. An archive of what failed "
              "is the record\nof what was tried, and DGM keeps variants "
              "precisely to avoid stagnating.")
        return 0

    if a.show:
        d = ARCHIVE / a.show
        if not d.is_dir():
            print(f"no attempt {a.show}", file=sys.stderr)
            return 1
        for f in ("note.txt", "expect.txt", "change.diff", "score.txt"):
            p = d / f
            if p.exists():
                print(f"----- {f} -----")
                print(p.read_text()[:3000])
        return 0

    if not a.patch and not a.cmd:
        print("give it something to try: --patch <file> or --cmd '<command>'",
              file=sys.stderr)
        return 2

    base = baseline()
    if not base:
        print("no baseline score. Run `fitness` first, or there is nothing to "
              "compare against.", file=sys.stderr)
        return 1

    group = hashlib.sha1(f"{time.time()}{a.patch}{a.cmd}".encode()).hexdigest()[:8]
    cands = []
    for i in range(a.n):
        aid = group if a.n == 1 else hashlib.sha1(f"{group}{i}".encode()).hexdigest()[:8]
        dest = ARCHIVE / aid
        dest.mkdir(parents=True, exist_ok=True)
        (dest / "note.txt").write_text(a.note or "(no note)")
        cands.append({"aid": aid, "wt": ROOT / ".worktrees" / f"evolve-{aid}", "dest": dest,
                      "ok": True, "detail": "", "after": None, "delta": None, "branch": None,
                      "judged": None, "counts": None, "diff_lines": 0, "gate": None})

    made = []
    try:
        for c in cands:
            print(f"attempt {c['aid']}, isolated in {c['wt']}")
            try:
                git("worktree", "add", "--detach", "-q", str(c["wt"]), "HEAD", check=True)
            except RuntimeError as e:
                print(f"could not create worktree: {e}", file=sys.stderr)
                return 1
            made.append(c["wt"])
        return attempt(a, base, group, cands)
    finally:
        # Remove only these worktrees, each by exact path.
        for wt in made:
            subprocess.run(["git", "-C", str(ROOT), "worktree", "remove",
                            "--force", str(wt)], capture_output=True)


def candidate_env(a, c):
    """The environment a candidate's change and its judge run in.

    Under --gate, or with more than one candidate, its declines wait in its
    own archive dir and reach declined.jsonl only if the gate keeps it. A
    single attempt without --gate keeps them the way it always did, because
    nothing will ever decide it was kept."""
    if a.gate or a.n > 1:
        return dict(os.environ, CHEWBACCA_PENDING_DECLINES=str(c["dest"] / "declines.jsonl"))
    return None


def run_change(a, c):
    """Apply the patch or run the command in one candidate's worktree.

    Never raises. It runs on a pool thread, and an exception there would end
    the whole run with no ledger row for any candidate, including ones that
    finished and cost a proposal each."""
    env = candidate_env(a, c)
    try:
        if a.patch:
            r = subprocess.run(["git", "-C", str(c["wt"]), "apply",
                                str(pathlib.Path(a.patch).resolve())],
                               capture_output=True, text=True)
            c["ok"], c["detail"] = r.returncode == 0, r.stderr[-400:]
        else:
            r = subprocess.run(a.cmd, shell=True, cwd=str(c["wt"]), env=env,
                               capture_output=True, text=True, errors="replace", timeout=1800)
            c["ok"], c["detail"] = r.returncode == 0, (r.stderr or r.stdout)[-400:]
    except subprocess.TimeoutExpired:
        c["ok"], c["detail"] = False, "timed out after 1800 s"
    except Exception as e:  # noqa: BLE001 - recorded on the candidate, see above
        c["ok"], c["detail"] = False, f"{type(e).__name__}: {e}"[:400]
    return c


def attempt(a, base, group, cands):
    """Judge before, change every candidate, judge after, rank, gate."""
    first = cands[0]
    if a.expect:
        # Before the change, on a clean HEAD, once: every candidate starts
        # from the same commit. A judge that already passes cannot tell a fix
        # from a no-op, so there is nothing to try.
        before, out, _ = expect(first["wt"], a.expect)
        for c in cands:
            (c["dest"] / "expect.txt").write_text(f"BEFORE (must fail)\n{out}\n")
        if before:
            print("  the judge already passes before any change: nothing to fix")
            for c in cands:
                c["ok"] = False
            return ledger(a, base, group, cands, judged_before=True)
    baseline_suite = None
    if a.gate:
        print("  running the suite on the unchanged commit (cached per commit)")
        baseline_suite = suite_before(first["wt"])

    if len(cands) > 1:
        print(f"  running the change in {len(cands)} worktrees at once")
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(cands)) as pool:
        list(pool.map(lambda c: run_change(a, c), cands))

    for c in cands:
        if not c["ok"]:
            if c["detail"]:
                print(f"  {c['aid']}: the change did not apply/run:\n  {c['detail']}")
            continue
        diff = full_diff(c["wt"])
        (c["dest"] / "change.diff").write_text(diff)
        c["diff_lines"] = changed_lines(diff)
        if a.expect:
            c["judged"], out, c["counts"] = expect(c["wt"], a.expect, candidate_env(a, c))
            with (c["dest"] / "expect.txt").open("a") as fh:
                fh.write(f"\nAFTER (must pass)\n{out}\n")
            print(f"  {c['aid']}: judge failed before, "
                  f"{'PASSES' if c['judged'] else 'still FAILS'} after{spread(c)}")

    ranked = rank_candidates(cands)
    if len(cands) > 1:
        ran = sum(c["ok"] for c in cands)
        print(f"\n  {len(ranked)} of {len(cands)} candidates "
              f"{'passed the judge' if a.expect else 'ran'}"
              + (f" ({len(cands) - ran} did not run)" if ran < len(cands) else ""))
        if 0 < len(ranked) < len(cands):
            print("  Not every sample fixed it, so the fix is not reliable yet, "
                  "whichever one is kept.")
        for i, c in enumerate(ranked, 1):
            print(f"    {i}. {c['aid']}{spread(c)}, {c['diff_lines']} changed lines")

    # Under --gate only the ranked are scored and gated, best first, and the
    # first the gate allows is kept: the suite is 15 to 20 minutes a run, and
    # a change the judge still fails would be refused whatever the suite
    # said. Without --gate every candidate that ran is scored.
    if a.gate:
        for c in cands:
            if c["ok"] and c["judged"] is False:
                why = "the judge (--expect) still fails after the change, so the suite was not run"
                c["gate"] = {"allowed": False, "reasons": [why]}
                print(f"\n  {c['aid']}  GATE: refused.\n    {why}")
        todo = ranked
    else:
        todo = [c for c in cands if c["ok"]]
    for c in todo:
        c["after"], out = score_in(c["wt"])
        (c["dest"] / "score.txt").write_text(out or "")
        c["delta"] = (round(c["after"] - base["structural_score"], 2)
                      if c["after"] is not None else None)
        print(f"\n  {c['aid']}")
        print(f"  base  {base['structural_score']:.2f}  ({base['sha']})")
        print(f"  after {c['after'] if c['after'] is None else format(c['after'], '.2f')}")
        if c["delta"] is not None:
            verdict = ("BETTER" if c["delta"] > 0 else
                       "WORSE" if c["delta"] < 0 else "NO MEASURABLE CHANGE")
            print(f"  delta {c['delta']:+g}   {verdict}")
        if not a.gate:
            continue
        allowed, reasons = gate(c["wt"], base, c["after"], c["judged"], baseline_suite)
        c["gate"] = {"allowed": allowed, "reasons": reasons}
        print()
        if not allowed:
            print("  GATE: refused.")
            for why in reasons:
                print(f"    {why}")
            continue
        print("  GATE: passes.")
        for why in reasons:
            print(f"    note: {why}")
        kept = keep_declines(c["dest"])
        if kept:
            print(f"  kept its {kept} decline(s) in the loop's declined.jsonl")
        if a.branch:
            c["branch"] = commit_branch(c["wt"], c["aid"], a.note)
        print(f"\n  Nothing has been merged. The diff is at:")
        print(f"    {c['dest'] / 'change.diff'}")
        if c["branch"]:
            print(f"  and committed on {c['branch']}, for a person to read and merge.")
        else:
            print("  Read it, then apply it yourself:")
            print(f"    git apply {c['dest'] / 'change.diff'}")
        break
    return ledger(a, base, group, cands)


def spread(c):
    held = (c.get("counts") or {}).get("held")
    return f", held out {held[0]}/{held[1]}" if held and held[1] else ""


def ledger(a, base, group, cands, judged_before=False):
    order = {c["aid"]: i for i, c in enumerate(rank_candidates(cands), 1)}
    with LEDGER.open("a") as fh:
        for c in cands:
            judged = ({"cmd": a.expect, "before": judged_before, "after": c["judged"]}
                      if a.expect else None)
            fh.write(json.dumps({
                "id": c["aid"], "at": time.time(), "applied": c["ok"],
                "base": base["structural_score"], "base_sha": base["sha"],
                "after": c["after"], "delta": c["delta"], "note": a.note,
                "expect": judged, "branch": c["branch"],
                "group": group, "n": len(cands), "rank": order.get(c["aid"]),
                "counts": c["counts"], "diff_lines": c["diff_lines"],
                "gate": c["gate"],
            }) + "\n")
    for c in cands:
        print(f"\narchived: {c['dest']}")
    print("NOT MERGED. The score is coverage and conformance, not quality, so "
          "a rise\ncan still be a worse kit. Read the diff and decide.")
    return 0

if __name__ == "__main__":
    sys.exit(main())
