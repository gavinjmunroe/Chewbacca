# ── Server (runtime) ──────────────────────────────────────────
# Railway Postgres connection string. Internal *.railway.internal
# hosts skip TLS automatically (see server/db.js).
DATABASE_URL=

# Google OAuth client used to verify ID tokens server-side.
# Falls back to the checked-in public client ID in server/verify.js.
GOOGLE_CLIENT_ID=

# Google Workspace domain allowed to sign in.
ALLOWED_DOMAIN=bluemodernadvisory.com

# Only for local runs against Railway's public Postgres proxy:
# DATABASE_SSL_INSECURE=1

# Railway injects PORT in production:
# PORT=3000

# ── Frontend (Vite, baked into the bundle at BUILD time) ──────
# Same value as GOOGLE_CLIENT_ID; used by the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=

# Shared password for the /bma-login -> /team portal.
# Note: this ships in the client bundle (client-side check).
VITE_PORTAL_PASSWORD=

# Where "Back to main site" links point:
# VITE_MARKETING_URL=https://bluemodernadvisory.com

# ── Togari dashboard ──────────────────────────────────────────
# GCP project holding the Togari BigQuery datasets.
GCP_PROJECT_ID=midyear-glazing-485303-u3

# Base64-encoded service-account JSON with BigQuery read access.
GCP_CREDENTIALS_BASE64=

# Togari platform MCP endpoint (the togari-platform /mcp URL).
TOGARI_MCP_URL=

# Bearer token; matches MCP_BEARER_TOKEN on togari-platform.
TOGARI_MCP_TOKEN=

# Brand and owner scoping for Togari queries.
TOGARI_BRAND=bma
TOGARI_OWNER_ID=sagar
