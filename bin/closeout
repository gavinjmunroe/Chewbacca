#!/usr/bin/env python3
"""Answer "is it safe to close this tab" from evidence, never from confidence.

WHY THIS EXISTS. On 2026-09-21, after a ten hour session, the question was
asked directly: "We good to close this tab? Don't answer that based on vibes."

It was the right question, because for most of that session the answer would
have come from feel. Three separate times a fix was reported as done and the
next screenshot showed the same bug; once, several rounds of "fixed" were
claimed while the code path in question was not even running, because a
texture upload had failed silently and the old path had taken over.

A closing question has a factual answer. Every condition below is something a
command can decide, so none of them need an opinion:

    is anything uncommitted          git status
    is anything unpushed             git rev-list
    do the gates pass                run them
    was the lesson written down      git log on the notes
    is debug scaffolding still in    git grep

Prints every check with the evidence that decided it, and exits non-zero on
the first thing that is not true. On a full pass it writes a receipt naming
the exact commits it passed against, so a claim made afterwards can be tied
to a specific verified state rather than to a memory of having run it.

    closeout            check, print, write a receipt on success; the gates
                        run only the suite checks that name what changed
    closeout --all      the same, with every group of the suite as the gates
    closeout --fast     the git half in about a second, gates reused only
                        from a pass on this exact tree
    closeout --quiet    receipt only, for hooks

Every check prints the moment it is decided, with its evidence. The first
version printed only at the end, so `closeout | tail` sat blank for four
minutes on 2026-09-26, got killed, and the question never got an answer.

SCOPED GATES (CHW-153). "that thing is so wack and takes forever", Caleb,
2026-10-07. Every closeout ran all 26 groups, six minutes at best and far more
under load, and the kit takes about 87 commits a day, so a pass keyed to one
commit was stale by the next closeout and --fast almost never had anything to
reuse. Now the gates are the check lines in tests/run.sh that name a file
changed since the last pass (or a test named after one), each run alone with
the suite's own hermetic preamble, plus a syntax check of every changed file.
A check that cannot run alone pulls in its whole group. `--all` is the old
behaviour.

A static import graph was tried first and rejected: at two hops every group
reached 1,300 to 1,600 of the 1,641 tracked files through hubs like
bin/chewbacca and setup.sh, so it selected all 26 groups for 78 of the last 80
commits, even a one-line team task.
"""

from __future__ import annotations

import concurrent.futures as cf
import fnmatch
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import threading
import time
from pathlib import Path

KIT = Path(__file__).resolve().parent.parent
BRAIN = Path.home() / "second-brain"
STATE = Path(os.environ.get("CHEWBACCA_HOME", str(Path.home() / ".chewbacca"))).expanduser()
RECEIPT = STATE / "closeout-receipt.json"

# How long a receipt is worth anything. Long enough to write a closing
# message, short enough that it cannot be reused tomorrow.
RECEIPT_TTL_S = 900
# What the gates said for one exact kit tree. Gates read only the committed
# tree, so a pass on this tree with a clean checkout stays a pass until either
# changes; --fast reuses it rather than running the suite again.
GATES = STATE / "closeout-gates.json"
# Paths no gate reads. Same list as the CI workflow's paths-ignore: team board
# edits are one-file commits to main, 140 of them the day the board landed,
# and none of them can break a script. Without this every board edit by any
# tab threw away the last pass.
INERT = ("team/",)


def run(args: list[str], cwd: Path, timeout: int = 60) -> tuple[int, str]:
    """A git query is quick; the gates are not. See the `gates` check, which
    asks for its own budget. 180 seconds was the first guess and the full
    suite blew straight through it, which reports as a failure and is really
    an unknown. An unknown answer is exactly the thing this command exists to
    refuse to give."""
    try:
        p = subprocess.run(
            args, cwd=cwd, capture_output=True, text=True, timeout=timeout
        )
        return p.returncode, (p.stdout + p.stderr).strip()
    except FileNotFoundError:
        return 127, "not found: " + args[0]
    except subprocess.TimeoutExpired:
        return 124, "timed out, so this check has no answer rather than a pass"


def head(repo: Path) -> str:
    code, out = run(["git", "rev-parse", "HEAD"], repo)
    return out[:12] if code == 0 else "?"


def tree_clean(repo: Path) -> bool:
    code, out = run(["git", "status", "--porcelain", "--untracked-files=no"], repo)
    return code == 0 and not out.strip()


def tree_key(repo: Path) -> str | None:
    """The committed tree minus INERT paths, or None when the checkout is dirty."""
    if not tree_clean(repo):
        return None
    code, out = run(["git", "ls-tree", "-r", "HEAD"], repo)
    if code != 0:
        return None
    live = [ln for ln in out.splitlines()
            if not ln.split("\t", 1)[-1].startswith(INERT)]
    return hashlib.sha256("\n".join(live).encode()).hexdigest()[:16]


def load_gates() -> dict:
    try:
        d = json.loads(GATES.read_text())
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


# Guessed from the load incident above, never tuned: three leaves headroom.
GATE_WORKERS = 3


def stem(path: str) -> str:
    """tests/test_vibe_guard.py, .claude/hooks/vibe-guard.sh -> vibe_guard."""
    s = path.rsplit("/", 1)[-1].lower().replace("-", "_")
    s = re.sub(r"\.(sh|py|js|mjs|ts|swift)$", "", s)
    s = re.sub(r"^test_", "", s)
    return re.sub(r"_test$", "", s)


class Scope:
    """The suite's check lines, as units that can run one at a time.

    A unit is one top-level `check`/`expect`/`exits` line inside a group. It
    runs in its own bash with the suite's own preamble (the hermetic TMP,
    PEOPLE_DIR, CHEWBACCA_NO_SEND=1 and the helper functions), cut out of
    run.sh rather than copied here, so a new export there applies here too.
    """

    UNIT = re.compile(r"^  (check|expect|exits)\s")
    GROUP = re.compile(r'^\s*(?:if\s+)?group\s+"([^"]+)"')
    REF = re.compile(r'\$\{?ROOT\}?"?/([A-Za-z0-9_.\-/]+)')
    GLOB = re.compile(r'^\s*for\s+\w+\s+in\s+"?\$\{?ROOT\}?"?/([^\s;]+)')

    def __init__(self, suite: Path) -> None:
        self.suite = suite
        try:
            text = suite.read_text(encoding="utf-8", errors="replace")
        except OSError:
            text = ""
        lines = text.splitlines()
        start = next((i for i, ln in enumerate(lines)
                      if re.match(r'^TMP="\$\(mktemp -d\)"', ln)), None)
        first = next((i for i, ln in enumerate(lines) if self.GROUP.match(ln)), None)
        self.preamble = ("\n".join(lines[start:first])
                         if start is not None and first is not None and start < first
                         and "check()" in "\n".join(lines[start:first]) else None)
        allowed = {"ROOT", "TMP", "HOME"}
        if self.preamble:
            allowed |= set(re.findall(r"^export (\w+)=", self.preamble, re.M))
        # (group, line, standalone) per check line, and per-group glob loops.
        self.units: list[tuple[str, str, bool]] = []
        self.globs: list[tuple[str, str]] = []
        # Paths named anywhere in a group outside a runnable unit: a check
        # nested in a loop, the second line of a continued one, the body of a
        # `bash -c '...'`. Naming a changed file there runs the whole group.
        self.loose: dict[str, set[str]] = {}
        self.loose_lines: dict[str, set[str]] = {}
        group = None
        body = lines[first or 0:] if first is not None else []
        i = 0
        while i < len(body):
            ln = body[i]
            i += 1
            m = self.GROUP.match(ln)
            if m:
                group = m.group(1)
                self.loose.setdefault(group, set())
                self.loose_lines.setdefault(group, set())
                continue
            if group is None:
                continue
            g = self.GLOB.match(ln)
            if g:
                self.globs.append((group, g.group(1).replace('"', "")))
            if self.UNIT.match(ln):
                stmt = [ln]
                # Backslash continuations are one statement; run alone with
                # only its first line, `check` would get no command and pass.
                while stmt[-1].rstrip().endswith("\\") and i < len(body):
                    stmt.append(body[i])
                    i += 1
                text = "\n".join(stmt)
                used = set(re.findall(r"\$\{?([A-Za-z_]\w*)", text)) - allowed
                self.units.append((group, text.strip(), not used))
                if used:
                    self.loose[group].update(self.refs(text))
            else:
                self.loose[group].update(self.refs(ln))
                self.loose_lines[group].add(ln.strip())

    @classmethod
    def refs(cls, text: str) -> list[str]:
        return [r.rstrip(".") for r in cls.REF.findall(text)]

    def select(self, touched: list[str], added: set[str]
               ) -> tuple[list[tuple[str, str]], list[str], list[str]]:
        """(units to run alone as (group, line), whole groups to run, and
        pytest-only test files the suite reaches only through its pytest group)."""
        tset = set(touched)
        stems = {stem(t) for t in touched if len(stem(t)) >= 3}
        root = self.suite.parent.parent
        mention: dict[str, bool] = {}

        def names_touched(ref: str, deep: bool = True) -> bool:
            """The check names a changed file, a test named after one, or a
            script whose own text names one (tools/checksums.py names
            SHA256SUMS.txt; bin/chewbacca names every subcommand it routes).

            Not deep for a whole group: setup.sh names nearly every file in
            the kit, so following it put the installer groups, 90 s each, on
            every closeout. A group follows only its tests' own text."""
            if ref in tset:
                return True
            s = stem(ref)
            if ref.startswith("tests/") and any(s == t or s.startswith(t + "_") for t in stems):
                return True
            if not deep and not ref.startswith("tests/"):
                return False
            if ref not in mention:
                try:
                    text = (root / ref).read_text(encoding="utf-8", errors="replace")
                except OSError:
                    text = ""
                mention[ref] = any(t in text for t in tset)
            return mention[ref]

        alone: list[tuple[str, str]] = []
        groups: list[str] = []
        for group, refs in self.loose.items():
            if any(names_touched(r, deep=False) for r in refs) or \
                    (added & self.loose_lines.get(group, set())) - {""}:
                groups.append(group)
        for group, line, standalone in self.units:
            refs = self.refs(line)
            added_here = any(ln.strip() in added for ln in line.splitlines())
            if not (added_here or any(names_touched(r) for r in refs)):
                continue
            # An opening quote that closes lines later fails to parse alone.
            if standalone and self.preamble and \
                    run(["bash", "-n", "-c", line], root)[0] == 0:
                alone.append((group, line))
            # Same shallow rule as above for a whole group: a dirty AGENTS.md
            # pulled in `doctor`, 432 s under load, through a script that
            # merely mentions it.
            elif group not in groups and (added_here or any(
                    names_touched(r, deep=False) for r in refs)):
                groups.append(group)
        for group, pattern in self.globs:
            if group not in groups and any(fnmatch.fnmatch(t, pattern) for t in touched):
                groups.append(group)
        # A unit whose whole group runs anyway would only run twice.
        alone = [(g, ln) for g, ln in alone if g not in groups]
        # A test_*.py the suite never names runs only inside the pytest group,
        # about 300 s; run just that file under pytest instead.
        named = {r for refs in self.loose.values() for r in refs}
        named |= {r for _, line, _ in self.units for r in self.refs(line)}
        tests_dir = root / "tests"
        pytest_only = sorted(
            f"tests/{p.name}" for p in tests_dir.glob("test_*.py")
            if f"tests/{p.name}" not in named
            and (f"tests/{p.name}" in tset or stem(p.name) in stems)
        ) if tests_dir.is_dir() else []
        return alone, groups, pytest_only

    def script(self, group: str, line: str) -> str:
        root = self.suite.parent.parent
        return "\n".join([
            "set -uo pipefail",
            f"ROOT={shlex.quote(str(root))}",
            "GRN=; RED=; DIM=; BLD=; NC=; PASS=0; FAIL=0; SKIP=0; ONLY=",
            "declare -a FAILURES=()",
            self.preamble or "",
            f"CURRENT={shlex.quote(group)}",
            line,
            'exit "$FAIL"',
        ])


def pytest_cmd() -> list[str] | None:
    """The same pytest the suite's pytest group finds: installed, else via uv."""
    if run(["python3", "-c", "import pytest"], KIT)[0] == 0:
        return ["python3", "-m", "pytest"]
    if run(["uv", "--version"], KIT)[0] == 0:
        return ["uv", "run", "--no-project", "--with", "pytest", "python", "-m", "pytest"]
    return None


def syntax_cmd(path: Path) -> list[str] | None:
    """A parse-only check for one changed file, or None when there is none."""
    name = path.name
    try:
        first = path.open("rb").readline(200).decode("utf-8", "replace")
    except OSError:
        return None
    if name.endswith(".py") or ("python" in first and first.startswith("#!")):
        return ["python3", "-c",
                "import ast,sys; ast.parse(open(sys.argv[1],encoding='utf-8').read(), sys.argv[1])",
                str(path)]
    if name.endswith((".sh", ".bash")) or (first.startswith("#!") and "bash" in first) \
            or first.startswith("#!/bin/sh"):
        return ["bash", "-n", str(path)]
    if name.endswith((".js", ".mjs", ".cjs")) or ("node" in first and first.startswith("#!")):
        return ["node", "--check", str(path)]
    if name.endswith(".json"):
        return ["python3", "-c", "import json,sys; json.load(open(sys.argv[1],encoding='utf-8'))",
                str(path)]
    return None


class Checks:
    def __init__(self, quiet: bool = False) -> None:
        self.failures: list[str] = []
        self.lines: list[str] = []
        self.quiet = quiet
        self._lock = threading.Lock()

    def say(self, text: str) -> None:
        if not self.quiet:
            with self._lock:
                print(text, flush=True)

    def record(self, ok: bool | None, name: str, evidence: str) -> None:
        """ok None is UNKNOWN: not a pass, and said so rather than guessed."""
        mark = {True: "  PASS  ", False: "  FAIL  ", None: "  ????  "}[ok]
        new = [mark + name] + ["          " + line for line in evidence.splitlines()[:6] if evidence]
        with self._lock:
            self.lines += new
            if not self.quiet:
                print("\n".join(new), flush=True)
            if ok is not True:
                self.failures.append(name)

    # ── the checks ───────────────────────────────────────────────────────

    def clean(self, repo: Path, label: str) -> None:
        if not (repo / ".git").exists():
            self.record(True, f"{label}: not a repo, skipped", "")
            return
        # Tracked changes only. An untracked file is often scratch, and a
        # workspace full of other projects reports hundreds of them; that
        # noise is what made the old stop hook ignorable.
        code, out = run(["git", "status", "--porcelain"], repo)
        dirty = [ln for ln in out.splitlines() if ln and not ln.startswith("??")]
        self.record(
            not dirty,
            f"{label}: no uncommitted tracked changes",
            "\n".join(dirty) if dirty else "git status --porcelain: clean",
        )

    def pushed(self, repo: Path, label: str) -> None:
        if not (repo / ".git").exists():
            return
        code, _ = run(
            ["git", "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"], repo
        )
        if code != 0:
            self.record(False, f"{label}: branch has no upstream", "nothing tracked")
            return
        _, out = run(["git", "rev-list", "--count", "@{u}..HEAD"], repo)
        ahead = out.strip() or "?"
        self.record(
            ahead == "0",
            f"{label}: nothing unpushed",
            f"git rev-list @{{u}}..HEAD: {ahead} commit(s) ahead",
        )

    def gates(self, quiet: bool = False, everything: bool = False) -> None:
        """Run the gates: the checks that name what changed, fanned out.

        "Nothing should ever take that long bruh, you have graph engineering
        and the ability to intelligently split things up."

        The suite is independent check lines grouped into 26 groups with no
        edges between them. Fanning the groups out took closeout from ten
        minutes to six, and six was still the slowest group (pytest, about
        300 s) plus the queue behind it, on every closeout, for a change to
        one file. The finer partition is the check line: run only the lines
        that name a changed file, each in its own process, three at a time.
        """
        suite = KIT / "tests" / "run.sh"
        if not suite.exists():
            self.record(True, "gates: no suite present, skipped", "")
            return
        key = tree_key(KIT)
        last = load_gates()
        if not everything and key and last.get("key") == key:
            when = time.strftime("%H:%M", time.localtime(last.get("at", 0)))
            self.record(True, f"gates: passed on this tree at {when}, reused",
                        f"{last.get('scope', 'all')} pass on {last.get('kit')}, "
                        f"{last.get('ran')} job(s), {last.get('seconds')}s")
            return

        groups = self.groups(suite)
        scope = Scope(suite)
        started = time.time()
        jobs: list[tuple[str, list[str], str | None]] = []   # label, argv, script
        if everything or not groups or not scope.preamble:
            if not groups:
                code, out = run(["bash", str(suite)], KIT, timeout=900)
                self.record(code == 0, "gates: tests/run.sh passes",
                            "\n".join(out.splitlines()[-4:]) or f"exit {code}")
                if code == 0 and key:
                    self.save_gates(key, "all", 1, time.time() - started)
                return
            jobs = [(g, ["bash", str(suite), g], None) for g in groups]
            label = f"{len(groups)} groups"
            scope_name = "all"
        else:
            touched, base, added = self.touched()
            alone, whole, pyonly = scope.select(touched, added)
            for g in whole:
                jobs.append((g, ["bash", str(suite), g], None))
            if pyonly:
                py = pytest_cmd()
                if not py:
                    # The suite's pytest group skips the same way.
                    self.say(f"  skip  pytest: {', '.join(pyonly)} (no pytest and no uv)")
                if py:
                    # Exit 5 is "collected nothing": a script-mode file with no
                    # test functions, which the pytest group also passes.
                    jobs.append((f"pytest: {', '.join(pyonly)}", ["bash", "-c",
                                 '"$@"; c=$?; [ "$c" = 5 ] && exit 0; exit "$c"', "pytest",
                                 *py, *pyonly, "-q"], None))
            for g, line in alone:
                name = re.match(r'^\w+\s+"([^"]*)"', line)
                jobs.append((f"{g}: {name.group(1) if name else line[:50]}",
                             ["bash", "-c", scope.script(g, line)], None))
            # Parses take milliseconds; queued behind a 100 s group they held
            # 62 lines of output back until the end on the first timed run.
            jobs[:0] = [(f"parses: {t}", cmd, None) for t in touched
                        for cmd in [syntax_cmd(KIT / t)] if cmd]
            label = (f"{len(touched)} file(s) changed since "
                     f"{base or 'midnight'}: {len(alone)} check(s), "
                     f"{len(whole)} group(s), {sum(1 for j in jobs if j[0].startswith('parses:'))} parse(s)")
            scope_name = "touched"
            self.say(f"  ....  gates: {label}")
            if not jobs:
                self.record(True, "gates: nothing changed that a check names",
                            f"{len(touched)} file(s) changed since {base or 'midnight'}")
                if key:
                    self.save_gates(key, scope_name, 0, time.time() - started)
                return

        failed: list[str] = []
        detail: list[str] = []
        # Bounded well under the core count. Six local jobs took this Mac's
        # load to 50 on 2026-09-22 (memory feedback_one_job_not_six), and the
        # hud group's tests race real timers, so contention turns into flakes.
        # Whole groups first: they are the long poles.
        with cf.ThreadPoolExecutor(max_workers=min(len(jobs), GATE_WORKERS)) as pool:
            futures = {pool.submit(run, argv, KIT, 600): lbl for lbl, argv, _ in jobs}
            done_n = 0
            for fut in cf.as_completed(futures):
                lbl = futures[fut]
                code, out = fut.result()
                done_n += 1
                if code != 0:
                    failed.append(lbl)
                    lines = [ln.strip() for ln in out.splitlines() if ln.strip()]
                    hits = [ln[2:] for ln in lines if ln.startswith("- ")] or \
                        [ln for ln in lines if ln.startswith("FAIL")] or lines[-2:]
                    detail += [f"{lbl}: {h}" for h in hits[:3]]
                # SAY SO AS IT LANDS. "Closeout taking too long bruh, break it
                # up into more steps." Silence and then one verdict is the
                # same information delivered in the worst possible shape.
                # A passing parse is one line of noise per changed file.
                if not quiet and not (code == 0 and lbl.startswith("parses: ")):
                    mark = "ok  " if code == 0 else "FAIL"
                    self.say(f"  {mark}  [{done_n}/{len(jobs)}] {lbl}"
                             f"  {time.time() - started:.0f}s")
        secs = time.time() - started
        self.record(
            not failed,
            f"gates: {label}, {secs:.0f}s",
            "\n".join(detail[:5]) if detail else f"all {len(jobs)} green",
        )
        if not failed and key:
            self.save_gates(key, scope_name, len(jobs), secs)

    @staticmethod
    def save_gates(key: str, scope: str, ran: int, secs: float) -> None:
        GATES.parent.mkdir(parents=True, exist_ok=True)
        GATES.write_text(json.dumps({"kit": head(KIT), "key": key, "at": time.time(),
                                     "scope": scope, "ran": ran,
                                     "seconds": round(secs)}))

    def touched(self) -> tuple[list[str], str | None, set[str]]:
        """Files changed since the last pass, the base it was taken from, and
        any check lines added to the suite since then.

        The base is the commit the last pass ran on, when it is an ancestor of
        HEAD; every pass covered what changed before it, so the diff from it
        is what nothing has checked yet. With no usable pass, today's commits.
        """
        base = load_gates().get("kit")
        names: list[str] = []
        if base and run(["git", "merge-base", "--is-ancestor", base, "HEAD"], KIT)[0] == 0:
            _, out = run(["git", "diff", "--name-only", base, "HEAD"], KIT)
            names = out.splitlines()
            _, diff = run(["git", "diff", "-U0", base, "HEAD", "--", "tests/run.sh"], KIT)
        else:
            base = None
            _, out = run(["git", "log", "--since=midnight", "--name-only", "--format="], KIT)
            names = out.splitlines()
            _, first = run(["git", "log", "--since=midnight", "--reverse", "--format=%H"], KIT)
            start = first.split("\n", 1)[0].strip()
            diff = run(["git", "diff", "-U0", start + "^", "HEAD", "--", "tests/run.sh"],
                       KIT)[1] if start else ""
        _, dirty = run(["git", "diff", "--name-only", "HEAD"], KIT)
        names += dirty.splitlines()
        # Bare keywords match every group: one added `fi` selected all three
        # groups of the test fixture.
        filler = {"", "fi", "done", "esac", "then", "do", "else", "}", "{", ";;"}
        added = {ln[1:].strip() for ln in diff.splitlines()
                 if ln.startswith("+") and not ln.startswith("+++")
                 and ln[1:].strip() not in filler and not ln[1:].strip().startswith("#")}
        seen: list[str] = []
        for n in names:
            n = n.strip()
            if n and n not in seen and not n.startswith(INERT) and (KIT / n).is_file():
                seen.append(n)
        return seen, (base[:12] if base else None), added

    def gates_cached(self) -> None:
        """The fast path's gates: a pass on this exact tree, or unknown."""
        d = load_gates()
        key = tree_key(KIT)
        if key and d.get("key") == key:
            when = time.strftime("%H:%M", time.localtime(d.get("at", 0)))
            self.record(True, f"gates: passed on {d.get('kit')} at {when}, reused",
                        f"{d.get('scope', 'all')} pass, {d.get('ran')} job(s), "
                        f"{d.get('seconds')}s, same tree, clean checkout")
        else:
            self.record(None, "gates: not run on this commit",
                        f"last pass was on {d.get('kit') or 'nothing'}; "
                        "`closeout` without --fast runs them")

    @staticmethod
    def groups(suite: Path) -> list[str]:
        """Group names, read from the suite rather than hardcoded here.

        Hardcoding them would mean a group added later silently never runs,
        which is the same shape as a hook that ships without being registered.
        """
        try:
            text = suite.read_text(encoding="utf-8", errors="replace")
        except OSError:
            return []
        # Every group in run.sh is written `if group "name"; then`. The old
        # pattern required `group` at the start of the line, matched 0 of 16,
        # and closeout silently fell back to one sequential 900s run: 9 to 14
        # minutes per closeout, seen twice on 2026-09-28 (BACKLOG 116).
        found = re.findall(r'^\s*(?:if\s+)?group\s+"([^"]+)"', text, re.M)
        seen, out = set(), []
        for g in found:
            if g not in seen:
                seen.add(g)
                out.append(g)
        return out

    def lesson_written(self) -> None:
        """Code changed today means a lesson was written down today.

        The standing rule is that a session does not close until what it
        learned is in the kit. That is checkable: if the kit has commits from
        today, something under the notes or the rules should have one too.
        """
        _, kit_today = run(
            ["git", "log", "--since=midnight", "--oneline"], KIT
        )
        if not kit_today.strip():
            self.record(True, "lesson: no code committed today, nothing owed", "")
            return
        found = []
        for repo, paths in ((BRAIN, ["memory"]), (KIT, [".claude/rules", "skills"])):
            if not (repo / ".git").exists():
                continue
            _, out = run(
                ["git", "log", "--since=midnight", "--oneline", "--"] + paths, repo
            )
            if out.strip():
                found.append(f"{repo.name}: {len(out.splitlines())} commit(s)")
        self.record(
            bool(found),
            "lesson: today's learning is written down",
            "; ".join(found) if found else
            f"{len(kit_today.splitlines())} kit commits today, none touching "
            "memory/ or rules/",
        )

    def board_updated(self) -> None:
        """A project decision recorded in memory today belongs on the team board too.

        2026-10-06: a session produced three product decisions and filed them
        in memory only, and Caleb had to ask: "update the chewb shared todo. I
        should never have to say this ever again." The board is what Gavin,
        Jake and Semyon read; a decision only in his private memory never
        reaches them.
        """
        if not (BRAIN / ".git").exists():
            self.record(True, "board: no brain, nothing owed", "")
            return
        _, proj = run(["git", "log", "--since=midnight", "--name-only",
                       "--format=", "--", "memory"], BRAIN)
        touched = sorted({ln for ln in proj.splitlines() if "/project_" in ln})
        if not touched:
            self.record(True, "board: no project decisions recorded today", "")
            return
        run(["git", "fetch", "-q", "origin", "main"], KIT)
        _, board = run(["git", "log", "origin/main", "--since=midnight",
                        "--oneline", "--", "team/tasks"], KIT)
        self.record(
            bool(board.strip()),
            "board: today's project decisions are on the team board",
            f"{len(board.splitlines())} board commit(s) today" if board.strip() else
            f"project notes changed today ({', '.join(Path(t).stem for t in touched[:3])}) "
            "and no team/tasks commit on origin/main: run `team add`",
        )

    def no_scaffolding(self) -> None:
        """Debug scaffolding left in tracked source is not a finished session."""
        markers = ["PROBE:", "XXX-debug", "console.warn('dbg"]
        hits: list[str] = []
        for m in markers:
            _, out = run(["git", "grep", "-n", "--", m], KIT)
            hits += [ln for ln in out.splitlines() if ln.strip()]
        # This file names the markers in its own docstring; do not count that.
        hits = [h for h in hits if not h.startswith("bin/closeout:")]
        self.record(
            not hits,
            "source: no debug scaffolding committed",
            "\n".join(hits) if hits else "git grep: none of " + ", ".join(markers),
        )


def main() -> int:
    quiet = "--quiet" in sys.argv
    fast = "--fast" in sys.argv
    everything = "--all" in sys.argv
    c = Checks(quiet)
    if not quiet:
        print("closeout: is it safe to close this tab"
              + (" (fast)" if fast else " (all groups)" if everything else ""), flush=True)

    # No edges between any of these: each reads its own repo and decides one
    # line. They ran one after another, the board check's `git fetch` waiting
    # on the scaffolding greps, and the gates waited on all of them. Now the
    # git half and the gates start together and each line prints as it lands.
    git_half = [
        lambda: c.clean(KIT, "kit"),
        lambda: c.pushed(KIT, "kit"),
        lambda: c.clean(BRAIN, "brain"),
        lambda: c.pushed(BRAIN, "brain"),
        c.lesson_written,
        c.board_updated,
        c.no_scaffolding,
    ]
    with cf.ThreadPoolExecutor(max_workers=len(git_half) + 1) as pool:
        futs = [pool.submit(f) for f in git_half]
        futs.append(pool.submit(c.gates_cached) if fast
                    else pool.submit(c.gates, quiet, everything))
        for f in futs:
            f.result()

    if not quiet:
        print()

    if c.failures:
        if not quiet:
            print("NOT SAFE TO CLOSE. " + str(len(c.failures)) + " check(s) not passed:")
            for f in c.failures:
                print("  - " + f)
        RECEIPT.unlink(missing_ok=True)
        return 1

    RECEIPT.parent.mkdir(parents=True, exist_ok=True)
    RECEIPT.write_text(
        json.dumps(
            {
                "at": time.time(),
                "kit": head(KIT),
                "brain": head(BRAIN),
                "checks": len(c.lines),
                "fast": fast,
            }
        )
    )
    if not quiet:
        print("SAFE TO CLOSE. Receipt written to " + str(RECEIPT))
        print("  kit   " + head(KIT))
        print("  brain " + head(BRAIN))
    return 0


def receipt_valid() -> tuple[bool, str]:
    """Used by the Stop hook. A receipt is only worth the state it names."""
    try:
        d = json.loads(RECEIPT.read_text())
    except Exception:
        return False, "no closeout receipt exists"
    age = time.time() - float(d.get("at", 0))
    if age > RECEIPT_TTL_S:
        return False, f"the closeout receipt is {int(age / 60)} minutes old"
    if d.get("kit") != head(KIT):
        return False, "the kit has moved since closeout ran"
    if (BRAIN / ".git").exists() and d.get("brain") != head(BRAIN):
        return False, "the brain has moved since closeout ran"
    return True, "receipt matches the current commits"


if __name__ == "__main__":
    if "--check-receipt" in sys.argv:
        ok, why = receipt_valid()
        print(why)
        sys.exit(0 if ok else 1)
    sys.exit(main())
