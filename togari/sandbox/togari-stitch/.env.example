# ============================================================================
# Togari Healthcare MCP Server — Local Development Environment
# Copy to .env and fill in values. Never commit the .env file.
# ============================================================================

# Server
NODE_ENV=development
PORT=4200

# Tenant (used in stdio mode when no JWT)
TENANT_ID=org_dev_local
TENANT_TIER=pro

# GCP
GCP_PROJECT_ID=midyear-glazing-485303-u3
GCP_STORAGE_BUCKET=togari-healthcare-files

# Firestore (CRUD datastore — uses ADC on Cloud Run, GOOGLE_APPLICATION_CREDENTIALS locally)
# FIRESTORE_DATABASE_ID=            # optional: named database (defaults to "(default)")
# Local dev: set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Required IAM role: roles/datastore.user on the service account

# Anthropic (required for normalize_data; other tools degrade gracefully without it)
ANTHROPIC_API_KEY=

# Structify (optional — used for AI extraction features in process_file only)
STRUCTIFY_API_KEY=
STRUCTIFY_BASE_URL=https://api.structify.com/v1

# Exa (optional — for enrichment & web search)
EXA_API_KEY=

# Clay (optional — for enrichment)
CLAY_API_KEY=
CLAY_BASE_URL=https://api.clay.com/v1
CLAY_TABLE_ID=

# Auth0 (optional in dev — required in production HTTP mode)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Redis (optional in dev — falls back to in-memory rate limiting)
REDIS_URL=

# Sentry (optional — for error tracking)
SENTRY_DSN=

# n8n (optional — for workflow webhooks)
N8N_WEBHOOK_URL=
