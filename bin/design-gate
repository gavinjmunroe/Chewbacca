#!/usr/bin/env python3
"""Refuse a design that has never been looked at. Exit 2 means stop.

WHY. On 2026-09-23 a page shipped with its hero and its next scene rendered
on top of each other, body text crossing a 42-cell grid, unreadable. Caleb
sent the screenshot. Every generative rule in the kit had been followed: the
components came from the taxonomy, the tokens were consistent, ink was in
band, no stagger exceeded 400ms. The page was still garbage.

The audit afterwards found why, and it was structural rather than a slip:

  - NO hook in the kit reads a rendered image. Not one.
  - design-context.sh INJECTS constants and gates nothing.
  - crafts/interface.md has no verification step at all.
  - the `interface` skill's five steps end at "build the three states".

The entire design system is feed-forward. It can say what to do and has no
way to say what was done. `feedback_the_screenshot_beat_the_code` recorded
this exact lesson on 2026-09-21, two days earlier, and changed nothing,
because a memory is prose and prose does not fail CI. Per
`feedback_enforce_dont_document` and `feedback_advisory_hooks_do_nothing`:
exit 2, or it is decoration.

WHAT IT CHECKS. ux-eye renders the page at N scroll positions and measures
the IMAGE: text sitting on non-uniform ground, painted boxes colliding,
visual weight off centre, whether anything survives a squint. Those are
whole-field properties, and no per-element rule can express them.

This gate does not have taste. It catches the failures that are not matters
of taste at all: unreadable type, collided scenes, a page with no focal
point. Passing it means the page is not broken, never that it is good.
"""

import subprocess, sys, os, pathlib, json

HERE = pathlib.Path(__file__).resolve().parent


def main():
    if len(sys.argv) < 2:
        print("usage: design-gate <url> [--shots N]", file=sys.stderr)
        return 2
    url = sys.argv[1]
    shots = "6"
    if "--shots" in sys.argv:
        shots = sys.argv[sys.argv.index("--shots") + 1]

    out = os.environ.get("DESIGN_GATE_OUT", "/tmp/design-gate")
    r = subprocess.run([sys.executable, str(HERE / "ux-eye"), url,
                        "--out", out, "--shots", shots],
                       capture_output=True, text=True)
    sys.stdout.write(r.stdout)
    if r.stderr.strip():
        sys.stderr.write(r.stderr)

    data = pathlib.Path(out) / "eye.json"
    if not data.exists():
        print("\nGATE ERROR: ux-eye produced nothing. The page was never "
              "rendered, so nothing was verified.", file=sys.stderr)
        return 2

    res = json.loads(data.read_text())
    # Only the failures that are never a matter of taste.
    hard = []
    for m in res:
        if m["illegible"]:
            hard.append(f"y={m['y']}: {len(m['illegible'])} text box(es) "
                        f"unreadable over other content "
                        f"(worst purity {m['illegible'][0]['purity']})")
        bad = [o for o in m["overlaps"] if o["share"] > 0.35]
        if bad:
            hard.append(f"y={m['y']}: {bad[0]['a']} collides with "
                        f"{bad[0]['b']} over {int(bad[0]['share']*100)}%")

    if hard:
        print("\nREFUSED. This is not a taste call, these are broken:",
              file=sys.stderr)
        for h in hard[:8]:
            print(f"  {h}", file=sys.stderr)
        print(f"\n  images in {out}/ . Open them before changing anything.",
              file=sys.stderr)
        return 2

    print("\nGATE PASS. Nothing is broken. That is not the same as good: "
          "open the images and judge.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
