# GitHub OAuth app (github.com/settings/developers). Callback: <PUBLIC_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Any long random string; it encrypts the session cookie that holds the GitHub token.
SESSION_SECRET=
# Where the board is served, no trailing slash.
PUBLIC_URL=https://team.example.app
# The repo and branch the tasks live in.
TEAM_REPO=calebnewtonusc/Chewbacca
TEAM_BRANCH=main
# Whose "today" activity lines and due-date colors use.
TEAM_TZ=America/Los_Angeles
