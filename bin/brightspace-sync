#!/usr/bin/env python3
"""
brightspace-sync: read your own Brightspace courses, list what is due, push due
dates to Apple Reminders, and download course files.

  brightspace-sync courses
  brightspace-sync due [--days 30] [--json]
  brightspace-sync reminders [--days 30] [--list Brightspace] [--exams] [--apply]
  brightspace-sync files <course> [--since YYYY-MM-DD] [--from-chapter N] [--also REGEX] [--out DIR] [--apply]
  brightspace-sync transcripts <course> [--from-chapter N] [--out DIR] [--apply]
  brightspace-sync links <course>          Panopto recording links in a course
  brightspace-sync refresh [--out DIR] [--apply]   the daily job: files, master
                                           sheet, decks and deck index for every course
  brightspace-sync decks <course|all> [--sheet ID] [--out DIR] [--apply]
                                           every Google Slides deck the course's
                                           master sheet links, as PDF and text

files also runs decks when the course ledger (~/coursework/courses/<code>.yml)
names a master_sheet, because a course like ACAD 185 posts no files at all.

Auth is the session `chewbacca api login brightspace` imports from your
browser (or one api-anything saved under your Brightspace host).
Nothing here ever writes to Brightspace. Reads only, your own enrolments only.

Every request waits 4 to 8 seconds first (BRIGHTSPACE_DELAY=min,max overrides),
because a university LMS that sees one account pull 200 files in 90 seconds
files a security ticket. A 401, 403 or 429 stops the run immediately.

Scans never write. reminders and files only act with --apply.

BRIGHTSPACE_FIXTURE=<file.json> replaces the network with {"path prefix": response}
for tests. GOOGLE_EXPORT_FIXTURE=<dir> serves Google exports from <dir>/<id>.<ext>.
"""
import argparse
import datetime as dt
import json
import os
import random
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from zoneinfo import ZoneInfo

HOST = os.environ.get("BRIGHTSPACE_HOST", "brightspace.usc.edu")
SESSION = Path(os.environ.get(
    "BRIGHTSPACE_SESSION", Path.home() / ".api-anything/sessions" / f"{HOST}.json"))
STATE = Path(os.environ.get("BRIGHTSPACE_STATE", Path.home() / ".chewbacca/brightspace"))
TZ = ZoneInfo(os.environ.get("BRIGHTSPACE_TZ", "America/Los_Angeles"))
DOWNLOADS = str(Path(os.environ.get("COURSEWORK_DIR", "~/coursework")) / "downloads")
DELAY = tuple(float(x) for x in os.environ.get("BRIGHTSPACE_DELAY", "4,8").split(","))


class Stop(Exception):
    pass


def chrome_cookie_header():
    """The student's live d2l cookies, straight from Chrome, the way bin/brightspace reads them.

    The api-anything session file is a 12 hour snapshot that only exists after
    `chewbacca api login brightspace`, and that command first builds a Node
    engine from GitHub. On a fresh Mac neither had happened, so the first
    "pull my slides" stopped at "no Brightspace session" while the student had
    Brightspace open in Chrome. Chrome's own cookie file is always the newest
    copy, so it goes first and the snapshot is the fallback.
    """
    if HOST != "brightspace.usc.edu" or os.environ.get("BRIGHTSPACE_NO_CHROME"):
        return None
    try:
        sys.dont_write_bytecode = True  # never litter the kit snapshot with .pyc
        import importlib.machinery
        import importlib.util
        here = Path(__file__).resolve().parent / "brightspace"
        loader = importlib.machinery.SourceFileLoader("brightspace_reader", str(here))
        spec = importlib.util.spec_from_loader("brightspace_reader", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        jar = mod.chrome_cookies()
    except Exception:
        return None
    return "; ".join(f"{k}={v}" for k, v in jar.items()) or None


def cookie_header(host=HOST):
    if host == HOST and "BRIGHTSPACE_SESSION" not in os.environ:
        live = chrome_cookie_header()
        if live:
            return live
    session = SESSION if host == HOST else SESSION.parent / f"{host}.json"
    # `chewbacca api login brightspace` saves the session under the site name,
    # not the host, and it's the import that holds: a plain profile import loses
    # the d2l cookies, which have no expiry (2026-10-10).
    if not session.exists() and host == HOST and "BRIGHTSPACE_SESSION" not in os.environ:
        session = SESSION.parent / "brightspace.json"
    if not session.exists():
        raise Stop(f"no Brightspace session. Sign in once at https://{HOST} in Chrome, then rerun "
                   f"(`brightspace whoami` says what it sees)")
    jar = json.load(open(session))["cookies"]
    return "; ".join(
        f"{c['name']}={c['value']}" for c in jar
        if host.endswith(c.get("domain", "").lstrip(".") or "\0")
    )


class SameHostCookies(urllib.request.HTTPRedirectHandler):
    """Follow a redirect, but carry the session cookie only to the same host.
    urllib copies every header onto a redirect, Cookie included, so a file URL
    that bounced to another host (a CDN, the SSO login, or an open redirect
    someone planted) was handed the student's whole Brightspace session
    (security review, 2026-10-28). bin/brightspace refuses redirects outright;
    file downloads here can legitimately redirect, so they're followed bare."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        old, to = urllib.parse.urlparse(req.full_url), urllib.parse.urlparse(newurl)
        # Same scheme, host and port, or the cookie stays behind: an https page
        # bouncing to http on the same host would otherwise send it in the clear.
        if new is not None and (to.scheme, to.hostname, to.port) != (old.scheme, old.hostname, old.port):
            new.remove_header("Cookie")
        return new


OPENER = urllib.request.build_opener(SameHostCookies)


class FixtureResponse:
    def __init__(self, body, url):
        # {"base64": ...} is a file's exact bytes. A plain string went through
        # .encode(), so a test could never serve a real pptx or PDF: any byte
        # over 0x7f came back re-encoded and the download was corrupt (USC
        # week walk, 2026-10-13, item 10).
        if isinstance(body, dict) and set(body) == {"base64"}:
            import base64
            self._body = base64.b64decode(body["base64"])
        else:
            self._body = body.encode() if isinstance(body, str) else json.dumps(body).encode()
        self._url = url

    def read(self):
        return self._body

    def geturl(self):
        return self._url


class Client:
    def __init__(self, host=HOST):
        fixture = os.environ.get("BRIGHTSPACE_FIXTURE")
        self.fixture = json.load(open(fixture)) if fixture else None
        self.cookie = "" if self.fixture is not None else cookie_header(host)
        self.last = 0.0

    def _wait(self):
        gap = random.uniform(*DELAY)
        left = self.last + gap - time.time()
        if left > 0:
            time.sleep(left)

    def open(self, url):
        if self.fixture is not None:
            # Tests: a file download is served from the fixture like any read,
            # keyed by the path after /d2l/api.
            path = urllib.parse.urlparse(url).path.replace("/d2l/api", "", 1)
            for k, v in self.fixture.items():
                if path.startswith(k):
                    return FixtureResponse(v, url)
            raise Stop(f"fixture has no {path}")
        self._wait()
        req = urllib.request.Request(url, headers={"Cookie": self.cookie, "User-Agent": "Mozilla/5.0"})
        try:
            resp = OPENER.open(req, timeout=60)
        except urllib.error.HTTPError as e:
            if e.code in (401, 403, 429):
                raise Stop(f"HTTP {e.code} from {urllib.parse.urlparse(url).path}. Stopping. "
                           f"If 401/403, run `brightspace whoami`: it says whether Chrome only needs a restart "
                           f"(signed in, cookies not saved) or a real sign-in")
            raise
        finally:
            self.last = time.time()
        if "/d2l/login" in resp.geturl() or "shibboleth" in resp.geturl():
            raise Stop(f"session expired (redirected to sign-in). Run `brightspace whoami` before asking "
                       f"anyone to sign in: it says whether Chrome only needs a restart")
        return resp

    def json(self, path):
        if self.fixture is not None:
            return next(v for k, v in self.fixture.items() if path.startswith(k))
        return json.load(self.open(f"https://{HOST}/d2l/api{path}"))


def term_of(name):
    """USC section names lead with the term: "20263_10212 ACAD-185: ..."."""
    m = re.match(r"(\d{5})_", name)
    return m[1] if m else ""


def courses(client, all_terms=False):
    items, mark = [], ""
    while True:
        d = client.json("/lp/1.63/enrollments/myenrollments/?orgUnitTypeId=3" + (f"&bookmark={mark}" if mark else ""))
        items += d["Items"]
        if not d["PagingInfo"].get("HasMoreItems"):
            break
        mark = d["PagingInfo"]["Bookmark"]
    out = []
    for it in items:
        if not it["Access"].get("IsActive"):
            continue
        name = it["OrgUnit"]["Name"]
        m = re.search(r"([A-Z]{2,5})[- ](\d{3}[A-Za-z]?)", name)
        out.append({"id": it["OrgUnit"]["Id"], "name": name, "code": f"{m[1]}-{m[2]}" if m else name,
                    "term": term_of(name)})
    # Past terms stay enrolled and active (a 20253 GESM seminar was still
    # listed in Fall 2026), so every student's due list and course picker
    # carried last year's classes. Keep the newest term unless asked.
    newest = max((c["term"] for c in out), default="")
    if not all_terms and newest:
        out = [c for c in out if c["term"] == newest]
    return out


def pick(client, key):
    all_courses = courses(client)
    key = key.lower()
    hits = [c for c in all_courses if key in c["code"].lower() or key in c["name"].lower() or key == str(c["id"])]
    if len(hits) != 1:
        # A lecture and its lab share a code (BISC-101 twice), so name each by id.
        raise Stop(f"'{key}' matched {len(hits)} courses; pass the id instead: "
                   + ", ".join(f"{c['code']} ({c['id']})" for c in (hits or all_courses)))
    return hits[0]


def local(iso):
    return dt.datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone(TZ)


# Calendar titles are instructor text, and they reach the terminal and the ledger.
CONTROL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def due_items(client, days):
    now = dt.datetime.now(dt.timezone.utc)
    start = now.strftime("%Y-%m-%dT%H:%M:%S.000Z")
    end = (now + dt.timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%S.000Z")
    rows = []
    for c in courses(client):
        d = client.json(f"/le/1.99/{c['id']}/calendar/events/myEvents/?associatedEventsOnly=false"
                        f"&startDateTime={start}&endDateTime={end}")
        seen = set()
        for e in sorted(d.get("Objects", []), key=lambda e: e["StartDateTime"]):
            if e["Title"] in seen:
                continue
            seen.add(e["Title"])
            rows.append({"course": c["code"], "courseId": c["id"], "title": CONTROL.sub("", e["Title"]),
                         "due": local(e["StartDateTime"]).isoformat(timespec="minutes")})
    return sorted(rows, key=lambda r: r["due"])


def cmd_due(client, a):
    rows = due_items(client, a.days)
    if a.json:
        print(json.dumps(rows, indent=2))
        return
    for r in rows:
        print(f"{r['due'][:16].replace('T', ' ')}  {r['course']:<9} {r['title']}")
    print(f"{len(rows)} items in the next {a.days} days", file=sys.stderr)


ADD_REMINDER = """
on run argv
  set due to current date
  set day of due to 1
  set year of due to (item 3 of argv as integer)
  set month of due to (item 4 of argv as integer)
  set day of due to (item 5 of argv as integer)
  set time of due to ((item 6 of argv as integer) * 3600 + (item 7 of argv as integer) * 60)
  set alert to due
  set time of alert to 9 * 3600
  if (time of due) < 10 * 3600 then set alert to due - 12 * 3600
  tell application "Reminders"
    if not (exists list (item 1 of argv)) then make new list with properties {name:(item 1 of argv)}
    tell list (item 1 of argv) to make new reminder with properties {name:(item 2 of argv), body:"From Brightspace", due date:due, remind me date:alert}
  end tell
end run
"""


def add_reminder(list_name, title, when):
    subprocess.run(["osascript", "-e", ADD_REMINDER, list_name, title, str(when.year), str(when.month),
                    str(when.day), str(when.hour), str(when.minute)], check=True)


def cmd_reminders(client, a):
    rows = due_items(client, a.days)
    if a.exams:
        out = subprocess.run(["coursework", "due", "--days", str(a.days), "--json"],
                             capture_output=True, text=True, check=True).stdout
        for it in json.loads(out)["upcoming"]:
            if it["type"] in ("exam", "quiz"):
                rows.append({"course": it["course"].replace(" ", "-"), "courseId": "ledger", "title": it["name"],
                             "due": f"{it['date']}T{it.get('at') or '08:00'}"})
        rows.sort(key=lambda r: r["due"])
    STATE.mkdir(parents=True, exist_ok=True)
    pushed_file = STATE / "reminders-pushed.json"
    pushed = set(json.load(open(pushed_file))) if pushed_file.exists() else set()
    todo = [r for r in rows if f"{r['courseId']}|{r['title']}|{r['due']}" not in pushed]
    for r in todo:
        when = dt.datetime.fromisoformat(r["due"])
        title = f"{r['course']}: {r['title']}"
        if not a.apply:
            print(f"would add  {when:%a %b %d %I:%M%p}  {title}")
            continue
        add_reminder(a.list, title, when)
        pushed.add(f"{r['courseId']}|{r['title']}|{r['due']}")
        json.dump(sorted(pushed), open(pushed_file, "w"))
        print(f"added      {when:%a %b %d %I:%M%p}  {title}")
    print(f"{len(todo)} new, {len(rows) - len(todo)} already pushed" + ("" if a.apply else " (dry run, pass --apply)"),
          file=sys.stderr)


def walk(modules, trail=()):
    for m in modules:
        here = trail + (m["Title"],)
        for t in m.get("Topics", []):
            yield here, t
        yield from walk(m.get("Modules", []), here)


def safe(s):
    return re.sub(r'[\\/:*?"<>|]+', "-", s).strip(" .")[:120] or "untitled"


def cmd_links(client, a):
    c = pick(client, a.course)
    for trail, t in walk(client.json(f"/le/1.99/{c['id']}/content/toc")["Modules"]):
        if "panopto" in (t.get("Url") or "").lower():
            print(f"{t['TopicId']}\t{t['Title']}\t{t['Url']}")


def cmd_files(client, a):
    c = pick(client, a.course)
    sync_files(client, c, a)
    sheet = master_sheet(c["code"])
    if sheet:
        sync_decks(c["code"], sheet, a)


COURSES = Path(os.environ.get("COURSEWORK_DIR", "~/coursework")).expanduser() / "courses"


def ledger_file(code):
    """The course ledger for a code. ACAD 324's is acad-324g.yml, so a suffix is allowed."""
    base = re.sub(r"[\s_-]+", "-", code).lower()
    exact = COURSES / (base + ".yml")
    if exact.exists():
        return exact
    return next(iter(sorted(COURSES.glob(base + "*.yml"))), None)


def master_sheet(code):
    """The Google Sheet id a course ledger names as master_sheet, or None."""
    f = ledger_file(code)
    m = f and re.search(r"^master_sheet:\s*[\"']?([\w-]{20,})", f.read_text(), re.M)
    return m[1] if m else None


def find_master_sheet(client, c, a):
    """A Google Sheet an announcement links, written to the ledger as master_sheet.

    ACAD 185 links its master sheet from an announcement, not from Content, so
    nothing found it until someone typed the id in (2026-11-02). Only a sheet
    whose rows are WnSn sessions counts, so a sign-up sheet never becomes one.
    """
    f = ledger_file(c["code"])
    if not f or master_sheet(c["code"]):
        return None
    try:
        news = json.dumps(client.json(f"/le/1.99/{c['id']}/news/"))
    except Stop:
        raise
    except Exception:
        return None
    for gid in dict.fromkeys(re.findall(r"docs\.google\.com/spreadsheets/d/([\w-]{20,})", news)):
        try:
            if not any(True for _ in sheet_decks(google_export("sheet", gid, "xlsx"))):
                continue
        except Exception:
            continue
        if a.apply:
            text = f.read_text()
            f.write_text(text + ("" if text.endswith("\n") else "\n") + f'master_sheet: "{gid}"\n')
        print(f"{'found' if a.apply else 'would set'}  {c['code']} master_sheet {gid} (from an announcement)")
        return gid
    return None


def google_export(kind, gid, fmt):
    """Bytes of a Google file exported as fmt. Link-shared files need no sign-in."""
    fx = os.environ.get("GOOGLE_EXPORT_FIXTURE")
    if fx:
        return (Path(fx) / f"{gid}.{fmt}").read_bytes()
    url = (f"https://docs.google.com/spreadsheets/d/{gid}/export?format={fmt}" if kind == "sheet"
           else f"https://docs.google.com/{kind}/d/{gid}/export/{fmt}")
    with urllib.request.urlopen(url, timeout=120) as r:
        return r.read()


def sheet_decks(xlsx):
    """(session, title, kind, id) for each Google Slides or Docs link in a master sheet."""
    import io
    import openpyxl
    wb = openpyxl.load_workbook(io.BytesIO(xlsx))
    seen = set()
    for ws in wb:
        for row in ws.iter_rows():
            sid = str(row[0].value or "").strip()
            # Only session rows. The other tabs hold ~40 classmates' pitch and
            # exercise decks (2026-11-02 sheet), which are not lecture material.
            if not re.fullmatch(r"W\d+S\d+", sid):
                continue
            for cell in row:
                link = cell.hyperlink.target if cell.hyperlink else ""
                m = re.search(r"docs\.google\.com/(presentation|document)/d/([\w-]{20,})", link or "")
                if not m or m[2] in seen:
                    continue
                seen.add(m[2])
                title = str(cell.value or "").strip()
                if title.startswith("http"):
                    title = m[2]
                yield sid, title, m[1], m[2]


def assigned_in(xlsx):
    """(session, deck title, assignment id) from each session row's "Given" column."""
    import io
    import openpyxl
    for ws in openpyxl.load_workbook(io.BytesIO(xlsx)):
        head = col = None
        for row in ws.iter_rows():
            cells = [str(c.value or "") for c in row]
            if head is None:
                hit = [i for i, v in enumerate(cells) if re.search(r"assignment.*given", v, re.I)]
                if hit:
                    head, col = True, hit[0]
                continue
            sid = cells[0].strip()
            if not re.fullmatch(r"W\d+S\d+", sid) or col >= len(cells):
                continue
            deck = next((c for c in row if c.hyperlink and "docs.google.com" in (c.hyperlink.target or "")), None)
            if deck is None:
                continue
            for aid in dict.fromkeys(re.findall(r"\bA\d+[a-z]?\b", cells[col])):
                yield sid, str(deck.value or "").strip(), aid


def sync_decks(code, sheet, a):
    """Every deck the master sheet links into <a.out>/<CODE>/<session> <title>.pdf plus .txt.

    ACAD 185 posts nothing to Brightspace Content. Every lecture deck is a
    Google Slides link in the master sheet, so the Content walk found zero and
    nothing pulled W8S15 onward: on 2026-11-02 the team built A20 from the
    dropbox brief alone, a text deck, when the W10S20 lecture that assigned it
    asked for an AI-image storyboard. The deck is the spec.
    """
    out = Path(a.out).expanduser() / safe(code).replace(" ", "-")
    xlsx = google_export("sheet", sheet, "xlsx")
    new = 0
    for sid, title, kind, gid in sheet_decks(xlsx):
        stem = out / safe(f"{sid} {title}")
        if Path(f"{stem}.txt").exists() or Path(f"{stem}.pdf").exists():
            continue
        new += 1
        if not a.apply:
            print(f"would save  {stem.name}.pdf")
            continue
        try:
            pdf = google_export(kind, gid, "pdf")
        except (urllib.error.URLError, OSError) as e:
            print(f"not shared  {stem.name}: {e}", file=sys.stderr)
            continue
        if not pdf.startswith(b"%PDF"):
            print(f"not shared  {stem.name}: Google returned a sign-in page", file=sys.stderr)
            continue
        out.mkdir(parents=True, exist_ok=True)
        Path(f"{stem}.pdf").write_bytes(pdf)
        subprocess.run(["pdftotext", "-layout", str(Path(f"{stem}.pdf")), str(Path(f"{stem}.txt"))],
                       stderr=subprocess.DEVNULL)
        print(f"saved       {stem.name}.pdf")
    if a.apply:
        out.mkdir(parents=True, exist_ok=True)
        (out / "master.xlsx").write_bytes(xlsx)
        # Which deck assigned each assignment, so lecture-gate can refuse a
        # SPEC that never cites it (the A20 miss in sync_decks' docstring).
        given = {}
        for sid, title, aid in assigned_in(xlsx):
            given.setdefault(aid, {"session": sid, "deck": safe(f"{sid} {title}") + ".pdf"})
        (out / "assigned-in.json").write_text(json.dumps(given, indent=1) + "\n")
    print(f"{new} linked decks" + ("" if a.apply else " (dry run, pass --apply)"), file=sys.stderr)
    return new


DECK_EXT = {".pdf", ".pptx", ".ppt", ".docx", ".txt"}


def deck_text(path):
    """Plain text of one deck, cached beside it as .text/<name>.txt."""
    if path.suffix == ".txt":
        return path.read_text(errors="replace")
    cache = path.parent / ".text" / (path.name + ".txt")
    if cache.exists() and cache.stat().st_mtime >= path.stat().st_mtime:
        return cache.read_text(errors="replace")
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader("usc", str(Path(__file__).resolve().parent / "chewbacca-usc"))
    spec = importlib.util.spec_from_loader("usc", loader)
    usc = importlib.util.module_from_spec(spec)
    loader.exec_module(usc)
    try:
        pages = usc.file_pages(path) or []
    except Exception:
        pages = []
    text = "\n".join(t for _, t in pages)
    cache.parent.mkdir(exist_ok=True)
    cache.write_text(text)
    return text


def ledger_ids(code):
    """Assignment ids from the ledger's names: A20, WP3, and "Project 4b" as P4b."""
    f = ledger_file(code)
    ids = set()
    for name in re.findall(r'name:\s*"([^"]+)"', f.read_text() if f else ""):
        m = re.match(r"([A-Z]{1,3}\d+[a-z]?)\b", name) or re.match(r"Project\s+(\d+[a-z]?)\b", name)
        if m:
            ids.add(m[1] if m[1][0].isalpha() else "P" + m[1])
    return ids


def id_pattern(aid):
    """A20; P4b also as "Project 4b"; WP2 also as "Writing Project 2", the prompt's name for it."""
    alt = ""
    if m := re.fullmatch(r"P(\d+[a-z]?)", aid):
        alt = rf"|Project\s*{m[1]}"
    elif m := re.fullmatch(r"WP(\d+)", aid):
        alt = rf"|Writing\s+Project\s*{m[1]}"
    return re.compile(rf"\b(?:{aid}{alt})\b", re.I)


def natural(s):
    """wk9 before wk10, so the first deck listed is the earliest one."""
    return [int(x) if x.isdigit() else x.lower() for x in re.split(r"(\d+)", s)]


def index_course(code, out):
    """<out>/<CODE>/deck-index.json: every deck that mentions each ledger assignment.

    The master sheet says where ACAD 185 assigned each one (assigned-in.json,
    listed first). Every other course has no sheet, so the decks that name an
    assignment stand in: on 2026-11-02 lecture-gate covered ACAD 185 only.
    """
    root = Path(out).expanduser() / code
    ids = ledger_ids(code)
    if not root.is_dir() or not ids:
        return {}
    given = {}
    if (root / "assigned-in.json").exists():
        given = json.load(open(root / "assigned-in.json"))
    by_stem = {}
    for p in sorted(root.rglob("*")):
        if p.is_file() and p.suffix.lower() in DECK_EXT and ".text" not in p.parts:
            stem = str(p.relative_to(root))[: -len(p.suffix)]
            # A deck's .txt sidecar is the cheap read; keep it over the PDF.
            if stem not in by_stem or p.suffix == ".txt":
                by_stem[stem] = p
    texts = [(stem, p, deck_text(p)) for stem, p in by_stem.items()]
    index = {}
    for aid in sorted(ids):
        hits = []
        if aid in given:
            title = given[aid]["deck"][:-4].split(" ", 1)[-1]
            hits.append({"deck": given[aid]["deck"], "cite": [given[aid]["session"], title]})
        pat = id_pattern(aid)
        # A deck named for the assignment (the WP3 prompt) is its spec; then
        # every other deck that mentions it, earliest week first.
        ranked = sorted(texts, key=lambda t: (not pat.search(Path(t[0]).name),
                                              not re.search(r"prompt|assignment", Path(t[0]).name, re.I),
                                              natural(t[0])))
        for stem, p, text in ranked:
            if (pat.search(Path(stem).name) or pat.search(text)) \
                    and not any(stem == h["deck"].rsplit(".", 1)[0] for h in hits):
                pdf = p.with_suffix(".pdf")
                hits.append({"deck": str((pdf if p.suffix == ".txt" and pdf.exists() else p).relative_to(root)),
                             "cite": [Path(stem).name, re.sub(r"^W\d+S\d+\s+", "", Path(stem).name)]
                             # A SPEC quoting "the prompt" read the one file the course calls that
                             # (the WP2 spec, 2026-10-21, never named it any other way).
                             + (["prompt"] if re.search(r"prompt", Path(stem).name, re.I) else [])})
        if hits:
            index[aid] = hits
    (root / "deck-index.json").write_text(json.dumps(index, indent=1) + "\n")
    return index


def cmd_refresh(client, a):
    """Every current course: new Brightspace files, a master sheet found from the
    announcements, its decks, and the deck index lecture-gate reads. The daily job."""
    current = courses(client)
    if a.apply:
        # lecture-gate maps a `brightspace submit <ou>` back to its course.
        out = Path(a.out).expanduser()
        out.mkdir(parents=True, exist_ok=True)
        (out / "courses.json").write_text(json.dumps({str(c["id"]): c["code"] for c in current}, indent=1) + "\n")
    for c in current:
        try:
            sync_files(client, c, a)
            sheet = master_sheet(c["code"]) or find_master_sheet(client, c, a)
            if sheet:
                sync_decks(c["code"], sheet, a)
            if a.apply:
                n = len(index_course(c["code"], a.out))
                print(f"indexed     {c['code']}: {n} assignments mapped to decks", file=sys.stderr)
        except Stop:
            raise
        except Exception as e:
            print(f"skipped     {c['code']}: {e}", file=sys.stderr)


def cmd_decks(client, a):
    if a.course == "all":
        # What the daily daemon job runs: every ledger that names a master sheet.
        for f in sorted(COURSES.glob("*.yml")):
            sheet = master_sheet(f.stem)
            if sheet:
                sync_decks(f.stem.upper(), sheet, a)
                if a.apply:
                    index_course(f.stem.upper(), a.out)
        return
    sheet = a.sheet or master_sheet(a.course)
    if not sheet:
        raise Stop(f"no master_sheet in the {a.course} ledger; pass --sheet <Google Sheet id>")
    sync_decks(a.course, sheet, a)
    if a.apply:
        index_course(a.course, a.out)


def sync_files(client, c, a):
    """Every visible file in course c into <a.out>/<CODE>/, mirroring the module tree."""
    since = dt.datetime.fromisoformat(a.since).replace(tzinfo=TZ) if getattr(a, "since", None) else None
    out = Path(a.out).expanduser() / safe(c["code"])
    manifest_file = out / ".manifest.json"
    manifest = json.load(open(manifest_file)) if manifest_file.exists() else {}
    picks = []
    for trail, t in walk(client.json(f"/le/1.99/{c['id']}/content/toc")["Modules"]):
        if t.get("TypeIdentifier") != "File" or t.get("IsHidden"):
            continue
        if since and t.get("LastModifiedDate") and local(t["LastModifiedDate"]) < since:
            continue
        if getattr(a, "from_chapter", None):
            ch = re.search(r"\b(?:Chapter|Ch)\.?\s*(\d+)", t["Title"], re.I)
            keep = ch and int(ch[1]) >= a.from_chapter
            keep = keep or any(re.search(p, " / ".join(trail), re.I) for p in a.also)
            if not keep:
                continue
        if str(t["TopicId"]) in manifest and manifest[str(t["TopicId"])] == t.get("LastModifiedDate"):
            continue
        picks.append((trail, t))
    for trail, t in picks:
        ext = Path(urllib.parse.unquote(t["Url"])).suffix
        dest = out.joinpath(*[safe(x) for x in trail]) / (safe(t["Title"]) + ext)
        if not a.apply:
            if not getattr(a, "quiet", False):
                print(f"would save  {c['code']}/{dest.relative_to(out)}")
            continue
        resp = client.open(f"https://{HOST}/d2l/api/le/1.99/{c['id']}/content/topics/{t['TopicId']}/file")
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(resp.read())
        manifest[str(t["TopicId"])] = t.get("LastModifiedDate")
        json.dump(manifest, open(manifest_file, "w"))
        print(f"saved       {c['code']}/{dest.relative_to(out)}")
    if not getattr(a, "quiet", False):
        print(f"{len(picks)} files" + ("" if a.apply else " (dry run, pass --apply)"), file=sys.stderr)
    return len(picks)


def srt_to_text(srt):
    out = []
    for block in re.split(r"\n\s*\n", srt.strip()):
        text = " ".join(l for l in block.splitlines()[2:] if not l.startswith("[Auto-generated"))
        if text:
            out.append(text)
    return "\n".join(out)


def cmd_transcripts(client, a):
    c = pick(client, a.course)
    recs = []
    for trail, t in walk(client.json(f"/le/1.99/{c['id']}/content/toc")["Modules"]):
        m = re.search(r"https://([^/]*panopto[^/]*)/.*[?&]id=([0-9a-f-]{36})", t.get("Url") or "", re.I)
        if not m:
            continue
        chapters = [int(x) for x in re.findall(r"\b(?:Chapter|Ch)\.?\s*(\d+)", t["Title"], re.I)]
        if a.from_chapter and not (chapters and max(chapters) >= a.from_chapter):
            continue
        recs.append((t, m[1], m[2]))
    out = Path(a.out).expanduser() / safe(c["code"]) / "Lecture transcripts"
    panopto, missing = {}, []
    for t, host, vid in recs:
        dest = out / (safe(t["Title"]) + ".txt")
        if dest.exists():
            continue
        if not a.apply:
            print(f"would save  {dest.name}")
            continue
        panopto.setdefault(host, Client(host))
        try:
            srt = panopto[host].open(
                f"https://{host}/Panopto/Pages/Transcription/GenerateSRT.ashx?id={vid}&language=0"
            ).read().decode("utf8", "replace")
        except urllib.error.HTTPError as e:
            srt = ""
        if not re.match(r"\s*1\s*\n\d\d:", srt):
            missing.append(t["Title"])
            continue
        out.mkdir(parents=True, exist_ok=True)
        dest.write_text(f"{t['Title']}\n\n{srt_to_text(srt)}\n")
        print(f"saved       {dest.name}")
    if missing:
        print("no captions published for: " + "; ".join(missing), file=sys.stderr)
    print(f"{len(recs)} recordings" + ("" if a.apply else " (dry run, pass --apply)"), file=sys.stderr)


def main():
    ap = argparse.ArgumentParser(prog="brightspace-sync")
    sub = ap.add_subparsers(dest="cmd", required=True)
    cs = sub.add_parser("courses")
    cs.add_argument("--all-terms", action="store_true", help="include past terms' courses")
    d = sub.add_parser("due")
    d.add_argument("--days", type=int, default=30)
    d.add_argument("--json", action="store_true")
    r = sub.add_parser("reminders")
    r.add_argument("--days", type=int, default=30)
    r.add_argument("--list", default="Brightspace")
    r.add_argument("--exams", action="store_true", help="also add exams and quizzes from the coursework ledger")
    r.add_argument("--apply", action="store_true")
    f = sub.add_parser("files")
    f.add_argument("course")
    f.add_argument("--since")
    f.add_argument("--from-chapter", type=int, help="keep files whose title names this chapter or later")
    f.add_argument("--also", action="append", default=[], help="regex on the module path to keep regardless of chapter")
    f.add_argument("--out", default=DOWNLOADS)
    f.add_argument("--apply", action="store_true")
    l = sub.add_parser("links")
    l.add_argument("course")
    rf = sub.add_parser("refresh")
    rf.add_argument("--out", default=DOWNLOADS)
    rf.add_argument("--apply", action="store_true")
    rf.add_argument("--since")
    k = sub.add_parser("decks")
    k.add_argument("course")
    k.add_argument("--sheet", help="Google Sheet id; default is master_sheet from the course ledger")
    k.add_argument("--out", default=DOWNLOADS)
    k.add_argument("--apply", action="store_true")
    t = sub.add_parser("transcripts")
    t.add_argument("course")
    t.add_argument("--from-chapter", type=int)
    t.add_argument("--out", default=DOWNLOADS)
    t.add_argument("--apply", action="store_true")
    a = ap.parse_args()
    try:
        if a.cmd == "decks":
            return cmd_decks(None, a)
        client = Client()
        if a.cmd == "courses":
            for c in courses(client, all_terms=a.all_terms):
                print(f"{c['id']}\t{c['code']}\t{c['name']}")
        else:
            {"due": cmd_due, "reminders": cmd_reminders, "files": cmd_files, "links": cmd_links,
             "transcripts": cmd_transcripts, "refresh": cmd_refresh}[a.cmd](client, a)
    except Stop as e:
        print(f"stopped: {e}", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
