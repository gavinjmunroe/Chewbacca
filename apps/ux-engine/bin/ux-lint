# WHOSE RULE IS THIS? The question that decides whether a tool survives.
#
# A postmortem of this category (research/16) found one cause underneath every
# death: there is no external, published, machine-checkable standard for good
# design, so every tool invents the standard it enforces, and a tool that
# invents its own standard cannot survive contact with a designer who
# disagrees.
#
# Every survivor escapes that. axe-core enforces WCAG, which Deque did not
# write, so the argument is with the W3C. Prettier abolishes the decision and
# froze its options permanently. Google's Tricorder restricts itself to the
# provable subset.
#
# The 30 rules below are an invented standard. Some of them cite WCAG and are
# therefore borrowed authority; the rest are this repo's opinion, however well
# sourced. So they are split, and only borrowed authority is allowed to block:
#
#   EXTERNAL  cites WCAG, a spec, or a measured study    -> may block
#   HOUSE     this repo's reading, defensible but ours   -> advises, never blocks
#   PROJECT   the project's own DENY.md                  -> may block
#
# PROJECT is the real answer and it is the one opening the postmortem found:
# a convention the project declared is, from the tool's point of view, an
# external standard. That is the axe-core move applied to design.
#
# Google's thresholds, which this must respect: under 10% effective false
# positives for a review check, ZERO for anything build-breaking. Measured LLM
# design critique runs near 34%. A build-breaking gate made of house opinion is
# roughly 3.4x over the line where tools get switched off, and the suppression
# literature is blunt about what happens next: false positives are only 4-5%
# of why rules get silenced, while 61-68% is "unactionable", meaning the rule
# was right in general and wrong here because the tool did not know the intent.
EXTERNAL_AUTHORITY = re.compile(r"WCAG|W3C|MDN|NIST|web\.dev|Material|APG", re.I)


def authority(rule):
    """EXTERNAL if the rule cites a standard somebody else published."""
    return "EXTERNAL" if EXTERNAL_AUTHORITY.search(rule[6]) else "HOUSE"


def load_project_rules(start):
    """A DENY.md in the project is the only thing here with real standing.

    Walk up from the linted file looking for one. Its rules block, because the
    project declared them, which makes them external from this tool's point of
    view. This is the escape from the graveyard.
    """
    d = pathlib.Path(start).resolve()
    for parent in [d] + list(d.parents):
        f = parent / "DENY.md"
        if f.exists():
            return f
    return None


EXT = {".tsx", ".jsx", ".ts", ".js", ".css", ".scss", ".html", ".vue", ".svelte", ".md", ".mdx", ".astro"}
# corpus/ is deliberately-slop training data and runs/ is generated variants.
# Linting either one reports findings the repo put there on purpose.
SKIP = {"node_modules", ".git", "dist", "build", ".next", "vendor", "systems",
        "research", ".venv", "corpus", "runs"}


# ---- Rules that a regex cannot express ------------------------------------
#
# WHY THESE EXIST. Measured 2026-09-20 against corpus/slop/saas-landing-0.html,
# a page with a violet-to-pink gradient headline, a pill announcement badge and
# an avatar stack: THE REGEX RULES RETURNED ZERO HIGH FINDINGS. Every headline
# rule above matches Tailwind syntax (bg-indigo-600, bg-clip-text) and that page
# is written in plain CSS with variables, so `background-clip: text` and
# `#7c6dff` slid straight past a detector built to catch exactly them.
#
# A rule keyed to one framework's dialect only catches slop written in that
# dialect. These work on the computed value instead, so #7c6dff, rgb(124,109,255)
# and bg-indigo-600 are all the same finding.

VIOLET_LO, VIOLET_HI = 228, 295   # indigo through purple, in HSL degrees


def _saturated_violets(text):
    """Hex accents in the indigo-violet band, however they were written."""
    import colorsys
    out = []
    for m in re.finditer(r"#([0-9a-fA-F]{6})\b", text):
        raw = m.group(1)
        r, g, b = (int(raw[i:i + 2], 16) / 255 for i in (0, 2, 4))
        h, l, sat = colorsys.rgb_to_hls(r, g, b)
        if sat >= 0.45 and 0.25 <= l <= 0.75 and VIOLET_LO <= h * 360 <= VIOLET_HI:
            out.append((m.start(), f"#{raw}"))
    return out


def _gradient_text(text):
    """Gradient headline text in CSS, which the Tailwind rule cannot see."""
    out = []
    for m in re.finditer(r"(?:-webkit-)?background-clip\s*:\s*text", text):
        window = text[max(0, m.start() - 400):m.start() + 400]
        if "linear-gradient" in window or "gradient" in window:
            out.append((m.start(), "background-clip: text over a gradient"))
    return out


def _emoji_as_icon(text):
    """Emoji standing in for an icon. Banned outright in Caleb's global rules."""
    import re as _re
    rng = _re.compile(r"[\U0001F300-\U0001FAFF\u2600-\u27BF\u2B00-\u2BFF]")
    return [(m.start(), m.group(0)) for m in rng.finditer(text)]


def _three_up_grid(text):
    """The three-equal-cards row. The single most repeated generated structure."""
    out = []
    for m in re.finditer(r"repeat\(\s*3\s*,\s*(?:1fr|minmax)", text):
        out.append((m.start(), "three equal columns"))
    for m in re.finditer(r"\bgrid-cols-3\b", text):
        out.append((m.start(), "three equal columns"))
    return out if len(out) >= 2 else []


def _invented_proof(text):
    """Fabricated social proof and metrics presented as real."""
    out = []
    for pat in (r"[Tt]rusted by\s+[\d,]+\+?", r"[Jj]oin\s+[\d,]+\+?\s+\w+",
                r"\b\d{1,3}(?:,\d{3})*\+\s*(?:users|customers|teams|companies|creators)"):
        for m in re.finditer(pat, text):
            out.append((m.start(), m.group(0)))
    return out


COMPUTED = [
    ("violet-accent-hex", "high", _saturated_violets,
     "An indigo/violet accent written as a raw hex, which the Tailwind rules cannot see",
     "Pick a system from SYSTEMS.md and use its accent, or derive one with ux-constrain.",
     "Once a viewer can name the style as generated, they have an attribution for why it read easily, and the fluency-to-liking path is cut. Naming is the damage.",
     "research/14; Winkielman & Fazendeiro 2003. Measured: this fired on corpus/slop/saas-landing-0.html where every regex rule missed."),
    ("emoji-as-icon", "high", _emoji_as_icon,
     "An emoji standing in for an icon",
     "Use an SVG icon, or a text label. Emoji render differently on every platform and are read aloud in full by screen readers.",
     "A screen reader announces the CLDR name of every emoji in full, so a card titled with a lightning bolt is announced as 'high voltage sign' before the heading text.",
     "W3C WAI on emoji in content; Unicode CLDR annotation names are what assistive tech reads."),
    ("three-up-grid", "high", _three_up_grid,
     "Repeated three-equal-column grids, the most reproduced generated structure",
     "Vary the row. Let the number of columns follow the number of things, or use a list.",
     "Three equal cards force every item to the same visual weight, so nothing is ranked and the reader has to compare all of them to find the one that matters.",
     "research/04; measured: a census of the corpus found this row in nearly every unguided generation."),
    ("invented-social-proof", "high", _invented_proof,
     "Fabricated user counts or 'trusted by N' presented as fact",
     "Delete it, or use a real number you can source.",
     "An invented metric in a shipped page is a false claim to the reader, and the one person who knows the real number is the one most likely to see it.",
     "FTC Endorsement Guides 16 CFR 255 on unsubstantiated performance claims."),
    ("gradient-text-css", "high", _gradient_text,
     "Gradient headline text via CSS background-clip rather than Tailwind",
     "One colour. Let size and weight carry hierarchy.",
     "Gradient text lowers effective contrast across its own run, so part of the headline fails WCAG 1.4.3 even when the sampled colour passes.",
     "WCAG 2.2 SC 1.4.3. Measured: 4 occurrences in corpus/slop/saas-landing-0.html, 0 findings from the Tailwind rule."),
]


def scan(path):
    hits = []
    text = path.read_text(errors="ignore")
    lines = text.split("\n")
    for rid, sev, pat, what, fix, why, src in RULES:
        flags = re.M if rid == "emoji-heading" else 0
        # One finding per rule per line. A pattern can match twice on one line
        # (`from-indigo-600 to-purple-600` matches `indigo` at both ends) and
        # the finding text is rule-level, so the second copy is identical noise
        # that also inflates the --max count a CI gate is set against. COMPUTED
        # below already deduped this way; RULES did not.
        seen = set()
        for m in re.finditer(pat, text, flags):
            line_no = text[: m.start()].count("\n") + 1
            if line_no in seen:
                continue
            seen.add(line_no)
            hits.append((sev, rid, path, line_no, lines[line_no - 1].strip()[:90], what, fix, why, src))
    for rid, sev, fn, what, fix, why, src in COMPUTED:
        seen = set()
        for off, _detail in fn(text):
            line_no = text[:off].count("\n") + 1
            if line_no in seen:
                continue
            seen.add(line_no)
            hits.append((sev, rid, path, line_no, lines[line_no - 1].strip()[:90], what, fix, why, src))
    return hits


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("paths", nargs="+")
    ap.add_argument("--max", type=int, default=None, help="exit 1 above this many hits")
    ap.add_argument("--fix-help", action="store_true", help="print the replacement for each rule that fired")
    a = ap.parse_args()

    files = []
    for p in a.paths:
        p = pathlib.Path(p)
        if p.is_file():
            files.append(p)
        else:
            files += [f for f in p.rglob("*") if f.suffix in EXT and not (SKIP & set(f.parts))]

    hits = []
    for f in sorted(set(files)):
        hits += scan(f)

    order = {"high": 0, "med": 1, "low": 2}
    hits.sort(key=lambda h: (order[h[0]], h[1]))

    # COMPUTED rules carry the same 7-field shape, so authority() reads them
    # identically. Leaving them out of this map was a KeyError on any file
    # that only a computed rule fired on.
    by_id = {r[0]: r for r in RULES}
    by_id.update({r[0]: r for r in COMPUTED})
    blocking = [h for h in hits if authority(by_id[h[1]]) == "EXTERNAL" and h[0] == "high"]
    advisory = [h for h in hits if h not in blocking]

    if not hits:
        print(f"clean. {len(files)} file(s), no generated-UI tells.")
        return 0

    def render(group, header):
        if not group:
            return
        print(f"\n{header}\n")
        for sev, rid, path, line, snippet, what, _f, why, src in group:
            tag = authority(by_id[rid])
            print(f"{sev.upper():4s} [{tag}] {path}:{line}  [{rid}]  {what}")
            print(f"       {snippet}")
            print(f"       COSTS: {why}")
            if tag == "EXTERNAL":
                print(f"       AUTHORITY: {src}")

    render(blocking, "BLOCKING. These cite a standard this tool did not write.")
    render(advisory, "ADVISORY. This repo's reading. Disagree and move on; "
                     "put it in DENY.md if you want it enforced.")

    fired = []
    for h in hits:
        if h[1] not in [f[0] for f in fired]:
            fired.append((h[1], h[6], h[8]))

    if a.fix_help:
        print("\nwhat to do instead:")
        for rid, fix, src in fired:
            print(f"  {rid}: {fix}")
            print(f"    source: {src}")

    high = sum(1 for h in hits if h[0] == "high")
    print(f"\n{len(hits)} hit(s) across {len(files)} file(s), {high} high. "
          f"{len(fired)} distinct tell(s).")
    if not a.fix_help:
        print("run with --fix-help for the replacement for each.")

    print(f"\n{len(blocking)} blocking, {len(advisory)} advisory.")
    if advisory:
        print("Advisory findings never fail a build. If one is right for this "
              "project, add it to DENY.md and it becomes enforceable.")

    # Only borrowed or declared authority can fail anything.
    if a.max is not None and len(blocking) > a.max:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
