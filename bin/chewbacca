#!/usr/bin/env bash
# chewbacca: the one command. Everything else is implementation.
#
# The repo root used to be six shell scripts with similar names, and a new
# reader had to work out which of start.sh, install.sh and setup.sh was theirs.
# It also meant the README documented `chewbacca doctor`, a command that did not
# exist, which is the same failure the kit adds doctor checks for.
#
# So: one verb-shaped entry point that finds the repo wherever it lives. The
# subcommand table below is the single source of truth for help, completion,
# and dispatch, so a new verb cannot exist without being documented.

set -uo pipefail

# Where the kit actually is. Follows the symlink this is usually installed as,
# so `chewbacca` works from ~/.local/bin without hardcoding a clone path.
resolve_root() {
  if [ -n "${CHEWBACCA_ROOT:-}" ] && [ -d "$CHEWBACCA_ROOT" ]; then
    printf '%s' "$CHEWBACCA_ROOT"
    return
  fi
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ $src != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")/.." && pwd
}

ROOT="$(resolve_root)"
STATE="$HOME/.chewbacca"

# name|one-line help. Help output, shell completion, and the unknown-command
# error all read this, so they cannot disagree with each other.
COMMANDS=(
  "open|the whole kit on one screen"
  "doctor|check the install and say what is broken"
  "status|what is installed, what is on, what is stale"
  "version|version installed here and in the repo"
  "setup|full setup on this machine (asks nothing)"
  "agent|plan, install, inspect or launch a runtime adapter"
  "ux-learning|record UX evidence and inspect portable navigation maps"
  "jev|typed TypeSafe decisions and semantic skill suggestions"
  "decision-lab|compare bounded Jev decisions with verified outcomes"
  "ux-decision|recommend controls from fresh observed and permitted states"
  "ux-policy|learn offline action rewards and plan evidence-backed graph routes"
  "clay-review|verify at most five held Clay draft records without model calls"
  "task-graph|manage durable agent jobs and verification dependencies"
  "work-ledger|preserve workspace commitments across messages and runtimes"
  "tabs|see what every other live agent tab is doing, in any runtime"
  "graph-fuse|inspect possible entity matches without merging records"
  "review-gate|run independent code review and check its current receipt"
  "update|pull the latest, show what changed, re-run setup"
  "changelog|what changed between versions"
  "skills|list, search, or show a skill"
  "commands|list, search, or show a slash command"
  "why|which rule or skill governs a behavior"
  "log|what the kit has done recently"
  "bench|time the things that run on every session"
  "context|measure what the kit costs you before you type"
  "evals|run the skill evals"
  "gtme-math|compute offline cost, funnel, and heldout metrics"
  "gtme-graph|track GTM dependencies, budgets, and evidence"
  "gtme-learning|compare paired workflow experiments offline"
  "gtme-library|index and search a local source corpus"
  "gtme-dedupe|cluster duplicate people across contact CSVs"
  "gtme-signals|list recent SEC Form D raises as buying signals"
  "gtm|every client's campaigns, sends, replies and meetings, from the local graph"
  "jobs|one queue for long and heavy work: runs it when the Mac has room"
  "api|any website as an API: call taught sites, teach new ones (not Clay)"
  "clay|any Clay read without opening Clay, by the fastest surface (clay ops)"
  "clay-fixture-check|compare a CSV export with an expected fixture"
  "oss-apps|open source apps that replace a Mac app, and which can be remixed"
  "task-graph|track local jobs, ownership, and dependencies"
  "ux-learning|record UX evidence and inspect portable navigation maps"
  "live|check the real tools on this machine, not just the install"
  "guide|interactive study guides that remember what you got wrong"
  "triggers|say things out loud and see whether any skill fires"
  "export|bundle this machine's kit state"
  "import|bring in what your other AI tools know (scan, apply, undo), or restore a bundle"
  "completion|print shell completion for zsh, bash, or fish"
  "add-skill|add a skill to the kit"
  "install|copy the standards into the current project"
  "uninstall|remove what setup put on this machine"
  "where|print where the kit is installed"
)

usage() {
  echo "chewbacca: shared context and tools for your coding agents"
  echo
  local name help
  for entry in "${COMMANDS[@]}"; do
    name="${entry%%|*}"; help="${entry#*|}"
    printf '  chewbacca %-12s %s\n' "$name" "$help"
  done
  echo
  echo "Runtime setup: chewbacca agent setup --runtime claude-code|codex|both"
  echo "ChatGPT Web: mac-use --provider chatgpt-web, or chatgpt-gateway --help."
}

run() {
  local script="$ROOT/$1"
  shift
  if [ ! -f "$script" ]; then
    echo "chewbacca: missing $script" >&2
    echo "  The kit may have moved. Set CHEWBACCA_ROOT, or re-run the installer." >&2
    exit 1
  fi
  bash "$script" "$@"
}

repo_version() { cat "$ROOT/VERSION" 2>/dev/null || echo "unknown"; }
installed_version() { cat "$STATE/version" 2>/dev/null || echo "unrecorded"; }

case "${1:-}" in
task-graph|graph-fuse|review-gate|work-ledger|tabs|ux-learning|jev|decision-lab|ux-decision|ux-policy|clay-review|gtme-math|gtme-graph|gtme-learning|gtme-library|gtme-signals|gtm|clay-fixture-check|oss-apps)
  tool="$1"
  shift
  exec python3 "$ROOT/bin/$tool" "$@"
  ;;
gtme-dedupe)
  # Bash, not python: it picks the venv that has splink.
  shift
  exec bash "$ROOT/bin/gtme-dedupe" "$@"
  ;;
agent)
  shift
  exec python3 "$ROOT/tools/agent_runtime.py" "$@"
  ;;
clay)
  # Clay through the CLI, its own frontend API (api-anything), or the UI
  # route, whichever answers fastest. Writes need --allow-writes and --confirm.
  shift
  CHEWBACCA_ROOT="$ROOT" exec node "$ROOT/bin/chewbacca-clay" "$@"
  ;;
slack)
  # Slack sending through slackcli; reading needs nothing.
  shift
  exec bash "$ROOT/bin/chewbacca-slack" "$@"
  ;;
email)
  # Every inbox, one `chewbacca email add` each. Read and sent through the
  # Gmail API, never Mail.app.
  shift
  exec bash "$ROOT/bin/chewbacca-email" "$@"
  ;;
whatsapp)
  # WhatsApp is part of the kit: link, status and sync live here, and the
  # engines underneath are installed and driven for you.
  shift
  exec bash "$ROOT/bin/chewbacca-whatsapp" "$@"
  ;;
permissions|permission|perms)
  # Every macOS grant Chewbacca needs, walked one card at a time over System
  # Settings, each closing itself once detected. No args = the guide, because
  # "make it SUPER EZ" (Caleb, 2026-10-10) means one command, not a menu.
  shift
  [ $# -eq 0 ] && set -- guide
  exec python3 "$ROOT/bin/chewbacca-permissions" "$@"
  ;;
jobs)
  # The machine queue. See bin/chewbacca-jobs.
  shift
  exec python3 "$ROOT/bin/chewbacca-jobs" "$@"
  ;;
api)
  # Websites with no API, called over plain HTTP from operations learned off
  # their own frontend. Engine: goodnight000/api-anything.
  shift
  exec bash "$ROOT/bin/chewbacca-api" "$@"
  ;;
connect)
  # One verb wires every installed app (Claude Code, Codex, Cursor, Gemini)
  # and rebuilds the ChatGPT and claude.ai exports from the same sources.
  shift
  exec python3 "$ROOT/tools/agent_runtime.py" connect "$@"
  ;;
open)
  shift
  # A dashboard nobody can find is a file. This is the one verb that is worth
  # typing, so it gets the shortest name in the table.
  CHEWBACCA_ROOT="$ROOT" exec node "$ROOT/bin/lib/chewbacca-hud.js" "$@"
  ;;
doctor)
  shift
  run doctor.sh "$@"
  ;;
setup)
  shift
  run setup.sh "$@"
  ;;
add-skill)
  shift
  run add-skill.sh "$@"
  ;;
install)
  shift
  run install.sh "$@"
  ;;
uninstall)
  shift
  run uninstall.sh "$@"
  ;;
update)
  shift
  BEFORE="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo none)"
  git -C "$ROOT" pull --ff-only || {
    echo "chewbacca: could not fast-forward. Fix the working tree first:" >&2
    echo "  cd $ROOT && git status" >&2
    exit 1
  }
  AFTER="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo none)"
  if [ "$BEFORE" != "$AFTER" ] && [ "$BEFORE" != none ]; then
    echo
    echo "What changed:"
    git -C "$ROOT" log --oneline --no-decorate "$BEFORE..$AFTER" | sed 's/^/  /'
    echo
  else
    echo "Already current at $(repo_version)."
  fi
  run setup.sh "$@"
  ;;
version)
  shift
  if [ "${1:-}" = "--json" ]; then
    printf '{"repo":"%s","installed":"%s","commit":"%s","root":"%s"}\n' \
      "$(repo_version)" "$(installed_version)" \
      "$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)" "$ROOT"
  else
    echo "repo:      $(repo_version)  ($(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo 'not a git checkout'))"
    echo "installed: $(installed_version)"
    [ "$(repo_version)" != "$(installed_version)" ] &&
      echo "            these differ. Run: chewbacca setup"
  fi
  ;;
changelog)
  shift
  if [ -f "$ROOT/CHANGELOG.md" ]; then
    "${PAGER:-cat}" "$ROOT/CHANGELOG.md"
  else
    git -C "$ROOT" log --oneline -30
  fi
  ;;
status)
  shift
  run bin/lib/status.sh "$@"
  ;;
skills)
  shift
  run bin/lib/skills.sh "$@"
  ;;
commands)
  shift
  run bin/lib/commands.sh "$@"
  ;;
why)
  shift
  run bin/lib/why.sh "$@"
  ;;
log)
  shift
  run bin/lib/log.sh "$@"
  ;;
bench)
  shift
  run bin/lib/bench.sh "$@"
  ;;
context)
  shift
  python3 "$ROOT/tools/context_cost.py" "$@"
  ;;
evals)
  shift
  python3 "$ROOT/tools/evals.py" "$@"
  ;;
live)
  shift
  run bin/live-check "$@"
  ;;
guide)
  shift
  python3 "$ROOT/bin/guide" "$@"
  ;;
triggers)
  shift
  python3 "$ROOT/tools/triggers.py" "$@"
  ;;
export)
  shift
  run bin/lib/export.sh "$@"
  ;;
import)
  shift
  # scan, apply and undo bring in what Claude Code, Codex, Cursor or a chat
  # export already know. Anything else is a bundle path for the restore.
  case "${1:-}" in
  scan|apply|undo) exec python3 "$ROOT/tools/context_import.py" "$@" ;;
  esac
  run bin/lib/import.sh "$@"
  ;;
completion)
  shift
  run bin/lib/completion.sh "$@"
  ;;
where)
  printf '%s\n' "$ROOT"
  ;;
"" | -h | --help | help)
  usage
  ;;
*)
  echo "chewbacca: unknown command '$1'" >&2
  # Nearest match beats a bare error. A typo should cost one line, not a re-read.
  NEAR="$(for e in "${COMMANDS[@]}"; do echo "${e%%|*}"; done | grep -i "^${1:0:3}" | head -1)"
  [ -n "$NEAR" ] && echo "  did you mean: chewbacca $NEAR" >&2
  echo >&2
  usage >&2
  exit 1
  ;;
esac
