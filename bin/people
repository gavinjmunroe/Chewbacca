#!/usr/bin/env node
// @ts-nocheck
// node:sqlite is still flagged experimental, and it prints a warning to stderr
// on every single invocation. In a CLI people run twenty times a day that is
// not a warning, it is noise that trains them to ignore stderr.
process.removeAllListeners("warning");
/**
 * people: everything you know about the people in your life, in one place you own.
 *
 * The design here is ported from Amber's identity service with the permission of
 * its authors, Karthik Devarakonda and Sagar Tiwari. The good ideas are theirs:
 * one observations table instead of seven, modality as a column rather than a
 * tag, scoring knobs as rows rather than constants, and permissions where the
 * absence of a grant means no. What changed is the setting. Amber is a
 * multi-tenant Cloud SQL service; this is one person's SQLite file on their own
 * laptop, so tenancy is gone and everything else survives.
 *
 * Zero dependencies. Node 22.5+ for node:sqlite.
 *
 * Storage:
 *   $PEOPLE_DIR (default ~/.chewbacca/people)
 *     people.db          the database
 *     export/            markdown, written by `people export`
 *
 * Sync is opt-in: `people sync init <git-url>` and the directory becomes a repo.
 *
 * Every command lives in bin/lib/people/, one module per concern, each opening
 * with what it owns. What stays here is the dispatch table.
 */

"use strict";

const { c, die, say } = require("./lib/people/output");
const { cmdDims, cmdTune, cmdScore } = require("./lib/people/scoring");
const { cmdHistory, cmdTrend, cmdSnapshot } = require("./lib/people/history");
const {
  cmdDate, cmdTask, cmdLoan, cmdRel, cmdCheckOn, cmdAsk, cmdFact,
} = require("./lib/people/commitments");
const { cmdAdd, cmdNote, cmdMe, cmdLog } = require("./lib/people/observations");
const { cmdShow, cmdList, cmdRank, cmdSearch } = require("./lib/people/show");
const { cmdEvents } = require("./lib/people/events");
const { cmdCircle, cmdClassify } = require("./lib/people/circles");
const { cmdExport, cmdSync } = require("./lib/people/export");
const { cmdAlias, cmdIdentify, cmdIdentities } = require("./lib/people/identities");
const { cmdDistill, cmdBridgeFacts } = require("./lib/people/distill");
const { cmdCheck, cmdStats } = require("./lib/people/health");
const { cmdResolve } = require("./lib/people/resolve");
const { cmdLinkedin } = require("./lib/people/linkedin");
const { cmdWho } = require("./lib/people/who");
const { cmdInfer } = require("./lib/people/infer");
const {
  cmdUpdate, cmdMute, cmdUnmute, cmdMuted, cmdMine, cmdReconnect, cmdBirthdays, cmdToday,
  cmdIntro,
} = require("./lib/people/keeping-up");
const { cmdImport } = require("./lib/people/import");
const { cmdTexts } = require("./lib/people/texts");
const { cmdSend } = require("./lib/people/send");
const {
  cmdPurge, cmdDedupe, cmdMerge, cmdOrgs, cmdPruneBroadcasts,
} = require("./lib/people/cleanup");
const { cmdBrief } = require("./lib/people/brief");
const { cmdDashboard } = require("./lib/people/dashboard");
const { HELP } = require("./lib/people/help");

// ---------------------------------------------------------------- dispatch

const COMMANDS = {
  add: cmdAdd,
  dedupe: cmdDedupe,
  orgs: cmdOrgs,
  "prune-broadcasts": cmdPruneBroadcasts,
  brief: cmdBrief,
  merge: cmdMerge,
  note: cmdNote,
  me: cmdMe,
  log: cmdLog,
  show: cmdShow,
  list: cmdList,
  ls: cmdList,
  circle: cmdCircle,
  circles: (a) => cmdCircle(["list", ...a]),
  update: cmdUpdate,
  set: cmdUpdate,
  date: cmdDate,
  dates: (a) => cmdDate(["list", ...a]),
  task: cmdTask,
  tasks: (a) => cmdTask(["list", ...a]),
  owe: (a) => cmdTask(["list", ...a]),
  loan: cmdLoan,
  loans: (a) => cmdLoan(["list", ...a]),
  rel: cmdRel,
  "check-on": cmdCheckOn,
  ask: cmdAsk,
  fact: cmdFact,
  texts: cmdTexts,
  send: cmdSend,
  msgs: cmdTexts,
  today: cmdToday,
  mine: cmdMine,
  alias: cmdAlias,
  distill: cmdDistill,
  identify: cmdIdentify,
  purge: cmdPurge,
  who: cmdWho,
  infer: cmdInfer,
  identities: cmdIdentities,
  "bridge-facts": cmdBridgeFacts,
  resolve: cmdResolve,
  linkedin: cmdLinkedin,
  li: cmdLinkedin,
  classify: cmdClassify,
  aliases: cmdAlias,
  mute: cmdMute,
  unmute: cmdUnmute,
  muted: cmdMuted,
  reconnect: cmdReconnect,
  due: cmdReconnect,
  birthdays: cmdBirthdays,
  bdays: cmdBirthdays,
  intro: cmdIntro,
  import: cmdImport,
  rank: cmdRank,
  search: cmdSearch,
  find: cmdSearch,
  dims: cmdDims,
  tune: cmdTune,
  score: cmdScore,
  history: cmdHistory,
  trajectory: cmdHistory,
  trend: cmdTrend,
  drifting: cmdTrend,
  snapshot: cmdSnapshot,
  events: cmdEvents,
  timeline: (a) => cmdEvents(["list", ...a]),
  export: cmdExport,
  sync: cmdSync,
  check: cmdCheck,
  stats: cmdStats,
  dashboard: cmdDashboard,
  dash: cmdDashboard,
};

function main() {
  const argv = process.argv.slice(2);
  const cmd = argv.shift();
  if (!cmd || cmd === "help" || cmd === "--help" || cmd === "-h") {
    process.stdout.write(HELP);
    return;
  }
  if (cmd === "--version" || cmd === "version") return say("people 1.0.0");
  const fn = COMMANDS[cmd];
  if (!fn) {
    process.stderr.write(c.red(`people: unknown command "${cmd}"\n\n`));
    process.stdout.write(HELP);
    process.exit(1);
  }
  fn(argv);
}

try {
  main();
} catch (e) {
  const msg = e && e.message ? e.message : String(e);
  // A raw "CHECK constraint failed: modality IN (...)" is the database talking
  // to itself. Say which flag was wrong and what it accepts instead.
  const check = msg.match(/CHECK constraint failed:\s*(\w+) IN \(([^)]*)\)/);
  if (check) {
    const opts = check[2].replace(/'/g, "").split(",").map((s) => s.trim()).join(", ");
    die(`Not a valid --${check[1]}. Use one of: ${opts}`);
  }
  if (/FOREIGN KEY constraint failed/.test(msg))
    die("That points at something that no longer exists. Run: people check");
  if (/UNIQUE constraint failed/.test(msg)) die("That already exists.");
  die(msg);
}
