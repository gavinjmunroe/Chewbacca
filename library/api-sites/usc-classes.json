          "template": "https://classes.usc.edu/term/{termCode}/catalogue/search?searchphrase={query}"
        },
        {
          "ref": "session:searchCourses/x-csrf",
          "at": [
            "header:x-csrf"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://classes.usc.edu/term/{termCode}/catalogue/search?searchphrase={query}"
      },
      "match": {
        "path": "/api/Search/Basic"
      },
      "response": {
        "format": "json",
        "contentType": "application/json; charset=utf-8",
        "extract": "courses",
        "pick": [
          "code=scheduledCourseCode.courseHyphen",
          "title=name",
          "units=courseUnits",
          "description",
          "seatsTotal=sectionSeatCount",
          "seatsRemaining=remainingSectionSeats"
        ]
      },
      "params": [
        {
          "name": "termCode",
          "type": "string",
          "required": true,
