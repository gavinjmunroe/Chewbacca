// Development build configuration.
// Points iOS at dev-tier amber-agent and amber-id.
// DO NOT put secrets here. Keep API keys in Keychain or CI secrets.
//
// xcconfig "//" escape: a literal "//" starts a line comment, so we split the
// scheme separator across the variable boundary using xcconfig variable
// concatenation. AMBER_URL_SCHEME expands to "https://" without tripping the
// comment lexer, and consumers concatenate it with the host.

AMBER_URL_SCHEME = https:/$()/

AMBER_AGENT_BASE_URL = $(AMBER_URL_SCHEME)amber-agent-development.up.railway.app
AMBER_ID_BASE_URL = $(AMBER_URL_SCHEME)amber-id-development.up.railway.app
PRIVY_APP_ID = REPLACE_WITH_PRIVY_DEV_APP_ID
PRIVY_APP_CLIENT_ID = REPLACE_WITH_PRIVY_DEV_CLIENT_ID
COMPOSIO_PROJECT_ID = REPLACE_WITH_COMPOSIO_DEV_PROJECT_ID
AMBER_ENVIRONMENT = development

PRODUCT_BUNDLE_IDENTIFIER = com.amber.AmberApp.dev
DISPLAY_NAME = Amber Dev
ASSETCATALOG_COMPILER_APPICON_NAME = AppIconDev
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG AMBER_DEV
