{
  "name": "@togari/admin",
  "version": "1.0.0",
  "description": "Togari Admin — shared infrastructure library + Cloud Run service for all Togari MCP servers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node build.mjs",
    "build:lib": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.42",
    "@anthropic-ai/sdk": "^0.35.0",
    "@google-cloud/bigquery": "^7.9.1",
    "@google-cloud/pubsub": "^5.3.0",
    "@google-cloud/secret-manager": "^6.1.1",
    "@google-cloud/storage": "^7.14.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@sentry/node": "^10.46.0",
    "@slack/web-api": "^7.8.0",
    "ai": "^5.0.137",
    "cockatiel": "^3.2.1",
    "content-type": "^1.0.5",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-oauth2-jwt-bearer": "^1.7.4",
    "googleapis": "^130.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "openai": "^4.77.0",
    "rate-limiter-flexible": "^10.0.1",
    "raw-body": "^3.0.2",
    "uuid": "^10.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.17",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "xlsx": "^0.18.5"
  }
}
