# Analytics & Error Tracking Configuration

# Sentry DSN for error tracking and crash reporting
# Get this from your Sentry project settings: https://sentry.io
EXPO_PUBLIC_SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0000000

# Environment (development, staging, production)
EXPO_PUBLIC_ENVIRONMENT=development

# API Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_ERROR_TRACKING=true

# Debug Mode
EXPO_PUBLIC_DEBUG_MODE=false
