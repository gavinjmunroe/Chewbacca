#!/usr/bin/env bash
# mac-use: one-shot macOS UI agent powered by browser-use/macOS-use.
# Chewbacca owns the provider adapters; macOS-use supplies the runtime/venv.
set -euo pipefail

export ANONYMIZED_TELEMETRY="${ANONYMIZED_TELEMETRY:-false}"

# setup.sh clones to ~/code/refs; ~/Projects is where installs before the
# 2026-10-03 code reorg put it, and where this script still looked, so every
# reorganised machine reported a missing venv that was sitting one folder over.
# The first of the two with a working venv wins, so a half-finished clone in
# the new place never hides a working install in the old one.
if [ -n "${MACOS_USE_HOME:-}" ]; then
  MACOS_USE="$MACOS_USE_HOME"
else
  MACOS_USE="$HOME/code/refs/macOS-use"
  for _d in "$HOME/code/refs/macOS-use" "$HOME/Projects/macOS-use"; do
    [ -x "$_d/.venv/bin/python" ] && { MACOS_USE="$_d"; break; }
  done
fi
PY="$MACOS_USE/.venv/bin/python"

if [ ! -x "$PY" ]; then
  echo "mac-use: macOS-use venv missing at $MACOS_USE/.venv" >&2
  echo "  run: chewbacca setup --only tools" >&2
  exit 1
fi

# Resolve this launcher, including ~/.local/bin symlinks. Another checkout's
# chewbacca command on PATH must never redirect provider ownership.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
CHEWBACCA_ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"

CLI="$CHEWBACCA_ROOT/bin/mac_use_cli.py"
[ -f "$CLI" ] || {
  echo "mac-use: provider CLI missing at $CLI" >&2
  exit 1
}

export PYTHONPATH="$CHEWBACCA_ROOT/bin${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" "$CLI" "$@"
