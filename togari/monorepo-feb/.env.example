# ============================================
# GCP / BigQuery Configuration
# ============================================
GCP_PROJECT_ID=togari-prod
GCP_KEY_FILE=./gcp-key.json
BIGQUERY_LOCATION=US
BIGQUERY_DATASET_RAW=raw_data
BIGQUERY_DATASET_ENRICHED=enriched
BIGQUERY_DATASET_ANALYTICS=analytics
BIGQUERY_DATASET_PROCUREMENT=procurement

# ============================================
# MCP Server API Keys
# ============================================

# Exa - AI-powered search
EXA_API_KEY=your_exa_api_key_here

# Structify - Data transformation pipeline (NOT storage!)
# Get your API key from: https://app.structify.ai/settings
STRUCTIFY_API_KEY=your_structify_api_key_here
STRUCTIFY_DATASET_ID=your_dataset_id_here

# Happenstance - Healthcare data
HAPPENSTANCE_API_KEY=your_happenstance_key

# Serif Health - Healthcare provider data
SERIF_HEALTH_CLIENT_ID=your_serif_client_id
SERIF_HEALTH_CLIENT_SECRET=your_serif_secret
SERIF_HEALTH_API_URL=https://api.serifhealth.com

# ============================================
# API Server Configuration
# ============================================
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000

# Frontend Configuration (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================
# Amber Integration
# ============================================
AMBER_API_KEY=dev_test_key_change_in_production
AMBER_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# Worker/Queue Configuration
# ============================================
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5
SYNC_INTERVAL_MINUTES=15

# ============================================
# n8n Workflow Integration
# ============================================
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_PATH=/webhook/amber-enrichment

# ============================================
# Development Flags
# ============================================
USE_MOCK_STRUCTIFY=false

# ============================================
# Optional: AI & LLMs
# ============================================
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# ============================================
# Optional: Monitoring
# ============================================
SENTRY_DSN=your_sentry_dsn
LOG_LEVEL=info
