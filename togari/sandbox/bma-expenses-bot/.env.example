# ---- Slack ----
# From api.slack.com/apps -> your app
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
# App-level token with connections:write (Socket Mode). Required when SLACK_SOCKET_MODE=true.
SLACK_APP_TOKEN=xapp-...
# true = Socket Mode (local/dev, no public URL). false = HTTP events (prod on Railway).
SLACK_SOCKET_MODE=true
# Channel where approval cards are posted, e.g. C0123456789 (the ID, not the name).
APPROVALS_CHANNEL_ID=C0000000000

# Slack user IDs allowed to approve/reject (comma separated). Sagar, Karthik.
APPROVER_SLACK_IDS=U0000000000,U1111111111

# ---- Supabase ----
SUPABASE_URL=https://xxxx.supabase.co
# Service-role key (server side only, never ship to a client).
SUPABASE_SERVICE_ROLE_KEY=...
# Storage bucket for receipt copies. Create it as a private bucket.
SUPABASE_RECEIPTS_BUCKET=receipts

# ---- Google Sheets (accounting ledger) ----
GOOGLE_SHEET_ID=...
# Tab name inside the sheet to append to.
GOOGLE_SHEET_TAB=Reimbursements
# Service-account credentials. Provide ONE of these:
#   - GOOGLE_SERVICE_ACCOUNT_JSON: the full JSON blob as a single-line string
#   - GOOGLE_APPLICATION_CREDENTIALS: path to a JSON key file on disk
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# ---- App ----
PORT=3000
