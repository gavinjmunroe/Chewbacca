          "x-csrf": ""
        }
      },
      "slots": [
        {
          "param": "termCode",
          "at": [
            "query:termCode"
          ]
        },
        {
          "param": "query",
          "at": [
            "query:searchTerm"
          ]
        },
        {
          "param": "termCode",
          "at": [
            "header:referer"
