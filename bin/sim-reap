#!/usr/bin/env python3
"""Shut down iOS simulators that are booted with nothing using them.

On 2026-10-10 the Mac was at load 19 to 37 with 15% memory free, and an
iPhone 17 Pro simulator was booted headless: about 160 processes (healthd,
pairedsyncd and the rest) with Simulator.app closed and no build or test
attached. Nobody remembered booting it.

A simulator counts as orphaned when Simulator.app isn't running and no
process that drives one (xcodebuild, simctl, expo, detox, maestro, appium,
react-native) is alive. Then `xcrun simctl shutdown all`. Booting it again
takes seconds and loses nothing, so this runs without asking.

    sim-reap            shut down orphaned simulators
    sim-reap --dry-run  say what it would do
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys

DRIVERS = ("Simulator", "xcodebuild", "simctl spawn", "simctl launch", "simctl io",
           "expo", "detox", "maestro", "appium", "react-native")


def _run(cmd: str) -> str:
    try:
        return subprocess.run(shlex.split(cmd), capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def booted() -> list[str]:
    raw = _run(os.environ.get("SIM_REAP_LIST_CMD", "xcrun simctl list devices booted -j"))
    try:
        devices = json.loads(raw).get("devices", {})
    except ValueError:
        return []
    return [d.get("name", "?") for group in devices.values() for d in group
            if d.get("state") == "Booted"]


def drivers_alive() -> list[str]:
    procs = _run(os.environ.get("SIM_REAP_PS_CMD", "ps -Ao command="))
    alive = []
    for line in procs.splitlines():
        if "sim-reap" in line:
            continue
        name = line.split("/")[-1] if line.startswith("/") else line
        for d in DRIVERS:
            if d == "Simulator":
                if "/Simulator.app/Contents/MacOS/Simulator" in line:
                    alive.append(d)
            elif d in name:
                alive.append(d)
    return sorted(set(alive))


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()
    names = booted()
    if not names:
        print("no booted simulators")
        return 0
    alive = drivers_alive()
    if alive:
        print(f"leaving {', '.join(names)} booted: in use by {', '.join(alive)}")
        return 0
    if args.dry_run:
        print(f"would shut down {', '.join(names)}")
        return 0
    _run(os.environ.get("SIM_REAP_SHUTDOWN_CMD", "xcrun simctl shutdown all"))
    print(f"shut down {', '.join(names)}: booted with nothing using them")
    return 0


if __name__ == "__main__":
    sys.exit(main())
