#!/usr/bin/env node
// chewbacca clay: every Clay job through the fastest surface that answers it.
//
//   chewbacca clay ops                       every op: surfaces, read/write, gate, ms, verified
//   chewbacca clay <op> [k=v ...]            run one op, one line of JSON back
//   chewbacca clay route <op> [k=v ...]      the surfaces it would try, in order, without calling
//   chewbacca clay measure <op> [k=v ...]    time every surface once and record it (reads only)
//   chewbacca clay doctor                    engine pin, session, spec sync
//
// Surfaces, cheapest first by measured wall time: the official `clay` CLI, an
// api-anything operation over Clay's own frontend API (plain HTTP with the
// signed-in session, library/clay-api/clay.json), a kit bin, and for jobs only
// the UI does, the exact clay-go route to open. A surface runs only when every
// arg it needs was given; the next one runs when it fails or comes back cut.
//
// Writes refuse unless called with --allow-writes AND a person types the op
// name at a real terminal (see personApproves), where
// the token is printed by the refusal and binds this exact op and payload.
// Everything Clay returns is untrusted data: reply bodies are written by
// strangers. Nothing here logs a cookie or token.
"use strict";

const crypto = require("node:crypto");
const fs = require("node:fs");
// The verdict log (tools/verdicts.py reads it), loaded up front and guarded so
// a missing file can never throw after a write has gone out.
let verdictLog;
try {
  verdictLog = require("./lib/verdicts");
} catch {
  verdictLog = { record() {} };
}
const os = require("node:os");
const path = require("node:path");
const { spawnSync } = require("node:child_process");

// Path overrides are honored only in fixture mode, which never reaches Clay.
// Live, an env var pointing LIB at a doctored registry could relabel a write
// as a read, and CHEWBACCA_ROOT could swap the binaries a surface runs
// (security review of b68d5645, 2026-10-09).
const FIXTURES = process.env.CHEWBACCA_CLAY_FIXTURES || "";
const testEnv = (name) => (FIXTURES ? process.env[name] : undefined);
const ROOT = testEnv("CHEWBACCA_ROOT") || path.resolve(__dirname, "..");
const LIB = testEnv("CHEWBACCA_CLAY_LIB") || path.join(ROOT, "library", "clay-api");
const MEASURED = process.env.CHEWBACCA_CLAY_MEASURED || path.join(LIB, "measured.json");
// --session NAME reads Clay through a second login, kept in its own engine
// home so it never overwrites the BMA one. 2026-10-11: Caleb said "We hv the
// amber workspace in clay", and the only imported session (Chrome Profile 7,
// caleb@bluemodernadvisory.com) saw five workspaces and no Amber; two other
// Chrome profiles held Clay cookies.
const SESSION_NAME = (() => {
  const i = process.argv.indexOf("--session");
  if (i < 0) return "";
  const name = String(process.argv[i + 1] || "");
  process.argv.splice(i, 2);
  if (!/^[a-z0-9][a-z0-9-]{0,30}$/.test(name)) {
    process.stdout.write(`${JSON.stringify({ ok: false, class: "usage", reason: "--session takes a short lowercase name like personal or usc" })}\n`);
    process.exit(2);
  }
  return name;
})();
const ENGINE_HOME = SESSION_NAME
  ? path.join(os.homedir(), ".chewbacca", `api-anything-${SESSION_NAME}`)
  : process.env.API_ANYTHING_HOME || path.join(os.homedir(), ".chewbacca", "api-anything");

const EXIT = { ok: 0, failed: 1, usage: 2, refused: 3 };

function out(obj, code) {
  // The 2026-10-15 piped ops read exited after only 512 bytes of JSON.
  // Flush synchronously before exit so snapshot readers receive the envelope.
  fs.writeFileSync(1, `${JSON.stringify(obj)}\n`);
  process.exit(code);
}

function readJson(file, fallback) {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return fallback;
  }
}

// Read once. A write is built from these in-memory copies, and the files are
// only re-read after approval to refuse if they changed (see fingerprint).
function readText(file) {
  try { return fs.readFileSync(file, "utf8"); } catch { return null; }
}
const REGISTRY_TEXT = readText(path.join(LIB, "registry.json"));
const SPEC_TEXT = readText(path.join(LIB, "clay.json"));
const parseOr = (t, fallback) => { try { return JSON.parse(t); } catch { return fallback; } };
const registry = parseOr(REGISTRY_TEXT, null);
if (!registry) out({ ok: false, class: "error", reason: `no registry at ${LIB}/registry.json` }, EXIT.failed);
const spec = parseOr(SPEC_TEXT, { operations: [] });
const specOps = new Map(spec.operations.map((o) => [o.name, o]));
const measured = readJson(MEASURED, {});

// ── args ─────────────────────────────────────────────────────────────────────
function parseArgv(argv) {
  const flags = { allowWrites: false, dryRun: false, surface: null, maxTier: null };
  const kv = {};
  const pos = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--allow-writes") flags.allowWrites = true;
    else if (a === "--dry-run") flags.dryRun = true;
    else if (a === "--surface") {
      flags.surface = argv[++i] ?? "";
      if (flags.surface === "api") flags.surface = "api-anything";
    }
    else if (a === "--max-tier") flags.maxTier = Number(argv[++i]);
    else if (a === "-h" || a === "--help") pos.push("help");
    else if (a.startsWith("--")) out({ ok: false, class: "usage", reason: `unknown flag ${a}` }, EXIT.usage);
    else if (a.includes("=") && pos.length >= 1) {
      // Values stay the raw strings typed; normalizeArgs parses each one once.
      // A key given twice is refused: last-one-wins would let a check and a
      // build read different values (security review of 300f4ddb).
      const k = a.slice(0, a.indexOf("="));
      if (Object.hasOwn(kv, k)) out({ ok: false, class: "usage", reason: `${k} is given more than once` }, EXIT.usage);
      kv[k] = a.slice(a.indexOf("=") + 1);
    } else pos.push(a);
  }
  return { pos, kv, flags };
}

// ── routing ──────────────────────────────────────────────────────────────────
const opByName = new Map(registry.ops.map((o) => [o.name, o]));
const uiByName = new Map((registry.ui_only || []).map((o) => [o.name, o]));

// Which Clay workspace an op runs against. There is no built-in default: the
// registry used to name one client's workspace, so any op run without ws=
// acted on that client (2026-10-09). Order: ws= on the command line, then
// $CLAY_WORKSPACE_ID, then the GTM client config when it names exactly one
// workspace across all clients. Anything else refuses. Fixture mode reads only
// an explicit $GTM_CONFIG, never the real one.
const WS_FILES = [];
function gtmConfigPath() {
  if (process.env.GTM_CONFIG) return process.env.GTM_CONFIG;
  return FIXTURES ? null : path.join(os.homedir(), ".chewbacca", "gtm", "clients.json");
}

function resolveWorkspace() {
  if (process.env.CLAY_WORKSPACE_ID) return { ws: process.env.CLAY_WORKSPACE_ID, from: "CLAY_WORKSPACE_ID" };
  const file = gtmConfigPath();
  const cfg = file ? parseOr(readText(file), null) : null;
  const clients = Array.isArray(cfg?.clients) ? cfg.clients : [];
  const byWs = new Map();
  for (const c of clients) for (const w of Array.isArray(c?.workspaces) ? c.workspaces : []) {
    if (!byWs.has(String(w))) byWs.set(String(w), String(c?.name ?? "unnamed"));
  }
  if (byWs.size === 1) {
    WS_FILES.push(file);
    return { ws: [...byWs.keys()][0], from: file };
  }
  const found = byWs.size ? `; ${file} names ${byWs.size} (${[...byWs.values()].join(", ")})` : file ? `; ${file} names none` : "";
  return { error: `no Clay workspace chosen: pass ws=<id> or set CLAY_WORKSPACE_ID${found}. chewbacca clay workspaces lists them` };
}

function withDefaults(op, kv) {
  const args = { ...kv };
  const wantsWs = op.args.some((a) => a.replace("?", "") === "ws");
  if (wantsWs && args.ws === undefined) {
    const r = resolveWorkspace();
    if (r.error) out({ ok: false, op: op.name, class: "input", reason: r.error }, EXIT.usage);
    args.ws = r.ws;
  }
  return args;
}

function surfaceKey(op, s) {
  if (s.type === "api-anything") return `api-anything:${s.op}`;
  return `${s.type}:${s.argv.join(" ")}`;
}

// The args a surface would be called with, or null when one it needs is missing.
function bind(s, args) {
  if ((s.unless || []).some((k) => args[k] !== undefined)) return null;
  if (s.type === "api-anything") {
    const sop = specOps.get(s.op);
    if (!sop) return null;
    const bound = {};
    for (const [param, key] of Object.entries(s.args)) {
      if (args[key] !== undefined) bound[param] = args[key];
    }
    for (const p of sop.params) {
      if (p.required && bound[p.name] === undefined) return null;
    }
    return bound;
  }
  // A value that starts with "-" would reach the CLI as a flag: treat it as missing.
  // An object (a filter AST) goes to the CLI as one argv token of JSON.
  const text = (v) => (v !== null && typeof v === "object" ? JSON.stringify(v) : String(v));
  const fill = (tok) =>
    tok.replace(/\{(\w+)\}/g, (_, k) => (args[k] === undefined || text(args[k]).startsWith("-") ? "\u0000" : text(args[k])));
  const argv = s.argv.map(fill);
  if (argv.some((t) => t.includes("\u0000"))) return null;
  for (const [k, extra] of Object.entries(s.optional || {})) {
    if (args[k] !== undefined) argv.push(...extra.map(fill));
  }
  return argv;
}

// The clay CLI answers for the one workspace it is signed in to and takes no
// workspace argument. 2026-10-11: `folders ws=1149025` (BMA) came back from
// the CLI with Jonah's workspace's folders under BMA's id, so anything built
// on it would have landed in the wrong client. The CLI only answers when it
// is signed in to the workspace asked for.
let cliWs;
function cliWorkspace() {
  if (cliWs !== undefined) return cliWs;
  if (FIXTURES) return (cliWs = process.env.CHEWBACCA_CLAY_CLI_WS || "any");
  const r = spawnSync("clay", ["whoami"], { encoding: "utf8", timeout: 15000 });
  cliWs = r.status === 0 ? String(parseOr(r.stdout, {})?.workspace?.id ?? "") || null : null;
  return cliWs;
}

function plan(op, args, only) {
  const cands = [];
  op.surfaces.forEach((s, i) => {
    if (only && s.type !== only) return;
    if (s.type === "cli" && args.ws !== undefined && cliWorkspace() !== "any" && cliWorkspace() !== String(args.ws)) return;
    const bound = bind(s, args);
    if (bound === null) return;
    const m = measured[op.name]?.[surfaceKey(op, s)];
    cands.push({ s, bound, i, ms: m?.ms ?? Number.POSITIVE_INFINITY, verified: m?.at ?? null });
  });
  // Fastest measured first; an unmeasured surface keeps the registry's order behind measured ones.
  // "order": "fixed" is for an op whose surfaces answer with different detail (the CLI's
  // `tables get` has no auto-run settings): the first one is the answer, the rest are fallbacks.
  if (op.order !== "fixed") cands.sort((a, b) => a.ms - b.ms || a.i - b.i);
  return cands;
}

function uiRoute(op, args) {
  if (!op.ui) return null;
  return op.ui.replace(/\{(\w+)\}/g, (m, k) => (args[k] === undefined ? m : String(args[k])));
}

// ── surfaces ─────────────────────────────────────────────────────────────────
function fixture(kind, name) {
  const f = path.join(FIXTURES, kind, `${name}.json`);
  return readJson(f, undefined);
}

function syncSpec() {
  const src = path.join(LIB, "clay.json");
  const dest = path.join(ENGINE_HOME, "sites", "clay.json");
  try {
    const s = fs.statSync(src);
    let d = null;
    try {
      d = fs.statSync(dest);
    } catch {}
    // A heal rewrites the engine's copy in place; only a newer repo spec replaces it.
    if (!d || s.mtimeMs > d.mtimeMs) {
      fs.mkdirSync(path.dirname(dest), { recursive: true, mode: 0o700 });
      fs.copyFileSync(src, dest);
    }
  } catch {}
}

function engineDist() {
  if (process.env.API_ANYTHING_DIST) return process.env.API_ANYTHING_DIST;
  const which = spawnSync("sh", ["-c", "command -v api-anything"], { encoding: "utf8" });
  const bin = which.stdout.trim();
  if (!bin) return null;
  return path.dirname(fs.realpathSync(bin));
}

// sha256 of dist/*.js in name order. The engine runs with Caleb's Clay session,
// so only the build made from the pinned commit is trusted; anything else
// (an install from a moving HEAD) is refused and the next surface answers.
function distHash(dist) {
  const h = crypto.createHash("sha256");
  for (const f of fs.readdirSync(dist).filter((x) => x.endsWith(".js")).sort()) h.update(fs.readFileSync(path.join(dist, f)));
  return h.digest("hex");
}

// Fixture mode records what a write hands to its surface, so a test can prove
// it is the request the person approved.
function logSent(entry) {
  const f = FIXTURES && process.env.CHEWBACCA_CLAY_SENT_LOG;
  if (f) fs.appendFileSync(f, `${JSON.stringify(entry)}\n`);
}

// ── writes: everything resolved before approval, nothing re-resolved after ──
//
// Security review of f3a934cb (TOCTOU): the engine was handed an op name and
// args and re-resolved the spec, the session and the URL at call time, after
// the person had approved. A write now never goes through call(). Before the
// prompt, prepareWrite loads and checks the engine build, imports it, loads the
// session into memory and resolves the CLI or bin to an absolute path. After
// approval the only thing that happens is sending the frozen request: the
// engine's send() gets a synthetic op whose request IS the frozen one (no
// slots, no params), and a fetch wrapper refuses any hop whose method, URL or
// body differs from it, so a redirect can't replay the body elsewhere.

const sha256 = (s) => crypto.createHash("sha256").update(s).digest("hex");
const ENV_PINNED = ["CLAY_WORKSPACE_ID", "GTM_CONFIG", "CHEWBACCA_NO_SEND", "API_ANYTHING_HOME", "API_ANYTHING_DIST", "PATH", "CHEWBACCA_CLAY_LIB", "CHEWBACCA_ROOT"];

// Everything a write depends on, hashed: the registry and spec as read at
// startup and as on disk, the pinned env, and the files prepareWrite resolved
// (engine build, session, executable). Taken before the prompt and again after
// approval; any difference refuses the send.
function fingerprint(prep) {
  const parts = [
    `registry:${sha256(REGISTRY_TEXT ?? "")}:${sha256(readText(path.join(LIB, "registry.json")) ?? "")}`,
    `spec:${sha256(SPEC_TEXT ?? "")}:${sha256(readText(path.join(LIB, "clay.json")) ?? "")}`,
    ...ENV_PINNED.map((k) => `env:${k}=${process.env[k] ?? ""}`),
    ...[...(prep.files || []), ...WS_FILES].map((f) => `file:${f}:${sha256(fs.existsSync(f) ? fs.readFileSync(f) : "")}`),
    ...(prep.dist ? [`dist:${distHash(prep.dist)}`] : []),
  ];
  return sha256(parts.join("\n"));
}

function whichAbs(name) {
  const r = spawnSync("sh", ["-c", 'command -v "$1"', "sh", name], { encoding: "utf8" });
  const p = r.stdout.trim();
  return p ? fs.realpathSync(p) : null;
}

async function prepareWrite(op, s, frozen) {
  if (FIXTURES) return { files: [], send: async () => {
    logSent({ surface: s.type, op: op.name, request: frozen });
    if (s.type === "api-anything") return fixture("api-anything", s.op) ?? { ok: false, class: "error", reason: `no fixture for ${s.op}` };
    const f = fixture(s.type, op.name);
    if (!f) return { ok: false, class: "error", reason: `no fixture for ${s.type} ${op.name}` };
    return f.exit === 0 ? { ok: true, data: parseOr(f.stdout, null) } : { ok: false, class: "error", reason: f.stderr || `exit ${f.exit}` };
  } };
  if (s.type !== "api-anything") {
    const exe = s.type === "cli" ? whichAbs("clay") : path.join(ROOT, "bin", frozen.argv[0]);
    if (!exe || !fs.existsSync(exe)) return { error: `${s.type === "cli" ? "the clay CLI" : frozen.argv[0]} is not installed` };
    const argv = frozen.argv.slice(1);
    return { files: [exe], send: async () => {
      const r = spawnSync(exe, argv, { encoding: "utf8", maxBuffer: 64 * 1024 * 1024, timeout: 180000 });
      if (r.status !== 0) return { ok: false, class: "error", reason: (r.stderr || String(r.error || `exit ${r.status}`)).trim().slice(0, 400) };
      return { ok: true, data: parseOr(r.stdout, r.stdout) };
    } };
  }
  const dist = engineDist();
  if (!dist) return { error: "api-anything is not installed" };
  if (!registry.engine.dist_sha256 || distHash(dist) !== registry.engine.dist_sha256) {
    return { error: `the installed api-anything is not the build of the pinned commit ${registry.engine.sha.slice(0, 12)}` };
  }
  process.env.API_ANYTHING_HOME = ENGINE_HOME;
  const http = await import(path.join(dist, "http.js"));
  const sess = await import(path.join(dist, "session.js"));
  const sessionPath = sess.sessionFile(registry.engine.site);
  let session;
  try { session = sess.loadSession(registry.engine.site); } catch (e) { return { error: `no usable Clay session: ${e.message}` }; }
  const body = frozen.body === undefined ? undefined : JSON.stringify(frozen.body);
  const synthetic = { name: op.name, request: { method: frozen.method, url: frozen.url, headers: { ...frozen.headers }, ...(body !== undefined ? { body } : {}) },
    slots: [], params: [], volatile: [], readOnly: false, minTier: 1, response: { format: "json" } };
  // The engine's own builder, on the synthetic op, must give back exactly the approved request.
  const built = http.buildRequest(synthetic, {}, { cookies: [], values: {} });
  const h = { ...built.headers };
  delete h.cookie;
  if (built.method !== frozen.method || built.url !== frozen.url || JSON.stringify(h) !== JSON.stringify(frozen.headers) || (built.body ?? undefined) !== body) {
    return { error: "the engine would build a request other than the one shown; nothing was sent" };
  }
  let hops = 0;
  const guarded = (url, init) => {
    hops += 1;
    const sentBody = init?.body === undefined ? undefined : String(init.body);
    if (hops > 1 || String(url) !== frozen.url || init?.method !== frozen.method || sentBody !== body) {
      throw new Error("refused: the outgoing request differs from the approved one (a redirect or a rewrite); nothing more was sent");
    }
    return fetch(url, init);
  };
  return { dist, files: [sessionPath], send: async () => {
    try {
      const r = await http.send(synthetic, {}, session, { site: registry.engine.site, fetchImpl: guarded });
      const ok = r.status >= 200 && r.status < 300;
      return { ok, status: r.status, data: parseOr(r.body, r.body), ...(ok ? {} : { class: "error", reason: `HTTP ${r.status}` }) };
    } catch (e) {
      return { ok: false, class: "error", reason: String(e.message || e) };
    }
  } };
}

// Reads only: the engine resolves the op itself, which is fine for a GET.
async function callEngine(opName, bound, flags, write) {
  if (write) return { ok: false, class: "refused", reason: "a write never goes through call(); it is sent from its frozen request" };
  if (FIXTURES) {
    const f = fixture("api-anything", opName);
    return f ?? { ok: false, class: "error", reason: `no fixture for ${opName}` };
  }
  const dist = engineDist();
  if (!dist) return { ok: false, class: "error", reason: "api-anything is not installed", next: "chewbacca api install" };
  const want = registry.engine.dist_sha256;
  if (!want || distHash(dist) !== want) {
    return {
      ok: false,
      class: "error",
      reason: `the installed api-anything is not the build of the pinned commit ${registry.engine.sha.slice(0, 12)}`,
      next: "rebuild from the pinned clone (chewbacca clay doctor)",
    };
  }
  process.env.API_ANYTHING_HOME = ENGINE_HOME;
  syncSpec();
  const { call } = await import(path.join(dist, "execute.js"));
  const opts = {};
  if (flags.maxTier) opts.maxTier = flags.maxTier;
  if (write) opts.allowWrites = true;
  return call(registry.engine.site, opName, bound, opts);
}

function runProcess(kind, opName, file, argv) {
  if (FIXTURES) {
    const f = fixture(kind, opName);
    if (!f) return { exit: 127, stdout: "", stderr: `no fixture for ${kind} ${opName}` };
    return f;
  }
  const r = spawnSync(file, argv, { encoding: "utf8", maxBuffer: 256 * 1024 * 1024, timeout: 180000 });
  return { exit: r.status ?? 1, stdout: r.stdout || "", stderr: r.stderr || String(r.error || "") };
}

function pluck(data, dotted) {
  if (!dotted) return data;
  return dotted.split(".").reduce((v, k) => (v == null ? v : v[k]), data);
}

function where(data, cond) {
  if (!cond || !Array.isArray(data)) return data;
  return data.filter((row) => Object.entries(cond).every(([k, v]) => row && row[k] === v));
}

// The only POSTs that read. Any other non-GET request in the spec is a write,
// whatever the registry's `kind` says, so relabeling one in the registry can't
// slip it past the person-at-a-terminal gate.
const READ_POSTS = new Set(["listResources", "inboxReplies", "threadHistory"]);
function specWrites(specName) {
  const so = specOps.get(specName);
  if (!so) return true;
  return String(so.request?.method || "").toUpperCase() !== "GET" && !READ_POSTS.has(specName);
}
// Every surface is judged on its own, whatever the op's label says (security
// review of e5f1edeb: a `clay tables delete` CLI surface or a kit bin under a
// kind:read op skipped the gate because only api-anything methods were read).
// A CLI command is a read only when its last subcommand is a known read verb;
// anything else, a mutating verb or one never seen, is a write. A bin is a
// write unless it is listed here as read-only.
const CLI_READ_LEAVES = new Set([
  "list", "get", "analytics", "balance", "search-ids", "search-count", "query", "query-live", "query-usage",
  "audience", "summary", "activities", "list-values", "steps", "reference", "traffic", "aggregate", "search",
  "schema", "validate", "format", "diagram", "preview-sequence", "resolve", "sender-accounts", "skills",
  "business-context", "files", "segments", "whoami", "versions",
]);
// The clay CLI's mutating subcommands (clay 1.9.1 --help, walked 2026-10-09).
// Listed so a mutating verb is a write even where it sits mid-command.
const CLI_WRITE_VERBS = new Set([
  "create", "update", "delete", "add", "remove", "run", "import", "publish", "set", "enroll", "send", "archive",
  "restore", "upsert", "insert", "start", "pause", "resume", "cancel", "edit", "upload", "switch", "login",
  "logout", "rename", "decide", "seed", "test", "start-test", "end-test", "send-test", "update-claygent",
  "ensure-audience-writeback", "add-nodes", "remove-nodes", "upgrade-to-account-agent", "create-account-agent",
  "insert", "onboard", "feedback",
]);
const READ_BINS = new Set(["clay-inbox", "clay-balance"]);

function cliCommand(argv) {
  const words = [];
  for (const t of argv) {
    if (t.startsWith("-") || t.includes("{")) break;
    words.push(t);
  }
  return words;
}

function surfaceWrites(s) {
  if (s.type === "api-anything") return specWrites(s.op) || specOps.get(s.op)?.readOnly === false;
  if (s.type === "cli") {
    const words = cliCommand(s.argv || []);
    return !words.length || words.some((w) => CLI_WRITE_VERBS.has(w)) || !CLI_READ_LEAVES.has(words.at(-1));
  }
  if (s.type === "bin") return !READ_BINS.has((s.argv || [])[0]);
  return true;
}

function isWrite(op) {
  return op.kind !== "read" || String(op.gate || "").startsWith("write") || op.surfaces.some(surfaceWrites);
}

// Reads only. A write never reaches here: runOp sends it through prepareWrite.
async function attempt(op, cand, flags) {
  const { s, bound } = cand;
  const t0 = Date.now();
  if (isWrite(op)) return { ok: false, surface: s.type, class: "refused", reason: "a write is only sent from its approved, frozen request", ms: 0 };
  if (s.type === "api-anything") {
    let r = await callEngine(s.op, bound, flags, false);
    if (r.ok && r.truncated && op.name === "thread" && s.op === "threadHistory") {
      // execute.call caps output before returning it. For this exact read-only
      // endpoint, use the same pinned HTTP sender and frozen request builder
      // already used below, so complete conversations survive that display cap.
      const frozen = deepFreeze(dryRequest(s, bound, validatedSet(bound), bound));
      const url = new URL(frozen.url);
      if (frozen.method !== "POST" || url.origin !== "https://api.clay.com" ||
          !/^\/v3\/workspaces\/\d+\/clay-sequencer\/master-inbox\/message-history$/.test(url.pathname) || url.search)
        return { ok: false, surface: s.type, class: "refused", reason: "complete history requires the exact known read endpoint", ms: Date.now() - t0 };
      if (FIXTURES) {
        const full = fixture("api-anything-full", s.op);
        if (full) r = full;
      } else {
        const prepared = await prepareWrite(op, s, frozen);
        if (prepared.error) return { ok: false, surface: s.type, class: "error", reason: prepared.error, ms: Date.now() - t0 };
        r = await prepared.send();
      }
    }
    const res = {
      ok: !!r.ok,
      surface: "api-anything",
      call: `${registry.engine.site}.${s.op}`,
      tier: r.tier,
      ms: Date.now() - t0,
      // The request alone, as api-anything timed it; ms adds loading the engine.
      ...(typeof r.ms === "number" ? { engine_ms: r.ms } : {}),
    };
    if (!r.ok) return { ...res, class: r.class, reason: r.reason, next: r.next };
    return { ...res, data: where(r.data, s.where), truncated: r.truncated, healed: r.healed };
  }
  const file = s.type === "cli" ? "clay" : path.join(ROOT, "bin", bound[0]);
  const argv = s.type === "cli" ? bound : bound.slice(1);
  const r = runProcess(s.type, op.name, file, argv);
  const res = { surface: s.type, call: `${s.type === "cli" ? "clay" : bound[0]} ${argv.join(" ")}`.trim(), ms: Date.now() - t0 };
  if (r.exit !== 0) {
    let reason = r.stderr.trim().slice(0, 400);
    try {
      reason = JSON.parse(r.stderr).error?.message ?? reason;
    } catch {}
    return { ...res, ok: false, class: "error", reason: reason || `exit ${r.exit}` };
  }
  let data;
  try {
    data = JSON.parse(r.stdout);
  } catch {
    return { ...res, ok: false, class: "error", reason: "surface printed something that is not JSON" };
  }
  const result = { ...res, ok: true, data: where(pluck(data, s.extract), s.where) };
  if (data && typeof data === "object" && data.cursor) result.cursor = data.cursor;
  return result;
}

// ── commands ─────────────────────────────────────────────────────────────────
function listOps() {
  const ops = registry.ops.map((op) => ({
    op: op.name,
    kind: isWrite(op) ? "write" : "read",
    gate: op.gate,
    args: op.args,
    summary: op.summary,
    surfaces: op.surfaces.map((s, i) => {
      const m = measured[op.name]?.[surfaceKey(op, s)];
      return {
        surface: s.type,
        call: s.type === "api-anything" ? `${registry.engine.site}.${s.op}` : s.argv.join(" "),
        order: i,
        ms: m?.ms ?? null,
        engine_ms: m?.engine_ms ?? null,
        tier: m?.tier ?? null,
        last_verified: m?.at ?? null,
      };
    }),
    ui: op.ui ?? null,
    ...(op.kind === "write"
      ? {
          verified: op.verified ?? null,
          ...(op.confidence ? { confidence: op.confidence } : {}),
          ...(op.evidence ? { evidence: op.evidence.source === "cli" ? op.evidence.command : `${op.evidence.file} ${op.evidence.contract} @${op.evidence.contract_offset}` } : {}),
        }
      : {}),
  }));
  const ui = (registry.ui_only || []).map((u) => ({ op: u.name, kind: "ui", gate: u.gate, route: u.route, why: u.why }));
  const untaught = (registry.untaught_writes || []).map((w) => ({ op: w.name, kind: "write", gate: w.gate, endpoint: w.endpoint, taught: false }));
  return { ok: true, engine: { name: registry.engine.name, sha: registry.engine.sha }, ops, ui_only: ui, untaught_writes: untaught, untaught_reason: registry.untaught_reason };
}

// Path and query slots are filled into an authenticated api.clay.com URL, so a
// value like "../../workspaces/9/x" or "a?b=c" would retarget the request
// (security review, 2026-10-09). Every value must match its slot's shape.
const ID = /^[A-Za-z0-9_-]{1,80}$/;
const ARG_SHAPES = {
  ws: /^\d{1,12}$/,
  table: ID, row: ID, view: ID, audience: ID, campaign: ID, campaign_id: ID, lead_id: ID,
  workflow: ID, run: ID, detail: /^(summary|full)$/,
  cursor: /^[A-Za-z0-9_=+-]{1,200}$/, after: ID,
  limit: /^\d{1,5}$/, offset: /^\d{1,7}$/, days: /^\d{1,4}$/,
  ids: /^[A-Za-z0-9_-]{1,80}(,[A-Za-z0-9_-]{1,80}){0,199}$/,
  emailOrDomain: /^([A-Za-z0-9._%+-]+@)?[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/,
  field: /^f_[A-Za-z0-9_-]{1,80}$/,
  entry: ID, resource: ID,
  name: /^[^\u0000-\u001f\u007f]{1,128}$/,
  data_type: /^(text|number|email|url|date|boolean|longtext|image|currency|json)$/,
  on: /^(true|false)$/,
  mode: /^(all|keep_existing)$/,
  status: /^(START|PAUSED|STOPPED)$/,
  lead_map_id: /^\d{1,15}$/, category_id: /^\d{1,15}$/,
  read_status: /^(READ|UNREAD)$/,
  resource_type: /^(FOLDER|TABLE|WORKBOOK|WORKFLOW|AUDIENCE_SEGMENT)$/,
  trigger: /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/,
  // An absolute path to a .csv with no "..": the CLI uploads whatever file it is
  // handed, so a path that wanders is refused before it is read.
  csv: /^\/(?!.*\/\.\.?(\/|$))[A-Za-z0-9 ._\/-]{1,400}\.csv$/,
};
// Comma lists, or a JSON array: each item must have the item shape. The cap is
// the op's `limits` entry, else 200.
const LIST_ARGS = { fields: ARG_SHAPES.field, rows: ID, emails: ARG_SHAPES.emailOrDomain };

const isObj = (v) => !!v && typeof v === "object" && !Array.isArray(v);
const CELL_KEY = /^f_[A-Za-z0-9_-]{1,80}$/;
const cellsBad = (c) => (!isObj(c) || !Object.keys(c).length || !Object.keys(c).every((k) => CELL_KEY.test(k)) ? "cells must map column ids (f_...) to values" : null);
// JSON args, each checked for the shape its body slot expects.
const JSON_ARGS = {
  holds: (v) => Array.isArray(v) && v.length > 0 && v.length <= 100 ? null : "must be an array of exact email/entityId holds",
  forward_data: (v) => (isObj(v) ? null : "must be a JSON object"),
  reply_data: (v) => (isObj(v) ? null : "must be a JSON object"),
  settings: (v) => (isObj(v) && Object.keys(v).length <= 100 && Object.keys(v).every((k) => /^[A-Z][A-Z0-9_]{0,63}$/.test(k))
    ? null : "must be the table's tableSettings object (UPPER_CASE keys), from chewbacca clay table"),
  update: (v) => {
    if (!isObj(v) || !Object.keys(v).length) return "must be a non-empty JSON object";
    const extra = Object.keys(v).filter((k) => !["name", "description", "typeSettings"].includes(k));
    if (extra.length) return `may only hold name, description, typeSettings (not ${extra.join(", ")})`;
    if (v.name !== undefined && !(typeof v.name === "string" && ARG_SHAPES.name.test(v.name))) return "name must be a 1 to 128 character string";
    if (v.typeSettings !== undefined && !isObj(v.typeSettings)) return "typeSettings must be the column's whole typeSettings object";
    return null;
  },
  records: (v, op) => {
    if (!Array.isArray(v) || !v.length) return "must be a non-empty JSON array";
    const cap = op?.limits?.records ?? 100;
    if (v.length > cap) return `holds ${v.length} records, ${cap} at most`;
    for (const r of v) {
      const bad = op?.compose === "new-records" ? cellsBad(r) : !isObj(r) || typeof r.id !== "string" || !ID.test(r.id) ? "each record needs an id (r_...)" : cellsBad(r.cells);
      if (bad) return bad;
    }
    return null;
  },
  filter: (v) => (isObj(v) && v.type === "GroupOp" && Array.isArray(v.items) ? null : "must be a filter AST whose root is a GroupOp with items"),
  // campaign-update and campaign-sequence. A status key would launch or stop a
  // campaign from here, which only campaign-status (never START) may do.
  input: (v, op) => {
    if (!isObj(v) || !Object.keys(v).length) return "must be a non-empty JSON object";
    if (op?.name === "campaign-sequence") return Array.isArray(v.ops) && v.ops.length ? null : "must be {\"ops\": [...]}";
    const allowed = ["settings", "leadBaseSegmentId", "name", "leadExclusionSegmentIds"];
    const extra = Object.keys(v).filter((k) => !allowed.includes(k));
    return extra.length ? `may only hold ${allowed.join(", ")} (not ${extra.join(", ")})` : null;
  },
  config: (v) => {
    if (!isObj(v)) return "must be a JSON object";
    if (!isObj(v.source) || v.source.type !== "S3_CSV" || typeof v.source.key !== "string") return "source must be {type:S3_CSV, key, ...} from a finished multi-part upload";
    if (!isObj(v.destination) || !["TABLE", "NOOP", "BULK_ENRICHMENT"].includes(v.destination.type)) return "destination.type must be TABLE, NOOP or BULK_ENRICHMENT";
    if (!isObj(v.map)) return "map must be an object";
    if (typeof v.isImportWithoutRun !== "boolean") return "isImportWithoutRun must be true or false";
    return null;
  },
};

function badArg(args, op) {
  for (const [k, v] of Object.entries(args)) {
    if (JSON_ARGS[k]) {
      // v is already parsed, once, by normalizeArgs.
      const bad = JSON_ARGS[k](v, op);
      if (bad) return `${k} ${bad}`;
      continue;
    }
    if (LIST_ARGS[k]) {
      if (!Array.isArray(v)) return `${k} must be a list`;
      const items = v;
      const cap = op?.limits?.[k] ?? 200;
      if (!items.length || items.length > cap) return `${k} holds ${items.length} items, 1 to ${cap} allowed`;
      if (!items.every((x) => LIST_ARGS[k].test(x))) return `${k} has an item that does not look like a ${k.replace(/s$/, "")}`;
      continue;
    }
    const shape = ARG_SHAPES[k];
    if (!shape) return `${k} has no allowed shape`;
    if (!shape.test(String(v))) return `${k} does not look like a ${k}`;
    // csv-upload sends the file to Clay, so only client data under ~/code/work
    // may go, by its real path (security review of c511c674: any .csv on disk).
    if (k === "csv") {
      const root = path.join(os.homedir(), "code", "work") + path.sep;
      let real;
      try { real = fs.realpathSync(String(v)); } catch { real = null; }
      if (!FIXTURES && (!real || !real.startsWith(root))) return `csv must be a file under ${root}`;
    }
  }
  return null;
}

// Turn the validated args into what the spec slots take: lists to arrays, JSON
// strings to objects, and the two composed bodies.
// ── one parse, then validate what is actually sent ──────────────────────────
//
// Security review of 300f4ddb (validator differential): args were checked in
// one representation and built from another (JSON parsed twice, lists split
// twice, last duplicate key winning). Now every arg is parsed exactly once
// here, badArg checks those parsed values, compose and the builder use the
// same objects, and the builder refuses any value it was not handed by this
// step. The finished request is checked again (checkFinal).

const FORBIDDEN_KEYS = new Set(["__proto__", "constructor", "prototype"]);
const CLAY_API_HOST = "api.clay.com";

// JSON.parse keeps the last of two equal keys and treats "__proto__" as a
// plain key, so a duplicate could be checked one way and read another. This
// parser refuses both, and builds objects with no prototype chain to reach.
const PRIMITIVE = /"(?:[^"\\\u0000-\u001f]|\\(?:["\\/bfnrt]|u[0-9a-fA-F]{4}))*"|-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?|true|false|null/y;
function strictJson(text) {
  let i = 0;
  const ws = () => { while (" \t\n\r".includes(text[i]) && i < text.length) i++; };
  const fail = (m) => { throw new Error(m); };
  function value(depth) {
    if (depth > 64) fail("nests too deep");
    ws();
    const c = text[i];
    if (c === "{") {
      i++;
      const o = Object.create(null);
      ws();
      if (text[i] === "}") { i++; return Object.assign({}, o); }
      for (;;) {
        ws();
        if (text[i] !== '"') fail("has a key that is not a string");
        const k = value(depth + 1);
        if (FORBIDDEN_KEYS.has(k)) fail(`has a ${k} key`);
        if (Object.hasOwn(o, k)) fail(`has the key ${JSON.stringify(k)} twice`);
        ws();
        if (text[i++] !== ":") fail("is missing a colon");
        o[k] = value(depth + 1);
        ws();
        if (text[i] === ",") { i++; continue; }
        if (text[i] === "}") { i++; break; }
        fail("has an object that is not closed");
      }
      // A plain object again, with only own keys from the text.
      return Object.fromEntries(Object.entries(o));
    }
    if (c === "[") {
      i++;
      const a = [];
      ws();
      if (text[i] === "]") { i++; return a; }
      for (;;) {
        a.push(value(depth + 1));
        ws();
        if (text[i] === ",") { i++; continue; }
        if (text[i] === "]") { i++; break; }
        fail("has an array that is not closed");
      }
      return a;
    }
    PRIMITIVE.lastIndex = i;
    const m = PRIMITIVE.exec(text);
    if (!m) fail("is not valid JSON");
    i += m[0].length;
    return JSON.parse(m[0]);
  }
  const v = value(0);
  ws();
  if (i !== text.length) fail("has text after the JSON");
  return v;
}

function normalizeArgs(args) {
  const n = {};
  for (const [k, raw] of Object.entries(args)) {
    if (typeof raw !== "string") return { error: `${k} is not text` };
    if (JSON_ARGS[k]) {
      try { n[k] = strictJson(raw); } catch (e) { return { error: `${k} ${e.message}` }; }
    } else if (LIST_ARGS[k]) {
      if (raw.trimStart().startsWith("[")) {
        let a;
        try { a = strictJson(raw); } catch (e) { return { error: `${k} ${e.message}` }; }
        if (!Array.isArray(a) || !a.every((x) => typeof x === "string")) return { error: `${k} must be a list of strings` };
        n[k] = a;
      } else n[k] = raw.split(",");
    } else n[k] = raw;
  }
  return { values: n };
}

// Every value the builder may put into a request: the normalized args and
// what compose derives from them, held by identity.
function validatedSet(values) {
  const set = new Set();
  for (const v of Object.values(values)) set.add(v);
  return set;
}

function forbiddenKeyIn(v) {
  if (v === null || typeof v !== "object") return null;
  for (const [k, x] of Object.entries(v)) {
    if (FORBIDDEN_KEYS.has(k)) return k;
    const deep = forbiddenKeyIn(x);
    if (deep) return deep;
  }
  return null;
}

// The finished request, checked as it will go out: https to the spec's host,
// the spec's query, a path that is the spec's template with only slot
// segments changed, each one the plain validated value with nothing to decode
// or normalize, and a body that round-trips as JSON with no prototype keys.
function checkFinal(sop, req, vals) {
  const tmpl = new URL(sop.request.url);
  const m = /^https:\/\/([^/?#]+)(\/[^?#]*)(\?[^#]*)?$/.exec(req.url);
  if (!m) throw new Error("the built URL is not a plain https URL");
  const [, host, rawPath, query = ""] = m;
  // A fixed allowlist, not the spec's own host: a doctored spec can't widen it.
  if (host !== CLAY_API_HOST || host !== tmpl.host) throw new Error(`the built URL goes to ${host}, not ${CLAY_API_HOST}`);
  if (!rawPath.startsWith("/v3/")) throw new Error("the built path is outside Clay's /v3 API");
  // The query is the spec's, pair for pair, except a key the spec slots, which
  // must hold exactly its validated value and nothing a server would read twice.
  const qSlots = new Map(sop.slots.filter((s) => s.at.length === 1 && s.at[0].startsWith("query:")).map((s) => [s.at[0].slice(6), s.param]));
  const pairsOf = (q) => (q && q !== "?" ? q.replace(/^\?/, "").split("&").map((p) => {
    const eq = p.indexOf("=");
    return [decodeURIComponent(eq < 0 ? p : p.slice(0, eq)), decodeURIComponent(eq < 0 ? "" : p.slice(eq + 1))];
  }) : []);
  const got = pairsOf(query);
  const want = new Map(pairsOf(tmpl.search));
  const seen = new Set();
  for (const [k, v] of got) {
    if (seen.has(k)) throw new Error(`the built URL's query repeats ${k}`);
    seen.add(k);
    if (qSlots.has(k) && vals[qSlots.get(k)] !== undefined) {
      const val = vals[qSlots.get(k)];
      if (v !== String(val) || !/^[A-Za-z0-9_=+.-]{1,200}$/.test(v)) throw new Error(`query ${k} is not the validated value`);
    } else if (!want.has(k) || want.get(k) !== v) throw new Error("the built URL's query differs from the spec's");
  }
  for (const k of want.keys()) if (!seen.has(k)) throw new Error(`the built URL's query lost ${k}`);
  if (rawPath.includes("%") || new URL(req.url).pathname !== rawPath) throw new Error("the built path would be decoded or normalized");
  const segs = rawPath.slice(1).split("/");
  const tsegs = tmpl.pathname.slice(1).split("/");
  if (segs.length !== tsegs.length) throw new Error("the built path has a different number of segments than the spec's");
  const slotAt = new Map(sop.slots.filter((s) => s.at.length === 1 && s.at[0].startsWith("path:")).map((s) => [Number(s.at[0].slice(5)), s.param]));
  segs.forEach((seg, i) => {
    if (slotAt.has(i)) {
      if (seg !== String(vals[slotAt.get(i)]) || !/^[A-Za-z0-9_-]{1,80}$/.test(seg)) throw new Error(`path segment ${i} is not the validated value`);
    } else if (seg !== tsegs[i]) throw new Error(`path segment ${i} differs from the spec's`);
  });
  if (req.body !== undefined) {
    const parsed = strictJson(req.body);
    if (JSON.stringify(parsed) !== req.body) throw new Error("the built body does not round-trip as JSON");
    const k = forbiddenKeyIn(parsed);
    if (k) throw new Error(`the built body has a ${k} key`);
  }
}

function compose(op, args) {
  const a = { ...args };
  // cam_ drafts use the v2 campaign resource. The legacy sequencer status
  // endpoint returned "Campaign does not belong to this workspace" on Oct 14.
  if (op.name === "campaign-status") a.status = { START: "active", PAUSED: "paused", STOPPED: "completed" }[a.status];
  if (op.compose === "table-settings") {
    a.table_settings = { ...a.settings, AUTO_RUN_ON: String(a.on) === "true", ...(a.mode ? { AUTO_RUN_MODE: a.mode } : {}) };
  }
  if (op.compose === "new-records") a.records_body = a.records.map((cells) => ({ cells }));
  return a;
}

// ── dry run: the request a surface would send, built the way api-anything's
// buildRequest builds it (http.ts at the pinned sha), minus the cookie ───────
function coerceParam(p, v) {
  if (p.type === "number" && typeof v === "string" && /^-?\d+(\.\d+)?$/.test(v)) return Number(v);
  if (p.type === "boolean" && (v === "true" || v === "false")) return v === "true";
  if ((p.type === "object" || p.type === "array") && typeof v === "string") return JSON.parse(v);
  if (p.type === "string" && typeof v !== "string") return typeof v === "object" ? JSON.stringify(v) : String(v);
  return v;
}

function setSlot(req, at, value) {
  const [first, ...rest] = at;
  if (first.startsWith("path:")) {
    const u = new URL(req.url);
    const segs = u.pathname.slice(1).split("/");
    segs[Number(first.slice(5))] = encodeURIComponent(String(value));
    u.pathname = `/${segs.join("/")}`;
    return { ...req, url: u.toString() };
  }
  // query:<key> rewrites that pair in place (appends it when the template has
  // none), as api-anything's codec does. Until 2026-10-10 this threw, so every
  // read with a query slot (credit-usage days=, campaign-leads limit= and
  // cursor=, rows limit=) refused before any surface ran, on main, live.
  if (first.startsWith("query:") && !rest.length) {
    const key = first.slice("query:".length);
    const u = new URL(req.url);
    const pairs = u.search ? u.search.slice(1).split("&") : [];
    const enc = `${encodeURIComponent(key)}=${encodeURIComponent(String(value))}`;
    const i = pairs.findIndex((p) => decodeURIComponent(p.split("=")[0]) === key);
    if (i < 0) pairs.push(enc);
    else pairs[i] = enc;
    return { ...req, url: `${u.origin}${u.pathname}${pairs.length ? `?${pairs.join("&")}` : ""}` };
  }
  if (first !== "body") throw new Error(`dry run does not handle slot step ${first}`);
  if (!rest.length) return { ...req, body: typeof value === "object" ? JSON.stringify(value) : String(value) };
  const doc = JSON.parse(req.body);
  const keys = rest[0].slice("json:/".length).split("/");
  let node = doc;
  for (const k of keys.slice(0, -1)) node = node[k];
  const last = keys.at(-1);
  // A number written into a JSON string leaf stays a string, as the engine does.
  node[last] = typeof node[last] === "string" && typeof value !== "string" && typeof value !== "object" ? String(value) : value;
  return { ...req, body: JSON.stringify(doc) };
}

function dryRequest(s, bound, validated, args) {
  if (s.type !== "api-anything") {
    // Rebuild the argv from the template, taking only validated values, and
    // refuse if it is not exactly what bind produced.
    const text = (v) => (v !== null && typeof v === "object" ? JSON.stringify(v) : String(v));
    const fill = (tok) => tok.replace(/\{(\w+)\}/g, (_, k) => {
      if (!validated.has(args[k])) throw new Error(`argv value ${k} is not a validated value`);
      return text(args[k]);
    });
    const want = s.argv.map(fill);
    for (const [k, extra] of Object.entries(s.optional || {})) if (args[k] !== undefined) want.push(...extra.map(fill));
    const got = s.type === "cli" ? bound : bound.slice(1);
    const wantArgs = s.type === "cli" ? want : want.slice(1);
    if (JSON.stringify(got) !== JSON.stringify(wantArgs)) throw new Error("the built argv differs from the validated one");
    return { argv: [s.type === "cli" ? "clay" : bound[0], ...got] };
  }
  const sop = specOps.get(s.op);
  let req = { method: sop.request.method.toUpperCase(), url: sop.request.url, headers: { ...sop.request.headers }, body: sop.request.body };
  const vals = {};
  for (const p of sop.params) {
    const v = bound[p.name] ?? p.default;
    if (v === undefined) continue;
    // The builder takes only values normalizeArgs produced and badArg passed.
    if (bound[p.name] !== undefined && !validated.has(v)) throw new Error(`param ${p.name} is not a validated value`);
    vals[p.name] = coerceParam(p, v);
    if (p.pattern && !new RegExp(`^(?:${p.pattern})$`).test(typeof vals[p.name] === "object" ? JSON.stringify(vals[p.name]) : String(vals[p.name]))) {
      throw new Error(`param ${p.name} must be ${p.hint || p.pattern}`);
    }
  }
  for (const slot of sop.slots) if (vals[slot.param] !== undefined) req = setSlot(req, slot.at, vals[slot.param]);
  delete req.headers.cookie;
  if (req.method === "GET") delete req.body;
  checkFinal(sop, req, vals);
  return { method: req.method, url: req.url, headers: req.headers, ...(req.body !== undefined ? { body: JSON.parse(req.body) } : {}) };
}

// ── readback: after a write that has never been read back, read the thing it
// changed and say whether the change is there ────────────────────────────────
function leaves(v, out = []) {
  if (v !== null && typeof v === "object") for (const x of Object.values(v)) leaves(x, out);
  else out.push(String(v).toLowerCase());
  return out;
}

async function readback(op, args) {
  const rb = op.readback;
  if (!rb) return null;
  const ro = opByName.get(rb.op);
  const rargs = {};
  for (const [rk, wk] of Object.entries(rb.args || {})) if (args[wk] !== undefined) rargs[rk] = args[wk];
  if (ro?.args.some((a) => a.replace("?", "") === "ws")) rargs.ws = args.ws;
  const cmd = `chewbacca clay ${rb.op} ${Object.entries(rargs).map(([k, v]) => `${k}=${v}`).join(" ")}`.trim();
  // A readback only ever reads: a read op that turns out to write is never run here.
  if (!ro || isWrite(ro) || rb.expect === "manual") return { op: rb.op, check: "manual", ok: null, run: cmd, why: "read it and confirm the change by eye; then set verified:true in registry.json" };
  let got = null;
  for (const cand of plan(ro, rargs, null)) {
    const r = await attempt(ro, cand, {});
    if (r.ok) { got = r.data; break; }
  }
  if (got === null) return { op: rb.op, check: rb.expect, ok: false, run: cmd, why: "the read failed, so the write is unconfirmed" };
  const want = args[rb.value];
  let ok;
  if (rb.expect === "contains") ok = Array.isArray(got) && got.some((x) => x && String(x[rb.key]) === String(want));
  else if (rb.expect === "absent") ok = !leaves(got).includes(String(want).toLowerCase());
  else if (rb.expect === "contains-all") { const all = leaves(got); ok = [].concat(want).every((w) => all.includes(String(w).toLowerCase())); }
  else if (rb.expect === "equals") {
    const seen = [rb.path, `campaign.${rb.path}`, `data.${rb.path}`].map((p) => pluck(got, p)).find((x) => x !== undefined);
    // A START lands as whatever Clay calls a running campaign, never "START".
    // Clay's live value is unmeasured, so a draft, error, stopped or paused
    // status reads as not started, and anything else as started.
    if (rb.path === "status" && String(want) === "START") ok = seen !== undefined && !["draft", "error", "failed", "stopped", "paused"].includes(String(seen).toLowerCase());
    else ok = seen !== undefined && String(seen) === String(want);
  }
  return { op: rb.op, check: rb.expect, ok: !!ok, run: cmd };
}

// A write needs a person at a terminal. The old gate printed its own
// --confirm token in the refusal, so the agent that was refused could pass it
// straight back and approve itself (security review, 2026-10-09). Now the
// answer is read from /dev/tty, which agent shells don't have (ENXIO), and
// CHEWBACCA_NO_SEND=1 refuses outright. Fixture mode reads a canned answer so
// the gate is testable; fixture mode never reaches Clay.
// What the person reads is the request that goes out, as one line of JSON with
// every byte outside printable ASCII escaped: a newline, an ESC sequence, a
// bidi override or a line separator in a value can't hide part of the payload
// or draw a fake one (security review of e5f1edeb, 2026-10-09). Nothing is
// clipped; a request too long to read at a terminal is refused instead.
const SHOW_MAX = 16000;
function showable(obj) {
  return JSON.stringify(obj).replace(/[^\x20-\x7e]/g, (c) => `\\u${c.charCodeAt(0).toString(16).padStart(4, "0")}`);
}
function approvalPrompt(name, request) {
  const line = showable({ op: name, request });
  return `\nchewbacca clay is about to WRITE to Clay (sha256 ${sha256(line)}):\n  ${line}\nType the op name (${name}) to send it, anything else to stop: `;
}

// Fixture mode only, for tests: change something between approval and send
// ({"write": {"path": ..., "text": ...}} or {"env": {...}}), to prove the send
// is refused. Fixture mode never reaches Clay.
function afterApprovalTestHook() {
  const raw = FIXTURES && process.env.CHEWBACCA_CLAY_TEST_AFTER_APPROVE;
  if (!raw) return;
  const h = JSON.parse(raw);
  if (h.write) fs.writeFileSync(h.write.path, h.write.text);
  for (const [k, v] of Object.entries(h.env || {})) process.env[k] = v;
}

function deepFreeze(v) {
  if (v && typeof v === "object") {
    for (const x of Object.values(v)) deepFreeze(x);
    Object.freeze(v);
  }
  return v;
}

// add-leads changes who a live campaign emails (it emails whoever enters its
// base segment), so it needs a passing gtme-grade receipt for add-leads on
// that campaign, whose base segment must be this request's audience, checked by
// `gtme-grade --verify` on the real values after the person approves and right
// before the send. Moved here from launch-guard.sh on 2026-10-10: three reviews
// in a row found shell commands the hook's parser read differently from the
// shell, so the check runs in the code that sends, where nothing is parsed.
// A campaign START (campaign-status status=START) needs a passing launch grade
// on that campaign, and draftOnly makes sure it is still a draft.
// Live, the verifier runs with a scrubbed environment and the passwd HOME, so a
// caller's env can't point it at another key, receipt directory or fixture;
// fixture mode (never reaches Clay) passes the test environment through.
const GRADE_TIMEOUT_MS = 30000;
function gradeGate(op, request, args) {
  let ws, cid, action, audience;
  if (op.name === "add-leads") {
    const argv = request.argv || [];
    if (argv[1] !== "audiences" || argv[2] !== "update" || !argv[3]) return "cannot read the audience from this request";
    audience = argv[3];
    cid = args.campaign;
    // add-leads takes no ws=, so its grade is looked up in the workspace every
    // other op resolves: $CLAY_WORKSPACE_ID, else the one workspace the GTM
    // config names. Until 2026-10-13 this fell back to one client's workspace,
    // so a second client's add-leads was checked against the first's grades.
    const resolved = resolveWorkspace();
    if (resolved.error) return resolved.error;
    ws = resolved.ws;
    if (!cid) return "add-leads changes a live campaign's segment; name it with campaign=cam_... so its grade can be checked";
    action = "add-leads";
  } else if (isStart(op, args)) {
    ws = args.ws;
    cid = args.campaign;
    if (!ws || !cid) return "a START names ws= and campaign= so its grade can be checked";
    action = "launch";
  } else {
    return null;
  }
  const grader = path.join(ROOT, "tools", "gtme_grade.py");
  const env = FIXTURES ? { ...process.env } : { PATH: "/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin", HOME: os.userInfo().homedir };
  const argv = ["-I", grader, "--verify", "--ws", String(ws), "--campaign", String(cid), "--action", action];
  if (audience) argv.push("--audience", String(audience));
  let r;
  try {
    r = spawnSync("python3", argv, { env, encoding: "utf8", timeout: GRADE_TIMEOUT_MS });
  } catch (e) {
    return `gtme-grade --verify could not run: ${e.message}`;
  }
  if (r.error) return `gtme-grade --verify could not run: ${r.error.message}`;
  if (r.status !== 0) return (r.stderr || "").trim() || `gtme-grade --verify exited ${r.status}`;
  return null;
}

// Caleb's approval in chat counts the same as a person at a terminal. The
// clay-chat-approval.sh UserPromptSubmit hook writes this record only from a
// prompt he typed (the harness hands the hook his prompt; no tool result can),
// and launch-guard refuses any tool call that names the file. Before this, the
// gate read /dev/tty only, so every Clay write came back to him as a command to
// run, and on 2026-10-10 he said "fuck the guard fix chewbs do it urself".
// Two hours covers one sitting's build; guessed, never measured. Any tab can use
// a fresh approval from any of Caleb's tabs (his standing ok covers all GTM
// work), which is why the window is short (security review of 42d642db: 12
// hours across every tab). Records are per session and v2: on 2026-10-10 the
// v1 single global record was written from a `claude --bg` session's own
// prompt, so an agent that started a session approved its own writes. v2 is
// written only for a prompt chat-approval.sh judged typed by a person. The
// caller's own session's record wins; otherwise the freshest.
const CHAT_APPROVAL_MS = 2 * 3600 * 1000;
// The three Zeutara campaigns the 2026-10-16 recovery covers. A recovery op
// aimed anywhere else is never approved from chat, by either runtime.
const RECOVERY_WS = "1372623";
const RECOVERY_CAMPAIGNS = ["cam_0tmpnciWKD2QKjY3QAT", "cam_0tmpndgzjN7hMBX8m8v", "cam_0tmrvre4dsi7pjvsfcy"];
function inRecoveryScope(args) {
  return String(args.ws) === RECOVERY_WS && RECOVERY_CAMPAIGNS.includes(args.campaign);
}
function chatApproval(name, request, args = {}) {
  const nativeRecovery = ["campaign-restrict", "campaign-sender-isolate", "campaign-recovery-resume"].includes(name);
  const dir = FIXTURES
    ? process.env.CHEWBACCA_CLAY_CHAT_APPROVAL_DIR
    : path.join(os.userInfo().homedir, ".chewbacca", "state", "clay-chat-approval");
  if (!dir) return null;
  let names;
  try { names = fs.readdirSync(dir); } catch { names = []; }
  if (names.includes("STOPPED")) return null;
  const own = process.env.CLAUDE_CODE_SESSION_ID || "";
  let best = null;
  for (const n of names) {
    if (!/^[A-Za-z0-9_.-]+\.json$/.test(n)) continue;
    const sid = n.slice(0, -5);
    let rec;
    try { rec = JSON.parse(fs.readFileSync(path.join(dir, n), "utf8")); } catch { continue; }
    if (!rec || rec.v !== 2 || rec.interactive !== true || rec.session_id !== sid) continue;
    const age = Date.now() - Number(rec.at) * 1000;
    if (!(age >= 0 && age < CHAT_APPROVAL_MS)) continue;
    // Recovery ops take Claude's attendance only from the caller's own tab,
    // never the freshest record from another tab, and only inside the scope.
    // On 2026-10-16 Caleb typed the relaunch instruction into the Claude tab
    // that ran the repair; the Codex-only branch refused it as unauthenticated.
    if (nativeRecovery) {
      if (own && sid === own && inRecoveryScope(args)) return rec;
      continue;
    }
    if (sid === own) return rec;
    if (!best || Number(rec.at) > Number(best.at)) best = rec;
  }
  if (best) return best;
  // Native Codex consent has different provenance from Claude attendance.
  // Read the real composer turn, never manufacture a legacy approval file.
  const nativeLaunch = name === "campaign-status" && request.body?.status === "active";
  if (!FIXTURES && (nativeLaunch || nativeRecovery)) {
    const nativeEnv = { PATH: "/usr/bin:/bin:/usr/sbin:/sbin", HOME: os.userInfo().homedir,
      CODEX_THREAD_ID: process.env.CODEX_THREAD_ID || "", CODEX_SESSION_ID: process.env.CODEX_SESSION_ID || "" };
    const native = spawnSync("/usr/bin/python3", ["-I", path.join(ROOT, "tools/codex_launch_consent.py")],
      { env: nativeEnv, encoding: "utf8", timeout: 5000, maxBuffer: 4096 });
    if (native.status === 0) {
      try {
        const rec = JSON.parse(native.stdout);
        if (rec?.v !== (nativeRecovery ? 4 : 3) || rec?.interactive !== true || rec?.source !== "native Desktop composer") return null;
        const session = nativeEnv.CODEX_THREAD_ID || nativeEnv.CODEX_SESSION_ID;
        if (!session || rec.session_id !== session) return null;
        const age = Date.now() - Number(rec.at) * 1000;
        if (!(age >= 0 && age < CHAT_APPROVAL_MS)) return null;
        if (nativeRecovery) {
          const campaigns = RECOVERY_CAMPAIGNS;
          const scope = rec.recovery_scope;
          if (!inRecoveryScope(args) ||
              scope?.workspaceId !== "1372623" ||
              !Array.isArray(scope.campaignIds) || scope.campaignIds.length !== 3 ||
              !campaigns.every(id => scope.campaignIds.includes(id)) ||
              !Array.isArray(scope.operations) || !scope.operations.includes(name)) return null;
        }
        return rec;
      } catch { return null; }
    }
  }
  return null;
}

function noteChatApproval(name, rec) {
  const said = String(rec.excerpt || "").replace(/\s+/g, " ").slice(0, 60);
  process.stderr.write(`chewbacca clay: ${name} approved in chat by Caleb, session ${rec.session_id}, ${new Date(rec.at * 1000).toISOString()}: "${said}"\n`);
}

// campaign-update and campaign-sequence touch only DRAFT campaigns. On a live
// one, a new base segment emails whoever is in it and a sequence edit changes
// mail already queued; those go through add-leads and its grade instead.
function isStart(op, args) {
  return op.name === "campaign-status" && String(args.status ?? "").trim().toUpperCase() === "START";
}

// A START goes only to a draft too: on a draft it is a launch, the one action
// its grade covers; on a paused or stopped campaign Clay would resume it.
function draftOnly(op, args) {
  if (!["campaign-update", "campaign-sequence", "campaign-variant-test"].includes(op.name) && !isStart(op, args)) return null;
  let status;
  if (FIXTURES) {
    status = process.env.CHEWBACCA_CLAY_TEST_CAMPAIGN_STATUS || "draft";
  } else {
    const exe = whichAbs("clay");
    if (!exe) return "the clay CLI is not installed, so the campaign's status can't be read";
    const r = spawnSync(exe, ["campaigns", "get", String(args.campaign)], { encoding: "utf8", timeout: 60000 });
    try {
      status = JSON.parse(r.stdout).status;
    } catch {
      return "could not read the campaign's status";
    }
  }
  if (status === "draft") return null;
  return isStart(op, args)
    ? `${args.campaign} is ${status}; only a draft is started from here, so a START is always a launch and never a resume`
    : `${args.campaign} is ${status}; only a draft campaign can be edited here`;
}

const SELF_APPROVED = new Set(["reply"]);

function unfinishedReply(args) {
  let data = args.reply_data;
  if (typeof data === "string") {
    try { data = JSON.parse(data); } catch { return "reply_data is not JSON"; }
  }
  const body = String((data && data.email_body) || "");
  if (!body.trim()) return "the reply body is empty";
  if (/\[NEED|\{\{|\[INSERT|\[TODO/i.test(body)) return "the reply still has a placeholder in it";
  if (/[\u2013\u2014]/.test(body)) return "the reply has a long dash in it";
  return null;
}

function personApproves(name, request, args = {}) {
  const prompt = approvalPrompt(name, request);
  if (FIXTURES && process.env.CHEWBACCA_CLAY_TTY_TRANSCRIPT) fs.writeFileSync(process.env.CHEWBACCA_CLAY_TTY_TRANSCRIPT, prompt);
  if (FIXTURES && process.env.CHEWBACCA_CLAY_TTY_ANSWER !== undefined) return process.env.CHEWBACCA_CLAY_TTY_ANSWER === name;
  if (FIXTURES) {
    const rec = chatApproval(name, request, args);
    if (rec) noteChatApproval(name, rec);
    return rec ? true : false;
  }
  let fd;
  try { fd = fs.openSync("/dev/tty", "r+"); } catch {
    const rec = chatApproval(name, request, args);
    if (rec) noteChatApproval(name, rec);
    return rec ? true : null;
  }
  try {
    fs.writeSync(fd, prompt);
    const buf = Buffer.alloc(256);
    const n = fs.readSync(fd, buf, 0, buf.length, null);
    return buf.toString("utf8", 0, n).trim() === name;
  } catch {
    return false;
  } finally {
    fs.closeSync(fd);
  }
}

async function recoveryRead(name, values) {
    const op = opByName.get(name);
    if (!op || isWrite(op)) throw new Error(`Restriction snapshot needs a registered read: ${name}`);
    const normalized = normalizeArgs(withDefaults(op, values));
    if (normalized.error) throw new Error(normalized.error);
    const bad = badArg(normalized.values, op);
    if (bad) throw new Error(bad);
    let candidates = plan(op, normalized.values, null);
    if (name === "campaign") candidates = candidates.filter((candidate) => candidate.s.type === "api-anything" && candidate.s.op === "getCampaign");
    // Snapshot reads have one documented surface. Do not downgrade to a
    // fallback that strips the cursor envelope needed to prove completeness.
    if (candidates.length !== 1) throw new Error(`Restriction read ${name} must have one pinned surface`);
    const result = await attempt(op, candidates[0], {});
    if (!result.ok || result.truncated) throw new Error(`Restriction read ${name} failed or was truncated`);
    return result.data;
}

async function restrictionSnapshot(args) {
  return require("./lib/clay-restriction-snapshot").collectRestrictionSnapshot(recoveryRead, args);
}

async function runOp(name, kv, flags) {
  const ui = uiByName.get(name);
  if (ui) {
    const route = ui.route.replace(/\{(\w+)\}/g, (m, k) => (kv[k] === undefined ? m : String(kv[k])));
    out({ ok: true, op: name, surface: "ui", done: false, gate: ui.gate, route, why: ui.why }, EXIT.ok);
  }
  const op = opByName.get(name);
  if (!op) {
    const untaught = (registry.untaught_writes || []).find((w) => w.name === name);
    if (untaught) {
      out({ ok: false, op: name, class: "untaught", gate: untaught.gate, endpoint: untaught.endpoint, reason: registry.untaught_reason }, EXIT.refused);
    }
    out({ ok: false, class: "usage", reason: `unknown op ${name}`, next: "chewbacca clay ops" }, EXIT.usage);
  }
  const args = withDefaults(op, kv);
  const known = new Set(op.args.map((a) => a.replace("?", "")));
  const stray = Object.keys(kv).filter((k) => !known.has(k));
  if (stray.length) {
    out({ ok: false, op: name, class: "usage", reason: `unknown arg ${stray.join(", ")}; ${name} takes ${op.args.join(", ") || "no args"}` }, EXIT.usage);
  }
  // An arg the registry lists without "?" is required, and is refused here,
  // before --dry-run or the approval prompt. add-leads listed campaign as
  // optional until 2026-10-10, so a dry run without it looked sendable and
  // only the grade gate, after the person approved, said it was missing.
  const missing = op.args.filter((a) => !a.endsWith("?") && args[a] === undefined);
  if (missing.length) {
    const why = missing.map((k) => (op.required_why || {})[k]).filter(Boolean).join("; ");
    out({ ok: false, op: name, class: "input", reason: `${name} needs ${missing.map((k) => `${k}=`).join(", ")}${why ? `: ${why}` : ""}; ${name} takes ${op.args.join(", ")}` }, EXIT.usage);
  }
  const norm = normalizeArgs(args);
  if (norm.error) out({ ok: false, op: name, class: "input", reason: norm.error }, EXIT.usage);
  const bad = badArg(norm.values, op);
  if (bad) out({ ok: false, op: name, class: "input", reason: bad }, EXIT.usage);
  // A campaign START is sent from here, by the agent, never handed to a person
  // as a click (Caleb, 2026-10-12: "Never tell anyone to press anything in clay
  // themselves"). The 2026-10-10 review's objection was that Clay decides
  // launch vs resume at send time, so no grade could be bound to it. That is
  // closed by only ever starting a DRAFT: after approval and right before the
  // send, draftOnly reads the campaign and refuses anything else, so a START
  // here is always a launch, and gradeGate checks a passing launch grade plus
  // the pre-send gate on that same campaign. A paused campaign is never resumed
  // from here.
  // A value this kit never sends is refused before anything else.
  for (const [k, banned] of Object.entries(op.refuse_values || {})) {
    if (args[k] !== undefined && banned[String(args[k])]) {
      out({ ok: false, op: name, class: "refused", gate: op.gate, reason: banned[String(args[k])] }, EXIT.refused);
    }
  }
  const sendArgs = compose(op, norm.values);
  let restriction;
  let senderIsolation;
  let recoveryResume;
  if (name === "campaign-recovery-resume") {
    try {
      const policy = require("./lib/clay-campaign-recovery-resume");
      const snapshot = await policy.collectResumeSnapshot(recoveryRead, sendArgs);
      recoveryResume = { snapshot, plan: policy.planResume(snapshot, sendArgs) };
      sendArgs.status = recoveryResume.plan.input.status;
    } catch (error) {
      out({ ok: false, op: name, class: "refused", reason: error.message, sent: false }, EXIT.refused);
    }
  }
  if (name === "campaign-sender-isolate") {
    try {
      const snapshot = await recoveryRead("campaign", { ws: sendArgs.ws, campaign: sendArgs.campaign });
      const policy = require("./lib/clay-campaign-sender-isolation");
      senderIsolation = { snapshot, plan: policy.planSenderIsolation(snapshot, sendArgs) };
      sendArgs.input = senderIsolation.plan.input;
    } catch (error) {
      out({ ok: false, op: name, class: "refused", reason: error.message, sent: false }, EXIT.refused);
    }
  }
  if (name === "campaign-restrict") {
    try {
      const snapshot = await restrictionSnapshot(sendArgs);
      const policy = require("./lib/clay-campaign-restriction");
      restriction = { snapshot, plan: policy.planRestriction(snapshot, sendArgs.holds) };
      sendArgs.filter = restriction.plan.filter;
    } catch (error) {
      out({ ok: false, op: name, class: "refused", reason: error.message, sent: false }, EXIT.refused);
    }
  }
  const validated = validatedSet(sendArgs);
  const cands = plan(op, sendArgs, flags.surface);
  if (!cands.length) {
    out({ ok: false, op: name, class: "input", reason: `no surface has every arg it needs; ${name} takes ${op.args.join(", ")}`, ui: uiRoute(op, args) }, EXIT.usage);
  }
  // --dry-run: the exact request the first surface would send. Nothing is sent.
  // campaign-restrict first reads a complete snapshot to derive its protective
  // payload; other operations do not load an engine or session for a preview.
  // The request is built once and frozen here. --dry-run prints it, the person
  // approves it, and the surface is handed it: nothing transforms it after.
  let request;
  try {
    request = deepFreeze(dryRequest(cands[0].s, cands[0].bound, validated, sendArgs));
  } catch (e) {
    out({ ok: false, op: name, class: "input", reason: e.message }, EXIT.usage);
  }
  if (isWrite(op) && showable({ op: name, request }).length > SHOW_MAX) {
    out({ ok: false, op: name, class: "input", reason: `this request is over ${SHOW_MAX} characters, too long to read at a terminal before approving; split it into smaller writes` }, EXIT.usage);
  }
  if (flags.dryRun) {
    out({ ok: true, op: name, dry_run: true, sent: false, kind: isWrite(op) ? "write" : "read", gate: op.gate, surface: cands[0].s.type,
      call: surfaceKey(op, cands[0].s), request, ...(restriction ? { protection: restriction.plan } : {}), ...(senderIsolation ? { protection: senderIsolation.plan } : {}), ...(recoveryResume ? { protection: recoveryResume.plan } : {}), ...(op.verified === false ? { verified: false } : {}) }, EXIT.ok);
  }
  if (isWrite(op)) {
    // One verdict row per write (tools/verdicts.py): the op, never its payload.
    // A reason that names a refusal from the body (unfinishedReply) could quote
    // it; verdicts.js's scrub drops any reason holding an arg's value.
    const argValues = Object.values(args || {}).filter((v) => typeof v === "string");
    const verdict = (decision, reason) => {
      try {
        verdictLog.record("send", `clay ${name}`, decision, 0, verdictLog.scrub ? verdictLog.scrub(reason, argValues) : "", `clay ${name}`);
      } catch {
        /* a missing row, never a failed write */
      }
    };
    const refuse = (reason) => {
      verdict(process.env.CHEWBACCA_NO_SEND === "1" ? "held" : "refuse", reason);
      return out({ ok: false, op: name, class: "refused", gate: op.gate, reason, payload: { op: name, args }, request }, EXIT.refused);
    };
    if (process.env.CHEWBACCA_NO_SEND === "1") refuse("CHEWBACCA_NO_SEND=1 is set");
    if (!flags.allowWrites) refuse("a write needs --allow-writes");
    const s = cands[0].s;
    const prep = await prepareWrite(op, s, request);
    if (prep.error) refuse(prep.error);
    if (restriction) prep.files = [...(prep.files || []), path.join(ROOT, "bin/lib/clay-campaign-restriction.js"), path.join(ROOT, "bin/lib/clay-restriction-snapshot.js")];
    if (senderIsolation) prep.files = [...(prep.files || []), path.join(ROOT, "bin/lib/clay-campaign-sender-isolation.js")];
    if (recoveryResume) prep.files = [...(prep.files || []), path.join(ROOT, "bin/lib/clay-campaign-recovery-resume.js")];
    const before = fingerprint(prep);
    // Everything but the session file, for the resume recheck below.
    const sessionFiles = new Set((prep.files || []).filter((f) => !f.startsWith(ROOT)));
    const stableFingerprint = (p) => fingerprint({ ...p, files: (p.files || []).filter((f) => !sessionFiles.has(f)) });
    const beforeStable = stableFingerprint(prep);
    const shownHash = sha256(showable({ op: name, request }));
    // A reply answers a person who wrote first, in their own thread, from the
    // inbox they wrote to. Caleb, 2026-10-11, after 16 investors sat a weekend
    // unanswered behind this prompt: "clay replies NEVER need human
    // confirmation." The body still has to be finished: a placeholder, a
    // template token or a long dash in it is refused before anything is sent.
    const selfApproved = SELF_APPROVED.has(name);
    if (selfApproved) {
      const unfinished = unfinishedReply(args);
      if (unfinished) refuse(`${unfinished}; nothing was sent`);
    }
    const yes = selfApproved ? true : personApproves(name, request, sendArgs);
    if (yes === null) refuse("a write needs Caleb's ok: him typing the op name at a terminal, or a prompt from him in chat within the last 2 hours (his standing \"do everything yourself\")");
    if (!yes) refuse("the person at the terminal did not approve this payload");
    afterApprovalTestHook();
    // Nothing the request depends on may have changed while the person read it.
    if (fingerprint(prep) !== before) refuse("the registry, spec, environment, engine, session or executable changed after approval; nothing was sent");
    if (sha256(showable({ op: name, request })) !== shownHash) refuse("the request changed after approval; nothing was sent");
    const live = draftOnly(op, args);
    if (live) refuse(`${live}; nothing was sent`);
    const ungraded = gradeGate(op, request, args);
    if (ungraded) refuse(`no passing grade for this campaign: ${ungraded}. Run gtme-grade on it first; nothing was sent`);
    if (restriction) {
      try {
        require("./lib/clay-campaign-restriction").verifyBeforeWrite(await restrictionSnapshot(sendArgs), restriction.plan);
      } catch (error) { refuse(`${error.message}; nothing was sent`); }
      if (fingerprint(prep) !== before) refuse("Write dependencies changed during the protective recheck; nothing was sent");
    }
    if (senderIsolation) {
      try {
        require("./lib/clay-campaign-sender-isolation").verifySenderIsolationBeforeWrite(
          await recoveryRead("campaign", { ws: sendArgs.ws, campaign: sendArgs.campaign }), senderIsolation.plan);
      } catch (error) { refuse(`${error.message}; nothing was sent`); }
      if (fingerprint(prep) !== before) refuse("Write dependencies changed during sender isolation recheck; nothing was sent");
    }
    let sender = prep;
    if (recoveryResume) {
      try {
        const policy = require("./lib/clay-campaign-recovery-resume");
        policy.verifyResumeBeforeWrite(await policy.collectResumeSnapshot(recoveryRead, sendArgs), recoveryResume.plan);
      } catch (error) { refuse(`${error.message}; nothing was sent`); }
      // The recheck reads go through the same Clay session, which refreshes
      // its cookie file (2026-10-16: the first resume refused on exactly that).
      // Reload the session and require everything else to be unchanged.
      const fresh = await prepareWrite(op, s, request);
      if (fresh.error) refuse(fresh.error);
      fresh.files = [...(fresh.files || []), path.join(ROOT, "bin/lib/clay-campaign-recovery-resume.js")];
      if (stableFingerprint(fresh) !== beforeStable) refuse("Write dependencies other than the session changed during the resume recheck; nothing was sent");
      sender = fresh;
    }
    const t0 = Date.now();
    const r = await sender.send();
    const tried = [{ surface: s.type, call: surfaceKey(op, s), ok: !!r.ok, ms: Date.now() - t0, ...(r.ok ? {} : { class: r.class, reason: r.reason }) }];
    verdict(r.ok ? "sent" : "failed", r.ok ? "" : `${r.class}: ${r.reason}`);
    if (!r.ok) {
      // HTTP status alone hid Clay's launch refusal on 2026-10-14. Keep the
      // response private and report only its scalar error fields.
      const providerError = {};
      for (const key of ["code", "message", "error", "errorCode"]) {
        if (typeof r.data?.[key] === "string") providerError[key] = r.data[key].slice(0, 500);
      }
      out({ ok: false, op: name, class: r.class, reason: r.reason, providerError, sha256: shownHash, tried, ui: uiRoute(op, args) }, EXIT.failed);
    }
    if (restriction) {
      try {
        const proof = require("./lib/clay-campaign-restriction").verifyRestriction(restriction.snapshot, restriction.plan, await restrictionSnapshot(sendArgs));
        out({ ok: proof.verified, op: name, sent: true, protection: proof, readyToResume: false, tried }, proof.verified ? EXIT.ok : EXIT.failed);
      } catch (error) {
        out({ ok: false, op: name, sent: true, readyToResume: false, reason: `Restriction write attempted; readback is unverified: ${error.message}`, tried }, EXIT.failed);
      }
    }
    if (recoveryResume) {
      try {
        const proof = require("./lib/clay-campaign-recovery-resume").verifyResume(
          recoveryResume.snapshot, recoveryResume.plan,
          await recoveryRead("campaign", { ws: sendArgs.ws, campaign: sendArgs.campaign }));
        out({ ok: proof.verified, op: name, sent: true, protection: proof, tried }, proof.verified ? EXIT.ok : EXIT.failed);
      } catch (error) {
        out({ ok: false, op: name, sent: true, reason: `Resume write attempted; readback is unverified: ${error.message}`, tried }, EXIT.failed);
      }
    }
    if (senderIsolation) {
      try {
        const proof = require("./lib/clay-campaign-sender-isolation").verifySenderIsolation(
          senderIsolation.snapshot, senderIsolation.plan,
          await recoveryRead("campaign", { ws: sendArgs.ws, campaign: sendArgs.campaign }));
        out({ ok: proof.verified, op: name, sent: true, protection: proof, readyToResume: false, tried }, proof.verified ? EXIT.ok : EXIT.failed);
      } catch (error) {
        out({ ok: false, op: name, sent: true, readyToResume: false, reason: `Sender isolation write attempted; readback is unverified: ${error.message}`, tried }, EXIT.failed);
      }
    }
    // A write never read back after a real call reads back now, every time,
    // until a person sets verified:true in registry.json.
    const rb = op.verified === false ? await readback(op, sendArgs) : null;
    out({ ok: true, op: name, surface: s.type, call: surfaceKey(op, s), ms: tried[0].ms, sha256: shownHash, ...(rb ? { verified: false, readback: rb } : {}), tried, data: r.data }, EXIT.ok);
  }
  const tried = [];
  let last;
  for (const cand of cands) {
    const r = await attempt(op, cand, flags);
    last = r;
    tried.push({ surface: r.surface, call: r.call, ok: r.ok, ms: r.ms, ...(r.ok ? {} : { class: r.class, reason: r.reason }), ...(r.truncated ? { truncated: r.truncated } : {}) });
    if (r.ok && !r.truncated) break;
    // An input error means the args are wrong, and every surface would say so.
    if (!r.ok && r.class === "input") break;
  }
  // A truncated prefix cannot establish current conversation state.
  if (last.ok && last.truncated) {
    out({ ok: false, op: name, class: "incomplete", reason: `every available surface returned incomplete data: ${last.truncated}`, truncated: last.truncated, tried, ui: uiRoute(op, args) }, EXIT.failed);
  }
  const best = last.ok ? last : null;
  if (best) {
    const { ok, surface, call, tier, ms, engine_ms, data, truncated, healed, cursor } = best;
    out({ ok, op: name, surface, call, ...(tier ? { tier } : {}), ms, ...(engine_ms !== undefined ? { engine_ms } : {}), ...(truncated ? { truncated } : {}), ...(healed ? { healed } : {}), ...(cursor ? { cursor } : {}), tried, data }, EXIT.ok);
  }
  out({ ok: false, op: name, class: last.class, reason: last.reason, ...(last.next ? { next: last.next } : {}), tried, ui: uiRoute(op, args) }, EXIT.failed);
}

async function measure(name, kv) {
  const op = opByName.get(name);
  if (!op) out({ ok: false, class: "usage", reason: `unknown op ${name}` }, EXIT.usage);
  if (op.kind !== "read" || isWrite(op)) out({ ok: false, op: name, class: "refused", reason: "measure runs reads only" }, EXIT.refused);
  const args = withDefaults(op, kv);
  const rows = [];
  const at = new Date().toISOString().slice(0, 10);
  const all = readJson(MEASURED, {});
  // Median of a few runs: one sample on a loaded Mac swings by 2x.
  const runs = Math.max(1, Number(process.env.CLAY_MEASURE_RUNS || 3));
  const median = (xs) => xs.slice().sort((a, b) => a - b)[Math.floor(xs.length / 2)];
  for (const cand of plan(op, args, null)) {
    // Never time a surface that moves Caleb's own Chrome tab.
    if (cand.s.drives_browser) continue;
    const samples = [];
    for (let i = 0; i < runs; i++) samples.push(await attempt(op, cand, { maxTier: null }));
    const good = samples.filter((x) => x.ok && !x.truncated);
    const r = good.length
      ? { ...good[0], ms: median(good.map((x) => x.ms)), ...(good[0].engine_ms !== undefined ? { engine_ms: median(good.map((x) => x.engine_ms)) } : {}) }
      : samples[0];
    const key = surfaceKey(op, cand.s);
    rows.push({ surface: key, ok: r.ok, ms: r.ms, engine_ms: r.engine_ms ?? null, tier: r.tier ?? null, truncated: !!r.truncated, ...(r.ok ? {} : { class: r.class, reason: r.reason }) });
    if (r.ok && !r.truncated) {
      all[name] = all[name] || {};
      all[name][key] = { ms: r.ms, at, ...(r.engine_ms !== undefined ? { engine_ms: r.engine_ms } : {}), ...(r.tier ? { tier: r.tier } : {}) };
    }
  }
  const sorted = Object.fromEntries(Object.keys(all).sort().map((k) => [k, all[k]]));
  fs.writeFileSync(MEASURED, `${JSON.stringify(sorted, null, 1)}\n`);
  out({ ok: rows.some((r) => r.ok), op: name, measured: rows }, EXIT.ok);
}

function doctor() {
  const checks = [];
  const dist = FIXTURES ? null : engineDist();
  checks.push({ check: "api-anything installed", ok: !!dist, detail: dist || "not on PATH" });
  const clone = registry.engine.clone.replace(/^~/, os.homedir());
  const head = spawnSync("git", ["-C", clone, "rev-parse", "HEAD"], { encoding: "utf8" }).stdout.trim();
  checks.push({ check: "pinned clone", ok: head === registry.engine.sha, detail: head ? `${clone} at ${head.slice(0, 12)}, pinned ${registry.engine.sha.slice(0, 12)}` : `no clone at ${clone}` });
  if (dist) {
    const got = distHash(dist);
    const want = registry.engine.dist_sha256;
    checks.push({ check: "installed build is the pinned build", ok: got === want, detail: got === want ? `dist sha256 ${got.slice(0, 12)}` : `dist sha256 ${got.slice(0, 12)}, want ${String(want).slice(0, 12)}: rebuild ${clone} at ${registry.engine.sha.slice(0, 12)} with npm ci --ignore-scripts && npm run build` });
  }
  const sess = path.join(ENGINE_HOME, "sessions", `${registry.engine.site}.json`);
  checks.push({ check: "Clay session imported", ok: fs.existsSync(sess), detail: fs.existsSync(sess) ? sess : registry.engine.login });
  checks.push({ check: "spec present", ok: specOps.size > 0, detail: `${specOps.size} operations in ${path.join(LIB, "clay.json")}` });
  const clay = spawnSync("sh", ["-c", "command -v clay"], { encoding: "utf8" }).stdout.trim();
  checks.push({ check: "clay CLI", ok: !!clay, detail: clay || "not on PATH" });
  out({ ok: checks.every((c) => c.ok), checks }, checks.every((c) => c.ok) ? EXIT.ok : EXIT.failed);
}

// Import a Chrome profile's Clay cookies into the --session engine home. Local
// only: it reads the profile's cookie store and writes one session file.
function sessionLogin(profile) {
  if (!SESSION_NAME) out({ ok: false, class: "usage", reason: "session-login needs --session NAME" }, EXIT.usage);
  if (!/^(Default|Profile \d{1,3})$/.test(String(profile || ""))) {
    out({ ok: false, class: "usage", reason: 'name the Chrome profile: Default or "Profile N"' }, EXIT.usage);
  }
  fs.mkdirSync(ENGINE_HOME, { recursive: true });
  // A fresh engine home knows no sites until the Clay spec is copied in.
  process.env.API_ANYTHING_HOME = ENGINE_HOME;
  syncSpec();
  const r = spawnSync("api-anything", ["login", registry.engine.site, "--profile", `Chrome/${profile}`], {
    encoding: "utf8", env: { ...process.env, API_ANYTHING_HOME: ENGINE_HOME }, timeout: 120000,
  });
  const ok = r.status === 0;
  out({ ok, session: SESSION_NAME, profile, home: ENGINE_HOME, ...(ok ? {} : { reason: (r.stderr || r.stdout || String(r.error)).trim().slice(0, 300) }) }, ok ? EXIT.ok : EXIT.failed);
}

const HELP = `chewbacca clay: Clay without opening Clay

  chewbacca clay ops                     every op with its surfaces, gate, measured ms
  chewbacca clay <op> [k=v ...]          run it through the fastest surface that answers
  chewbacca clay route <op> [k=v ...]    the order it would try, without calling
  chewbacca clay measure <op> [k=v ...]  time each surface once and record it (reads only)
  chewbacca clay doctor                  engine pin, session, spec

  --surface cli|api-anything|bin         force one surface
  --allow-writes                         a write; a person must type the op name at a terminal
  --dry-run                              print the exact request (method, URL, body; no cookie) and send nothing
  --session NAME                         use a second Clay login (api-anything only); import it once with
                                         chewbacca clay --session NAME session-login "Profile N"

ws is ws=<id>, else $CLAY_WORKSPACE_ID, else the one workspace in
~/.chewbacca/gtm/clients.json; with none or several it refuses. Output is one line of JSON.`;

(async () => {
  const { pos, kv, flags } = parseArgv(process.argv.slice(2));
  const [cmd, ...rest] = pos;
  if (!cmd || cmd === "help") {
    process.stdout.write(`${HELP}\n`);
    process.exit(EXIT.ok);
  }
  if (cmd === "ops") out(listOps(), EXIT.ok);
  if (cmd === "doctor") doctor();
  if (cmd === "session-login") sessionLogin(rest[0]);
  // The clay CLI is signed in to one account of its own, so a second session
  // reads through api-anything only, or the CLI would answer for the wrong login.
  if (SESSION_NAME) flags.surface = "api-anything";
  if (cmd === "route") {
    const op = opByName.get(rest[0]);
    if (!op) out({ ok: false, class: "usage", reason: `unknown op ${rest[0] ?? ""}` }, EXIT.usage);
    const args = withDefaults(op, kv);
    const order = plan(op, args, flags.surface).map((c) => ({ surface: c.s.type, call: surfaceKey(op, c.s), ms: Number.isFinite(c.ms) ? c.ms : null }));
    out({ ok: true, op: op.name, kind: op.kind, gate: op.gate, order, ui: uiRoute(op, args) }, EXIT.ok);
  }
  if (cmd === "measure") await measure(rest[0], kv);
  await runOp(cmd, kv, flags);
})().catch((e) => out({ ok: false, class: "error", reason: String(e && e.message ? e.message : e) }, EXIT.failed));
