      "args": [
        "ws",
        "table",
        "view?",
        "limit?",
        "after?",
        "cursor?"
      ],
      "surfaces": [
        {
          "type": "api-anything",
          "op": "listRowsAfter",
          "args": {
            "ws": "ws",
            "tableId": "table",
            "viewId": "view",
            "afterRecordId": "after",
            "limit": "limit"
