# Public site URL
NEXT_PUBLIC_SITE_URL=https://amberintelligence.ai

# The Clay webhook every waitlist signup is posted to. Required — there is no
# fallback in the code, on purpose: a Clay webhook is an unauthenticated write
# endpoint and does not belong in a committed file.
CLAY_WEBHOOK_URL=

# The Amber API this site signs in against and reads the network from.
#
# READ AT RUNTIME, by app/api/config/route.ts. Set it like any other service
# variable and restart; no rebuild, no build arguments. It is deliberately NOT
# a NEXT_PUBLIC_* variable: those are inlined by Next during `npm run build`,
# so on a platform that builds a container and then injects variables into it,
# the value is already frozen as the empty string. That is what made the login
# form say "Something went wrong" while the API logs stayed empty.
#
# This is the origin the iOS app uses. Point it at a custom domain only once
# that domain actually resolves to the same service.
#
# Whatever origin the SITE is served from must also be listed in the API's
# AMBER_WEB_ORIGINS, or the browser blocks every request before it leaves.
AMBER_API=https://amber-id-production.up.railway.app
