#!/usr/bin/env python3
"""Check direct corrections for a subsequent policy write in this session.

This conservative text heuristic does not establish intent or prove learning.
Runtime adapters must supply the real user prompt, never hook feedback. Writes
are evidence of a policy change, not evidence that the change fixes the problem.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import re
import sys
import time
from pathlib import Path

WRITE_LOG = Path(os.environ.get("CHEWBACCA_WRITE_LOG") or
                 (Path(os.environ.get("CHEWBACCA_HOME") or Path.home() / ".chewbacca").expanduser() / "write-log.tsv")).expanduser()

# Generic fault words and questions such as "why did you" also occur in
# ordinary status requests (BACKLOG's 2026-09-23 integration handoff).
# Require a direct correction instead of treating those words as intent.
CORRECTION = re.compile(
    r"\b(that'?s (?:not|wrong)|not what i|"
    r"(?:i|you|u) didn'?t (?:ask|say|want|tell)|"
    r"stop (?:doing|asking)|never (?:do|ask|say|make)|i never said|"
    r"ur being|you'?re being|shouldn'?t hv to|shouldn'?t have to|"
    r"what is wrong with you|1% the way|"
    r"(?:this|that|it|your (?:reply|writing|answer)) is (?:ai slop|slop writing)|"
    r"(?:this|that|it) doesn'?t seem authentic)\b", re.I)
DIRECT_REACTION = re.compile(r"^(?:(?:bro|bruh|dawg)\s+)?wtf[!? .]*$", re.I)

# Explicit repair requests also stand on their own without another complaint.
# "Did you fix chewbacca?" is a status question, not a new repair request.
EXPLICIT = re.compile(
    r"(?:^|[.!?;,\n]|\band(?: then)?)\s*"
    r"(?:(?:bro|bruh|dawg|please|wtf)\s+)*(?:(?:can|could|would) you\s+)?"
    r"(?:fix (?:chewbacca|the kit|ts)|make ts perfect)\b", re.I)


def correction_text(text):
    """Ignore quoted examples, code and blockquotes when classifying prose."""
    text = re.sub(r"```.*?(?:```|$)", "", text, flags=re.S)
    text = re.sub(r"(?m)^\s*>.*$", "", text)
    return re.sub(r'`[^`]*`|"[^"\n]*"|“[^”\n]*”', "", text).strip()


# Policy surfaces. A write here changes what the next session will do.
POLICY = (
    "/.claude/rules/", "/.claude/hooks/", "/skills/", "/second-brain/memory/",
    "/tests/", "BACKLOG.md", "/methods/", "CLAUDE.md", "AGENTS.md",
    "/bin/", "/docs/", "settings.json",
)


def wrote_policy(session_id, since=None, log=WRITE_LOG):
    """Paths in a policy surface written by this session."""
    if not log.exists() or not session_id:
        return []
    out = []
    try:
        for line in log.read_text(encoding="utf-8", errors="ignore").splitlines():
            parts = line.split("\t")
            if len(parts) < 3:
                continue
            ts, sid, path = parts[0], parts[1], parts[2]
            if sid != session_id:
                continue
            try:
                observed = float(ts)
            except ValueError:
                continue
            if not math.isfinite(observed) or (since is not None and observed < since):
                continue
            kit = Path(__file__).resolve().parents[1]
            target = Path(path).resolve()
            runtime_surface = any(root == target.parent or root in target.parents
                                  for root in (kit / "tools", kit / "config" / "instructions"))
            if runtime_surface or any(m in path for m in POLICY):
                out.append(path)
    except OSError:
        return []
    return out


def check(user_text, session_id, since=None, log=WRITE_LOG):
    """Returns (refuse, reason)."""
    user_text = correction_text(user_text or "")
    explicit = bool(EXPLICIT.search(user_text))
    if not (explicit or CORRECTION.search(user_text) or DIRECT_REACTION.fullmatch(user_text)):
        return False, ""
    hits = wrote_policy(session_id, since, log)
    if hits:
        return False, ""
    why = ("The user requested a kit repair." if explicit
           else "That read as a correction.")
    return True, why


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--session", default="")
    ap.add_argument("--since", type=float, default=0.0)
    ap.add_argument("--log", type=Path, default=WRITE_LOG)
    a = ap.parse_args()
    user_text = sys.stdin.read()
    refuse, why = check(user_text, a.session, a.since or None, a.log)
    if not refuse:
        return 0
    print(f"durable-check: {why} Nothing durable changed in this session.",
          file=sys.stderr)
    print("""
A direct correction was detected, but no subsequent policy write was found
in this session. This is a heuristic check, not a verified recurring error.

Change a policy surface before ending the turn: a rule, a hook, a skill, a
test, a memory, or the backlog. Then say which one and why, in a line.

If the correction genuinely needs no durable change, say so explicitly and
say why.""", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
