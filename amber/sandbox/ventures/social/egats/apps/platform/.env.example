# Supabase — create project at supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — for AI matching & search
ANTHROPIC_API_KEY=sk-ant-...

# App
NEXT_PUBLIC_APP_URL=https://your-platform.vercel.app

# Platform fee (default: 0.05 = 5%)
PLATFORM_FEE_RATE=0.05

# Rate limiting (requests per minute for AI endpoints)
AI_RATE_LIMIT=10

# Resend (for email notifications)
RESEND_API_KEY=re_...

# Supabase Storage bucket for portfolio clips
NEXT_PUBLIC_STORAGE_BUCKET=portfolio-clips
