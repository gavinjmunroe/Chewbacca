// Release build configuration.
// Points iOS at production amber-agent and amber-id.
// DO NOT put secrets here. Keep API keys in Keychain or CI secrets.

AMBER_URL_SCHEME = https:/$()/

AMBER_AGENT_BASE_URL = $(AMBER_URL_SCHEME)amber-agent-production.up.railway.app
AMBER_ID_BASE_URL = $(AMBER_URL_SCHEME)amber-id-production.up.railway.app
PRIVY_APP_ID = REPLACE_WITH_PRIVY_PROD_APP_ID
PRIVY_APP_CLIENT_ID = REPLACE_WITH_PRIVY_PROD_CLIENT_ID
COMPOSIO_PROJECT_ID = REPLACE_WITH_COMPOSIO_PROD_PROJECT_ID
AMBER_ENVIRONMENT = production

PRODUCT_BUNDLE_IDENTIFIER = com.amber.AmberApp
DISPLAY_NAME = Amber
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited)
