# ============================================================
# amber-agent — environment variables
# Multi-tenant AI agent. Each tenant gets their own identity
# resolved from the tenants table in Supabase.
# Copy this to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# ── AI (at least one required) ───────────────────────────────
# Perplexity: the single AI provider. Agent API for tool calling, Sonar
# for chat. Get a key at perplexity.ai/settings/api.
PERPLEXITY_API_KEY=pplx-...

# ── Transport: choose ONE ────────────────────────────────────
# loop   = iMessage via Loop Message (requires a Mac with iMessage signed in)
# twilio = SMS via Twilio (works on any machine, no Mac required)
TRANSPORT=loop

# Loop Message transport (iMessage, requires Mac)
# Sign up at loopmessage.com, install the Mac app, sign into iMessage.
# Find these in the Loop dashboard under Organization.
LOOP_API_KEY=
# LOOP_SENDER_ID and LOOP_SENDER_PHONE are deliberately NOT here anymore.
# They're per-tenant; stored in amber-id and read off the resolved tenant
# object for every send. Adding a person = one POST to amber-id; zero
# Railway changes.

# Twilio transport (SMS, no Mac needed)
# Sign up at twilio.com. Get a number in the Twilio console.
# Only used when TRANSPORT=twilio.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=+1XXXXXXXXXX         # your Twilio number

# ── Identity (single-tenant fallback) ────────────────────────
# Used when no tenant record exists in the database.
# In multi-tenant mode, the tenants table in Supabase overrides these.
# Your phone number in E.164 format (+1XXXXXXXXXX).
# CALEB_PHONE_NUMBER is gone. Owner phone lives on the tenant record
# in amber-id as `phoneNumber`.

# ── amber-id (primary data plane — REQUIRED) ─────────────────────────────
# amber-id is the identity and storage gateway. amber-agent no longer talks
# to Supabase, Postgres, or GitHub for tenant-scoped data. Operational data
# (messages, sessions, contacts, interactions, health_profiles) goes to
# /v1/data/* endpoints backed by GCP Firestore. Per-user private knowledge
# (context, memories, per-dimension graphs over time) goes to /knowledge/*
# endpoints backed by Pinecone, namespaced per cNFT.
AMBER_ID_API_URL=https://amber-id-production.up.railway.app
AMBER_ID_API_KEY=

# ── Privy (single auth authority — REQUIRED) ─────────────────────────────
# Privy.io is the only authentication for user-scoped requests. The iOS app,
# web dashboard, and Tiwari proxy clients all carry Privy JWTs that this
# server verifies against Privy's JWKS. Service-to-service calls (Loop
# webhooks, cron scripts, the agent acting as a delegate) use the
# AMBER_ID_API_KEY above.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional override; defaults to https://auth.privy.io/api/v1/apps/${PRIVY_APP_ID}/jwks.json
PRIVY_JWKS_URL=

# ── GitHub ───────────────────────────────────────────────────
# Personal access token with repo scope.
# Create at github.com/settings/tokens.
# Used to read your context files and write per-contact memory.
GITHUB_TOKEN=ghp_...

# ── Tools (all optional) ─────────────────────────────────────
# Todoist task management
# Get token at app.todoist.com > Settings > Integrations > API token
TODOIST_API_KEY=

# Composio — Gmail, Google Calendar, Drive, Docs, LinkedIn, Vercel, YouTube
# Get a key at composio.dev
COMPOSIO_API_KEY=

# ── Web search ───────────────────────────────────────────────
# Ollama cloud search — enables real web search results (free at ollama.com).
# Without this, DuckDuckGo instant answers are used as a best-effort fallback.
OLLAMA_API_KEY=

# ── Security ─────────────────────────────────────────────────
# Webhook auth: amber-agent supports two layers of authentication for
# inbound webhooks.
#
# 1. Provider signature (preferred). When a provider secret is set
#    AND the inbound request looks like that provider, the signature
#    MUST validate or the request is rejected.
#
#    LOOP_WEBHOOK_SECRET — HMAC-SHA256 secret shared with Loop Message.
#                         When present, Loop webhooks must include a
#                         valid `Loop-Signature` / `X-Loop-Signature`
#                         header.
#    TWILIO_AUTH_TOKEN   — already used to authenticate outbound Twilio
#                         calls; also used to verify the
#                         `X-Twilio-Signature` on inbound Twilio
#                         webhooks.
#
# 2. Shared-secret fallback. WEBHOOK_SECRET, sent as `?secret=...` query
#    param, `X-Webhook-Secret` header, or `Authorization: Bearer`. Use
#    when the provider isn't sending signatures yet, or for internal
#    service-to-service calls.
#
# In production (NODE_ENV=production), at least one of these must be
# set or all webhook requests will be rejected. In development the
# server runs permissively when nothing is configured.
LOOP_WEBHOOK_SECRET=
WEBHOOK_SECRET=

# Admin auth: gates /debug/* endpoints (raw webhook payloads, breaker
# state, etc). Set this to a strong random token in production. When
# unset in production, /debug/* refuses all requests; when unset in
# development, /debug/* is open with a warning.
ADMIN_TOKEN=

# CORS: comma-separated list of origins allowed to call the Tiwari
# proxy / API endpoints. Empty in production = no cross-origin access.
# In development, an empty list allows all origins for convenience.
# Example: CORS_ALLOWED_ORIGINS=https://app.amber.so,https://amber.so
CORS_ALLOWED_ORIGINS=

# Tool-output sanitization cap (chars). Each tool result is truncated
# to this length before being fed back to the model. Defaults to 16000.
TOOL_OUTPUT_MAX_CHARS=

# Composio allowlist override. Tools whose names are not in
# COMPOSIO_ACTIONS or this CSV are NEVER forwarded to Composio. Use
# this to add tools while a new one is being native-ported.
# Example: COMPOSIO_EXTRA_TOOLS=GMAIL_NEW_ACTION,LINEAR_NEW_ACTION
COMPOSIO_EXTRA_TOOLS=

# ── Advanced overrides ───────────────────────────────────────
# Default is claude-sonnet-4-6 for you, claude-haiku-4-5-20251001 for contacts.
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_CONTACTS=claude-haiku-4-5-20251001

# Self-hosted Ollama (third-tier AI fallback, optional)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3

# (PERPLEXITY_API_KEY is declared above in the AI providers section)

# CRM / Logging
# Clay CRM: enriches contacts with company, title, LinkedIn data
CLAY_API_KEY=clay_...
CLAY_TABLE_ID=

# Firestore: direct CRM interaction log (optional auxiliary channel; the
# primary operational store is amber-id's Firestore accessed via /v1/data/*).
FIRESTORE_PROJECT_ID=
FIRESTORE_SA_KEY=/path/to/service-account.json

# Supabase — REMOVED. amber-agent no longer talks to Supabase. All data
# lives in amber-id (GCP Firestore operational + Pinecone private KB).

# Amber Vector Memory API (optional)
# If set, enables vector-based long-term memory for richer context recall
AMBER_API_URL=

# BMA Prospect Routing
# Slack webhook to route BMA/sales prospect replies to your deal team
BMA_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# Comma-separated keywords that flag a contact as a prospect
BMA_PROSPECT_KEYWORDS=bma,prospect,investor,bd,deal

# ── tiwari-opportunity -> togari-opportunity (Opportunity Engine V2) ──
# The production "togari-clay" service that owns signal subscriptions,
# data pulls, Clay enrichment, and Stripe-metered billing for BMA clients.
# Defaults to the live Railway URL if unset.
TOGARI_OPPORTUNITY_URL=https://togari-clay-production.up.railway.app
TOGARI_OPPORTUNITY_API_KEY=

# ── tiwari-peoplerank -> togari-peoplerank (list-build primitive) ──
# Ranks people matching a natural-language query across BMA's contact graph.
# Exposed to Amber as the `peoplerank_list_build` tool. Newton layers on
# relationship-strength and health-dimension boosts before returning.
TOGARI_PEOPLERANK_URL=https://togari-amber-production.up.railway.app
TOGARI_PEOPLERANK_API_KEY=
TOGARI_PEOPLERANK_TIMEOUT_MS=4000

# ── Retell — outbound voice-agent foundation ─────────────────
# Foundation for placing outbound voice calls via Retell. Disabled by
# default; even with a key set, no call is placed unless
# AMBER_RETELL_ENABLED=true. Camber / Samber / Togari will couple to
# this adapter in later PRs — see docs/RETELL.md.
AMBER_RETELL_ENABLED=false
RETELL_API_KEY=
# Either an agent ID (preferred — the agent owns the LLM + prompt) or
# an LLM ID if the caller wants to attach an LLM directly.
RETELL_AGENT_ID=
RETELL_LLM_ID=
# E.164 number registered with Retell that outbound calls originate
# from. Per-tenant from-numbers will live in amber-id later.
RETELL_FROM_NUMBER=

# ── Image generation ─────────────────────────────────────────
# OpenAI gpt-image-1 backs the generate_image agent tool. The tool
# stashes the PNG in the ephemeral image-host (lib/image-host.js)
# and returns a short URL the agent loop auto-attaches to the
# outbound iMessage. Per-tenant override is supported via
# tenant.secrets.OPENAI_API_KEY in amber-id; this env is the
# org-level fallback for tenants without their own key.
OPENAI_API_KEY=sk-...
