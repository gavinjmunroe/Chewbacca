# Togari env. Copy to .env and fill in. Everything blank is optional.
# Required vars are marked REQUIRED. validateEnv() at boot fails on missing REQUIRED.

# === REQUIRED — server fails to boot without these ===

# Auth0 — JWT verification for dashboard + magic-link routes
AUTH0_DOMAIN=bma.us.auth0.com
AUTH0_AUDIENCE=https://togari.bluemodernadvisory.com

# Google Cloud — pick ONE of these two
# Option A: path to service account JSON (local dev)
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: base64-encoded service account JSON (Railway / containers)
GCP_CREDENTIALS_BASE64=

# === Recommended — feature degrades silently if absent ===

# Anthropic — Claude Haiku for realness classifier (heuristic-only fallback if absent)
ANTHROPIC_API_KEY=sk-ant-...

# Public URL — used as OAuth redirect target. Set to deployed domain in prod.
PUBLIC_URL=https://togari.bluemodernadvisory.com

# Sentry — error tracking. Capture is a no-op if DSN is unset.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# === Slack — required for /togari slash commands + magic-link onboarding ===
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...
MAGIC_LINK_INTERNAL_SECRET=

# === OAuth client credentials per platform ===
# Each pair is OPTIONAL. /dnc/auth/<platform> returns 503 if its credentials
# are missing, which the dashboard surfaces as a greyed-out card.

# LinkedIn — https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta (Instagram + Facebook) — https://developers.facebook.com
# Instagram scopes require Meta App Review + Business Verification
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Twitter/X — https://developer.twitter.com
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Account Activity API (webhooks) — requires Twitter API Pro
TWITTER_WEBHOOK_SECRET=
TWITTER_WEBHOOK_REGISTER=false
TWITTER_ENV_NAME=

# Google (Gmail + Contacts) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Snapchat Kit — https://kit.snapchat.com/portal
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# TikTok for Developers — https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Apple CardDAV — defaults to iCloud
APPLE_CARDDAV_BASE_URL=https://contacts.icloud.com
APPLE_SYNC_INTERVAL_MS=300000

# Chrome extension — set after publishing to Chrome Web Store
CHROME_EXTENSION_ID=
CHROME_EXTENSION_STORE_URL=

# === BigQuery layout overrides (defaults match production) ===
GCP_PROJECT_ID=midyear-glazing-485303-u3
BIGQUERY_DATASET=togari_data_lake
BIGQUERY_TABLE=togari_structured_contacts_external
BIGQUERY_DEALS_TABLE=togari_structured_deals

# === Pub/Sub topics ===
PUBSUB_TOPIC=
PUBSUB_TOPIC_SOCIAL=

# === HTTP mode (Railway sets PORT automatically) ===
PORT=4100

# === Tenancy / multi-tenant gate ===
TENANT_ID=bma
AUTH0_CLIENT_ID_CLAIM=client_id

# === MCP gateway keys (comma-separated lists) ===
TOGARI_INTERNAL_KEYS=
TOGARI_EXTERNAL_KEYS=

# === Tools used by the agent layer (optional) ===
CLAY_API_KEY=
EXA_API_KEY=
STRUCTIFY_API_KEY=
