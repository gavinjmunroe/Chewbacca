#!/bin/bash
# chewbacca-node: one node for launchd jobs, at a path that never changes,
# that macOS shows in System Settings as "Chewbacca" with its own icon.
#
#   chewbacca-node            build or refresh the runtime, print the node path
#   chewbacca-node --path     print the path only
#   chewbacca-node --app      print the Chewbacca.app path (what a grant goes to)
#
# A job launchd starts has no .app above it, so macOS charges its privacy
# requests to the binary itself. On 2026-10-09 that was nvm's node, whose path
# moves with every version, so "node would like to access data from other apps"
# came up many times in one day. Then a stable copy fixed the repeats, but
# System Settings still listed it as "node" with a black exec icon, and Caleb,
# 2026-10-10: "non devs will think its malware".
#
# So node now lives inside ~/.chewbacca/runtime/Chewbacca.app, signed ad hoc as
# com.chewbacca.runtime, and ~/.chewbacca/runtime/node is a symlink to it.
# Jobs keep pointing at the same node path; TCC resolves the link, finds the
# bundle, and every prompt and list row says Chewbacca.
#
# An ad hoc signature is pinned to the binary's hash, so a re-sign is a new
# identity and needs the grant again. The first version rebuilt only on a node
# MAJOR change to spare that, and the commit security review (2026-10-10)
# flagged it: patch releases are where node ships its security fixes, so the
# Full Disk Access runtime would sit on a known-vulnerable node for months.
# It now rebuilds on any version change, and `chewbacca permissions` shows the
# grant as missing again so re-granting is one drag on the card.
#
# Known exposure, same as giving Terminal Full Disk Access: anything that can
# launch this binary as its own responsible process (a launchd job you or a
# program submit) runs JavaScript with the grant. A launcher that only runs
# the texts sync would narrow it; tracked in the work ledger.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNTIME="${CHEWBACCA_RUNTIME:-$HOME/.chewbacca/runtime}"
APP="$RUNTIME/Chewbacca.app"
BIN="$APP/Contents/MacOS/Chewbacca"
LINK="${CHEWBACCA_NODE:-$RUNTIME/node}"
ICON="$ROOT/mac/runtime/Chewbacca.icns"

case "${1:-}" in
  --path) echo "$LINK"; exit 0 ;;
  --app) echo "$APP"; exit 0 ;;
esac

src="${CHEWBACCA_NODE_SOURCE:-}"
if [[ -z "$src" && -d "$HOME/.nvm/versions/node" ]]; then
  newest=$(ls "$HOME/.nvm/versions/node" | sort -V | tail -1)
  [[ -n "$newest" && -x "$HOME/.nvm/versions/node/$newest/bin/node" ]] && src="$HOME/.nvm/versions/node/$newest/bin/node"
fi
if [[ -z "$src" ]]; then
  for candidate in /opt/homebrew/bin/node /usr/local/bin/node; do
    [[ -x "$candidate" ]] && { src=$(cd "$(dirname "$candidate")" && pwd -P)/$(basename "$candidate"); break; }
  done
fi
[[ -z "$src" ]] && { echo "chewbacca-node: no node found under ~/.nvm or Homebrew" >&2; exit 1; }

version() { "$1" -p 'process.versions.node' 2>/dev/null || echo none; }
want=$(version "$src")
have=$( [[ -x "$BIN" ]] && /usr/libexec/PlistBuddy -c "Print :ChewbaccaNodeVersion" "$APP/Contents/Info.plist" 2>/dev/null || echo none)

if [[ "$want" != "$have" ]] || ! codesign -v "$APP" 2>/dev/null; then
  # Build beside it and swap whole, so a job starting mid-refresh never runs
  # half a bundle.
  stage="$RUNTIME/.Chewbacca.app.new"
  rm -rf "$stage"
  mkdir -p "$stage/Contents/MacOS" "$stage/Contents/Resources"
  cp -p "$src" "$stage/Contents/MacOS/Chewbacca"
  [[ -f "$ICON" ]] && cp "$ICON" "$stage/Contents/Resources/Chewbacca.icns"
  cat > "$stage/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>Chewbacca</string>
  <key>CFBundleDisplayName</key><string>Chewbacca</string>
  <key>CFBundleIdentifier</key><string>com.chewbacca.runtime</string>
  <key>CFBundleExecutable</key><string>Chewbacca</string>
  <key>CFBundleIconFile</key><string>Chewbacca</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSUIElement</key><true/>
  <key>ChewbaccaNodeVersion</key><string>$want</string>
</dict></plist>
PLIST
  codesign --force --sign - --identifier com.chewbacca.runtime "$stage" >/dev/null 2>&1 \
    || { echo "chewbacca-node: could not sign $stage" >&2; exit 1; }
  rm -rf "$APP.old"
  [[ -d "$APP" ]] && mv "$APP" "$APP.old"
  mv "$stage" "$APP"
  rm -rf "$APP.old"
  echo "chewbacca-node: built $APP (node $want). Grants go to Chewbacca now." >&2
fi

# The old runtime was a plain copy at this path; replace it with the link.
if [[ ! -L "$LINK" || "$(readlink "$LINK")" != "$BIN" ]]; then
  mkdir -p "$(dirname "$LINK")"
  ln -sfn "$BIN" "$LINK.new" && mv -f "$LINK.new" "$LINK"
fi
echo "$LINK"
