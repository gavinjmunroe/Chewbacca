# ─────────────────────────────────────────────────────────────────────
# Togari platform — environment variables
# Copy to `.env` and fill in real values for local development.
# Production secrets live in Railway env settings.
# ─────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── MCP server auth (Tab 1) ──────────────────────────────────────────
# Static bearer accepted via `?token=<value>` URL query param. Required
# for Claude.ai / ChatGPT custom connectors that cannot send Authorization
# headers. Generate with: `openssl rand -hex 32`.
MCP_BEARER_TOKEN=

# Auth0 — used by the Bearer-JWT auth path on /mcp* and by the existing
# /api routes. The Togari tenant is dev-4prs757badfajpi5.us.auth0.com
# (NOT bluemodern.us.auth0.com — that one is a stale ref).
AUTH0_DOMAIN=dev-4prs757badfajpi5.us.auth0.com
AUTH0_AUDIENCE=

# Default tenant id assumed when auth is satisfied via URL token (which
# carries no claims) and in dev-anonymous mode. Production should set
# this per-Railway-environment to avoid cross-tenant leakage.
MCP_DEFAULT_TENANT_ID=bma

# ── Google Cloud (BigQuery + Pub/Sub + Storage) ──────────────────────
# Base64-encoded service-account JSON. Used by BigQueryClient and the
# Pub/Sub worker (Tab 3). Either GCP_CREDENTIALS_BASE64 or
# GOOGLE_CREDENTIALS_BASE64 is accepted.
GCP_CREDENTIALS_BASE64=
GOOGLE_CREDENTIALS_BASE64=

# ── Observability ────────────────────────────────────────────────────
SENTRY_DSN=

# ── Email engine ─────────────────────────────────────────────────────
# Smartlead inbound webhook HMAC secret (existing /smartlead/webhook route).
SMARTLEAD_API_KEY=
SMARTLEAD_WEBHOOK_SECRET=

# Per-client replybot webhook secrets (POST /replybot/:clientId/webhook).
# The env var name for each client is set by webhookSecretEnv in
# src/agents/replybot/client-config.ts. Generate with `openssl rand -hex 32`
# and set the SAME value on the caller:
#   - static-key clients (amber, bma, serif): Clay HTTP API column sends it
#     in the X-Replybot-Key header.
#   - smartlead-hmac clients: Smartlead's webhook secret field; it signs
#     the raw body into X-Smartlead-Signature.
# Required in production for every non-retired client, including ones whose
# replies only arrive via POST /replies and never call this route: with
# NODE_ENV=production an unset secret makes the route answer 503 and log an
# error naming the missing var. Outside production an unset secret logs a
# warning and skips auth (dev mode) so local testing works without one.
# serif_test inherits REPLYBOT_SERIF_WEBHOOK_SECRET from serif.
REPLYBOT_AMBER_WEBHOOK_SECRET=
REPLYBOT_BMA_WEBHOOK_SECRET=
REPLYBOT_SERIF_WEBHOOK_SECRET=
# Clients fed only by POST /replies (zeutara) name no secret and have no
# webhook: their route refuses everything, so there is nothing to set here.
REPLYBOT_HHH_WEBHOOK_SECRET=
# REPLYBOT_AIJ_WEBHOOK_SECRET= (AIJ offboarded 2026-09-02 — client is
# retired in client-config.ts and the webhook answers 410 before auth,
# so this being unset does not open the endpoint. Remove from Railway.)

# Outbound Clay webhook for approved replies (clients whose sendMethods
# include 'clay'; the env var name is set by clayReplyWebhookUrlEnv in
# client-config.ts). Serif's approved replies POST here and Clay sends them
# with its "reply to lead in a campaign" action, out of the campaign's own
# Smartsenders mailbox — so the persona the prospect wrote to is the one
# that answers, and we never touch the 30 sending inboxes.
#
# The URL carries a UUID and is itself the credential, so treat it like a
# secret. Unset means the Send button fails loudly rather than falling back
# to Gmail, which would mail the prospect from the wrong mailbox.
REPLYBOT_SERIF_CLAY_REPLY_URL=
# Zeutara: Clay Sequencer replies from whichever of Jonah's mailboxes the
# investor wrote to. Clay is Zeutara's only send method, so unset means Send
# fails. See docs/ZEUTARA_REPLYBOT_SETUP.md.
REPLYBOT_ZEUTARA_CLAY_REPLY_URL=

# Slack signing secret (existing /slack/events + /slack/interactivity).
SLACK_SIGNING_SECRET=

# Slack user token (xoxp-). OPTIONAL. Acts as the human who installed the
# app, not as @Togari, so use it only for APIs the bot token cannot call
# (search.messages, posting as a real person). Everything else keeps using
# SLACK_BOT_TOKEN.
#
# Where to get it: Slack app -> OAuth & Permissions -> declare the scopes
# you need under "User Token Scopes" -> Reinstall to Workspace -> copy the
# "User OAuth Token". The OAuth callback below isn't involved; the user
# token is only ever for the home workspace. See docs/SLACK_USER_TOKEN.md.
#
# This token carries that person's full workspace access. Treat it as more
# sensitive than the bot token and never commit it.
SLACK_USER_TOKEN=

# Slack app credentials, for installing Togari into a client's OWN workspace
# so its reply cards land there (GET /slack/oauth_callback). OPTIONAL: unset,
# the callback refuses every install and nothing else changes. Slack app ->
# Basic Information -> App Credentials.
#
# The secret also signs the install links scripts/slack-install-link.ts
# mints, so the value in your local .env must match Railway's, or the
# callback rejects the link. See docs/SLACK_EXTERNAL_WORKSPACE.md.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Auto-polling ─────────────────────────────────────────────────────
AUTO_POLL=false
POLL_INTERVAL_MINUTES=15

# ── Clay passthrough ingestion (supported path) ──────────────────────
# Bearer token Clay sends to POST /webhooks/clay/companies|/contacts.
# This is the supported inbound path (per-row streaming insert to BigQuery).
CLAY_INGEST_API_KEY=

# Per-IP fixed-window rate limit (requests/minute) on the /webhooks/clay
# routes. Backstop against runaway insert cost if the key leaks. Default 600.
CLAY_INGEST_RATE_LIMIT_PER_MIN=600

# Outbound Clay API key (Togari → Clay enrichment). Currently Caleb's key.
CLAY_API_KEY=

# ── Clay HMAC batch ingestion (DISABLED — legacy) ────────────────────
# The /api/ingest/clay batch route persists via per-row BigQuery DML, which
# does not scale. It is gated OFF and returns 501 unless explicitly enabled.
# Prefer the passthrough path above. Only set these to revive it deliberately.
CLAY_HMAC_INGEST_ENABLED=false
# HMAC-SHA256 shared secret Clay uses to sign POSTs to /api/ingest/clay.
# Generate with: `openssl rand -hex 32`.
CLAY_WEBHOOK_SECRET=

# Default tenant id stamped on incoming Clay rows when the payload
# does not specify one. Should match the tenant the Clay table belongs to.
CLAY_DEFAULT_TENANT_ID=bma

# ── BigQuery dataset (Tab 5 + Tab 2) ─────────────────────────────────
# Tab 2's schema (PR #5) created the togari_core dataset. Override only if you point at a scratch dataset for testing.
BIGQUERY_DATASET=togari_core
GCP_PROJECT_ID=midyear-glazing-485303-u3

# ── OpenAI ───────────────────────────────────────────────────────────
# Used by the agent enrichment loop (Tab 3). In production each tenant's
# OPENAI_API_KEY lives encrypted in tenant_secrets (Tab 7) and this env
# value is ignored. In non-production (NODE_ENV != 'production') this env
# value is used as a fallback so local dev works without seeding BQ.
OPENAI_API_KEY=

# ── Tenant secret store (Tab 7) ──────────────────────────────────────
# 32-byte AES-256-GCM master key used to encrypt rows in
# togari_core.tenant_secrets. Generate with: `openssl rand -hex 32`.
# Required to read or write any per-tenant secret. Rotating this key
# invalidates every existing encrypted row — plan a re-seed window.
TENANT_SECRETS_MASTER_KEY=

# ── Exa — platform-level credential (Tab 10) ─────────────────────────
# Used by the togari.exa.* MCP tools (search, find_similar, get_contents,
# answer). Single Togari-wide key; per-tenant usage rolls up via the
# cost_logs table and admin_settings.pricing_config bill-back. Resolves
# via the 3-tier secret system: Cloud Run volume → Secret Manager
# (`exa-api-key`) → this env var.
EXA_API_KEY=

# ── ZoomInfo — per-tenant credentials (Tab 10) ───────────────────────
# PKI auth triple for the legacy Enterprise API. Most PE / advisory
# tenants already own ZoomInfo seats; reuse their (username, client_id,
# private_key). Long-term these live in Tab 7's tenant_secrets BQ table
# (`getTenantSecret(tenantId, 'ZOOMINFO_*')`). Until that lands they
# resolve via the platform 3-tier as a single-tenant default.
#
# When pasting the private key into Railway / dotenv, line breaks are
# typically escaped as literal `\n`. The auth layer normalizes those
# back to real newlines before signing.
ZOOMINFO_USERNAME=
ZOOMINFO_CLIENT_ID=
ZOOMINFO_PRIVATE_KEY=

# ── Perplexity reply loop — Clay intake (POST /replies) ──────────────
# Bearer token Clay sends on the HTTP API column that posts each inbound
# cold-email reply into reply_items (migration 0033). Generate with
# `openssl rand -hex 32`. Unset means the endpoint fails closed with 500,
# never open. Comma-separated to rotate without downtime: add the new
# token, swap Clay's Authorization header, then drop the old one.
REPLIES_INGEST_TOKEN=
# Tenant stamped on rows that arrive without an explicit client_id, matching
# the replybot client registry (src/agents/replybot/client-config.ts). It is
# also what picks the Slack channel the resulting card lands in, so it is the
# switch between testing and live:
#   serif_test  -> cards to C0C14UKEEUR, labelled "Serif Health (test)"
#   serif       -> cards to Serif's real channel, C0BAL9JV0E5
# Everything else (voice, sender, Clay send routing) is identical between the
# two, so a test run exercises the real path.
REPLIES_DEFAULT_CLIENT_ID=serif_test
# Bearer token Perplexity sends when it POSTs a finished draft back to
# POST /replies/result (plan step 10 — stored in Perplexity's credential
# settings, never written into the instruction message, since Perplexity keeps
# a readable record of every session). Separate from REPLIES_INGEST_TOKEN so
# the two callers rotate independently. Comma-separated, same as above.
REPLY_RESULT_TOKEN=

# ── Perplexity Computer MCP — sign-in (plan step 05) ─────────────────
# Perplexity accounts are PER CLIENT — each client's drafting bills to their
# own account. The account id defaults to the replybot client id (serif ->
# "serif"), so a new client needs nothing here: just its own sign-in click at
# /perplexity/oauth/start?client=<id>.
#
# Set PERPLEXITY_ACCOUNT_<CLIENT_ID> only to point a client at a DIFFERENT
# account than their own — e.g. running Serif on our account before step 14
# hands it back to theirs. Removing the override and signing in again is the
# step 14 swap. This is also what lands in reply_items.pplx_account, and a
# conversation can only be continued by the account that started it, so drain
# the queue (step 13) before changing it.
# PERPLEXITY_ACCOUNT_SERIF=bma
# Port the local sign-in script listens on for the OAuth callback. Perplexity
# only accepts loopback redirect URIs (http://localhost:*), which is why
# signing in is `npx tsx scripts/perplexity-signin.ts --client=<id>` and not a
# page on the server. Only set this if 8765 is taken.
# PERPLEXITY_OAUTH_PORT=8765
# Channel for the "login is broken, drafting has stopped" alert. Without it the
# alert has nowhere to go and only reaches the logs — which is the exact
# failure mode step 05(g) exists to prevent.
PERPLEXITY_ALERT_SLACK_CHANNEL=

# The Perplexity PROJECT a task runs inside, per account. The plan sends
# project_uuid: null, but step 10 saves the Togari callback credential to a
# project vault — and a session with no project cannot see it, so the task
# does all its thinking and then cannot deliver. Set this to the project
# holding the credential. Leave unset only if the credential lives in the user
# vault with "Always allow".
# PERPLEXITY_PROJECT_UUID_SERIF=
# PERPLEXITY_PROJECT_UUID_ZEUTARA=

# ── Reply loop — sweeper + spend cap (plan steps 07/08) ──────────────
# Chases replies Perplexity never returned. Off by default so two replicas
# cannot double-chase the same rows and pay twice.
# NOTE: this flag runs the whole loop, not just the chase-up. With it off,
# replies land in the queue and stay there — nothing sends them to Perplexity,
# which looks exactly like "Clay worked but no card appeared".
REPLY_SWEEP_ENABLED=false
REPLY_SWEEP_INTERVAL_MINUTES=5
REPLY_DISPATCH_PER_PASS=5         # queued replies sent per pass, so a backlog
                                  # drains steadily instead of firing dozens of
                                  # paid tasks at once
REPLY_SWEEP_STALE_MINUTES=15      # silent this long -> chase it
REPLY_SWEEP_MAX_ATTEMPTS=3        # then mark it failed. Not optional: an
                                  # unlimited retry loop against something that
                                  # charges per call runs until the money does.
REPLY_SWEEP_GIVE_UP_MINUTES=60    # older than this -> failed, whatever attempts says
REPLY_SWEEP_DISPATCHING_MINUTES=15 # stuck mid-dispatch this long -> ALERT, never retry.
                                  # Must stay above normal end-to-end time (3-6 min), or
                                  # it alerts on replies that are only running slow.
                                  # Floored in code at PERPLEXITY_CALL_TIMEOUT_MS + 2 min:
                                  # a row sits on 'dispatching' for as long as its call
                                  # runs, so alerting sooner reports working tasks as stuck.
# How long one Perplexity Computer call may run. This is the WHOLE TASK, not a
# handshake — the MCP call blocks until the work is done. Normal is under a
# minute; the ceiling is for a degraded Perplexity. Giving up early does not
# stop or refund the task, it just loses the thread id that makes the row
# addressable afterwards. Raising it also raises the dispatch budget and the
# floor under the alert above, which is why it lives in one place.
PERPLEXITY_CALL_TIMEOUT_MS=900000 # 15 minutes
# Perplexity never reports what a call cost, so this counter is the only spend
# protection there is. Per account, per UTC day, counting chase-ups.
PERPLEXITY_DAILY_CALL_CAP=200

# The published categories/voice document Perplexity reads before classifying
# (step 09). PER CLIENT — every client gets their own categories, edge cases and
# voice, so there is deliberately no shared default: a client drafting against
# another client's guide is worse than one drafting against none.
#
# Naming is <CLIENT>_REPLY_GUIDE_URL. A derived test client (serif_test) reads
# the same variable as its parent, so one guide covers both.
#
# Must be readable with NO login — open it in a private window first. If it asks
# you to sign in, the AI cannot read it either, and it will classify blind.
SERIF_REPLY_GUIDE_URL=
ZEUTARA_REPLY_GUIDE_URL=
# BMA_REPLY_GUIDE_URL=
# AMBER_REPLY_GUIDE_URL=

# ── Warm-intro connection research (POST /connections) ──
# Same loop as replies, on the same Perplexity seat and project: Clay posts a
# person, Perplexity reads the guide and the target sheet and posts back
# employment histories, Togari matches them against the sheet and POSTs each
# connection into a Clay table. Setup: docs/SERIF_CONNECTIONS_SETUP.md.
#
# Intake uses REPLIES_INGEST_TOKEN and the callback REPLY_RESULT_TOKEN — no new
# tokens, and nothing new in the Perplexity project vault.
#
# Both URLs must open with NO login (try a private window). The sheet must be
# File -> Share -> Publish to web -> CSV; Togari reads it too.
SERIF_CONNECTION_GUIDE_URL=
SERIF_TARGET_ACCOUNTS_URL=
# Clay webhook-source table each connection is POSTed into. A secret.
SERIF_CONNECTIONS_CLAY_URL=
CONNECTION_SWEEP_ENABLED=false
CONNECTION_SWEEP_INTERVAL_MINUTES=10
CONNECTION_DISPATCH_PER_PASS=1           # people researched per pass
# Separate from PERPLEXITY_DAILY_CALL_CAP so a backfill cannot use up the day's
# reply drafting. The seat's CREDITS are still shared: run out, and reply
# drafting halts too.
PERPLEXITY_CONNECTION_DAILY_CALL_CAP=10
# Daily Slack digest of new warm-intro paths (src/connections/digest.ts).
# Weekdays, from this hour in each client's own timezone, up to 3 hours late.
CONNECTION_DIGEST_ENABLED=false
CONNECTION_DIGEST_HOUR=9

# Testing only: force every card to this replybot client regardless of what the
# row stored, so a row created with a live client_id cannot put a test card in
# the channel a client works out of. Unset it to go live.
REPLIES_FORCE_CLIENT_ID=

# An answered reply's queue row is deleted once the reply is sent — the row
# exists to get a draft in front of a person, and has done its job. Set to
# false to keep the rows (the draft, category and reasoning stay queryable, at
# the cost of holding prospect reply text in BigQuery indefinitely).
REPLIES_DELETE_AFTER_SEND=true

# Clay webhook that sends FIRST-TOUCH outreach (website form fills). Separate
# from REPLYBOT_SERIF_CLAY_REPLY_URL because Clay's "reply to lead in a
# campaign" action is keyed on lead id + campaign id, and a form fill has
# neither — nobody emailed them first. It needs its own Clay table and its own
# send action.
#
# It CAN be the same URL as REPLYBOT_SERIF_CLAY_REPLY_URL — that webhook feeds a
# Clay table, and one table can hold both kinds of row. Outreach posts
# {email, name, subject, body, client_id, kind: "outreach"} with no lead_id or
# campaign_id, so Clay routes on `kind`: replies go to "reply to lead in a
# campaign", outreach to a send action that does not need a campaign thread.
#
# While this is unset, outreach keeps going out over Gmail from the client's
# sender address, exactly as before. Setting it is the switch.
REPLYBOT_SERIF_CLAY_OUTREACH_URL=

# A verdict with no draft posts no Slack card. The AI writes no draft for
# `negative` by instruction and for out-of-office because the guide says so,
# and a card with nothing to approve is noise in the channel people work out of.
# The classification is still recorded on the row either way.
#
# NOTE what this hides: `negative` includes unsubscribes and do-not-contact
# requests, which now reach nobody. If those need a human, they need their own
# path — this flag is not it.
REPLIES_CARD_REQUIRES_DRAFT=true
