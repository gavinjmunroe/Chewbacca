#!/usr/bin/env python3
"""brain-pull-safe: bring a phone session's note commits into the Mac's brain
repo, and nothing else.

This Mac runs code from the brain repo without asking (sync scripts from
launchd, brain-check at SessionStart, .githooks on commit, .claude hooks and
skills when a session opens there), and it loads CLAUDE.md files as
instructions. Once a phone session can push (docs/PHONE.md), anything that
steers that session could plant either. So a pull is an ALLOWLIST: every path
the remote changed must be a plain note file. Two review rounds on 2026-10-07
broke a denylist of code extensions (extensionless scripts, the claude/ skills
the brain links in, quoted filenames), which is why this is a whitelist read
from `git diff --raw -z`, never from the quoted text output.

    brain-pull-safe <repo>     exit 0 pulled or nothing to pull
                               exit 3 refused, remote changes non-note paths
                               exit 4 rebase conflict, aborted
                               exit 2 not a repo / fetch failed
"""
import os
import subprocess
import sys

NOTE_EXT = {".md", ".yml", ".yaml", ".json", ".txt", ".csv", ".tsv"}
# Instruction files are loaded as orders, not read as notes. The memory index
# (MEMORY.md) is NOT here: a phone that can't index its own memory files isn't
# usable with the Mac off, which Caleb asked for on 2026-10-07. A repo that
# wants it locked lists it in .brain-pull-protect.
INSTRUCTION_NAMES = {"claude.md", "agents.md", "gemini.md", "claude.local.md",
                     "copilot-instructions.md"}
# claude/ holds skills the brain's .claude/skills links to; bin/ holds tools.
BLOCKED_TOP = {"claude", "bin"}
# Every comparison is lowercased: macOS checks out "Claude/x" and "claude/x"
# to the same folder, so a case-sensitive check let "CLAUDE.MD" and "Bin/"
# through on 2026-10-07.
#
# A repo adds its own instruction paths, the files its sessions @import, one
# per line in .brain-pull-protect ("core/" for a folder). That file starts with
# a dot, so a remote commit can never edit its own protection.
PROTECT_FILE = ".brain-pull-protect"
PLAIN_FILE, DELETED = "100644", "000000"


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True)


def protected(repo):
    try:
        with open(os.path.join(repo, PROTECT_FILE), encoding="utf-8") as f:
            return [l.strip().lower() for l in f if l.strip() and not l.startswith("#")]
    except OSError:
        return []


def refusal(old_mode, new_mode, path, protect):
    # Printable ASCII only. Python's lower() and macOS's filename matching
    # disagree outside ASCII (Unicode normalization, the Kelvin sign folding to
    # "k"), so a non-ASCII name could pass here as one file and land on disk as
    # another. Note titles are plain English, so nothing real is lost.
    if not path or any(not (32 <= ord(c) < 127) or c == "\\" for c in path):
        return "non-ASCII or control character in name"
    low = path.lower()
    parts = low.split("/")
    if any(p.startswith(".") for p in parts):
        return "dot path"
    if parts[0] in BLOCKED_TOP:
        return f"{parts[0]}/ is code"
    if parts[-1] in INSTRUCTION_NAMES:
        return "instruction file"
    if any(low == p or (p.endswith("/") and low.startswith(p)) for p in protect):
        return "protected in .brain-pull-protect"
    if os.path.splitext(parts[-1])[1] not in NOTE_EXT:
        return "not a note type"
    if new_mode not in (PLAIN_FILE, DELETED) or old_mode not in (PLAIN_FILE, DELETED):
        return f"mode {old_mode}->{new_mode}"
    return None


# Files a Claude Code session loads before the first message: the memory
# index, and in the kit's brain layout core/ and hot.md.
LOADED_AT_START = ("memory/memory.md", "core/", "hot.md")


def loaded_at_start(path):
    low = path.lower()
    return any(low == p or (p.endswith("/") and low.startswith(p)) for p in LOADED_AT_START)


def main():
    if len(sys.argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    repo = sys.argv[1]
    branch = git(repo, "branch", "--show-current").stdout.decode().strip()
    if not branch or git(repo, "fetch", "-q", "origin").returncode != 0:
        return 2
    # Resolve the remote to one commit and use that commit for both the check
    # and the rebase. Checking origin/main and then rebasing onto origin/main
    # let a concurrent fetch (brain-sync and the daily sync both pull) swap in
    # an unchecked commit between the two.
    ref = git(repo, "rev-parse", "--verify", "-q", f"origin/{branch}^{{commit}}")
    if ref.returncode != 0:
        return 2
    up = ref.stdout.decode().strip()
    head = git(repo, "rev-parse", "HEAD").stdout.decode().strip()
    if git(repo, "merge-base", "--is-ancestor", up, head).returncode == 0:
        return 0
    protect = protected(repo)
    raw = git(repo, "diff", "--raw", "-z", "--no-renames", "--no-ext-diff", f"{head}...{up}")
    if raw.returncode != 0:
        return 2
    fields = raw.stdout.decode("utf-8", "surrogateescape").split("\0")
    bad = []
    loaded_changes = 0
    i = 0
    while i + 1 < len(fields) and fields[i].startswith(":"):
        meta, path = fields[i][1:].split(" "), fields[i + 1]
        if len(meta) != 5:
            bad.append(f"{path!r} (unparsed diff entry)")
        else:
            why = refusal(meta[0], meta[1], path, protect)
            if why:
                bad.append(f"{path!r} ({why})")
            elif loaded_at_start(path):
                loaded_changes += 1
        i += 2
    # Every byte of the diff must have been read as an entry. Stopping early on
    # anything unexpected used to leave the rest of the entries unchecked.
    if fields[i:] not in ([], [""]):
        bad.append("unparsed remainder of the diff")
    marker = os.path.join(repo, ".git", "brain-pull-refused")
    if bad:
        print(f"brain-pull-safe: not pulling {up[:10]}, it changes: " + ", ".join(bad[:10]), file=sys.stderr)
        # A refused remote blocks every later pull until someone looks, so say
        # so where a session will see it (brain-check reads this at start).
        # Only a count and a hash go in: the refused paths are named by the
        # remote, and a session reads this file as context, so a filename
        # written as an instruction would have reached the model.
        with open(marker, "w", encoding="utf-8") as f:
            f.write(f"{len(bad)} refused path(s) in remote commit {up[:12]}\n")
        return 3
    # Also refuse if HEAD moved since the check, so the rebase applies exactly
    # the diff that was read.
    if git(repo, "rev-parse", "HEAD").stdout.decode().strip() != head:
        return 2
    if git(repo, "rebase", "-q", "--autostash", up).returncode != 0:
        git(repo, "rebase", "--abort")
        print(f"brain-pull-safe: rebase onto {up[:10]} conflicted, aborted", file=sys.stderr)
        return 4
    if os.path.exists(marker):
        os.remove(marker)
    # The phone may edit files every session loads (Caleb's call, 2026-10-07),
    # so the next session is told how many came in. A count, never the names.
    if loaded_changes:
        with open(os.path.join(repo, ".git", "brain-pull-loaded"), "a", encoding="utf-8") as f:
            f.write(f"{loaded_changes} loaded-at-start file(s) changed by remote commit {up[:12]}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
