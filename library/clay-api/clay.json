    }
   },
   "slots": [
    {
     "param": "tableId",
     "at": [
      "path:2"
     ]
    }
   ],
   "volatile": [],
   "trigger": {
    "url": "https://app.clay.com/workspaces/{ws}/workbooks/home/tables/{tableId}"
   },
   "match": {
    "method": "GET",
    "host": "api.clay.com",
    "path": "/v3/tables/*"
   },
   "response": {
    "format": "json",
    "extract": "table",
    "pick": [
     "id",
     "name",
     "workbookId",
     "type",
