        },
        {
          "type": "api-anything",
          "op": "listRows",
          "args": {
            "ws": "ws",
            "tableId": "table",
            "viewId": "view",
            "limit": "limit"
          },
          "unless": [
            "after",
            "cursor"
          ]
        },
        {
          "type": "cli",
          "argv": [
            "tables",
            "rows",
            "list",
            "{table}"
