import test from 'node:test';import assert from 'node:assert/strict';import {register} from 'node:module';
const loader=`export async function resolve(s,c,n){if(c.parentURL?.endsWith('/createReviewedContact.ts')){const source=s==='./appleContactWrite'?'export const chooseAppleContact=(...a)=>globalThis.__review.choose(...a);export const saveToAppleContacts=(...a)=>globalThis.__review.save(...a);':s==='./contactsSync'?'export const syncAppleContactById=(...a)=>globalThis.__review.sync(...a);':s==='./medhaId'?'export const callMedhaId=(...a)=>globalThis.__review.call(...a);':null;if(source)return{url:'data:text/javascript,'+encodeURIComponent(source),shortCircuit:true};}return n(s,c);}`;
register('data:text/javascript,'+encodeURIComponent(loader),import.meta.url);const {createReviewedContact}=await import('./createReviewedContact.ts');const g=globalThis as any;
test.afterEach(()=>delete g.__review);
test('memo-created person reuses the reviewed Apple ID and returns the canonical Amber ID',async()=>{const order:string[]=[];g.__review={choose:async()=>{order.push('review');return{id:'apple/existing'};},save:async(_p:any,id:string)=>{order.push('apple');assert.equal(id,'apple/existing');return id;},sync:async(id:string)=>{order.push('sync');assert.equal(id,'apple/existing');return{ok:true};},call:async(a:any)=>{order.push('resolve');assert.equal(a.path,'/v1/me/contacts/apple-link/apple%2Fexisting');assert.equal(a.requireAuth,true);return{ok:true,data:{contactId:'canonical'}};}};assert.equal(await createReviewedContact({fullName:'Person',email:'p@example.com'}),'canonical');assert.deepEqual(order,['review','apple','sync','resolve']);});
test('a partial Apple save never attaches the memo to a fabricated Amber contact',async()=>{g.__review={choose:async()=>({id:'apple'}),save:async()=> 'apple',sync:async()=>({ok:false}),call:()=>assert.fail('must not attach')};await assert.rejects(createReviewedContact({fullName:'Person',phone:'+14155550123'}),/Retry to finish syncing/);});
