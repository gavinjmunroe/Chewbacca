# ============================================================
# amber-id environment variables
# Privy-native identity service. No Supabase dependency.
# ============================================================

# Privy (required)
# Get these from console.privy.io > App Settings
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Server-to-server API key (amber-agent uses this to call amber-id)
# Generate a random string and set it in both amber-id and amber-agent
AMBER_ID_API_KEY=

# Optional: multiple named caller keys for service-to-service attribution.
# amber-id is multi-tenant — every Amber user is a tenant inside the SAME
# deployment, scoped by DID. These named keys identify the *calling
# service* (amber-imessage, amber-ios-dev, amber-agent, …), NOT the end
# user, and never partition tenant data. End users always authenticate
# with a Privy JWT against the same shared backend. Requests authenticated
# with one of these keys are stamped with the entry's `name` in audit logs
# and on Pinecone vector metadata (`client_id`). Two formats accepted:
#   JSON:    [{"name":"amber-imessage","key":"sk_..."},{"name":"amber-agent","key":"sk_..."}]
#   Compact: amber-imessage:sk_...,amber-agent:sk_...
# Callers can ALSO self-identify with the `x-amber-client` header, which
# overrides the key-derived name (useful when one shared key is used).
AMBER_ID_API_KEYS=

# ============================================================
# Optional environment-isolation prefixes
# Use ONLY for non-production deployments (staging, per-PR preview,
# integration sandbox) that share a Pinecone index or GCP project with
# production. Do NOT use these to carve out a single user — DIDs +
# cNFTs + per-user namespaces already provide per-tenant isolation
# inside the shared multi-tenant amber-id deployment.
# All optional — leave blank for production.
# ============================================================
# Logical name of this deployment, stamped on audit events + Pinecone
# metadata for debugging. Examples: "default" (production), "staging",
# "pr-1234".
AMBER_INSTANCE_ID=
# Prefix applied to root Firestore collection names so a non-production
# deployment can share a GCP project with prod without colliding.
# Example: "staging_" → users → staging_users.
FIRESTORE_COLLECTION_PREFIX=
# Prefix applied to KG namespaces (both `tenant-<did>` and `share-<did>`).
# Same-name env var as the pre-extraction Pinecone client so migration is
# a no-op; the sandbox KG service reads the same var on its end.
# Example: "staging_" → tenant-<did> → staging_tenant-<did>.
PINECONE_NAMESPACE_PREFIX=

# Server
PORT=3100
HOST=0.0.0.0

# ============================================================
# Perplexity for People layer (sagar/feat/cnft-pinecone-ask)
# ============================================================

# Solana — cNFT identity minting (Metaplex Bubblegum)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PAYER_SECRET_KEY=                # base58-encoded Ed25519 secret for the Amber ops wallet; pays rent
AMBER_MERKLE_TREE=                      # base58 pubkey of pre-created Bubblegum tree
AMBER_COLLECTION_MINT=                  # (optional) base58 pubkey of a collection NFT for grouping

# Sandbox knowledge-graph service — per-user private KB. Extracted from
# amber-id per MIGRATION_PLAN.md Phase 2; lives in
# amber-sandbox/domains/knowledge-graph/. HMAC-signed requests (5-min
# replay window). `KG_SERVICE_URL` points at the deployed service;
# `KG_SERVICE_SECRET` must be the same string both sides use to HMAC.
KG_SERVICE_URL=http://localhost:8081
KG_SERVICE_SECRET=

# Perplexity — the single LLM brain across Amber (embeddings + search +
# synthesis). No OpenAI or Anthropic in this service.
PERPLEXITY_API_KEY=
PERPLEXITY_EMBEDDING_MODEL=pplx-embed-v1-4b
PERPLEXITY_EMBEDDING_DIMS=3416
PERPLEXITY_SYNTHESIS_MODEL=sonar-pro

# togari-peoplerank — upstream list-build + scoring
PEOPLERANK_API_KEY=
PEOPLERANK_TIMEOUT_MS=4000

# ============================================================
# Photon / Spectrum Cloud — iMessage transport
# ============================================================

# Inbound webhook guard. Requests must supply this as ?key=<secret> or the
# x-photon-key header, else 401. Real Photon HMAC signature verification is a
# later step. Leave blank until set in Railway.
PHOTON_WEBHOOK_SECRET=

# Spectrum Cloud project credentials (app.photon.codes → Project Settings).
# Used to authenticate the gRPC outbound send via the spectrum-ts SDK:
#   Spectrum({ projectId, projectSecret, providers: [imessage.config()] })
# Both are required for POST /webhooks/photon/inbound to send replies.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Must match an assigned dedicated Photon line; used for sends and Messages links.
MEDHA_SENDER_PHONE=+15550100007

# Interim allowlist for iMessage reply testing.
# ALLOWED_TEST_NUMBERS: comma-separated E.164 numbers that receive AI replies.
#   Unlisted senders are logged (PHOTON_UNAUTHORIZED_SENDER) but not replied to.
# TEST_OWNER_PHONE: the owner account whose contacts/data all allowlisted senders
#   are served from. Temporary shim — per-sender identity resolution is the next task.
ALLOWED_TEST_NUMBERS=
TEST_OWNER_PHONE=

# ── IDENTITY_KEY_PEPPER ───────────────────────────────────────────────────────
# Secret salt for identity-key hashing (src/lib/identity-keys.js). Must be at
# least 32 characters; hashing REFUSES to run without it and throws.
#
# It was undocumented, and the cost of that was a diagnosis: 18 of 19 "failing"
# tests were this one missing variable, which reads as broken contact-sync code
# rather than a missing env var. The suite needs it set:
#
#   IDENTITY_KEY_PEPPER=<32+ chars> npm test
#
# CHANGING IT IN PRODUCTION ORPHANS EVERY EXISTING identity_keys ROW, because the
# hashes stop matching. Treat it as permanent once real data exists. Never commit
# a real value.
IDENTITY_KEY_PEPPER=

# ── EXA_API_KEY ───────────────────────────────────────────────────────────────
# Web search (src/lib/exa-search.js, and via src/lib/web-search.js the PeopleRank
# SEARCH + ENRICH paths, which replaced Perplexity). Absent = no web results, and
# exa-search logs loudly rather than degrading silently.
EXA_API_KEY=

# ── OPENAI_API_KEY ────────────────────────────────────────────────────────────
# Embeddings ONLY: text-embedding-3-small at 1536 dims, for observations.embedding
# and contact_embedding (both halfvec(1536)). Not used for generation anywhere.
OPENAI_API_KEY=

# ── ANTHROPIC_API_KEY ─────────────────────────────────────────────────────────
# All generation: chat, the intent router, fact extraction, dimension
# classification, /ask synthesis, the Amber Q&A threads, enrichment briefs.
ANTHROPIC_API_KEY=

# PERPLEXITY_API_KEY is no longer read anywhere and can be deleted.
AMBER_WEB_ORIGINS=

# Browser origins allowed to call this API (comma-separated, exact origins,
# no wildcards). The Amber website needs its own origin here to sign in.
# Example: AMBER_WEB_ORIGINS=https://amber.app,https://www.amber.app
