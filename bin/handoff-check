#!/usr/bin/env python3
"""Refuse a reply that hands the user a command to run.

THE FAILURE THIS EXISTS FOR. `~/.claude/rules/do-it-yourself.md` is an
ALWAYS-ON rule, loaded into every session, and it says plainly: never end a
task with a command for them to run. On 2026-09-21 Caleb said, twice in one
night:

    "Bro chewbacca u must be stupid to hv to ask me to do something manual"
    "Never ask me to do something manual retard"

An always-on rule did not prevent the behaviour it exists to prevent, twice,
inside six hours. That is the whole argument for this file. Writing a lesson
down does not make it fire; a repeated mistake needs a gate, not another
paragraph. The rule even ends with the test, which nothing ever ran:

    "Reread your final message and look for an imperative aimed at the user."

So this runs it.

WHAT IT MUST NOT DO is fire on a reply that merely contains a command. Most
do: reporting what was run is the honest thing, and Caleb explicitly asked
for a runnable prompt for a parallel tab on the same night. The difference
is grammatical, not lexical. Past tense about what happened is a report.
Second-person imperative about what should happen next is a handoff.

Getting that wrong in the strict direction is expensive: a guard that fires
on correct replies gets switched off within a day, and then it protects
nothing. So every pattern here needs a second-person subject or an explicit
instruction frame, and three escapes are honoured: a BLOCKED: line, which
is the sanctioned way to name a real blocker; an explicit request from the
user for a command; and the three genuine blockers the rule already names.
"""

from __future__ import annotations

import argparse
import re
import sys

# Second person plus an action. These are handoffs in any framing.
HANDOFF = [
    # (?:you|u): chat replies use "u" since voice.md's 2026-09-18 rule, and
    # every pattern here was written for "you", so "u'll need to" walked past.
    (r"\b(?:you|u)'?ll need to\s+\w+", "'you'll need to ...'"),
    (r"\b(?:you|u) need to\s+(?:run|install|open|add|set|export|chmod|brew|npm|pip)\b",
     "'you need to run/install/...'"),
    (r"\b(?:you|u) (?:should|can|could) (?:run|execute)\b", "'you should run ...'"),
    # "now run" only at the start of a sentence. Measured against 1051 real
    # replies, the bare form matched "the tests now run clean", which is
    # prose about a state and not an instruction to anybody.
    (r"(?:^|(?<=[.!?]\s))\s*(?:go ahead and\s+)?now run\b", "'now run ...'"),
    (r"\bgo ahead and run\b", "'go ahead and run ...'"),
    (r"\bjust run\b", "'just run ...'"),
    # "run it" is dropped deliberately. In 1051 replies it matched "make me
    # go test it and run it" and similar, where the subject is me. The
    # ambiguity is not resolvable by keyword and the false positives are
    # what kills a guard.
    (r"\brun (?:this|these|the following)\b", "'run this'"),
    (r"\btry running\b", "'try running ...'"),
    (r"\b(?:in|from|open) (?:a|your) terminal\b", "'open a terminal'"),
    # A decision is not a command. On 2026-10-06 "the one call you'll have to make is
    # when someone replies interested" was refused twice and Caleb got the same answer
    # three times; a judgment only he can make is exactly what the rules tell us to name.
    (r"\b(?:you|u)'?ll have to\s+(?!make\b(?!\s+sure)|decide\b|choose\b)\w+",
     "'you'll have to ...'"),
    (r"\bmake sure (?:you|to)\s+(?:run|install|set|add)\b", "'make sure you run ...'"),
    (r"\bdon'?t forget to\s+(?:run|install|set|add)\b", "'don't forget to run ...'"),
    # A lookup is work too. On 2026-10-09 a reply ended "Check the $500 edu
    # price on apple.com before u send it", Caleb said "never tell me to do
    # smth you can do", and the price the agent had guessed was wrong: Apple
    # had raised it to $799. A sentence that opens on a check verb and points
    # at a send is a lookup handed over.
    (r"(?:^|(?<=[.!?]\s)|(?<=\n))\s*(?:double[- ]?check|check|verify|confirm|look up)\b"
     r"[^\n]{0,100}?\bbefore (?:(?:you|u) )?(?:send|sending|quot|post|submit|buy|text)",
     "'check X before you send'"),
    # Work handed back in other words (feedback_dont_report_what_you_can_fix,
    # four times in three days). Each is a reply he answered with "do it urself":
    # 2026-10-09 "#11 ... still needs you to send the invite";
    # 2026-10-10 "There's one thing left and it's on you Monday morning";
    # 2026-10-11 "- Click after ..., hit Enter, then Cmd+V ... Say "done" when
    # u're finished". A "can u ...?" pattern was tried and dropped: on 14 days
    # of replies it fired mostly on drafted texts to teammates, not on him.
    (r"\bneeds? (?:you|u) to (?:send|click|press|add|invite|run|open|check|do|paste|sign(?! ?off)|log ?in|accept)\b",
     "'needs you to ...'"),
    (r"\b(?:it'?s|that'?s|is) (?:all )?on (?:you|u)\b", "'it's on you'"),
    (r"(?:^|\n)[ \t]*(?:[-*]|\d+[.)])[ \t]+(?:click|paste)\b",
     "a step list of clicks for him"),
    # Quotes are blanked before matching, so "done" arrives as "".
    (r'\bsay (?:\W?done\W?|"") when (?:you|u)', "'say done when you're finished'"),
    # A sign-in handed over as the next step, not named as a blocker. 2026-10-08
    # 23:56 "Sign into Slack there and leave it open", 2026-10-09 00:01 "Sign
    # into that one too", answered "do it for me bruh never make me do anything
    # that is manual" (feedback_never_hand_him_a_command). A sign-in only he can
    # do is real, and BLOCKED: is how to say so.
    (r"(?:^|(?<=[.!?]\s)|(?<=\n))\s*(?:sign|log) ?in(?:to)?\b", "'sign in there' as a step"),
]

# The patterns written before 2026-10-11 were measured on the raw reply.
ORIGINAL = {p for p, _ in HANDOFF[:HANDOFF.index(next(h for h in HANDOFF if h[1] == "'needs you to ...'"))]}

# Asking leave to do the work. "Never ask permission. The answer is always
# yes" (feedback_no_confirmation_prompts); he still had to say "Just push bro"
# (10-01), "Do everything don't ask questions" (10-06) and "YES ALWAYS dont ask
# that" (10-10), and on 10-04 a reply closed "say the word and I'll kill it".
# A factual question is fine; these are approval gates.
PERMISSION = [
    # "send" stays out: a message going out under his name waits for his
    # "send" (chat-approval.sh), and asking for it is the sanctioned form.
    (r"\b(?:want|wanna) me to (?!send\b)[^?\n]{0,160}\?", "'want me to ...?'"),
    (r"\bshall I\b", "'shall I'"),
    (r"\bshould I (?:go ahead|proceed|start|continue|keep going|push|ship|run|build|fix|kill|delete|merge)\b[^?\n]{0,120}\?",
     "'should I go ahead ...?'"),
    (r"\b(?:lmk|let me know) if (?:you|u) want me to\b", "'let me know if you want me to'"),
    (r"\bsay the word\b", "'say the word'"),
]

# A command block introduced as an instruction rather than a report.
#
# Keyed on the SHAPE OF THE BLOCK, not on the verb that introduces it. The
# first version looked for run/execute/paste/enter/type in the lead-in line
# and missed "Rebuild to see it:", which is the exact example the rule file
# itself lists as wrong. There are unlimited ways to introduce a command and
# a short list of ways to start one.
BLOCK_LEAD = re.compile(r"(?:^|\n)[^\n]*:\s*\n+```[a-z]*\n(.+?)(?:\n|$)", re.S)
# A first line that starts a shell command. Anything else in a fenced block
# is output, data or code being discussed.
SHELL_START = re.compile(
    r"^\s*(?:\$\s*)?(?:cd|\./|sh |bash |npm|npx|pnpm|yarn|brew|pip3?|python3?|"
    r"git|swift|make|sudo|chmod|export|mkdir|mv|cp|open|defaults|osascript|"
    r"claude|code|curl|ssh|docker|vercel|railway)\b", re.I)

# Escapes. Any of these and the reply is not a handoff.
BLOCKED_LINE = re.compile(r"^\s*BLOCKED:", re.M)
# Past tense about what already happened is a report, not an instruction.
REPORT = re.compile(
    r"\bI (?:ran|installed|built|pushed|committed|linked|fixed|moved|started)\b", re.I)


# A credential only the user holds, named in the same sentence as the match.
# On 2026-10-10 "You'll have to put the card in yourself, I can't enter
# payment" was refused at the end of a ticket search and Caleb saw the answer
# twice. Card numbers, passwords and 2FA codes are a blocker the rule itself
# names. A permission pane is not here on purpose: that one gets opened for him.
CREDENTIAL = re.compile(
    r"\b(?:card|payment|pay|checkout|password|passcode|2fa|two[- ]factor|"
    r"verification code|one[- ]time code|face ?id|touch ?id|duo|passkey|qr code)\b", re.I)


def sentence_at(message: str, start: int, end: int) -> str:
    left = max(message.rfind(c, 0, start) for c in ".!?\n")
    rights = [i for i in (message.find(c, end) for c in ".!?\n") if i != -1]
    return message[left + 1:min(rights) if rights else len(message)]


def asked_for_a_command(user_text: str) -> bool:
    """Did they ask for something runnable? Then handing it over is correct."""
    if not user_text:
        return False
    return bool(re.search(
        r"\b(give me (?:a|the) (?:prompt|command)|what'?s the command|"
        r"how do i run|paste(?:able)?|copy)\b", user_text, re.I))


def already_ran(sentence: str) -> bool:
    """True when the sentence says the run happened or isn't needed, and hands nothing on."""
    if re.search(r"\b(?:no need|don'?t need|don'?t have|never have|didn'?t have) to run (?:this|these)\b", sentence, re.I):
        return True
    return bool(re.search(r"\b(?:already ran|i ran|i've run)\s+(?:it|this|these|that)\b", sentence, re.I)
                and not re.search(r"\b(?:now|then|next|plz|please)\b", sentence, re.I))


def check(message: str, user_text: str = "") -> list[str]:
    if not message:
        return []
    if BLOCKED_LINE.search(message):
        return []
    if asked_for_a_command(user_text):
        return []

    found = []
    # Quoted text and code are somebody else's words: a drafted text he will
    # send ("can u add me as admin?"), a quote, a command being discussed.
    prose = re.sub(r"```.*?(?:```|$)", "", message, flags=re.S)
    prose = re.sub(r"(?m)^\s*>.*$", "", prose)
    prose = re.sub(r'"[^"\n]*"|\u201c[^\u201d\n]*\u201d', '""', prose)
    for pattern, label in HANDOFF:
        text = message if pattern in ORIGINAL else prose
        m = re.search(pattern, text, re.I)
        if m and CREDENTIAL.search(sentence_at(text, m.start(), m.end())):
            continue
        # 2026-11-05: "run this" fired on a reply saying it had already been run.
        if m and label == "'run this'" and already_ran(sentence_at(text, m.start(), m.end())):
            continue
        if m:
            line = text[:m.start()].count("\n") + 1
            found.append(f"line {line}: {label}  ->  \"{m.group(0)}\"")
    for pattern, label in PERMISSION:
        m = re.search(pattern, prose, re.I)
        if m:
            line = prose[:m.start()].count("\n") + 1
            found.append(f"line {line}: asks permission, {label}  ->  \"{m.group(0)[:60]}\"")
    m = BLOCK_LEAD.search(message)
    if m and SHELL_START.match(m.group(1) or "") and not REPORT.search(message):
        found.append("a shell command in a block, introduced as an instruction, "
                     f"with no report of having run anything: \"{m.group(1).strip()[:50]}\"")
    return found


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--user", default="", help="what the user asked, for the escape")
    ap.add_argument("--quiet", action="store_true")
    a = ap.parse_args()
    msg = sys.stdin.read()
    hits = check(msg, a.user)
    if not hits:
        return 0
    if not a.quiet:
        print("handoff-check: this reply hands the user something to run.", file=sys.stderr)
        for h in hits:
            print(f"  {h}", file=sys.stderr)
        print("\nYou have a shell. Run it, then report what happened. If it is a real\n"
              "blocker (a physical action, a credential only they have, a decision\n"
              "only they can make), say BLOCKED: and name it in one line.",
              file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
