SLOT_SECONDS = 15 * 60
# He works late, so the window runs past midnight: 8am up to 2am is 72 quarters.
QUIET_HOURS = range(2, 8)


def slot_for(now: float) -> int:
    """Which quarter hour this is, in local time, so the same quarter always agrees."""
    return int((now + time.localtime(now).tm_gmtoff) // SLOT_SECONDS)


def verse_for(now: float) -> tuple[str, str]:
    """This quarter hour's verse."""
    return VERSES[slot_for(now) % len(VERSES)]


def surface_for(now: float) -> str:
    """One card per quarter hour, so verses pile up beside each other.

    Caleb, 2026-10-16: "If a verse is alr on the screen, just keep piling them
    up next to each other. I wanna come back from a long break and see a bunch
    of verses!" A rerun inside the same quarter redraws its own card in place
    instead of adding a twin. The HUD stacks cards in one region and folds the
    oldest to their title rows once the column is full, so a long break reads
    as a column of references, newest open.
    """
    return f"verse-{slot_for(now)}"


def quiet(now: float) -> bool:
    return time.localtime(now).tm_hour in QUIET_HOURS


def ask_for(ref: str, text: str) -> str:
    """What a double-click on the card says in the chat, in his register."""
    return f"Let's talk abt {ref}: {text}"


def payload(ref: str, text: str, surface: str = "verse") -> str:
    # Ambient: it never breaks through a hidden display, because a verse is
    # an encouragement, not an alarm.
    return "\n".join([
        f"@ {surface} at=top w=480 urgency=ambient",
        # Double-click the card and this goes into the HUD's chat as a typed
        # request (Caleb, 2026-10-16: "If I double click on them I want it to
        # go into chat w the hud and chewbs where I can talk abt the verse").
        f'c s Screen title="{ref.upper()} ESV" ask="{ask_for(ref, text)}"',
        f'c t Text value="{text}"',
        "> s t",
        "r s",
    ]) + "\n"


def main(argv: list[str]) -> int:
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__)
        return 0
    if "--list" in argv:
        for ref, text in VERSES:
            print(f"{ref}: {text}")
        return 0
    now = time.time()
    if quiet(now) and "--now" not in argv:
        return 0
    ref, text = verse_for(now)
    lines = payload(ref, text, surface_for(now))
    if "--dry-run" in argv:
        print(lines, end="")
        return 0
    hud = shutil.which("hud")
    if not hud:
        print("hud-verse: no hud on PATH", file=sys.stderr)
        return 1
    try:
        done = subprocess.run([hud, "draw"], input=lines, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as err:
        print(f"hud-verse: {err}", file=sys.stderr)
        return 1
    if done.returncode != 0:
        print(f"hud-verse: hud draw failed: {done.stderr.strip()}", file=sys.stderr)
    return done.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
