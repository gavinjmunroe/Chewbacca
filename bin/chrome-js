#!/usr/bin/env bash
# chrome-js: run JavaScript in a Chrome tab and print the result.
#
# Built for agent-driven setup, where a step lives behind a web console that has
# no API. Reading and clicking through JS beats screenshot-and-click: it is
# deterministic, it survives the window moving, and it never captures the
# screen (which on a machine someone is using can catch a password field).
#
#   chrome-js --open "https://console.cloud.google.com/..." --profile Default
#   chrome-js --match "console.cloud" --file /tmp/step.js
#   chrome-js --match "console.cloud" --text            # innerText of the page
#   chrome-js --match "console.cloud" --click "Next"    # click a button by label
#   chrome-js --list                                    # every tab Chrome exposes
#   chrome-js --real --match "linkedin.com" --file x.js # the user's own Chrome, by PID
#
# Requires: View > Developer > Allow JavaScript from Apple Events, in Chrome.
#
# Two traps this exists to avoid:
#   1. Chrome runs one AppleScript-visible instance. Windows belonging to other
#      profiles or other user-data-dirs are invisible to it, so --open takes a
#      --profile and you should confirm with --list before assuming a tab exists.
#      Worse, when automation has launched Chrome clones (--user-data-dir, e.g.
#      chewie's debug-port copies), `tell application "Google Chrome"` binds to
#      a clone and the user's real windows vanish (2026-10-10: it saw 0 windows
#      while the real Chrome held a signed-in LinkedIn tab). --real addresses
#      the one Chrome process with no --user-data-dir by PID, through
#      ScriptingBridge, and --open under --real hands the URL to that running
#      browser's singleton instead of launching anything.
#   2. Quoting JS through shell into AppleScript into the page mangles it. The
#      script always goes through a file, never through an argument string.
set -euo pipefail

MATCH=""; JSFILE=""; OPEN_URL=""; PROFILE=""; MODE="js"; CLICK_TEXT=""; INLINE=""
ACTIVATE=false
REAL=false

while [ $# -gt 0 ]; do
  case "$1" in
    --match)   MATCH="$2"; shift 2 ;;
    --file)    JSFILE="$2"; shift 2 ;;
    --eval)    INLINE="$2"; shift 2 ;;
    --open)    OPEN_URL="$2"; shift 2 ;;
    --profile) PROFILE="$2"; shift 2 ;;
    --click)   MODE="click"; CLICK_TEXT="$2"; shift 2 ;;
    --text)    MODE="text"; shift ;;
    --list)    MODE="list"; shift ;;
    --check)   MODE="check"; shift ;;
    --activate) ACTIVATE=true; shift ;;
    --real)    REAL=true; shift ;;
    -h|--help) sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "chrome-js: unknown argument $1" >&2; exit 2 ;;
  esac
done

TMP_JS="$(mktemp "${TMPDIR:-/tmp}/chrome-js.XXXXXX")"
trap 'rm -f "$TMP_JS"' EXIT

# ── The password floor ────────────────────────────────────────────────────────
# This tool runs arbitrary JS in a browser that is signed in to the user's real
# accounts, usually while an agent is driving it. The one thing it must never do
# is read a secret out of a page and hand it back through a transcript, where it
# is then in a log, a context window, and possibly a model provider's servers.
#
# So: reading a password field is refused here, in every mode, with no flag to
# turn it off. An agent that needs a credential on a page is asking for the
# wrong thing. The right shape is the one Realm uses (31Carlton7/realm): the
# human enrolls the credential in an OS keychain out of band, and the fill is a
# separate privileged operation that puts the value straight into key events
# without any layer above ever holding it. Chewbacca does not implement that
# store, so its floor is simply: not through here.
#
# This is a floor, not a wall. It stops the common accident (an agent writes
# `document.querySelector("input[type=password]").value` because that is the
# obvious way to check a login form) and it does not stop a determined bypass.
# Obfuscated DOM access will get through. The value is in making the honest path
# refuse loudly instead of quietly succeeding.
refuse_password_access() {
  local src="$1" what="$2"
  if grep -qiE "type=[\"']?password|input\[type=password|\.password|passwordField|autocomplete=[\"']?current-password" "$src" 2>/dev/null; then
    echo "chrome-js: refused. $what touches a password field." >&2
    echo "  Reading a credential out of a page puts it in the transcript, the" >&2
    echo "  logs, and the model's context. There is no flag for this." >&2
    echo "  If a sign-in is genuinely needed, do it by hand in the window." >&2
    exit 3
  fi
}

# The user's own Chrome: the main process with no --user-data-dir and no
# --type (helpers). Clones always carry --user-data-dir.
real_pid() {
  ps -axo pid=,command= | awk '/\/Contents\/MacOS\/Google Chrome( |$)/ && !/--user-data-dir/ && !/--type=/ && !f {print $1; f=1}'
}

# One JXA runner for --list and script modes under --real. argv: mode pid match jsfile
REAL_JXA='ObjC.import("ScriptingBridge"); ObjC.import("Foundation");
function run(argv) {
  var mode = argv[0], pid = parseInt(argv[1], 10), match = argv[2], file = argv[3];
  var app = $.SBApplication.applicationWithProcessIdentifier(pid);
  if (!app || app.isNil()) return "NO_REAL_CHROME";
  var wins = app.valueForKey("windows"), out = [];
  for (var i = 0; i < wins.count; i++) {
    var tabs = wins.objectAtIndex(i).valueForKey("tabs");
    for (var j = 0; j < tabs.count; j++) {
      var t = tabs.objectAtIndex(j), u = ObjC.unwrap(t.valueForKey("URL")) || "";
      if (mode === "list") { out.push(u); continue; }
      if (u.indexOf(match) >= 0) {
        var js = ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(file, $.NSUTF8StringEncoding, null));
        var r = t.performSelectorWithObject("executeJavascript:", $(js));
        if (!r || r.isNil()) return "missing value";
        var v = ObjC.unwrap(r.description ? r.description : r);
        return String(v);
      }
    }
  }
  return mode === "list" ? out.join("\n") : "NO_TAB_MATCHING: " + match;
}'

run_real() {
  local mode="$1" pid
  pid="$(real_pid)"
  if [ -z "$pid" ]; then echo "chrome-js: no running Chrome without --user-data-dir" >&2; exit 4; fi
  local runner; runner="$(mktemp "${TMPDIR:-/tmp}/chrome-js-real.XXXXXX")"
  printf '%s' "$REAL_JXA" > "$runner"
  osascript -l JavaScript "$runner" "$mode" "$pid" "${MATCH:-}" "$TMP_JS" 2>&1 || true
  rm -f "$runner"
}

if [ "$MODE" = "check" ]; then
  # "Allow JavaScript from Apple Events" is per PROFILE, not per browser, and a
  # profile without it fails every --eval with the same opaque error. Report the
  # state of each profile rather than making someone guess which one is live.
  python3 - <<'PY'
import json, pathlib
root = pathlib.Path.home() / "Library/Application Support/Google/Chrome"
state = root / "Local State"
names = {}
if state.is_file():
    try:
        for k, v in json.loads(state.read_text())["profile"]["info_cache"].items():
            names[k] = v.get("user_name") or v.get("name") or ""
    except Exception:
        pass
found = False
for prefs in sorted(root.glob("*/Preferences")):
    prof = prefs.parent.name
    try:
        d = json.loads(prefs.read_text())
    except Exception:
        continue
    ok = bool(d.get("browser", {}).get("allow_javascript_apple_events"))
    found = True
    print(("enabled " if ok else "DISABLED") + "  " + prof + "  " + names.get(prof, ""))
if not found:
    print("no Chrome profiles found")
print("")
print("Enable a disabled profile: open a window in it, then")
print("View > Developer > Allow JavaScript from Apple Events.")
PY
  exit 0
fi

if [ "$MODE" = "list" ] && $REAL; then
  run_real list
  exit 0
fi

if [ "$MODE" = "list" ]; then
  osascript <<'AS'
tell application "Google Chrome"
  set out to ""
  repeat with w in windows
    repeat with t in tabs of w
      set out to out & (URL of t) & linefeed
    end repeat
  end repeat
  return out
end tell
AS
  exit 0
fi

if [ -n "$OPEN_URL" ]; then
  # A named profile needs its own instance argument; Chrome ignores the profile
  # when it just reuses an existing window.
  if $REAL; then
    # Chrome's own binary with the default user-data-dir forwards to the
    # running browser's singleton and exits ("Opening in existing browser
    # session"). No second instance survives this.
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
      ${PROFILE:+--profile-directory="$PROFILE"} "$OPEN_URL" >/dev/null 2>&1 || true
  elif [ -n "$PROFILE" ]; then
    open -na "Google Chrome" --args --profile-directory="$PROFILE" --new-window "$OPEN_URL"
  else
    open -a "Google Chrome" "$OPEN_URL"
  fi
  # Give the console app time to render past its own loading spinner. Chrome
  # reports loading=false well before an Angular console has painted a form.
  sleep "${CHROME_JS_SETTLE:-12}"
  [ -n "$MATCH" ] || exit 0
fi

if [ -z "$MATCH" ]; then
  echo "chrome-js: --match <url-substring> is required" >&2
  exit 2
fi

case "$MODE" in
  text)
    cat > "$TMP_JS" <<'JS'
document.body.innerText.replace(/\n{2,}/g, '\n').slice(0, 4000)
JS
    ;;
  click)
    # Exact label match on a visible, enabled button. Substring matching picks
    # the wrong control on consoles that show "Next" and "Next steps".
    cat > "$TMP_JS" <<JS
(function(){
  var want = $(printf '%s' "$CLICK_TEXT" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))');
  var els = document.querySelectorAll('button,[role="button"],a');
  for (var i = 0; i < els.length; i++) {
    var e = els[i];
    if (e.offsetParent === null || e.disabled) continue;
    if (e.innerText.trim() === want) { e.click(); return 'clicked:' + want; }
  }
  return 'NOT_CLICKABLE:' + want;
})()
JS
    ;;
  js)
    if [ -n "$INLINE" ]; then
      printf '%s' "$INLINE" > "$TMP_JS"
    elif [ -n "$JSFILE" ]; then
      cp "$JSFILE" "$TMP_JS"
    else
      cat > "$TMP_JS"   # read the script from stdin
    fi
    ;;
esac

# Every mode funnels through one file, so one check covers --eval, --file, stdin
# and the generated click script. Placed after the case and before the injection
# on purpose: a guard on only the paths someone remembered is not a guard.
refuse_password_access "$TMP_JS" "the script"

if $REAL; then
  RESULT="$(run_real js)"
else
# `|| true`: osascript exits non-zero when the page rejects the script, and
# set -e would abort here before the diagnosis below ever prints.
RESULT="$(osascript <<AS 2>&1 || true
set js to (read POSIX file "$TMP_JS" as «class utf8»)
tell application "Google Chrome"
  repeat with w in windows
    repeat with tabIndex from 1 to count of tabs of w
      set t to tab tabIndex of w
      if (URL of t) contains "$MATCH" then
        if $ACTIVATE then
          set active tab index of w to tabIndex
          set index of w to 1
          activate
        end if
        return execute t javascript js
      end if
    end repeat
  end repeat
  return "NO_TAB_MATCHING: $MATCH"
end tell
AS
)"
fi
if printf '%s' "$RESULT" | grep -q "Executing JavaScript through AppleScript is turned off"; then
  echo "chrome-js: this Chrome profile has JS-from-Apple-Events turned off." >&2
  echo "           Run: chrome-js --check     (shows which profiles are enabled)" >&2
  exit 3
fi
printf '%s\n' "$RESULT"
