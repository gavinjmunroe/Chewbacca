#!/usr/bin/env python3
"""Front door: runs Dough's engine/bin/gtme-reply. The gtme engine lives in Dough.

gtme-front-door. tools/dough_home.py finds Dough.
"""
import importlib.util as _u
import os as _o

_p = _u.spec_from_file_location("chewbacca_dough_home", _o.path.join(_o.path.dirname(_o.path.realpath(__file__)), "..", "tools", "dough_home.py"))
_m = _u.module_from_spec(_p)
_p.loader.exec_module(_m)
_m.exec_bin('gtme-reply')
