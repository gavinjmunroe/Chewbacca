# === Required secrets ===
ANTHROPIC_API_KEY=sk-ant-...

# === GCP auth — pick one ===
# Option 1: Path to service account JSON (local dev)
GOOGLE_APPLICATION_CREDENTIALS=
# Option 2: Base64-encoded service account JSON (Railway/containers)
GCP_CREDENTIALS_BASE64=

# === Required for stdio/Claude Desktop mode ===
TENANT_ID=bma

# === Optional overrides (defaults match production) ===
# GCP_PROJECT_ID=midyear-glazing-485303-u3
# BIGQUERY_DATASET=togari_data_lake
# BIGQUERY_TABLE=togari_structured_contacts_external
# BIGQUERY_DEALS_TABLE=togari_structured_deals

# === Optional HTTP/SSE mode ===
# Set PORT to enable HTTP/SSE mode (Railway sets this automatically)
# PORT=4100
# TOGARI_INTERNAL_KEYS=
# TOGARI_EXTERNAL_KEYS=
