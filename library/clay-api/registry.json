{
  "schema": "clay-ops/1",
  "revision": "2026-10-09.2",
  "notes": "Every Clay job `chewbacca clay` answers, and the surfaces that answer it. A surface is tried only when every arg it needs was given; the fastest measured one goes first, and the next is tried when it fails or comes back truncated. ms is end-to-end wall time for one call from a shell on Caleb's Mac on 2026-10-09, load average 60 to 90 from other agents, so read them as relative, not absolute. Every write refuses without --allow-writes and a person typing the op name at a real terminal, which agent shells don't have; --dry-run prints the exact request instead and sends nothing. Writes with verified:false were derived from Clay's frontend bundle or CLI help, never sent; their first live uses print a readback.",
  "engine": {
    "name": "api-anything",
    "repo": "https://github.com/goodnight000/api-anything",
    "sha": "ba26db14a122a684e2de672a24c6480c9b274e53",
    "clone": "~/Projects/api-anything",
    "home": "~/.chewbacca/api-anything",
    "site": "clay",
    "spec": "library/clay-api/clay.json",
    "login": "api-anything login clay --profile \"Chrome/Profile 7\"",
    "output_cap_chars": 20000,
    "dist_sha256": "a595b981ce1de4663f4ebc2eb1c9fe5ba64f5b96206e5776fab6e5331ebf21ca",
    "dist_sha256_of": "dist/*.js in name order, concatenated; built with npm ci --ignore-scripts && npm run build at sha"
  },
  "ops": [
    {
      "name": "workspaces",
      "kind": "read",
      "gate": "read",
      "summary": "every workspace this login can open: id, name, plan",
      "args": [],
      "surfaces": [
        {
          "type": "api-anything",
          "op": "listWorkspaces",
          "args": {}
        }
      ],
      "ui": "clay-go home"
    },
    {
      "name": "resources",
      "kind": "read",
      "gate": "read",
      "summary": "every folder, workbook and table in a workspace, one call",
