#!/usr/bin/env python3
"""Read and write any database macOS keeps about you, directly.

  mac-db stores                          every store: found, readable, rows, newest entry
  mac-db <store> [--days N] [--ahead N] [--search TEXT] [--limit N] [--json]
  mac-db note <id>                       one Apple Note's full text
  mac-db schema <store>                  tables and columns, to write your own query
  mac-db sql <store> "select ..."        any query; a write backs the file up first
  mac-db backups / restore <dir>         list snapshots, put one back
  mac-db notes add|append|edit|delete    writes through the app so iCloud syncs it
  mac-db reminders add|complete|edit|delete, calendar add|edit|delete, contacts add, messages send
  mac-db biome                           list Biome streams; mac-db biome <Stream.Name> reads one

Stores: messages, calls, contacts, mail, notes, calendar, reminders, safari,
chrome, photos, voicememos, podcasts, downloads, interactions, screentime,
knowledge, biome. --days 0 means all time.

Built 2026-10-09 after Caleb asked whether Chewbacca could pull from any
database the Mac has, "like screen time". It read five of them directly
(chat.db, knowledgeC, AddressBook, Reminders, TCC); Calendar, Notes and Mail
went through AppleScript, and call history, browser history, Photos, Voice
Memos, Podcasts, downloads, interactionC and Biome were not read at all. Every
path and column below was checked against this Mac (macOS 15.6) that night.

Reads open mode=ro; Chrome holds an exclusive lock on History, so reads use a
temp copy. Writes come two ways. App verbs (notes, reminders, calendar,
contacts, messages) go through the `mac` CLI, so the change goes through the
app and syncs to iCloud like a tap would; a raw row edit in a synced store is
overwritten by the next sync. `sql` runs any statement, and anything that
writes snapshots the database and its WAL into ~/.chewbacca/mac-db/backups
first, so `mac-db restore` undoes it. Caleb, 2026-10-10, on the first
read-only version: "NOTHING on chewb should ever be read only that is
stupid". MAC_DB_HOME points every path at a fake home for tests.
"""
from __future__ import annotations

import argparse
import datetime as dt
import glob
import gzip
import json
import os
import re
import shutil
import sqlite3
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path(os.environ.get("MAC_DB_HOME") or Path.home())
SYSROOT = Path(os.environ.get("MAC_DB_SYSROOT") or "/")
CD = 978307200  # Core Data / Cocoa dates count seconds from 2001-01-01 UTC
L = HOME / "Library"
GC = L / "Group Containers"


def first(*patterns: str) -> list[Path]:
    """Every existing file matching any pattern, in order, no duplicates."""
    seen: list[Path] = []
    for p in patterns:
        for hit in sorted(glob.glob(p)):
            path = Path(hit)
            if path.is_file() and path not in seen:
                seen.append(path)
    return seen


