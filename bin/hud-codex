#!/usr/bin/env python3
"""Read a HUD prompt on stdin and print only Codex's final assistant message.

Uses the user's Codex configuration without model or permission overrides.
HUD_CODEX_STATE selects the private conversation state file; deleting that file
starts a new conversation. Sessions are never borrowed through `resume --last`.
"""

from __future__ import annotations

import fcntl
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time
import uuid


def session_id(value: object) -> str | None:
    try:
        return str(uuid.UUID(str(value)))
    except (ValueError, AttributeError):
        return None


def signal_group(group: int, signum: int) -> None:
    try:
        os.killpg(group, signum)
    except ProcessLookupError:
        pass
    except PermissionError:
        # Darwin returns EPERM for a group with only zombie members. Confirm
        # that no live member remains before treating that as successful exit.
        result = subprocess.run(['ps', '-axo', 'pgid=,stat='],
                                capture_output=True, text=True, check=True, timeout=1)
        for line in result.stdout.splitlines():
            fields = line.split()
            if len(fields) == 2 and fields[0] == str(group) and not fields[1].startswith('Z'):
                raise


def run(prompt: str, state: Path) -> int:
    state.parent.mkdir(parents=True, exist_ok=True)
    cwd = str(Path.cwd().resolve())
    with state.with_suffix(state.suffix + ".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        previous = None
        try:
            saved = json.loads(state.read_text())
            if isinstance(saved, dict) and saved.get("cwd") == cwd:
                previous = session_id(saved.get("thread_id"))
        except (FileNotFoundError, json.JSONDecodeError):
            pass
        with tempfile.TemporaryDirectory(prefix="hud-codex-") as directory:
            final = Path(directory) / "final.txt"
            argv = ["codex", "exec"]
            if previous:
                argv += ["resume", previous]
            # launchd starts the HUD in the home directory, outside a repository.
            argv += ["--skip-git-repo-check", "--json", "--output-last-message", str(final), "-"]
            env = dict(os.environ, CHEWBACCA_HUD_CHILD="1")
            proc = None
            pending_signal = None

            def stop(signum, _frame):
                nonlocal pending_signal
                if proc is None:
                    pending_signal = signum
                    return
                for stop_signal in (signal.SIGTERM, signal.SIGINT):
                    signal.signal(stop_signal, signal.SIG_IGN)
                signal_group(proc.pid, signal.SIGTERM)
                # A fake Codex exited on TERM while its tool ignored TERM and
                # survived. Wait for the group, not just its original parent.
                # Equal two-second inner/outer deadlines let the listener kill
                # this adapter before it killed the tool (1 of 5 cancellations).
                # Leave 1.5 seconds before hud-listen's KILL_GRACE expires.
                # Do not reap the leader yet: its PID must remain reserved
                # until the final group signal has been sent.
                time.sleep(0.5)
                signal_group(proc.pid, signal.SIGKILL)
                proc.wait()
                raise SystemExit(128 + signum)

            handlers = {sig: signal.signal(sig, stop) for sig in (signal.SIGTERM, signal.SIGINT)}
            try:
                proc = subprocess.Popen(
                    argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                    stderr=None, text=True, env=env, start_new_session=True,
                )
                if pending_signal is not None:
                    stop(pending_signal, None)
                events, _ = proc.communicate(prompt)
            finally:
                for sig, handler in handlers.items():
                    signal.signal(sig, handler)
            if proc.returncode:
                print(f"hud-codex: Codex exited with status {proc.returncode}", file=sys.stderr)
                return proc.returncode if proc.returncode > 0 else 1
            if not final.is_file() or not final.read_text().strip():
                print("hud-codex: Codex returned no final message", file=sys.stderr)
                return 1
            thread = previous
            for line in events.splitlines():
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if isinstance(event, dict) and event.get("type") == "thread.started":
                    thread = session_id(event.get("thread_id")) or thread
            if thread:
                descriptor, temporary = tempfile.mkstemp(prefix=state.name + ".", dir=state.parent)
                try:
                    with os.fdopen(descriptor, "w") as output:
                        json.dump({"cwd": cwd, "thread_id": thread}, output)
                    os.replace(temporary, state)
                finally:
                    if os.path.exists(temporary):
                        os.unlink(temporary)
            sys.stdout.write(final.read_text())
            return 0


def main() -> int:
    prompt = sys.stdin.read()
    if not prompt.strip():
        print("hud-codex: expected a prompt on stdin", file=sys.stderr)
        return 2
    state = Path(os.environ.get("HUD_CODEX_STATE", str(Path.home() / ".bob" / "hud-codex-session.json")))
    try:
        return run(prompt, state)
    except OSError as error:
        print(f"hud-codex: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
