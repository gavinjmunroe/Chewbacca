{
  "name": "togari-gtm",
  "version": "1.0.0",
  "description": "Togari GTM OS — Unified MCP server for all 5 funnel stages + BigQuery NL queries",
  "main": "dist/index.cjs",
  "workspaces": [
    "products/*"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.35.0",
    "@google-cloud/bigquery": "^7.9.1",
    "@google-cloud/pubsub": "^5.3.0",
    "@google-cloud/secret-manager": "^6.1.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@sentry/node": "^10.46.0",
    "content-type": "^1.0.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "raw-body": "^3.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
