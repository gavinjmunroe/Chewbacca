#!/usr/bin/env python3
"""chewbacca pdf: markdown (or text) files to PDFs, in seconds, never a hang.

    chewbacca pdf brief.md other.md            PDFs next to each file
    chewbacca pdf *.md --out "~/Downloads/For Sagar"

Caleb, 2026-10-11 9:56pm: "Bro this should be a 2 sec task wtf???", then "Fix
chewb so u never take forever on smth that should take 2 seconds". Headless
Chrome writes the PDF and then stays alive; a hand-rolled pipeline waited on
it. The fix for exactly that had shipped the day before inside the GTM report
(tools/gtme_operator.py to_pdf), where nobody making a PDF would look. This
command is that one tested routine, for any file.

Prints one line per file: where the PDF went and its page count. Exit 1 if
any file failed.
"""
import argparse
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "tools"))
import gtme_operator as op  # noqa: E402


def pages(pdf: Path) -> str:
    try:
        out = subprocess.run(["pdfinfo", str(pdf)], capture_output=True, text=True, timeout=10).stdout
        return next((l.split()[-1] for l in out.splitlines() if l.startswith("Pages:")), "?")
    except (OSError, subprocess.SubprocessError):
        return "?"


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="chewbacca pdf", description=__doc__.splitlines()[0])
    ap.add_argument("files", nargs="+")
    ap.add_argument("--out", help="folder for the PDFs (default: next to each file)")
    a = ap.parse_args(argv)
    out_dir = Path(os.path.expanduser(a.out)) if a.out else None
    if out_dir:
        out_dir.mkdir(parents=True, exist_ok=True)
    failed = 0
    for f in a.files:
        src = Path(os.path.expanduser(f))
        if not src.is_file():
            print(f"missing: {src}")
            failed += 1
            continue
        dest = (out_dir or src.parent) / (src.stem + ".pdf")
        t0 = time.time()
        route = op.to_pdf(src.read_text(errors="replace"), src.stem, dest)
        if route and dest.exists():
            print(f"{dest}  ({pages(dest)} pages, {time.time() - t0:.1f}s, {route})")
        else:
            print(f"failed: {src}")
            failed += 1
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
