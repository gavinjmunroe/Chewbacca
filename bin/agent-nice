#!/usr/bin/env python3
"""Run every agent CLI, and everything it starts, at nice 10.

On 2026-10-10 Caleb said "My slow af rn" at load 19 to 37 on 14 cores: nine
agent tabs, their subagents, per-tab MCP servers and builds, all at the same
priority as the window he was typing in. Each tab's work was fine alone.

Priority is the fix that costs nothing. A process at nice 10 gets the CPU only
when nothing at nice 0 wants it, so on a calm Mac agents run at full speed and
on a busy one his apps win. Children inherit their parent's nice, so renicing
the `claude` and `codex` CLIs once covers every tool call, build, subagent and
MCP server they start afterwards; existing descendants are reniced here too.

The editor and the Claude Desktop window stay at 0: only processes whose
executable is literally named `claude` or `codex` are agents. Never lowered
back: an unprivileged process can't raise its own priority, and nothing here
needs it to. tab-rescue.sh runs this once a minute on any prompt.

    agent-nice            renice agents and their descendants to 10
    agent-nice --dry-run  list what it would change
"""
from __future__ import annotations

import argparse
import os
import shlex
import subprocess
import sys

TARGET = 10
AGENTS = {"claude", "codex"}


def table() -> list[tuple[int, int, int, str]]:
    cmd = os.environ.get("AGENT_NICE_PS_CMD", "ps -Ao pid=,ppid=,nice=,comm=")
    try:
        out = subprocess.run(shlex.split(cmd), capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    rows = []
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4 and parts[0].isdigit() and parts[1].isdigit():
            try:
                rows.append((int(parts[0]), int(parts[1]), int(parts[2]), parts[3]))
            except ValueError:
                continue
    return rows


def to_renice(rows) -> list[int]:
    kids: dict[int, list[int]] = {}
    for pid, ppid, _, _ in rows:
        kids.setdefault(ppid, []).append(pid)
    nice = {pid: n for pid, _, n, _ in rows}
    roots = [pid for pid, _, _, comm in rows if os.path.basename(comm) in AGENTS]
    seen, stack = set(), list(roots)
    while stack:
        pid = stack.pop()
        if pid in seen:
            continue
        seen.add(pid)
        stack.extend(kids.get(pid, []))
    me = os.getpid()
    return sorted(p for p in seen if nice.get(p, TARGET) < TARGET and p != me)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()
    pids = to_renice(table())
    if not pids:
        return 0
    if args.dry_run:
        print("would renice to %d: %s" % (TARGET, " ".join(map(str, pids))))
        return 0
    cmd = shlex.split(os.environ.get("AGENT_NICE_RENICE_CMD", "renice"))
    subprocess.run(cmd + [str(TARGET), "-p"] + [str(p) for p in pids],
                   capture_output=True, timeout=10)
    print("reniced %d agent process(es) to %d" % (len(pids), TARGET))
    return 0


if __name__ == "__main__":
    sys.exit(main())
