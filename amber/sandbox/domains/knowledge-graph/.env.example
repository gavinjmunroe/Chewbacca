# Pinecone (writes)
PINECONE_API_KEY=
PINECONE_INDEX=amber-people
# Optional: prefix all namespaces so a staging KG doesn't bleed into prod.
# PINECONE_NAMESPACE_PREFIX=staging_

# Embeddings (reads + writes)
PERPLEXITY_API_KEY=
# PERPLEXITY_EMBEDDING_MODEL=pplx-embed-v1-4b
# PERPLEXITY_EMBEDDING_DIMS=2560

# HTTP surface
PORT=8081
HOST=0.0.0.0
# LOG_LEVEL=info

# HMAC auth — shared with amber-id (KG_SERVICE_SECRET in both). MUST be set
# in production. Set KG_SERVICE_AUTH_MODE=disabled to skip signature
# verification in local dev; never in prod.
KG_SERVICE_SECRET=
# KG_SERVICE_AUTH_MODE=hmac

# Deployment identity — stamped on Pinecone metadata for debugging.
# AMBER_INSTANCE_ID=default
