#!/usr/bin/env bash
# chewbacca: the one command. Everything else is implementation.
#
# The repo root used to be six shell scripts with similar names, and a new
# reader had to work out which of start.sh, install.sh and setup.sh was theirs.
# It also meant the README documented `chewbacca doctor`, a command that did not
# exist, which is the same failure the kit adds doctor checks for.
#
# So: one verb-shaped entry point that finds the repo wherever it lives. The
# subcommand table below is the single source of truth for help, completion,
# and dispatch, so a new verb cannot exist without being documented.

set -uo pipefail

# Where the kit actually is. Follows the symlink this is usually installed as,
# so `chewbacca` works from ~/.local/bin without hardcoding a clone path.
resolve_root() {
  if [ -n "${CHEWBACCA_ROOT:-}" ] && [ -d "$CHEWBACCA_ROOT" ]; then
    printf '%s' "$CHEWBACCA_ROOT"
    return
  fi
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ $src != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")/.." && pwd
}

ROOT="$(resolve_root)"
STATE="$HOME/.chewbacca"

# name|one-line help. Help output, shell completion, and the unknown-command
# error all read this, so they cannot disagree with each other.
COMMANDS=(
  "open|the whole kit on one screen; add --week for your week in its own window"
  "apps|list, run or test anything the team built (apps/)"
  "doctor|check the install and say what is broken"
  "status|what is installed, what is on, what is stale"
  "version|version installed here and in the repo"
  "setup|full setup on this machine (asks nothing)"
  "agent|plan, install, inspect or launch a runtime adapter"
  "ux-learning|record UX evidence and inspect portable navigation maps"
  "jev|typed TypeSafe decisions and semantic skill suggestions"
  "decision-lab|compare bounded Jev decisions with verified outcomes"
  "ux-decision|recommend controls from fresh observed and permitted states"
  "ux-policy|learn offline action rewards and plan evidence-backed graph routes"
  "clay-review|verify at most five held Clay draft records without model calls"
  "task-graph|manage durable agent jobs and verification dependencies"
  "work-ledger|preserve workspace commitments across messages and runtimes"
  "tabs|see what every other live agent tab is doing, in any runtime"
  "land|put your files or commits on origin/main without anyone else's"
  "launch|open a new named, briefed session in the Claude desktop app"
  "graph-fuse|inspect possible entity matches without merging records"
  "review-gate|run independent code review and check its current receipt"
  "break-it|attack the current change before calling it done, and write a receipt"
  "update|pull the latest, show what changed, re-run setup"
  "changelog|what changed between versions"
  "agents|the agents page in your browser tab (builds it on first run, no Kyber needed)"
  "trust|what stays on this Mac and what leaves it, in plain words"
  "week|your week in one line from the git repos here: shipped, uncommitted, unpushed, with a receipt"
  "stranger|time a new dev's install in a scratch HOME: prompts, errors, clone to first agent answer"
  "skills|list, search, or show a skill"
  "commands|list, search, or show a slash command"
  "why|which rule or skill governs a behavior; --refused says what refused and why"
  "log|what the kit has done recently"
  "usage|what got used in 30 days: every skill, verb, tool, slash command and hook, and what nobody touched"
  "bench|time the things that run on every session"
  "context|measure what the kit costs you before you type"
  "evals|run the skill evals"
  "gtme-math|compute offline cost, funnel, and heldout metrics"
  "gtme-graph|track GTM dependencies, budgets, and evidence"
  "gtme-learning|compare paired workflow experiments offline"
  "gtme-library|index and search a local source corpus"
  "gtme-dedupe|cluster duplicate people across contact CSVs"
  "gtme-signals|list recent SEC Form D raises as buying signals"
  "gtme-investors|a client's seed investor list from the Prometheus file, deduped and audited"
  "gtme-grade|run the five pre-send gates on one campaign; launch-guard needs its pass"
  "gtme-reply|classify a cold-email reply, clean its text, and gate auto-send, offline"
  "rea|how another app does one thing: REA status, a scoped Electron trace, a native overview (optional)"
  "resolve|answer a fact question (an address, a phone, a site) from every source before asking a person"
  "name-check|before pitching a product name: who holds the .com, free prefix .coms, the USPTO step"
  "gtme-rules|which client rulings run as code, and check text a client will read"
  "gtme-dnc|may we email this address: one check across the graph, DNC lists and the Clay blocklist"
  "gtme-score|Togari's lead, affiliation, primary-contact, tier and quality rubrics, offline"
  "gtme-lookup|ZoomInfo's free company and person search, Fireflies meetings, keys from the keychain"
  "gtme-interview|drill GTM engineer interview cases from sourced Clay procedures"
  "gtm|every client's campaigns, sends, replies and meetings, from the local graph"
  "gtme|a hired growth engineer: a plan from your business, first list, brief, next, report, lessons"
  "gtm-memory|accounts, contacts, jobs, commitments, Clay columns and credits per client"
  "jobs|one queue for long and heavy work: runs it when the Mac has room"
  "ig|read every Instagram post of an account with his signed-in session"
  "x|read an X account's own posts with his signed-in session"
  "api|any website as an API: call taught sites, teach new ones (not Clay)"
  "linkedin|LinkedIn reads inside your own signed-in Chrome tab (me, profile, people, inbox)"
  "groupme|GroupMe group chats and DMs, read inside your own signed-in GroupMe web tab"
  "chat|one inbox for every chat network: local Matrix bridges (up, down, status, link)"
  "office|Microsoft 365 mail, calendar, files, docs and Teams, read through Graph after one Microsoft device-code sign-in"
  "usc|a USC student's day; lockin pulls your courses, lecture files and what's due first"
  "browser|ChatGPT or Claude in Chrome as Chewbacca: install the Mac half, status, tools, log"
  "google|find and read Google Docs, Sheets and Slides as text"
  "docs|local Word, Excel and PowerPoint files through genoffice: read, preview an edit, apply it"
  "clay|any Clay read without opening Clay, by the fastest surface (clay ops)"
  "clay-fixture-check|compare a CSV export with an expected fixture"
  "oss-apps|open source apps that replace a Mac app, and which can be remixed"
  "task-graph|track local jobs, ownership, and dependencies"
  "ux-learning|record UX evidence and inspect portable navigation maps"
  "live|check the real tools on this machine, not just the install"
  "guide|interactive study guides that remember what you got wrong"
  "triggers|say things out loud and see whether any skill fires"
  "export|bundle this machine's kit state"
  "import|bring in what your other AI tools know (scan, apply, undo), or restore a bundle"
  "completion|print shell completion for zsh, bash, or fish"
  "add-skill|add a skill to the kit"
  "install|copy the standards into the current project"
  "uninstall|remove what setup put on this machine"
  "where|print where the kit is installed"
)

usage() {
  echo "chewbacca: shared context and tools for your coding agents"
  echo
  local name help
  for entry in "${COMMANDS[@]}"; do
    name="${entry%%|*}"; help="${entry#*|}"
    printf '  chewbacca %-12s %s\n' "$name" "$help"
  done
  echo
  echo "Runtime setup: chewbacca agent setup --runtime claude-code|codex|both"
  echo "ChatGPT Web: mac-use --provider chatgpt-web, or chatgpt-gateway --help."
}

run() {
  local script="$ROOT/$1"
  shift
  if [ ! -f "$script" ]; then
    echo "chewbacca: missing $script" >&2
    echo "  The kit may have moved. Set CHEWBACCA_ROOT, or re-run the installer." >&2
    exit 1
  fi
  bash "$script" "$@"
}

repo_version() { cat "$ROOT/VERSION" 2>/dev/null || echo "unknown"; }
installed_version() { cat "$STATE/version" 2>/dev/null || echo "unrecorded"; }

case "${1:-}" in
task-graph|graph-fuse|review-gate|break-it|work-ledger|tabs|ux-learning|jev|decision-lab|ux-decision|ux-policy|clay-review|gtme-math|gtme-graph|gtme-learning|gtme-library|gtme-signals|gtme-investors|gtme-grade|gtme-reply|gtme-rules|gtme-dnc|gtme-score|gtme-interview|resolve|name-check|gtm|gtm-memory|gtme|clay-fixture-check|oss-apps)
  tool="$1"
  shift
  exec python3 "$ROOT/bin/$tool" "$@"
  ;;
gtme-lookup)
  # Node: ZoomInfo's auth signs an RS256 JWT, which stdlib python can't.
  shift
  exec node "$ROOT/bin/gtme-lookup" "$@"
  ;;
gtme-dedupe)
  # Bash, not python: it picks the venv that has splink.
  shift
  exec bash "$ROOT/bin/gtme-dedupe" "$@"
  ;;
agent)
  shift
  exec python3 "$ROOT/tools/agent_runtime.py" "$@"
  ;;
agents)
  # Realm's agents page in a normal browser tab. On a Mac with Kyber the same
  # page is on the glass (`realm-ui show`); this needs neither Kyber nor PATH.
  shift
  exec python3 "$ROOT/bin/realm-ui" open --build "$@"
  ;;
trust)
  # What stays on this Mac and what leaves it, in plain words (config/trust.json).
  shift
  exec python3 "$ROOT/tools/trust.py" "$@"
  ;;
week)
  # Your week in one line from the git repos on this machine, with a receipt.
  shift
  exec python3 "$ROOT/tools/first_win.py" "$@"
  ;;
stranger)
  shift
  exec python3 "$ROOT/tools/stranger_run.py" "$@"
  ;;
rea)
  # REA (rea-agents) behind a deadline, thinned binaries and a scoped input.
  # Not a bin/ tool, so the kit never shadows REA's own `rea` on PATH.
  shift
  exec python3 "$ROOT/tools/rea_kit.py" "$@"
  ;;
clay)
  # Clay through the CLI, its own frontend API (api-anything), or the UI
  # route, whichever answers fastest. Writes need --allow-writes and --confirm.
  shift
  CHEWBACCA_ROOT="$ROOT" exec node "$ROOT/bin/chewbacca-clay" "$@"
  ;;
slack)
  # Slack sending through slackcli; reading needs nothing.
  shift
  exec bash "$ROOT/bin/chewbacca-slack" "$@"
  ;;
email)
  # Every inbox, one `chewbacca email add` each. Read and sent through the
  # Gmail API, never Mail.app.
  shift
  exec bash "$ROOT/bin/chewbacca-email" "$@"
  ;;
whatsapp)
  # WhatsApp is part of the kit: link, status and sync live here, and the
  # engines underneath are installed and driven for you.
  shift
  exec bash "$ROOT/bin/chewbacca-whatsapp" "$@"
  ;;
welcome|onboard|hello)
  # The first conversation after install: six tappable questions whose
  # answers personalize every later reply. See skills/welcome/SKILL.md.
  shift
  exec python3 "$ROOT/bin/chewbacca-welcome" "$@"
  ;;
permissions|permission|perms)
  # Every macOS grant Chewbacca needs, walked one at a time over System
  # Settings, each step moving on once detected. No args = the walk (a ring on
  # each switch, on Kyber's glass), because "make it SUPER EZ" (Caleb,
  # 2026-10-10) means one command, not a menu; without Kyber running the walk
  # falls back to the cards (`guide`) by itself.
  shift
  [ $# -eq 0 ] && set -- walk
  exec python3 "$ROOT/bin/chewbacca-permissions" "$@"
  ;;
land)
  # The one way a tab pushes: builds on a fresh worktree of origin/main,
  # regenerates the manifest, retries lost races. See bin/chewbacca-land.
  shift
  exec python3 -I "$ROOT/bin/chewbacca-land" "$@"
  ;;
launch)
  # Opens a new named, briefed session in the Claude desktop app. See bin/chewbacca-launch.
  shift
  exec python3 "$ROOT/bin/chewbacca-launch" "$@"
  ;;
usage)
  # Every skill, verb, bin tool, slash command and hook with its 30-day use,
  # load and refusal counts. See tools/usage_report.py.
  shift
  exec python3 "$ROOT/tools/usage_report.py" "$@"
  ;;
machine)
  # What this Mac can take right now: cores by kind, memory, power, whether
  # anyone is at it, and every load limit the kit uses. See bin/lib/machine_profile.py.
  shift
  exec python3 -I "$ROOT/bin/lib/machine_profile.py" "$@"
  ;;
jobs)
  # The machine queue. See bin/chewbacca-jobs.
  shift
  exec python3 "$ROOT/bin/chewbacca-jobs" "$@"
  ;;
apps)
  # Everything the team builds lives in apps/, runnable by name.
  shift
  exec bash "$ROOT/bin/chewbacca-apps" "$@"
  ;;
ig)
  # Instagram posts past the logged-out 12. See bin/chewbacca-ig.
  shift
  exec python3 "$ROOT/bin/chewbacca-ig" "$@"
  ;;
x)
  # X posts, signed in. See bin/chewbacca-x.
  shift
  exec python3 "$ROOT/bin/chewbacca-x" "$@"
  ;;
google)
  # Docs, Sheets and Slides through the official APIs (gws). Read-only but
  # for `replace`, one revision-checked Docs edit the Doc surface previews.
  shift
  exec python3 "$ROOT/bin/chewbacca-google" "$@"
  ;;
pdf)
  # Markdown or text to PDF in about 2 s a file. See bin/chewbacca-pdf.
  shift
  exec python3 "$ROOT/bin/chewbacca-pdf" "$@"
  ;;
docs)
  # Local .docx, .xlsx and .pptx through genoffice. See bin/chewbacca-docs.
  shift
  exec python3 "$ROOT/bin/chewbacca-docs" "$@"
  ;;
linkedin)
  # LinkedIn reads run inside the user's own Chrome tab. Read-only.
  shift
  exec python3 "$ROOT/bin/chewbacca-linkedin" "$@"
  ;;
chat)
  # Signal, Telegram, Discord, Instagram, Messenger, X, Google Messages and the
  # rest through mautrix bridges on a homeserver bound to 127.0.0.1.
  shift
  exec python3 "$ROOT/bin/chewbacca-chat" "$@"
  ;;
groupme)
  # GroupMe reads run inside the user's own web.groupme.com tab. Read-only.
  shift
  exec python3 "$ROOT/bin/chewbacca-groupme" "$@"
  ;;
office)
  # Microsoft 365 reads through Graph, signed in with Microsoft's own
  # device-code flow (MSAL); the token cache lives in the login keychain. Read-only.
  shift
  exec python3 "$ROOT/bin/chewbacca-office" "$@"
  ;;
browser)
  # The native host a chat tab reaches through apps/extensions/chewbacca.
  # Reads run; writes need a press on the Mac. docs/reference/BROWSER-CHEWB.md
  shift
  exec python3 "$ROOT/bin/chewbacca-browser" "$@"
  ;;
products)
  # The products built out of Chewbacca (anchored, usc-os): which shared files
  # are behind, and a pull that tests each product before pushing its main.
  shift
  exec python3 "$ROOT/bin/chewbacca-products" "$@"
  ;;
usc)
  # Any USC student's day from Brightspace, dining and the campus calendar,
  # through chewbacca api. Read-only.
  shift
  exec python3 "$ROOT/bin/chewbacca-usc" "$@"
  ;;
api)
  # Websites with no API, called over plain HTTP from operations learned off
  # their own frontend. Engine: goodnight000/api-anything.
  shift
  exec bash "$ROOT/bin/chewbacca-api" "$@"
  ;;
connect)
  # One verb wires every installed app (Claude Code, Codex, Cursor, Gemini)
  # and rebuilds the ChatGPT and claude.ai exports from the same sources.
  shift
  exec python3 "$ROOT/tools/agent_runtime.py" connect "$@"
  ;;
open)
  shift
  # A dashboard nobody can find is a file. This is the one verb that is worth
  # typing, so it gets the shortest name in the table.
  CHEWBACCA_ROOT="$ROOT" exec node "$ROOT/bin/lib/chewbacca-hud.js" "$@"
  ;;
doctor)
  shift
  run doctor.sh "$@"
  ;;
setup)
  shift
  run setup.sh "$@"
  ;;
add-skill)
  shift
  run add-skill.sh "$@"
  ;;
install)
  shift
  run install.sh "$@"
  ;;
uninstall)
  shift
  run uninstall.sh "$@"
  ;;
update)
  shift
  # From PATH this runs inside the kit runtime, a detached snapshot that has
  # no branch to pull. Updating it means a new snapshot of origin/main.
  if [ -f "$ROOT.kit-runtime.json" ]; then
    python3 -I "$ROOT/tools/kit_runtime.py" update --fetch --link-bin "$HOME/.local/bin" || exit 1
    # ROOT still names the snapshot this process started in, which the update
    # just replaced. Its setup.sh syncs the source checkout to its own, older
    # sha before handing over, so on 2026-10-11 an update installed the
    # previous version's setup and essay-gate only registered on a second run.
    NEW_ROOT="$(cd -P "$(python3 -I "$ROOT/tools/kit_runtime.py" path)" 2>/dev/null && pwd)"
    [ -n "$NEW_ROOT" ] && [ -f "$NEW_ROOT/setup.sh" ] && ROOT="$NEW_ROOT"
    run setup.sh "$@"
    exit $?
  fi
  # A start.sh install is a tarball with no .git: start.sh is its updater,
  # the same thing the stub this CLI replaced used to run.
  if [ ! -e "$ROOT/.git" ] && [ -f "$ROOT/start.sh" ]; then
    exec bash "$ROOT/start.sh" "$@"
  fi
  BEFORE="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo none)"
  git -C "$ROOT" pull --ff-only || {
    echo "chewbacca: could not fast-forward. Fix the working tree first:" >&2
    echo "  cd $ROOT && git status" >&2
    exit 1
  }
  AFTER="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo none)"
  if [ "$BEFORE" != "$AFTER" ] && [ "$BEFORE" != none ]; then
    echo
    echo "What changed:"
    git -C "$ROOT" log --oneline --no-decorate "$BEFORE..$AFTER" | sed 's/^/  /'
    echo
  else
    echo "Already current at $(repo_version)."
  fi
  run setup.sh "$@"
  ;;
version)
  shift
  if [ "${1:-}" = "--json" ]; then
    printf '{"repo":"%s","installed":"%s","commit":"%s","root":"%s"}\n' \
      "$(repo_version)" "$(installed_version)" \
      "$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)" "$ROOT"
  else
    echo "repo:      $(repo_version)  ($(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo 'not a git checkout'))"
    echo "installed: $(installed_version)"
    [ "$(repo_version)" != "$(installed_version)" ] &&
      echo "            these differ. Run: chewbacca setup"
  fi
  ;;
changelog)
  shift
  if [ -f "$ROOT/CHANGELOG.md" ]; then
    "${PAGER:-cat}" "$ROOT/CHANGELOG.md"
  else
    git -C "$ROOT" log --oneline -30
  fi
  ;;
status)
  shift
  run bin/lib/status.sh "$@"
  ;;
skills)
  shift
  run bin/lib/skills.sh "$@"
  ;;
commands)
  shift
  run bin/lib/commands.sh "$@"
  ;;
why)
  shift
  run bin/lib/why.sh "$@"
  ;;
log)
  shift
  run bin/lib/log.sh "$@"
  ;;
bench)
  shift
  run bin/lib/bench.sh "$@"
  ;;
context)
  shift
  python3 "$ROOT/tools/context_cost.py" "$@"
  ;;
send-policy)
  shift
  exec python3 "$ROOT/tools/send_policy.py" "$@"
  ;;
lessons)
  shift
  python3 "$ROOT/tools/lessons_audit.py" "$@"
  ;;
evals)
  shift
  python3 "$ROOT/tools/evals.py" "$@"
  ;;
live)
  shift
  run bin/live-check "$@"
  ;;
guide)
  shift
  python3 "$ROOT/bin/guide" "$@"
  ;;
triggers)
  shift
  python3 "$ROOT/tools/triggers.py" "$@"
  ;;
export)
  shift
  run bin/lib/export.sh "$@"
  ;;
import)
  shift
  # scan, apply and undo bring in what Claude Code, Codex, Cursor or a chat
  # export already know. Anything else is a bundle path for the restore.
  # -B from the first import: Apple python caches stdlib bytecode under
  # $HOME/Library before the tool can set dont_write_bytecode, and a scan
  # must write nothing (test_context_import, 10/13).
  case "${1:-}" in
  scan|apply|undo) exec python3 -B "$ROOT/tools/context_import.py" "$@" ;;
  esac
  run bin/lib/import.sh "$@"
  ;;
completion)
  shift
  run bin/lib/completion.sh "$@"
  ;;
where)
  printf '%s\n' "$ROOT"
  ;;
"" | -h | --help | help)
  usage
  ;;
*)
  echo "chewbacca: unknown command '$1'" >&2
  # Nearest match beats a bare error. A typo should cost one line, not a re-read.
  NEAR="$(for e in "${COMMANDS[@]}"; do echo "${e%%|*}"; done | grep -i "^${1:0:3}" | head -1)"
  [ -n "$NEAR" ] && echo "  did you mean: chewbacca $NEAR" >&2
  echo >&2
  usage >&2
  exit 1
  ;;
esac
