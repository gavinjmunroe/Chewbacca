#!/usr/bin/env python3
"""Did this session teach the kit anything, or just the transcript?

    kit-debt                 report, exit 1 if the session owes the kit
    kit-debt --terse         the lines a Stop hook injects
    kit-debt --hours 12

WHY THIS EXISTS. On 2026-09-20 Caleb asked four separate times whether Chewbacca
had been updated with what the session learned, and said "I shouldn't hv to keep
asking this bruv". He was right. The standing rule was written into memory as
prose, which is the same mistake craft-gate and list-gate already exist to name:
judgment in markdown does not fire.

So the rule is a program. It compares what the session changed OUT THERE against
what it committed to the kit, and if real work happened in a project while the
kit learned nothing, it says so before anyone calls the session finished.

It cannot know whether a lesson is worth keeping. It only knows the shape that
has been wrong every time: hours of work somewhere else, nothing here.
"""
import argparse, json, os, pathlib, subprocess, sys, time

# The kit checkout, NOT this script's parent. Installed at ~/.local/bin/kit-debt,
# parent.parent was ~/.local, whose git toplevel is $HOME, so `git log` ran in the
# home repo and returned nothing. kit_commits() was therefore always empty and this
# tool reported OWED on every session no matter what the kit shipped. A gate that
# can never be satisfied gets ignored, which is how it went unnoticed since 9/20.
def _kit_root():
    here = pathlib.Path(__file__).resolve()
    for c in [here.parent.parent, *(pathlib.Path.home() / "code" / n
                                    for n in ("chewbacca", "Chewbacca"))]:
        if (c / ".git").exists() and (c / "bin" / "kit-debt").exists():
            return c
    return here.parent.parent

ROOT = _kit_root()

def git(args, cwd=ROOT):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""

def satellites():
    """Tool repos that install skills into the kit, so a lesson can land there.

    On 2026-10-06 the brief fallback fix went into Nova (ea1c138, code plus a
    test) and this hook kept refusing the turn three times, because only the
    Chewbacca checkout counted. Scoped to ~/code/tools on purpose: refs/,
    vendor/ and personal/ also hold repos with a skills/ dir and are not kit."""
    tools = pathlib.Path.home() / "code" / "tools"
    if not tools.is_dir():
        return []
    return [d for d in tools.iterdir()
            if (d / ".git").exists() and (d / "skills").is_dir()
            and d.resolve() != ROOT.resolve()]

# Paths where a lesson can actually live. On 2026-10-09 this tool reported
# "clear" all night while Caleb corrected a website five times, because the
# team board auto-commits (team: CHW-143 moved to Backlog) and the README
# count regen are kit commits too. A board move teaches nothing.
LEARNING = ("skills/", "bin/", ".claude/hooks/", ".claude/rules/", "crafts/",
            "tools/", "tests/", "methods/", "library/")

def kit_commits(hours):
    # --all, not HEAD. Work often lands on main from a worktree while the main
    # checkout sits on a feature branch, and HEAD-only counting scored that as
    # zero on 2026-09-26 for a commit that was already pushed to main.
    lines = []
    for repo in [ROOT, *satellites()]:
        out = git(["log", "--all", f"--since={hours} hours ago",
                   "--format=@@%h %s", "--name-only"], cwd=repo)
        tag = "" if repo == ROOT else f"{repo.name}: "
        for block in out.split("@@")[1:]:
            head, *files = [l for l in block.splitlines() if l.strip()]
            if any(f.startswith(LEARNING) for f in files):
                lines.append(tag + head)
    return lines

# What Caleb types when the work is wrong. Counted from his own messages in
# this session's transcript, never from the assistant's.
CORRECTIONS = ("lame", "bruh", "bro ", "wtf", "ugly", "slop", "wrong", "abrupt",
               "chopped", "low aura", "cooked", "should never have to",
               "i told you", "again?", "not what i", "nowhere near", "boring",
               "do not use", "don't use", "stop ")

def corrections(transcript):
    """How many of the user's own messages in this session read as a correction."""
    n = 0
    try:
        for line in open(transcript, encoding="utf-8", errors="ignore"):
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if ev.get("type") != "user":
                continue
            msg = ev.get("message", {})
            content = msg.get("content", msg) if isinstance(msg, dict) else msg
            if isinstance(content, list):
                text = " ".join(c.get("text", "") for c in content
                                if isinstance(c, dict) and c.get("type") == "text")
            else:
                text = str(content)
            if "<system-reminder>" in text or "tool_result" in text:
                continue
            low = text.lower()
            if any(w in low for w in CORRECTIONS):
                n += 1
    except OSError:
        return 0
    return n

def session_taught(session):
    """Did THIS session write anywhere a lesson lives? Read from write-log.tsv."""
    log = pathlib.Path.home() / ".chewbacca" / "write-log.tsv"
    if not session or not log.exists():
        return False
    roots = [str(ROOT) + "/" + p for p in LEARNING] + [
        str(pathlib.Path.home() / ".chewbacca" / "skills"),
        str(pathlib.Path.home() / ".claude" / "skills"),
        str(pathlib.Path.home() / "code" / "tools")]
    for line in log.read_text(errors="ignore").splitlines():
        parts = line.split("\t")
        if len(parts) >= 3 and parts[1] == session and parts[2].startswith(tuple(roots)):
            return True
    return False

def work_dirs(hours):
    """Project repos touched recently, excluding the kit and the context store."""
    # ~/code holds one level of groups (amber, work, school...) since the
    # 2026-10-03 reorg, so a repo sits at ~/code/<group>/<repo>.
    code = pathlib.Path.home() / "code"
    roots = [code] + [code / g for g in ("kits", "amber", "work", "school", "personal", "tools")]
    cutoff = time.time() - hours * 3600
    seen = {}
    for base in roots:
        if not base.is_dir():
            continue
        for d in base.iterdir():
            if not (d / ".git").exists() or d.resolve() == ROOT.resolve():
                continue
            if d.resolve() in {x.resolve() for x in satellites()}:
                continue
            if d.name == "second-brain":
                continue
            n = git(["log", f"--since={hours} hours ago", "--format=%h"], cwd=d)
            n = len([x for x in n.splitlines() if x.strip()])
            if n:
                seen[d.name] = n
            elif d.stat().st_mtime > cutoff:
                seen.setdefault(d.name, 0)
    return seen

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--hours", type=int, default=12)
    ap.add_argument("--terse", action="store_true")
    ap.add_argument("--session", default="")
    ap.add_argument("--transcript", default="")
    a = ap.parse_args()

    # Corrected twice or more and this session wrote no skill, hook, rule or
    # tool: that is the debt, whatever other sessions committed. Caleb,
    # 2026-10-09: "I should never have to tell chewb to make a skill".
    fixes = corrections(a.transcript) if a.transcript else 0
    if fixes >= 2 and not session_taught(a.session):
        if a.terse:
            print(f"Caleb corrected this session {fixes} times and it wrote no skill, hook, rule or tool.")
            print("  Each correction is a lesson the next session will repeat unless it lands in the kit.")
            print("  Write or update the skill that owns this work (its never-dos, with his words and the date),")
            print("  or a gate if it's mechanical, commit it, then finish. Don't mention this check to him.")
        return 1

    kit = kit_commits(a.hours)
    work = work_dirs(a.hours)
    busy = {k: v for k, v in work.items() if v >= 2}

    owes = bool(busy) and not kit
    if a.terse:
        if owes:
            where = ", ".join(f"{k} ({v} commits)" for k, v in sorted(busy.items(), key=lambda x: -x[1]))
            print("This session shipped work but taught the kit nothing.")
            print(f"  worked in: {where}")
            print(f"  kit commits (chewbacca + skill-shipping tools) in the last {a.hours}h: 0")
            print("  Name one thing that went wrong or got learned, and make it a tool, a")
            print("  gate, a test or a skill section. Prose in a memory file does not fire.")
        return 1 if owes else 0

    print(f"\nkit-debt, last {a.hours}h")
    print(f"  chewbacca commits : {len(kit)}")
    for l in kit[:8]:
        print(f"      {l[:78]}")
    print(f"  project work      : {', '.join(f'{k}={v}' for k, v in work.items()) or 'none'}")
    if owes:
        print("\n  OWED. Real work happened elsewhere and the kit learned nothing.")
        print("  What would have caught tonight's failure? Build that.")
    elif kit:
        print("\n  clear. The kit learned something this session.")
    else:
        print("\n  clear. No substantial project work to learn from.")
    return 1 if owes else 0

if __name__ == "__main__":
    sys.exit(main())
