{
  "manifest_version": 3,
  "name": "Chewbacca",
  "short_name": "Chewbacca",
  "description": "Turns ChatGPT and Claude in your browser into Chewbacca: summarize a tab, pull what's due, and with the Mac half, your calendar, tasks and files.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "tabs",
    "activeTab",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "protocol.js",
        "sites.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Chewbacca"
  }
}
