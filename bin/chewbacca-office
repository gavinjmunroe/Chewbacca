#!/usr/bin/env python3
"""chewbacca office: Microsoft 365 reads through Microsoft Graph, signed in with Microsoft's own device-code flow.

  chewbacca office login                     sign in once: prints Microsoft's code and opens
                                             https://microsoft.com/devicelogin
  chewbacca office logout                    delete the saved sign-in from the login keychain
  chewbacca office mail [--unread] [--from X] [--limit N]
                    from, subject, received, preview, has attachments
  chewbacca office read <message id>        the message body as plain text
  chewbacca office calendar [--days N]       subject, start, end, location, organizer
  chewbacca office files [--recent | --search words]
                    OneDrive and shared files: name, type, modified, webUrl
  chewbacca office doc <file id | sharing url>
                    a Word, PowerPoint or Excel file as text (Excel: every sheet)
  chewbacca office teams                     chat list, topic, last updated
  Every command takes --json. Every command is read-only.

Sign-in: MSAL's device-code flow against the "organizations" authority, with
Microsoft's first-party public client "Microsoft Graph Command Line Tools"
(14d82eec-204b-4c2f-b7e8-296a70dab67e), asking only for delegated read scopes:
Mail.Read, Calendars.Read, Files.Read.All, Chat.ReadBasic and User.Read. MSAL
adds offline_access, openid and profile on its own and refuses them if passed,
so offline_access is requested by MSAL, not listed here. Entering the code and
finishing Duo is the user's step; this tool never types a credential or a code.
A tenant that blocks the app or wants admin consent answers with an AADSTS
error, which is printed as-is.

Token storage: the serialized MSAL token cache lives in the macOS login
keychain (generic password, service chewbacca-office, account = the UPN),
written and read through keyring's Security.framework calls, so the secret is
never on a command line. It is never written to a file, log, stdout or the
repo, and every printed line is scrubbed of any token this process holds.
Each command loads it and calls acquire_token_silent, which uses the cached
access token or refreshes it.

msal and keyring live in a private venv at ~/.chewbacca/venvs/office,
created on first use (CHEWBACCA_OFFICE_VENV moves it).

Read-only by construction: every request is a GET to the fixed origin
https://graph.microsoft.com/v1.0, built from a fixed path template with ids
validated to a strict character set. No send, reply, delete, move, flag,
accept or edit. `read` fetches a message with GET, which does not mark it
read. Stops on the first 401, 403, 429 or unexpected redirect, and says so.
"""
import datetime
import json
import os
import pathlib
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parent.parent

# Microsoft's own public client for the Graph command line tools. First party,
# so it needs no app registration of ours; a tenant can still block it.
CLIENT_ID = "14d82eec-204b-4c2f-b7e8-296a70dab67e"
AUTHORITY = "https://login.microsoftonline.com/organizations"
# Delegated and read-only. offline_access is added by MSAL itself (see above).
SCOPES = [
    "https://graph.microsoft.com/Mail.Read",
    "https://graph.microsoft.com/Calendars.Read",
    "https://graph.microsoft.com/Files.Read.All",
    "https://graph.microsoft.com/Chat.ReadBasic",
    "https://graph.microsoft.com/User.Read",
]
KEYCHAIN_SERVICE = "chewbacca-office"
SECURITY = os.environ.get("CHEWBACCA_OFFICE_SECURITY") or "/usr/bin/security"
OPENER = os.environ.get("CHEWBACCA_OFFICE_OPEN") or "/usr/bin/open"
VENV = pathlib.Path(os.environ.get("CHEWBACCA_OFFICE_VENV")
                    or pathlib.Path.home() / ".chewbacca/venvs/office")
MSAL_PIN = "msal>=1.28,<2"
KEYRING_PIN = "keyring>=25,<26"
# Where Microsoft's device-code message may send the browser. Anything else in
# a flow's verification_uri is printed but never opened.
DEVICE_LOGIN_HOSTS = ("microsoft.com", "www.microsoft.com", "login.microsoftonline.com",
                      "login.microsoft.com")
# The UPN becomes the keychain account name on a command line, so it is held to
# an address charset and can never start with "-" and be read as a flag.
UPN_RE = re.compile(r"[A-Za-z0-9._%+'@-]{1,256}")

# The one origin every request goes to. Fixed, https, Graph v1.0, GET only.
GRAPH = "https://graph.microsoft.com/v1.0"
GRAPH_HOST = "graph.microsoft.com"
# Tests point this at a loopback fake. Only http://127.0.0.1:<port> is
# accepted, so the override can never send the token to another host.
_TEST_BASE = os.environ.get("CHEWBACCA_OFFICE_GRAPH_BASE", "")
if _TEST_BASE and not re.fullmatch(r"http://127\.0\.0\.1:\d{2,5}", _TEST_BASE):
    sys.exit("chewbacca office: refused: CHEWBACCA_OFFICE_GRAPH_BASE must be http://127.0.0.1:<port>")
BASE = (_TEST_BASE + "/v1.0") if _TEST_BASE else GRAPH
# A driveItem's /content answers 302 to a pre-authenticated download URL on
# SharePoint. That one redirect is followed, without the Authorization header,
# and only to these hosts. Every other redirect stops the command.
DOWNLOAD_SUFFIXES = (".sharepoint.com",)

# At least one second between Graph calls inside one command. Graph throttles
# per-app and per-mailbox; its own web clients space background calls further
# apart than this. Guessed, never measured, so the env var may raise it and
# never lower it.
PAUSE = max(1.0, float(os.environ.get("CHEWBACCA_OFFICE_PAUSE", "1") or 1))
TIMEOUT = 60

# Bounds, so a huge mailbox, a giant file or a nextLink cycle cannot run forever
# or exhaust memory. Each is enforced and each truncation is reported. The env
# vars may only LOWER the two that tests drive; a raised value is ignored.
MAX_PAGES = min(12, int(os.environ.get("CHEWBACCA_OFFICE_MAXPAGES", "12") or 12))
# Bytes a single response may be before it is refused. A partial JSON body
# cannot be parsed, so an oversize response is refused whole rather than
# truncated mid-document.
MAX_BODY = min(5_000_000, int(os.environ.get("CHEWBACCA_OFFICE_MAXBYTES", "5000000") or 5_000_000))
# Characters kept from one document's extracted text.
MAX_DOC_CHARS = 500_000
MAX_SHEET_CHARS = 200_000
# Decompressed XML read from one .docx/.pptx, across all its parts. The 5 MB
# download cap bounds the zip, not what it inflates to: deflate reaches about
# 1000:1, so a 5 MB file could expand to gigabytes inside zf.read() before the
# character cap ever applied (security review, 2026-10-09). Markup is most of
# OOXML, so 20 MB of XML still yields far more than MAX_DOC_CHARS of text.
MAX_XML_BYTES = 20_000_000

# Request templates. Every Graph path is one of these, with {id}/{sid}/{q}
# filled from values validated against the charset below and then encoded
# exactly as encodeURIComponent would. The request is refused unless its
# pathname matches the template's own regex.
TEMPLATES = {
    "messages":       "/me/messages",
    "message":        "/me/messages/{id}",
    "calendarView":   "/me/calendarView",
    "drive_recent":   "/me/drive/recent",
    "drive_search":   "/me/drive/root/search(q='{q}')",
    "item":           "/me/drive/items/{id}",
    "item_content":   "/me/drive/items/{id}/content",
    "worksheets":     "/me/drive/items/{id}/workbook/worksheets",
    "usedRange":      "/me/drive/items/{id}/workbook/worksheets('{sid}')/usedRange",
    "chats":          "/me/chats",
}
# Graph ids as returned with Prefer: IdType="ImmutableId" are base64url-ish.
# Worksheet ids are GUIDs, sometimes in braces. Search words are kept to plain
# text so nothing can break out of the OData '...' literal.
VALIDATORS = {
    "id":  re.compile(r"[A-Za-z0-9_=!.-]{1,1024}"),
    "sid": re.compile(r"[A-Za-z0-9{}.-]{1,128}"),
    "q":   re.compile(r"[A-Za-z0-9 _.-]{1,128}"),
}
# What an encoded id looks like in a pathname: unreserved plus %XX, so a "/",
# "?", "#", "\" or ".." in an id can never land unencoded in a path segment.
ENC_CLASS = r"(?:[A-Za-z0-9_.!~*'()-]|%[0-9A-Fa-f]{2})+"


class Stop(Exception):
    """Microsoft pushed back, or there is no usable sign-in. Never retried."""


# Subjects, names, bodies, file names and chat text are written by other people
# and printed to a terminal an agent also reads. A raw ESC/CSI/OSC sequence,
# BEL, CR overwrite or bidi override in one could recolor, hide, relink or
# rewrite what is shown (security review, 2026-10-09). Every human-readable
# line goes through clean(); --json stays raw, since JSON escapes all of these.
UNSAFE = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f‪-‮⁦-⁩]")


# Every token and cache value this process has touched. Anything printed,
# from a normal line to an error or an exception message, is scrubbed of them
# first (security review, 2026-10-09: the keychain write and the error paths
# were the places a refresh token could reach a terminal).
SECRETS = set()


def remember_secret(v):
    if isinstance(v, str) and len(v) >= 16:
        SECRETS.add(v)


def remember_cache(text):
    """The cache text itself plus every `secret` value inside it (MSAL keeps
    access, refresh and id tokens under that key)."""
    remember_secret(text)
    try:
        doc = json.loads(text)
    except ValueError:
        return
    stack = [doc]
    while stack:
        node = stack.pop()
        if isinstance(node, dict):
            for k, v in node.items():
                if k == "secret":
                    remember_secret(v)
                else:
                    stack.append(v)
        elif isinstance(node, list):
            stack.extend(node)


def scrub(s):
    s = str(s)
    for v in sorted(SECRETS, key=len, reverse=True):
        s = s.replace(v, "[redacted]")
    return s


def clean(s):
    return UNSAFE.sub("", scrub(s))


def say(*parts, **kw):
    print(*(clean(p) for p in parts), **kw)


def die(msg, code=1):
    say(f"chewbacca office: {msg}", file=sys.stderr)
    sys.exit(code)


# ── msal, from its own venv ──────────────────────────────────────────────────

def load_msal():
    """Import msal from the private venv. The first call re-executes this
    script under the venv's python, creating the venv and installing msal if it
    is not there yet. The env flag stops a second re-exec."""
    if os.environ.get("CHEWBACCA_OFFICE_IN_VENV") != "1":
        py = VENV / "bin" / "python"
        if not py.exists():
            say(f"chewbacca office: first use, installing {MSAL_PIN} and {KEYRING_PIN} into {VENV} ...", file=sys.stderr)
            VENV.parent.mkdir(parents=True, exist_ok=True)
            for cmd in ([sys.executable, "-m", "venv", str(VENV)],
                        [str(py), "-m", "pip", "install", "--quiet", "--disable-pip-version-check", MSAL_PIN, KEYRING_PIN]):
                if subprocess.run(cmd).returncode != 0:
                    die(f"could not set up the msal venv at {VENV} ({cmd[2] if len(cmd) > 2 else cmd[0]} failed)")
        os.environ["CHEWBACCA_OFFICE_IN_VENV"] = "1"
        os.execv(str(py), [str(py), str(pathlib.Path(__file__).resolve()), *sys.argv[1:]])
    try:
        import msal
    except ImportError:
        die(f"msal is not importable from {VENV}. Delete that folder and rerun to rebuild it.")
    return msal


# ── keychain ─────────────────────────────────────────────────────────────────
# The cache holds a refresh token. It goes to the login keychain through
# keyring, which calls Security.framework (SecItemAdd, SecItemCopyMatching,
# SecItemDelete) in this process, so the secret is never on a command line.
# The first version passed it as `security add-generic-password -w <cache>`,
# and any local process can read a running process's argv with `ps`
# (security review, 2026-10-09). `security -i` on stdin is not an option
# either: it truncates a line near 4 KB (measured: a 12,000-char value came
# back as 4,031 chars), and a cache is larger. The one `security` call left
# reads the account name only: no -w, no -g, nothing secret in or out.

def _keyring():
    load_msal()   # the venv, where keyring lives
    try:
        import keyring
        import keyring.errors
    except ImportError:
        die(f"keyring is not importable from {VENV}. Delete that folder and rerun to rebuild it.")
    return keyring


def kc_account():
    """The UPN the saved item is filed under, read from its attributes."""
    r = subprocess.run([SECURITY, "find-generic-password", "-s", KEYCHAIN_SERVICE],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    m = re.search(r'"acct"<blob>="([^"]*)"', r.stdout)
    return m.group(1) if m and m.group(1) else None


def _kc_call(what, fn, *args):
    kr = _keyring()
    try:
        return fn(*args)
    except kr.errors.KeyringError as e:
        # The type only: a backend message is not trusted to leave the secret out.
        die(f"could not {what} the login keychain ({type(e).__name__}).")


def kc_read():
    acct = kc_account()
    if not acct:
        return None
    kr = _keyring()
    text = _kc_call("read", kr.get_password, KEYCHAIN_SERVICE, acct)
    if text:
        remember_cache(text)
    return text or None


def kc_write(upn, cache_text):
    remember_cache(cache_text)
    if not UPN_RE.fullmatch(upn or "") or upn.startswith("-"):
        die("refused: the signed-in account name has characters a keychain account can't hold")
    kr = _keyring()
    _kc_call("save the sign-in to", kr.set_password, KEYCHAIN_SERVICE, upn, cache_text)


def kc_delete():
    """Delete every chewbacca-office item. Returns how many went."""
    n = 0
    while n < 20:
        acct = kc_account()
        if not acct:
            break
        kr = _keyring()
        _kc_call("delete from", kr.delete_password, KEYCHAIN_SERVICE, acct)
        n += 1
    return n


# ── sign-in ──────────────────────────────────────────────────────────────────

def make_app(msal, cache):
    return msal.PublicClientApplication(CLIENT_ID, authority=AUTHORITY, token_cache=cache)


def aad_error(res):
    """Microsoft's own words: the error code and the AADSTS description."""
    return f"{res.get('error', 'error')}: {res.get('error_description', '').strip()}"


def cmd_login():
    msal = load_msal()
    cache = msal.SerializableTokenCache()
    app = make_app(msal, cache)
    flow = app.initiate_device_flow(scopes=SCOPES)
    if "user_code" not in flow:
        die(f"STOPPED: Microsoft refused to start the sign-in. BLOCKED: {clean(aad_error(flow))}", 4)
    # Microsoft's message, exactly: the code and where to enter it.
    say(flow["message"], flush=True)
    uri = flow.get("verification_uri") or ""
    sp = urllib.parse.urlsplit(uri)
    if sp.scheme == "https" and (sp.hostname or "").lower() in DEVICE_LOGIN_HOSTS and sp.netloc.lower() == sp.hostname:
        subprocess.run([OPENER, uri], capture_output=True)
    say("chewbacca office: waiting for the code to be entered and Duo approved ...", file=sys.stderr, flush=True)
    res = app.acquire_token_by_device_flow(flow)
    for k in ("access_token", "refresh_token", "id_token"):
        remember_secret(res.get(k))
    if "access_token" not in res:
        if res.get("error") in ("authorization_pending", "expired_token", "code_expired"):
            # MSAL polls until the flow's expires_at (900 s from Microsoft) and then
            # returns the last poll's "authorization_pending ... Continue polling",
            # which read like a bug the first time it happened (2026-10-09, 22:24).
            die("STOPPED: the sign-in code expired before it was entered (Microsoft "
                "gives 15 minutes). BLOCKED: run `chewbacca office login` again for a new code.", 4)
        die(f"STOPPED: sign-in did not finish. BLOCKED: {clean(aad_error(res))}", 4)
    claims = res.get("id_token_claims") or {}
    upn = claims.get("preferred_username") or claims.get("upn") or ""
    if not upn:
        accts = app.get_accounts()
        upn = accts[0].get("username", "") if accts else ""
    kc_delete()   # one account at a time
    kc_write(upn, cache.serialize())
    say(f"Signed in as {upn}. The sign-in is saved in the login keychain "
        f"(service {KEYCHAIN_SERVICE}); `chewbacca office logout` removes it.", flush=True)
    return 0


def cmd_logout():
    n = kc_delete()
    say("Signed out: removed the saved sign-in from the login keychain." if n
        else "Nothing to remove: no saved sign-in in the login keychain.")
    return 0


LOGIN_HINT = "BLOCKED: run `chewbacca office login` and enter the code it prints."


def access_token():
    """An access token from the keychain cache via acquire_token_silent, which
    returns the cached token or refreshes it. A changed cache is saved back."""
    raw = kc_read()
    if not raw:
        raise Stop("not signed in to Microsoft 365. " + LOGIN_HINT)
    msal = load_msal()
    cache = msal.SerializableTokenCache()
    try:
        cache.deserialize(raw)
    except ValueError:
        raise Stop("the saved sign-in is unreadable. " + LOGIN_HINT)
    app = make_app(msal, cache)
    accts = app.get_accounts()
    if not accts:
        raise Stop("the saved sign-in has no account in it. " + LOGIN_HINT)
    res = app.acquire_token_silent(SCOPES, account=accts[0])
    for k in ("access_token", "refresh_token", "id_token"):
        remember_secret((res or {}).get(k))
    if not res or "access_token" not in res:
        why = clean(aad_error(res)) if res else "the refresh token is gone or expired"
        raise Stop(f"could not refresh the sign-in ({why}). " + LOGIN_HINT)
    if cache.has_state_changed:
        kc_write(accts[0].get("username", ""), cache.serialize())
    return res["access_token"]


# ── request building ─────────────────────────────────────────────────────────

def host_of(url):
    try:
        return urllib.parse.urlsplit((url or "").strip())
    except ValueError:
        return None


def enc(v):
    """encodeURIComponent, in Python."""
    return urllib.parse.quote(v, safe="!*'()~-_.")


def template_regex(template):
    """A regex that matches exactly this template's pathname under /v1.0, with
    each {placeholder} standing for one encoded segment and everything else a
    literal."""
    out = ""
    for part in re.split(r"(\{[a-z]+\})", template):
        out += ENC_CLASS if re.fullmatch(r"\{[a-z]+\}", part) else re.escape(part)
    return r"^/v1\.0" + out + r"$"


def build(key, **ids):
    """(path, its template regex). Each id is validated against a strict set
    before encoding, so "..", "/", "?", "#", "\\" or an encoded "%2e%2e" is
    rejected here, never encoded into a traversal."""
    tmpl = TEMPLATES[key]
    vals = {}
    for name in re.findall(r"\{([a-z]+)\}", tmpl):
        v = ids[name]
        if not VALIDATORS[name].fullmatch(v):
            die(f"refused: '{name}' has characters that are not allowed in a Graph id")
        vals[name] = enc(v)
    return tmpl.format(**vals), template_regex(tmpl)


def nextlink_path(nxt, tmpl_re):
    """A path rebuilt from Graph's own @odata.nextLink, accepted only if it
    parses to the Graph origin and its pathname matches the same template the
    walk is already bound to. The raw URL is never fetched as-is."""
    sp = host_of(nxt)
    if not sp or sp.scheme != "https" or (sp.hostname or "").lower() != GRAPH_HOST:
        return None
    if sp.netloc.lower() != GRAPH_HOST or not sp.path.startswith("/v1.0/"):
        return None
    if not re.fullmatch(tmpl_re, sp.path):
        return None
    return sp.path[len("/v1.0"):] + (("?" + sp.query) if sp.query else "")


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    # urllib would follow a redirect and copy the Authorization header to
    # wherever it points. Nothing is followed automatically.
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


_OPENER = urllib.request.build_opener(_NoRedirect)


def _fetch(url, headers):
    """One GET. Returns (status, headers, body bytes or None if oversize)."""
    req = urllib.request.Request(url, method="GET", headers=headers)
    try:
        resp = _OPENER.open(req, timeout=TIMEOUT)
    except urllib.error.HTTPError as e:
        resp = e
    except (urllib.error.URLError, OSError) as e:
        die(f"could not reach Microsoft Graph: {getattr(e, 'reason', e)}")
    with resp:
        status = resp.status if hasattr(resp, "status") else resp.code
        data = resp.read(MAX_BODY + 1)
        return status, resp.headers, (None if len(data) > MAX_BODY else data)


def download_ok(url):
    sp = host_of(url)
    if not sp:
        return False
    if _TEST_BASE:
        return url.startswith(_TEST_BASE + "/download/")
    host = (sp.hostname or "").lower()
    return (sp.scheme == "https" and sp.netloc.lower() == host
            and any(host.endswith(s) for s in DOWNLOAD_SUFFIXES))


class Graph:
    def __init__(self, token_fn):
        self.token_fn = token_fn
        self.token = None
        self.last = 0.0
        self.calls = 0

    def get(self, path, tmpl_re, binary=False):
        """GET BASE + path. Returns the parsed JSON doc, or raw bytes for a
        binary path. The path must match its template; GET is the only method."""
        pathname = "/v1.0" + path.split("?", 1)[0]
        if not re.fullmatch(tmpl_re, pathname):
            die("refused: not a read path")
        dec = urllib.parse.unquote(pathname)
        if ".." in dec or "\\" in dec or "//" in pathname[1:]:
            die("refused: path traversal")
        url = BASE + path
        sp = host_of(url)
        if not sp or sp.path != pathname:
            die("refused: url changed on normalization")
        if self.token is None:
            self.token = self.token_fn()
        wait = self.last + PAUSE - time.monotonic()
        if self.last and wait > 0:
            time.sleep(wait)
        self.calls += 1
        self.last = time.monotonic()
        status, hdrs, body = _fetch(url, {"Authorization": "Bearer " + self.token,
                                          "Accept": "application/json",
                                          "Prefer": 'IdType="ImmutableId"'})
        if status in (301, 302, 303, 307, 308):
            loc = hdrs.get("Location", "")
            if not (binary and download_ok(loc)):
                raise Stop("Graph redirected the request somewhere unexpected. Stopped.")
            # The download URL is pre-authenticated; the token never goes there.
            wait = self.last + PAUSE - time.monotonic()
            if wait > 0:
                time.sleep(wait)
            self.last = time.monotonic()
            status, hdrs, body = _fetch(loc, {})
            if status in (301, 302, 303, 307, 308):
                raise Stop("the file download redirected again. Stopped.")
        if status == 401:
            raise Stop("Graph answered 401: the sign-in was rejected or revoked. " + LOGIN_HINT)
        if status == 403:
            raise Stop("Graph answered 403: this sign-in's scopes don't cover that read, or the "
                       "tenant blocks it. Stopped. If the scopes changed, `chewbacca office login` "
                       "asks for them again.")
        if status == 429:
            raise Stop("Graph answered 429 (rate limit). Stopped; wait before trying again. If it "
                       "keeps happening after a wait, sign in fresh with `chewbacca office login`.")
        if body is None:
            die(f"Graph response was over the {MAX_BODY}-byte cap; "
                f"narrow it with --limit, --search or a smaller file.")
        if binary:
            if status != 200:
                die(f"Graph answered {status} for {path.split('?')[0]}")
            return body
        text = body.decode("utf-8", "replace")
        if status not in (200, 206):
            try:
                e = json.loads(text).get("error", {})
                die(f"Graph answered {status} for {path.split('?')[0]}: "
                    f"{e.get('code', '')} {e.get('message', '')}"[:200])
            except (ValueError, AttributeError):
                die(f"Graph answered {status} for {path.split('?')[0]}")
        try:
            return json.loads(text) if text else {}
        except ValueError:
            die("Graph sent something other than JSON.")


# ── shaping ──────────────────────────────────────────────────────────────────

def when(iso):
    """A Graph UTC ISO timestamp as local 'YYYY-MM-DD HH:MM'."""
    if not iso:
        return ""
    try:
        s = iso.replace("Z", "+00:00")
        dt = datetime.datetime.fromisoformat(s)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=datetime.timezone.utc)
        return dt.astimezone().strftime("%Y-%m-%d %H:%M")
    except ValueError:
        return iso


def html_to_text(html):
    """Good-enough plain text from an HTML mail body or a converted doc."""
    html = re.sub(r"(?is)<(script|style)[^>]*>.*?</\1>", "", html)
    html = re.sub(r"(?i)<br\s*/?>", "\n", html)
    html = re.sub(r"(?i)</(p|div|tr|h[1-6]|li)>", "\n", html)
    text = re.sub(r"<[^>]+>", "", html)
    text = (text.replace("&nbsp;", " ").replace("&amp;", "&").replace("&lt;", "<")
            .replace("&gt;", ">").replace("&quot;", '"').replace("&#39;", "'"))
    text = re.sub(r"\n[ \t]+\n", "\n\n", text)
    return re.sub(r"\n{3,}", "\n\n", text).strip()


def addr(obj):
    ea = (obj or {}).get("emailAddress") or {}
    return ea.get("name") or ea.get("address") or ""


def mail_row(m):
    return {"id": m.get("id", ""), "from": addr(m.get("from") or m.get("sender")),
            "subject": m.get("subject") or "(no subject)",
            "received": when(m.get("receivedDateTime")),
            "unread": not m.get("isRead", True),
            "has_attachments": bool(m.get("hasAttachments")),
            "preview": (m.get("bodyPreview") or "").strip()}


def event_row(e):
    return {"subject": e.get("subject") or "(no subject)",
            "start": when((e.get("start") or {}).get("dateTime")),
            "end": when((e.get("end") or {}).get("dateTime")),
            "location": ((e.get("location") or {}).get("displayName") or ""),
            "organizer": addr(e.get("organizer"))}


def file_row(d):
    kind = "folder" if d.get("folder") else ((d.get("file") or {}).get("mimeType") or "file")
    item = d.get("remoteItem") or d
    return {"name": d.get("name") or item.get("name") or "",
            "type": kind, "modified": when(d.get("lastModifiedDateTime")),
            "size": d.get("size"), "id": d.get("id") or item.get("id") or "",
            "webUrl": d.get("webUrl") or item.get("webUrl") or ""}


def chat_row(c):
    last = c.get("lastMessagePreview") or {}
    body = (last.get("body") or {}).get("content") or ""
    sender = (((last.get("from") or {}).get("user") or {}).get("displayName")) or ""
    topic = c.get("topic")
    if not topic:
        members = [m.get("displayName") or "" for m in (c.get("members") or [])]
        topic = ", ".join(m for m in members if m) or (c.get("chatType") or "chat")
    return {"id": c.get("id", ""), "topic": topic, "chat_type": c.get("chatType") or "",
            "last_message": when(last.get("createdDateTime") or c.get("lastUpdatedDateTime")),
            "preview": (f"{sender}: " if sender else "") + html_to_text(body)[:200]}


# ── commands ───────────────────────────────────────────────────────────────────

def q(params):
    return "?" + urllib.parse.urlencode(params, quote_via=urllib.parse.quote)


def page_list(g, key, query, limit, **ids):
    """Follow Graph @odata.nextLink up to MAX_PAGES. Each nextLink is parsed and
    must match the same template; a cycle (a nextLink already seen) or an
    off-template link stops the walk. Returns (items, truncated)."""
    path, tmpl_re = build(key, **ids)
    full = path + query
    out, pages, seen, truncated = [], 0, set(), False
    while True:
        doc = g.get(full, tmpl_re)
        out += (doc.get("value") or [])
        pages += 1
        nxt = doc.get("@odata.nextLink")
        if len(out) >= limit:
            break
        if pages >= MAX_PAGES:
            truncated = bool(nxt)
            break
        if not nxt:
            break
        np = nextlink_path(nxt, tmpl_re)
        if not np:
            truncated = True   # a nextLink off-template or off-origin: stop here
            break
        if np in seen:
            truncated = True   # a cycle: stop here
            break
        seen.add(np)
        full = np
    return out[:limit], truncated


def cmd_mail(g, a):
    sel = "id,subject,from,sender,receivedDateTime,isRead,hasAttachments,bodyPreview"
    filt = []
    if a.unread:
        filt.append("isRead eq false")
    if getattr(a, "frm", None):
        safe = a.frm.replace("'", "''")
        filt.append(f"from/emailAddress/address eq '{safe}'")
    params = {"$select": sel, "$top": str(min(a.limit or 25, 50)),
              "$orderby": "receivedDateTime desc"}
    if filt:
        params["$filter"] = " and ".join(filt)
    rows, trunc = page_list(g, "messages", q(params), a.limit or 25)
    return [mail_row(m) for m in rows], trunc


def cmd_read(g, a):
    if not a.rest:
        die("read needs a message id (from `chewbacca office mail`)")
    path, tmpl_re = build("message", id=a.rest[0])
    # GET of a single message. A GET never sets isRead; only a PATCH would, and
    # this tool issues no PATCH. $select avoids pulling attachments' bytes.
    doc = g.get(path + q({"$select": "subject,from,sender,toRecipients,receivedDateTime,body,bodyPreview,isRead"}),
                tmpl_re)
    body = doc.get("body") or {}
    content = body.get("content") or doc.get("bodyPreview") or ""
    text = html_to_text(content) if (body.get("contentType") == "html") else content.strip()
    to = ", ".join(addr(r) for r in (doc.get("toRecipients") or []))
    return {"subject": doc.get("subject") or "(no subject)", "from": addr(doc.get("from") or doc.get("sender")),
            "to": to, "received": when(doc.get("receivedDateTime")),
            "was_unread": not doc.get("isRead", True), "text": text[:MAX_DOC_CHARS]}


def cmd_calendar(g, a):
    days = a.days or 7
    now = datetime.datetime.now(datetime.timezone.utc)
    end = now + datetime.timedelta(days=days)
    params = {"startDateTime": now.strftime("%Y-%m-%dT%H:%M:%SZ"),
              "endDateTime": end.strftime("%Y-%m-%dT%H:%M:%SZ"),
              "$select": "subject,start,end,location,organizer",
              "$orderby": "start/dateTime", "$top": "50"}
    rows, trunc = page_list(g, "calendarView", q(params), a.limit or 50)
    return [event_row(e) for e in rows], trunc


def cmd_files(g, a):
    sel = "name,file,folder,lastModifiedDateTime,size,id,webUrl,remoteItem"
    if a.search is not None:
        if not VALIDATORS["q"].fullmatch(a.search):
            die("--search takes plain words (letters, digits, spaces, . _ -)")
        rows, trunc = page_list(g, "drive_search", q({"$select": sel, "$top": "50"}),
                                a.limit or 25, q=a.search)
    else:
        # recent is the default view: files touched lately, across drives.
        rows, trunc = page_list(g, "drive_recent", q({"$top": "50"}), a.limit or 25)
    return [file_row(d) for d in rows], trunc


def resolve_item_id(ref):
    """A drive-item id as given, or extracted from a OneDrive/SharePoint URL."""
    ref = ref.strip()
    sp = host_of(ref)
    if sp and sp.scheme in ("http", "https"):
        qs = dict(urllib.parse.parse_qsl(sp.query))
        for kk in ("id", "sourcedoc", "resid"):
            if qs.get(kk):
                return qs[kk].strip("{}")
        die("could not find a file id in that URL. Pass the id from `chewbacca office files`.")
    return ref


def cmd_doc(g, a):
    if not a.rest:
        die("doc needs a file id or a OneDrive/SharePoint URL")
    item_id = resolve_item_id(a.rest[0])
    mpath, mtmpl = build("item", id=item_id)
    meta = g.get(mpath + q({"$select": "name,file,size"}), mtmpl)
    name = meta.get("name") or ""
    mime = (meta.get("file") or {}).get("mimeType") or ""
    ext = name.lower().rsplit(".", 1)[-1] if "." in name else ""
    if ext in ("xlsx", "xlsm", "xlsb") or "spreadsheet" in mime:
        return {"name": name, "type": "excel", "sheets": excel_sheets(g, item_id)}
    cpath, ctmpl = build("item_content", id=item_id)
    data = g.get(cpath, ctmpl, binary=True)
    return {"name": name, "type": ext or mime or "file", "text": office_text(data, ext)}


def excel_sheets(g, item_id):
    sheets, _ = page_list(g, "worksheets", q({"$select": "id,name,position"}), 50, id=item_id)
    out = []
    for s in sorted(sheets, key=lambda x: x.get("position", 0)):
        rpath, rtmpl = build("usedRange", id=item_id, sid=str(s.get("id")))
        rng = g.get(rpath + q({"$select": "text"}), rtmpl)
        grid = rng.get("text") or []
        lines = ["\t".join("" if c is None else str(c) for c in row) for row in grid]
        text = "\n".join(lines)
        out.append({"name": s.get("name") or "", "rows": len(grid),
                    "text": text[:MAX_SHEET_CHARS]})
    return out


def office_text(data, ext):
    """Plain text from a Word (.docx) or PowerPoint (.pptx) OOXML file, which is
    a zip of XML. Done here, from bytes Graph returned, so no extra call."""
    import io
    import zipfile
    try:
        zf = zipfile.ZipFile(io.BytesIO(data))
    except zipfile.BadZipFile:
        # An older .doc/.ppt (OLE) or an unexpected type: return any printable
        # runs rather than nothing, so the command still says something useful.
        txt = data.decode("latin-1", "ignore")
        return re.sub(r"[^\x09\x0a\x0d\x20-\x7e]{1,}", " ", txt)[:MAX_DOC_CHARS].strip()
    names = zf.namelist()
    if ext == "pptx" or any(n.startswith("ppt/slides/slide") for n in names):
        parts = sorted(n for n in names if re.match(r"ppt/slides/slide\d+\.xml$", n))
    elif any(n == "word/document.xml" for n in names):
        parts = ["word/document.xml"]
    else:
        parts = [n for n in names if n.endswith(".xml") and ("document" in n or "slide" in n)]
    chunks, total, budget = [], 0, MAX_XML_BYTES
    for n in parts:
        if budget <= 0:
            break
        try:
            with zf.open(n) as member:
                raw = member.read(budget)
        except (KeyError, zipfile.BadZipFile, RuntimeError, OSError):
            continue
        budget -= len(raw)
        xml = raw.decode("utf-8", "ignore")
        xml = re.sub(r"(?i)</w:p>|</a:p>|<w:br/?>|<a:br/?>", "\n", xml)
        xml = re.sub(r"<[^>]+>", "", xml)
        xml = (xml.replace("&amp;", "&").replace("&lt;", "<").replace("&gt;", ">")
               .replace("&quot;", '"').replace("&#39;", "'"))
        if xml.strip():
            chunks.append(xml)
            total += len(xml)
        if total >= MAX_DOC_CHARS:
            break
    return re.sub(r"\n{3,}", "\n\n", "\n\n".join(chunks)).strip()[:MAX_DOC_CHARS]


def cmd_teams(g, a):
    # Chat.ReadBasic covers the chat list, topic and members' names, not message
    # bodies, so lastMessagePreview is not expanded: asking for it would be a
    # 403 that stops the whole command. chat_row prints a preview if one comes.
    params = {"$top": "50"}
    rows, trunc = page_list(g, "chats", q(params), a.limit or 50)
    return [chat_row(c) for c in rows], trunc


# ── output ───────────────────────────────────────────────────────────────────

def show(cmd, data):
    if cmd == "read":
        say(f"From:     {data['from']}")
        say(f"To:       {data['to']}")
        say(f"Subject:  {data['subject']}")
        say(f"Received: {data['received']}")
        say("")
        say(data["text"] or "(empty body)")
        return
    if cmd == "doc":
        say(f"{data['name']}  ({data['type']})")
        if data.get("type") == "excel":
            for sh in data["sheets"]:
                say(f"\n== {sh['name']}  ({sh['rows']} rows)")
                say(sh["text"] or "(empty)")
        else:
            say("")
            say(data.get("text") or "(no text)")
        return
    if not data:
        say("(nothing)")
        return
    for r in data:
        if cmd == "mail":
            flags = ("  [unread]" if r["unread"] else "") + ("  [attach]" if r["has_attachments"] else "")
            say(f"{r['received']}  {r['from']}{flags}")
            say(f"    {r['subject']}")
            if r["preview"]:
                say(f"    {r['preview'][:140]}")
            say(f"    id {r['id']}")
        elif cmd == "calendar":
            where = f"  @ {r['location']}" if r["location"] else ""
            say(f"{r['start']} - {r['end']}  {r['subject']}{where}")
            if r["organizer"]:
                say(f"    organizer: {r['organizer']}")
        elif cmd == "files":
            size = f"  {r['size']} B" if r.get("size") else ""
            say(f"{r['modified']}  {r['name']}  ({r['type']}){size}")
            if r["webUrl"]:
                say(f"    {r['webUrl']}")
            say(f"    id {r['id']}")
        elif cmd == "teams":
            say(f"{r['last_message']}  {r['topic']}  ({r['chat_type']})")
            if r["preview"]:
                say(f"    {r['preview'][:160]}")


COMMANDS = {"mail": cmd_mail, "read": cmd_read, "calendar": cmd_calendar,
            "files": cmd_files, "doc": cmd_doc, "teams": cmd_teams}
LIST_COMMANDS = {"mail", "calendar", "files", "teams"}


class Args:
    def __init__(self, argv):
        self.json = self.unread = self.recent = False
        self.frm = self.search = None
        self.days = self.limit = None
        self.rest = []
        it = iter(argv)
        for x in it:
            if x == "--json":
                self.json = True
            elif x == "--unread":
                self.unread = True
            elif x == "--recent":
                self.recent = True
            elif x == "--from":
                self.frm = next(it, None) or die("--from needs an address")
            elif x == "--search":
                self.search = next(it, None)
                if self.search is None:
                    die("--search needs words")
            elif x == "--days":
                try:
                    self.days = max(1, int(next(it, "")))
                except ValueError:
                    die("--days needs a number")
            elif x == "--limit":
                try:
                    self.limit = max(1, int(next(it, "")))
                except ValueError:
                    die("--limit needs a number")
            else:
                self.rest.append(x)


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.split("\n\n")[0] + "\n" + __doc__.split("\n\n")[1])
        return 0
    cmd = argv[0]
    if cmd == "login":
        return cmd_login()
    if cmd == "logout":
        return cmd_logout()
    if cmd not in COMMANDS:
        die(f"unknown command '{cmd}'. Try: chewbacca office help", 2)
    a = Args(argv[1:])
    g = Graph(access_token)
    truncated = False
    try:
        data = COMMANDS[cmd](g, a)
        if cmd in LIST_COMMANDS:
            data, truncated = data
    except Stop as e:
        die(f"STOPPED: {e}", 4)
    if a.json:
        out = {"items": data, "truncated": truncated} if cmd in LIST_COMMANDS else data
        print(scrub(json.dumps(out, indent=2, ensure_ascii=False)))
    else:
        show(cmd, data)
        if truncated:
            say("... (truncated: more results exist; narrow with --limit, --search or --from)")
    return 0


def run(argv):
    """main(), with any unexpected exception reduced to its type and a
    scrubbed message. No traceback: MSAL and urllib exceptions can carry
    response text, and a traceback prints it unfiltered."""
    try:
        return main(argv)
    except KeyboardInterrupt:
        return 130
    except Exception as e:  # noqa: BLE001, the last line of defense on purpose
        die(f"unexpected {type(e).__name__}: {str(e)[:300]}", 3)


if __name__ == "__main__":
    sys.exit(run(sys.argv[1:]))
